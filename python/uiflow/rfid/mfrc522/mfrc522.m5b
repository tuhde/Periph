{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_mfrc522Init", "__Periph_mfrc522IsCardPresent", "__Periph_mfrc522ReadUid"], "jscode": "// Block __Periph_mfrc522Init\nvar __Periph_mfrc522Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MFRC522\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPI bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CS pin\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs_pin\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_mfrc522Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mfrc522Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mfrc522Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _cs_pin = block.getFieldValue('_cs_pin');\nreturn `from periph.connection.spi_auto import SPIConnection as _periph_spi_conn\nfrom periph.chips.rfid.mfrc522 import MFRC522Full as _MFRC522Full\n\n_periph_mfrc522 = _MFRC522Full(_periph_spi_conn(bus=${_bus}, cs_pin=${_cs_pin}))\n`\n};\n// Block __Periph_mfrc522IsCardPresent\nvar __Periph_mfrc522IsCardPresent_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MFRC522 card present?\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_mfrc522IsCardPresent'] = {\n    init: function() {\n        this.jsonInit(__Periph_mfrc522IsCardPresent_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mfrc522IsCardPresent'] = function(block) {\n    \nreturn [`_periph_mfrc522.is_card_present()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mfrc522ReadUid\nvar __Periph_mfrc522ReadUid_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MFRC522 card UID (hex, empty if none)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_mfrc522ReadUid'] = {\n    init: function() {\n        this.jsonInit(__Periph_mfrc522ReadUid_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mfrc522ReadUid'] = function(block) {\n    \nreturn [`(_periph_mfrc522.read_uid() or b'').hex()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}