{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_hx711Init", "__Periph_hx711Tare", "__Periph_hx711SetScale", "__Periph_hx711ReadWeight", "__Periph_hx711ReadRaw"], "jscode": "// Block __Periph_hx711Init\nvar __Periph_hx711Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HX711\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DOUT pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_dout\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_dout\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PD_SCK pin\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pd_sck\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pd_sck\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_hx711Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx711Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx711Init'] = function(block) {\n    \n\nvar _dout = block.getFieldValue('_dout');\n\nvar _pd_sck = block.getFieldValue('_pd_sck');\nreturn `from periph.connection.hx711_auto import HX711Connection as _periph_hx711_conn\nfrom periph.chips.adc_dac.hx711 import HX711Full as _HX711Full\n\n_periph_hx711 = _HX711Full(_periph_hx711_conn(${_dout}, ${_pd_sck}))\n`\n};\n// Block __Periph_hx711Tare\nvar __Periph_hx711Tare_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX711 tare (zero the scale)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_hx711Tare'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx711Tare_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx711Tare'] = function(block) {\n    \nreturn `_periph_hx711.tare()\n`\n};\n// Block __Periph_hx711SetScale\nvar __Periph_hx711SetScale_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX711 set scale factor\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_factor\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_factor\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_hx711SetScale'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx711SetScale_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx711SetScale'] = function(block) {\n    \nvar _factor = block.getFieldValue('_factor');\nreturn `_periph_hx711.set_scale(${_factor})\n`\n};\n// Block __Periph_hx711ReadWeight\nvar __Periph_hx711ReadWeight_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX711 weight\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_hx711ReadWeight'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx711ReadWeight_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx711ReadWeight'] = function(block) {\n    \nreturn [`_periph_hx711.read_weight()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hx711ReadRaw\nvar __Periph_hx711ReadRaw_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX711 raw ADC value\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_hx711ReadRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx711ReadRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx711ReadRaw'] = function(block) {\n    \nreturn [`_periph_hx711.read_raw()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}