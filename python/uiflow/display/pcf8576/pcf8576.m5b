{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_pcf8576Init", "__Periph_pcf8576Clear", "__Periph_pcf8576SetDigit"], "jscode": "// Block __Periph_pcf8576Init\nvar __Periph_pcf8576Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init PCF8576\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8576Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8576Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8576Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.display.pcf8576 import PCF8576Full as _PCF8576Full\n\n_periph_pcf8576 = _PCF8576Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_pcf8576Clear\nvar __Periph_pcf8576Clear_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8576 clear display\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8576Clear'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8576Clear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8576Clear'] = function(block) {\n    \nreturn `_periph_pcf8576.clear()\n`\n};\n// Block __Periph_pcf8576SetDigit\nvar __Periph_pcf8576SetDigit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8576 set digit\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"position (0-19)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_position\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_position\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"segments byte\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_segments\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_segments\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8576SetDigit'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8576SetDigit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8576SetDigit'] = function(block) {\n    \n\nvar _position = block.getFieldValue('_position');\n\nvar _segments = block.getFieldValue('_segments');\nreturn `_periph_pcf8576.set_digit_7seg(${_position}, ${_segments})\n`\n};\n"}