{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_dht11Init", "__Periph_dht11ReadTemperature", "__Periph_dht11ReadHumidity"], "jscode": "// Block __Periph_dht11Init\nvar __Periph_dht11Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init DHT11\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"data pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_dht11Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_dht11Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_dht11Init'] = function(block) {\n    \n\nvar _pin = block.getFieldValue('_pin');\nreturn `from periph.connection.dhtxx_auto import DHTxxConnection as _periph_dhtxx_conn\nfrom periph.chips.humidity.dht11 import DHT11Full as _DHT11Full\n\n_periph_dht11 = _DHT11Full(_periph_dhtxx_conn(${_pin}))\n`\n};\n// Block __Periph_dht11ReadTemperature\nvar __Periph_dht11ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DHT11 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_dht11ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_dht11ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_dht11ReadTemperature'] = function(block) {\n    \nreturn [`_periph_dht11.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_dht11ReadHumidity\nvar __Periph_dht11ReadHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DHT11 humidity (%)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_dht11ReadHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_dht11ReadHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_dht11ReadHumidity'] = function(block) {\n    \nreturn [`_periph_dht11.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}