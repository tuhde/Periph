{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_ina219Init", "__Periph_ina219Voltage", "__Periph_ina219ShuntVoltage", "__Periph_ina219Current", "__Periph_ina219Power"], "jscode": "// Block __Periph_ina219Init\nvar __Periph_ina219Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init INA219\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"shunt resistor (ohm)\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_r_shunt\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_r_shunt\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"max current (A)\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_max_current\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_max_current\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina219Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina219Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina219Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\n\nvar _r_shunt = block.getFieldValue('_r_shunt');\n\nvar _max_current = block.getFieldValue('_max_current');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.power.ina219 import INA219Full as _INA219Full\n\n_periph_ina219 = _INA219Full(_periph_i2c_conn(${_address}, bus=${_bus}), r_shunt=${_r_shunt}, max_current=${_max_current})\n`\n};\n// Block __Periph_ina219Voltage\nvar __Periph_ina219Voltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA219 bus voltage (V)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina219Voltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina219Voltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina219Voltage'] = function(block) {\n    \nreturn [`_periph_ina219.voltage()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina219ShuntVoltage\nvar __Periph_ina219ShuntVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA219 shunt voltage (V)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina219ShuntVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina219ShuntVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina219ShuntVoltage'] = function(block) {\n    \nreturn [`_periph_ina219.shunt_voltage()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina219Current\nvar __Periph_ina219Current_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA219 current (A)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina219Current'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina219Current_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina219Current'] = function(block) {\n    \nreturn [`_periph_ina219.current()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina219Power\nvar __Periph_ina219Power_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA219 power (W)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina219Power'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina219Power_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina219Power'] = function(block) {\n    \nreturn [`_periph_ina219.power()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}