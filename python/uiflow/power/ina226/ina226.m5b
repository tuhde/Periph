{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_ina226Init", "__Periph_ina226ReadVoltage", "__Periph_ina226ReadCurrent", "__Periph_ina226ReadPower"], "jscode": "// Block __Periph_ina226Init\nvar __Periph_ina226Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init INA226\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"shunt resistor (Ω)\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_r_shunt\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_r_shunt\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"max current (A)\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_max_current\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_max_current\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina226Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina226Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina226Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\n\nvar _r_shunt = block.getFieldValue('_r_shunt');\n\nvar _max_current = block.getFieldValue('_max_current');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.power.ina226 import INA226Full as _INA226Full\n\n_periph_ina226 = _INA226Full(_periph_i2c_conn(${_address}, bus=${_bus}), r_shunt=${_r_shunt}, max_current=${_max_current})\n`\n};\n// Block __Periph_ina226ReadVoltage\nvar __Periph_ina226ReadVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA226 bus voltage (V)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina226ReadVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina226ReadVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina226ReadVoltage'] = function(block) {\n    \nreturn [`_periph_ina226.voltage()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina226ReadCurrent\nvar __Periph_ina226ReadCurrent_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA226 current (A)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina226ReadCurrent'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina226ReadCurrent_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina226ReadCurrent'] = function(block) {\n    \nreturn [`_periph_ina226.current()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina226ReadPower\nvar __Periph_ina226ReadPower_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA226 power (W)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina226ReadPower'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina226ReadPower_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina226ReadPower'] = function(block) {\n    \nreturn [`_periph_ina226.power()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}