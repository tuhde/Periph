{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_as5600Init", "__Periph_as5600Angle", "__Periph_as5600AngleRaw", "__Periph_as5600IsMagnetDetected", "__Periph_as5600IsMagnetTooStrong", "__Periph_as5600IsMagnetTooWeak"], "jscode": "// Block __Periph_as5600Init\nvar __Periph_as5600Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init AS5600\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_as5600Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_as5600Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as5600Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.magnetometer.as5600 import AS5600Full as _AS5600Full\n\n_periph_as5600 = _AS5600Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_as5600Angle\nvar __Periph_as5600Angle_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS5600 angle (degrees)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_as5600Angle'] = {\n    init: function() {\n        this.jsonInit(__Periph_as5600Angle_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as5600Angle'] = function(block) {\n    \nreturn [`_periph_as5600.angle()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_as5600AngleRaw\nvar __Periph_as5600AngleRaw_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS5600 angle raw (0-4095)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_as5600AngleRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_as5600AngleRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as5600AngleRaw'] = function(block) {\n    \nreturn [`_periph_as5600.angle_raw()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_as5600IsMagnetDetected\nvar __Periph_as5600IsMagnetDetected_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS5600 magnet detected?\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_as5600IsMagnetDetected'] = {\n    init: function() {\n        this.jsonInit(__Periph_as5600IsMagnetDetected_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as5600IsMagnetDetected'] = function(block) {\n    \nreturn [`_periph_as5600.is_magnet_detected()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_as5600IsMagnetTooStrong\nvar __Periph_as5600IsMagnetTooStrong_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n      