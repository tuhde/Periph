{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_neo6Init", "__Periph_neo6Update", "__Periph_neo6Latitude", "__Periph_neo6Longitude", "__Periph_neo6Altitude"], "jscode": "// Block __Periph_neo6Init\nvar __Periph_neo6Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init NEO-6\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UART port\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_port\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_port\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"baudrate\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_baudrate\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_baudrate\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TX pin\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_tx\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_tx\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RX pin\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_rx\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_rx\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_neo6Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_neo6Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_neo6Init'] = function(block) {\n    \n\nvar _port = block.getFieldValue('_port');\n\nvar _baudrate = block.getFieldValue('_baudrate');\n\nvar _tx = block.getFieldValue('_tx');\n\nvar _rx = block.getFieldValue('_rx');\nreturn `from periph.connection.uart_auto import UARTConnection as _periph_uart_conn\nfrom periph.chips.gnss.neo6 import NEO6Full as _NEO6Full\n\n_periph_neo6 = _NEO6Full(_periph_uart_conn(port=${_port}, baudrate=${_baudrate}, tx=${_tx}, rx=${_rx}))\n`\n};\n// Block __Periph_neo6Update\nvar __Periph_neo6Update_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"NEO-6 update (got new fix?)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_neo6Update'] = {\n    init: function() {\n        this.jsonInit(__Periph_neo6Update_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_neo6Update'] = function(block) {\n    \nreturn [`_periph_neo6.update()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_neo6Latitude\nvar __Periph_neo6Latitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"NEO-6 latitude (°)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_neo6Latitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_neo6Latitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_neo6Latitude'] = function(block) {\n    \nreturn [`_periph_neo6.latitude()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_neo6Longitude\nvar __Periph_neo6Longitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"NEO-6 longitude (°)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_neo6Longitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_neo6Longitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_neo6Longitude'] = function(block) {\n    \nreturn [`_periph_neo6.longitude()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_neo6Altitude\nvar __Periph_neo6Altitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"NEO-6 altitude (m)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_neo6Altitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_neo6Altitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_neo6Altitude'] = function(block) {\n    \nreturn [`_periph_neo6.altitude()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}