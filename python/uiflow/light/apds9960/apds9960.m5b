{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_apds9960Init", "__Periph_apds9960ColorClear", "__Periph_apds9960ColorRed", "__Periph_apds9960ColorGreen", "__Periph_apds9960ColorBlue", "__Periph_apds9960EnableProximity", "__Periph_apds9960Proximity"], "jscode": "// Block __Periph_apds9960Init\nvar __Periph_apds9960Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init APDS9960\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_apds9960Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_apds9960Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apds9960Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.light.apds9960 import APDS9960Full as _APDS9960Full\n\n_periph_apds9960 = _APDS9960Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_apds9960ColorClear\nvar __Periph_apds9960ColorClear_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APDS9960 clear channel\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_apds9960ColorClear'] = {\n    init: function() {\n        this.jsonInit(__Periph_apds9960ColorClear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apds9960ColorClear'] = function(block) {\n    \nreturn [`_periph_apds9960.color_clear()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_apds9960ColorRed\nvar __Periph_apds9960ColorRed_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APDS9960 red channel\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_apds9960ColorRed'] = {\n    init: function() {\n        this.jsonInit(__Periph_apds9960ColorRed_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apds9960ColorRed'] = function(block) {\n    \nreturn [`_periph_apds9960.color_red()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_apds9960ColorGreen\nvar __Periph_apds9960ColorGreen_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APDS9960 green channel\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_apds9960ColorGreen'] = {\n    init: function() {\n        this.jsonInit(__Periph_apds9960ColorGreen_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apds9960ColorGreen'] = function(block) {\n    \nreturn [`_periph_apds9960.color_green()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_apds9960ColorBlue\nvar __Periph_apds9960ColorBlue_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": 