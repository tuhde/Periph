# Periph Python test configuration
# Copy this file to testconfig and fill in your values.
# testconfig is gitignored — never commit it.

# ------------------------------------------------------------------
# MicroPython (mpremote)
# ------------------------------------------------------------------
# Serial port. Use 'auto' to let mpremote detect the board.
MP_PORT=auto

# I2C bus number (machine.I2C first argument)
MP_I2C_ID=0

# GPIO pin numbers for SDA and SCL. Required — check your board's pinout.
MP_SDA=
MP_SCL=

# I2C clock frequency in Hz
MP_I2C_FREQ=400000

# ------------------------------------------------------------------
# CircuitPython (mpremote or direct serial)
# ------------------------------------------------------------------
# Serial port for the CircuitPython board's REPL
CP_PORT=auto

# Board pin names as they appear in the 'board' module (e.g. board.SDA, board.SCL)
CP_SDA=board.SDA
CP_SCL=board.SCL

# ------------------------------------------------------------------
# Linux (smbus2 / /dev/i2c-N)
# ------------------------------------------------------------------
# I2C bus number (the N in /dev/i2c-N)
LINUX_I2C_BUS=1

# ------------------------------------------------------------------
# Common
# ------------------------------------------------------------------
# I2C address of the device under test (optional — falls back to chip_defaults)
# I2C_ADDR=0x40

# ------------------------------------------------------------------
# Rig-wide sigrok analyzer (one logic analyzer on the bench)
# ------------------------------------------------------------------
# SIGROK_DRIVER=fx2lafw
# SIGROK_CONN=
# SIGROK_SAMPLERATE=24m

# ------------------------------------------------------------------
# Per-chip wiring overrides
# ------------------------------------------------------------------
# Only list chips whose wiring differs from the flat defaults above — e.g. a
# permanent bench with several chips on different buses/pins, each needing
# its own logic-analyzer channel mapping. Python's MicroPython/CircuitPython/
# Linux settings already share this one testconfig, so the block lives
# directly here rather than in a separate testconfig_wiring (see
# specs/testing_framework.md, "Chip Wiring & Sigrok Configuration").
# case "${CATEGORY:-}/${CHIP:-}" in
#     gas/ens160)
#         I2C_ADDR=0x53
#         SIGROK_CHANNELS="D0=SCL,D1=SDA"
#         ;;
#     environmental/aht21)
#         I2C_ADDR=0x38
#         SIGROK_CHANNELS="D2=SCL,D3=SDA"
#         ;;
# esac
