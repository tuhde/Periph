{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_ina260Init", "__Periph_ina260ReadVoltage", "__Periph_ina260ReadCurrent", "__Periph_ina260ReadPower"], "jscode": "// Block __Periph_ina260Init\nvar __Periph_ina260Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init INA260\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ina260Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina260Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina260Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.power.ina260 import INA260Full as _INA260Full\n\n_periph_ina260 = _INA260Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_ina260ReadVoltage\nvar __Periph_ina260ReadVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA260 bus voltage (V)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ina260ReadVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina260ReadVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina260ReadVoltage'] = function(block) {\n    \nreturn [`_periph_ina260.voltage()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina260ReadCurrent\nvar __Periph_ina260ReadCurrent_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA260 current (A)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ina260ReadCurrent'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina260ReadCurrent_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina260ReadCurrent'] = function(block) {\n    \nreturn [`_periph_ina260.current()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina260ReadPower\nvar __Periph_ina260ReadPower_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA260 power (W)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ina260ReadPower'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina260ReadPower_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina260ReadPower'] = function(block) {\n    \nreturn [`_periph_ina260.power()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}