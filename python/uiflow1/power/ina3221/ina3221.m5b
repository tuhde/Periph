{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_ina3221Init", "__Periph_ina3221ReadVoltage", "__Periph_ina3221ReadCurrent", "__Periph_ina3221ReadPower"], "jscode": "// Block __Periph_ina3221Init\nvar __Periph_ina3221Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init INA3221\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"shunt resistor (Ω), all channels\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_r_shunt\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_r_shunt\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina3221Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina3221Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina3221Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\n\nvar _r_shunt = block.getFieldValue('_r_shunt');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.power.ina3221 import INA3221Full as _INA3221Full\n\n_periph_ina3221 = _INA3221Full(_periph_i2c_conn(${_address}, bus=${_bus}), r_shunt=${_r_shunt})\n`\n};\n// Block __Periph_ina3221ReadVoltage\nvar __Periph_ina3221ReadVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA3221 bus voltage (V), channel\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina3221ReadVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina3221ReadVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina3221ReadVoltage'] = function(block) {\n    \nvar _channel = block.getFieldValue('_channel');\nreturn [`_periph_ina3221.voltage(${_channel})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina3221ReadCurrent\nvar __Periph_ina3221ReadCurrent_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA3221 current (A), channel\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina3221ReadCurrent'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina3221ReadCurrent_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina3221ReadCurrent'] = function(block) {\n    \nvar _channel = block.getFieldValue('_channel');\nreturn [`_periph_ina3221.current(${_channel})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ina3221ReadPower\nvar __Periph_ina3221ReadPower_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"INA3221 power (W), channel\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ina3221ReadPower'] = {\n    init: function() {\n        this.jsonInit(__Periph_ina3221ReadPower_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ina3221ReadPower'] = function(block) {\n    \nvar _channel = block.getFieldValue('_channel');\nreturn [`_periph_ina3221.power(${_channel})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}