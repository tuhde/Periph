ss}\n_periph_at24c64 = _AT24C64Full(_periph_i2c_conn(${_address}, bus=${_bus}, reg_bytes=2))\n`\n};\n// Block __Periph_at24c64ReadByte\nvar __Periph_at24c64ReadByte_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 read byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64ReadByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c64ReadByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c64ReadByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\nreturn [`_periph_at24c64.read_byte(${_address})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c64WriteByte\nvar __Periph_at24c64WriteByte_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 write byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64WriteByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c64WriteByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c64WriteByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_at24c64.write_byte(${_address}, ${_value})\n`\n};\n// Block __Periph_at24c64Read\nvar __Periph_at24c64Read_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 read (hex string)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"length\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_length\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_length\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64Read'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c64Read_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c64Read'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _length = block.getFieldValue('_length');\nreturn [`_periph_at24c64.read(${_address}, ${_length}).hex()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c64Write\nvar __Periph_at24c64Write_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 write (data hex)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"data\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_data\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_data\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64Write'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c64Write_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c64Write'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _data = Blockly.Python.valueToCode(block, '_data', Blockly.Python.ORDER_NONE);\nreturn `_periph_at24c64.write(${_address}, bytes.fromhex(${_data}))\n`\n};\n// Block __Periph_at24c64Fill\nvar __Periph_at24c64Fill_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 fill\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"length\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_length\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_length\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64Fill'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c64Fill_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c64Fill'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _length = block.getFieldValue('_length');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_at24c64.fill(${_address}, ${_length}, ${_value})\n`\n};\n// Block __Periph_at24c64Size\nvar __Periph_at24c64Size_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 size (bytes)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64Size'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c64Size_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c64Size'] = function(block) {\n    \nreturn [`_periph_at24c64.size()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c64PageSize\nvar __Periph_at24c64PageSize_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 page size (bytes)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64PageSize'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c64PageSize_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c64PageSize'] = function(block) {\n    \nreturn [`_periph_at24c64.page_size()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c64WaitReady\nvar __Periph_at24c64WaitReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C64 ready within (ms)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"timeout\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_timeout\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_timeout\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c64WaitReady'] = {\n    init: function() {\n        this.jsonInit(__