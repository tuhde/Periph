{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_cat24c512Init", "__Periph_cat24c512ReadByte", "__Periph_cat24c512WriteByte", "__Periph_cat24c512Read", "__Periph_cat24c512Write", "__Periph_cat24c512Fill", "__Periph_cat24c512Size", "__Periph_cat24c512PageSize", "__Periph_cat24c512WaitReady"], "jscode": "// Block __Periph_cat24c512Init\nvar __Periph_cat24c512Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init CAT24C512\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.memory.cat24c512 import CAT24C512Full as _CAT24C512Full\n\n_periph_cat24c512_bus = ${_bus}\n_periph_cat24c512_addr = ${_address}\n_periph_cat24c512 = _CAT24C512Full(_periph_i2c_conn(${_address}, bus=${_bus}, reg_bytes=2))\n`\n};\n// Block __Periph_cat24c512ReadByte\nvar __Periph_cat24c512ReadByte_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 read byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512ReadByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512ReadByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512ReadByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\nreturn [`_periph_cat24c512.read_byte(${_address})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_cat24c512WriteByte\nvar __Periph_cat24c512WriteByte_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 write byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512WriteByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512WriteByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512WriteByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_cat24c512.write_byte(${_address}, ${_value})\n`\n};\n// Block __Periph_cat24c512Read\nvar __Periph_cat24c512Read_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 read (hex string)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"length\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_length\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_length\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512Read'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512Read_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512Read'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _length = block.getFieldValue('_length');\nreturn [`_periph_cat24c512.read(${_address}, ${_length}).hex()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_cat24c512Write\nvar __Periph_cat24c512Write_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 write (data hex)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"data\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_data\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_data\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512Write'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512Write_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512Write'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _data = Blockly.Python.valueToCode(block, '_data', Blockly.Python.ORDER_NONE);\nreturn `_periph_cat24c512.write(${_address}, bytes.fromhex(${_data}))\n`\n};\n// Block __Periph_cat24c512Fill\nvar __Periph_cat24c512Fill_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 fill\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"length\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_length\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_length\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512Fill'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512Fill_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512Fill'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _length = block.getFieldValue('_length');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_cat24c512.fill(${_address}, ${_length}, ${_value})\n`\n};\n// Block __Periph_cat24c512Size\nvar __Periph_cat24c512Size_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 size (bytes)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512Size'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512Size_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512Size'] = function(block) {\n    \nreturn [`_periph_cat24c512.size()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_cat24c512PageSize\nvar __Periph_cat24c512PageSize_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 page size (bytes)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512PageSize'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512PageSize_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512PageSize'] = function(block) {\n    \nreturn [`_periph_cat24c512.page_size()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_cat24c512WaitReady\nvar __Periph_cat24c512WaitReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CAT24C512 ready within (ms)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"timeout\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_timeout\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_timeout\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_cat24c512WaitReady'] = {\n    init: function() {\n        this.jsonInit(__Periph_cat24c512WaitReady_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_cat24c512WaitReady'] = function(block) {\n    \n\nvar _timeout = block.getFieldValue('_timeout');\nreturn [`_periph_cat24c512.wait_ready(${_timeout})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}