{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mb85rcInit", "__Periph_mb85rcReadByte", "__Periph_mb85rcWriteByte", "__Periph_mb85rcRead", "__Periph_mb85rcWrite", "__Periph_mb85rcFill", "__Periph_mb85rcSize", "__Periph_mb85rcReadDeviceId"], "jscode": "// Block __Periph_mb85rcInit\nvar __Periph_mb85rcInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MB85RC\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.memory.mb85rc import MB85RCFull as _MB85RCFull\n\n_periph_mb85rc_bus = ${_bus}\n_periph_mb85rc_addr = ${_address}\n_periph_mb85rc = _MB85RCFull(_periph_i2c_conn(${_address}, bus=${_bus}, reg_bytes=2))\n`\n};\n// Block __Periph_mb85rcReadByte\nvar __Periph_mb85rcReadByte_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MB85RC read byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcReadByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcReadByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcReadByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\nreturn [`_periph_mb85rc.read_byte(${_address})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mb85rcWriteByte\nvar __Periph_mb85rcWriteByte_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MB85RC write byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcWriteByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcWriteByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcWriteByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_mb85rc.write_byte(${_address}, ${_value})\n`\n};\n// Block __Periph_mb85rcRead\nvar __Periph_mb85rcRead_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MB85RC read (hex string)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"length\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_length\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_length\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcRead'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcRead_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcRead'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _length = block.getFieldValue('_length');\nreturn [`_periph_mb85rc.read(${_address}, ${_length}).hex()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mb85rcWrite\nvar __Periph_mb85rcWrite_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MB85RC write (data hex)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"data\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_data\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_data\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcWrite'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcWrite_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcWrite'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _data = Blockly.Python.valueToCode(block, '_data', Blockly.Python.ORDER_NONE);\nreturn `_periph_mb85rc.write(${_address}, bytes.fromhex(${_data}))\n`\n};\n// Block __Periph_mb85rcFill\nvar __Periph_mb85rcFill_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MB85RC fill\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"length\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_length\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_length\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcFill'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcFill_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcFill'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _length = block.getFieldValue('_length');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_mb85rc.fill(${_address}, ${_length}, ${_value})\n`\n};\n// Block __Periph_mb85rcSize\nvar __Periph_mb85rcSize_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MB85RC size (bytes)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcSize'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcSize_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcSize'] = function(block) {\n    \nreturn [`_periph_mb85rc.size()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mb85rcReadDeviceId\nvar __Periph_mb85rcReadDeviceId_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MB85RC device ID (hex, empty if unavailable)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mb85rcReadDeviceId'] = {\n    init: function() {\n        this.jsonInit(__Periph_mb85rcReadDeviceId_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mb85rcReadDeviceId'] = function(block) {\n    \nreturn [`'%03X%X%02X' % _periph_mb85rc.read_device_id(_periph_i2c_conn(0x7C, bus=_periph_mb85rc_bus, reg_bytes=1), _periph_mb85rc_addr)`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}