c02n_addr = ${_address}\n_periph_at24c02n = _AT24C02NFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_at24c02nReadByte\nvar __Periph_at24c02nReadByte_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C02N read byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c02nReadByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c02nReadByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c02nReadByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\nreturn [`_periph_at24c02n.read_byte(${_address})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c02nWriteByte\nvar __Periph_at24c02nWriteByte_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C02N write byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c02nWriteByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c02nWriteByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c02nWriteByte'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_at24c02n.write_byte(${_address}, ${_value})\n`\n};\n// Block __Periph_at24c02nRead\nvar __Periph_at24c02nRead_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C02N read (hex string)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"length\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_length\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_length\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c02nRead'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c02nRead_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c02nRead'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _length = block.getFieldValue('_length');\nreturn [`_periph_at24c02n.read(${_address}, ${_length}).hex()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c02nWrite\nvar __Periph_at24c02nWrite_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C02N write (data hex)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"data\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_data\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_data\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c02nWrite'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c02nWrite_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c02nWrite'] = function(block) {\n    \n\nvar _address = block.getFieldValue('_address');\n\nvar _data = Blockly.Python.valueToCode(block, '_data', Blockly.Python.ORDER_NONE);\nreturn `_periph_at24c02n.write(${_address}, bytes.fromhex(${_data}))\n`\n};\n// Block __Periph_at24c