th}, ${_value})\n`\n};\n// Block __Periph_at24c02nSize\nvar __Periph_at24c02nSize_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C02N size (bytes)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c02nSize'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c02nSize_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c02nSize'] = function(block) {\n    \nreturn [`_periph_at24c02n.size()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c02nPageSize\nvar __Periph_at24c02nPageSize_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C02N page size (bytes)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c02nPageSize'] = {\n    init: function() {\n        this.jsonInit(__Periph_at24c02nPageSize_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_at24c02nPageSize'] = function(block) {\n    \nreturn [`_periph_at24c02n.page_size()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_at24c02nWaitReady\nvar __Periph_at24c02nWaitReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AT24C02N ready within (ms)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"timeout\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_timeout\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_timeout\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_at24c02nWai