{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_sdSpiInit", "__Periph_sdSpiBlockCount", "__Periph_sdSpiCardType", "__Periph_sdSpiReadByte", "__Periph_sdSpiWriteByte", "__Periph_sdSpiFillBlock", "__Periph_sdSpiMount"], "jscode": "// Block __Periph_sdSpiInit\nvar __Periph_sdSpiInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init SD card\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPI bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CS pin\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs_pin\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sdSpiInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_sdSpiInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sdSpiInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _cs_pin = block.getFieldValue('_cs_pin');\nreturn `from periph.connection.spi_auto import SPIConnection as _periph_spi_conn\nfrom periph.chips.memory.sd_spi import SDSPIFull as _SDSPIFull\nfrom periph.storage.block_device import BlockDeviceVFS as _BlockDeviceVFS\n\n_periph_sd_spi = _SDSPIFull(_periph_spi_conn(bus=${_bus}, cs_pin=${_cs_pin}), crc=False)\n`\n};\n// Block __Periph_sdSpiBlockCount\nvar __Periph_sdSpiBlockCount_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SD card capacity (512-byte blocks)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sdSpiBlockCount'] = {\n    init: function() {\n        this.jsonInit(__Periph_sdSpiBlockCount_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sdSpiBlockCount'] = function(block) {\n    \nreturn [`_periph_sd_spi.block_count()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sdSpiCardType\nvar __Periph_sdSpiCardType_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SD card type (1 SDv1, 2 SDv2, 3 SDHC)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sdSpiCardType'] = {\n    init: function() {\n        this.jsonInit(__Periph_sdSpiCardType_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sdSpiCardType'] = function(block) {\n    \nreturn [`_periph_sd_spi.card_type()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sdSpiReadByte\nvar __Periph_sdSpiReadByte_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SD read byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"block\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_block\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_block\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"offset\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_offset\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_offset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sdSpiReadByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_sdSpiReadByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sdSpiReadByte'] = function(block) {\n    \n\nvar _block = block.getFieldValue('_block');\n\nvar _offset = block.getFieldValue('_offset');\nreturn [`_periph_sd_spi.read_block(${_block})[${_offset}]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sdSpiWriteByte\nvar __Periph_sdSpiWriteByte_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SD write byte\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"block\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_block\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_block\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"offset\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_offset\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_offset\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sdSpiWriteByte'] = {\n    init: function() {\n        this.jsonInit(__Periph_sdSpiWriteByte_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sdSpiWriteByte'] = function(block) {\n    \n\nvar _block = block.getFieldValue('_block');\n\nvar _offset = block.getFieldValue('_offset');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_sd_spi_buf = bytearray(_periph_sd_spi.read_block(${_block}))\n_periph_sd_spi_buf[${_offset}] = ${_value}\n_periph_sd_spi.write_block(${_block}, _periph_sd_spi_buf)\n`\n};\n// Block __Periph_sdSpiFillBlock\nvar __Periph_sdSpiFillBlock_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SD fill block\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"block\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_block\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_block\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sdSpiFillBlock'] = {\n    init: function() {\n        this.jsonInit(__Periph_sdSpiFillBlock_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sdSpiFillBlock'] = function(block) {\n    \n\nvar _block = block.getFieldValue('_block');\n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_sd_spi.write_block(${_block}, bytes([${_value}]) * 512)\n`\n};\n// Block __Periph_sdSpiMount\nvar __Periph_sdSpiMount_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Mount SD card as FAT at\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_path\"\n        },\n        {\n            \"type\": \"field_input\",\n            \"text\": \"\",\n            \"spellcheck\": false,\n            \"name\": \"_path\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sdSpiMount'] = {\n    init: function() {\n        this.jsonInit(__Periph_sdSpiMount_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sdSpiMount'] = function(block) {\n    \nvar _path = block.getFieldValue('_path');\nreturn `import os as _os\n_os.mount(_os.VfsFat(_BlockDeviceVFS(_periph_sd_spi)), str(${_path}))\n`\n};\n"}