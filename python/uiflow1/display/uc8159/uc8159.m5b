{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_uc8159Init", "__Periph_uc8159Clear", "__Periph_uc8159SetPixel", "__Periph_uc8159DrawLine", "__Periph_uc8159DrawRect", "__Periph_uc8159Show", "__Periph_uc8159Sleep"], "jscode": "// Block __Periph_uc8159Init\nvar __Periph_uc8159Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init UC8159 e-paper, SCK\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sck\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sck\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MOSI\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mosi\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mosi\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CS\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"D/C\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_dc\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_dc\"\n        }\n    ],\n    \"message8\": \"%1\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RES\"\n        }\n    ],\n    \"message9\": \"%1 %2\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_res\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_res\"\n        }\n    ],\n    \"message10\": \"%1\",\n    \"args10\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BUSY\"\n        }\n    ],\n    \"message11\": \"%1 %2\",\n    \"args11\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_busy\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_busy\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc8159Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc8159Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc8159Init'] = function(block) {\n    \nvar _sck = block.getFieldValue('_sck');\n\nvar _mosi = block.getFieldValue('_mosi');\n\nvar _cs = block.getFieldValue('_cs');\n\nvar _dc = block.getFieldValue('_dc');\n\nvar _res = block.getFieldValue('_res');\n\nvar _busy = block.getFieldValue('_busy');\nreturn `from machine import SPI as _SPI, Pin as _Pin\nfrom periph.connection.display_micropython import DisplayConnection as _periph_display_conn\nfrom periph.connection.output_pin import MicroPythonOutputPin as _periph_out_pin\nfrom periph.connection.input_pin import MicroPythonPin as _periph_in_pin\nfrom periph.chips.display.uc8159 import UC8159Full as _UC8159Full\n\n_periph_uc8159 = _UC8159Full(\n    _periph_display_conn(_SPI(2, baudrate=4000000, polarity=0, phase=0,\n                              sck=_Pin(${_sck}), mosi=_Pin(${_mosi})),\n                         _periph_out_pin(${_cs}), _periph_out_pin(${_dc}),\n                         _periph_out_pin(${_res}), _periph_in_pin(_Pin(${_busy}, _Pin.IN))))\n`\n};\n// Block __Periph_uc8159Clear\nvar __Periph_uc8159Clear_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC8159 clear framebuffer (0 black, 1 white, 2 green, 3 blue, 4 red, 5 yellow, 6 orange)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc8159Clear'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc8159Clear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc8159Clear'] = function(block) {\n    \nvar _color = block.getFieldValue('_color');\nreturn `_periph_uc8159.clear(int(${_color}))\n`\n};\n// Block __Periph_uc8159SetPixel\nvar __Periph_uc8159SetPixel_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC8159 set pixel x\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"color (0 black, 1 white, 2 green, 3 blue, 4 red, 5 yellow, 6 orange)\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc8159SetPixel'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc8159SetPixel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc8159SetPixel'] = function(block) {\n    \nvar _x = block.getFieldValue('_x');\n\nvar _y = block.getFieldValue('_y');\n\nvar _color = block.getFieldValue('_color');\nreturn `_periph_uc8159.set_pixel(int(${_x}), int(${_y}), int(${_color}))\n`\n};\n// Block __Periph_uc8159DrawLine\nvar __Periph_uc8159DrawLine_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC8159 draw line x0\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x0\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x0\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y0\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y0\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n          