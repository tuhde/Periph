ction() {\n        this.jsonInit(__Periph_st7036Clear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_st7036Clear'] = function(block) {\n    \nreturn `_periph_st7036.clear()\n`\n};\n// Block __Periph_st7036Home\nvar __Periph_st7036Home_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ST7036 return home\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_st7036Home'] = {\n    init: function() {\n        this.jsonInit(__Periph_st7036Home_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_st7036Home'] = function(block) {\n    \nreturn `_periph_st7036.home()\n`\n};\n// Block __Periph_st7036SetCursor\nvar __Periph_st7036SetCursor_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ST7036 set cursor col\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_col\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_col\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"row\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_row\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_row\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_st7036SetCursor'] = {\n    init: function() {\n        this.jsonInit(__Periph_st7036SetCursor_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_st7036SetCursor'] = function(block) {\n    \nvar _col = block.getFieldValue('_col');\n\nvar _row = block.getFieldValue('_row');\nreturn `_periph_st7036.set_cursor(int(${_col}), int(${_row}))\n`\n};\n// Block __Periph_st7036Write\nvar __Periph_st7036Write_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ST7036 write text\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_text\"\n        },\n        {\n            \"type\": \"field_input\",\n            \"text\": \"\",\n            \"spellcheck\": false,\n            \"name\": \"_text\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_st7036Write'] = {\n    init: function() {\n        this.jsonInit(__Periph_st7036Write_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_st7036Write'] = function(block) {\n    \nvar _text = block.getFieldValue('_text');\nreturn `_periph_st7036.write(str(${_text}))\n`\n};\n// Block __Periph_st7036PrintAt\nvar __Periph_st7036PrintAt_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ST7036 print col\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_col\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_col\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"row\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_row\"\n        },\n        {\n          