 ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_st7036Display'] = {\n    init: function() {\n        this.jsonInit(__Periph_st7036Display_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_st7036Display'] = function(block) {\n    \nvar _on = block.getFieldValue('_on');\nreturn `_periph_st7036.display(bool(int(${_on})))\n`\n};\n"}