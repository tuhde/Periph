{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_ssd1331Init", "__Periph_ssd1331Clear", "__Periph_ssd1331SetPixel", "__Periph_ssd1331DrawLine", "__Periph_ssd1331DrawRect", "__Periph_ssd1331Show", "__Periph_ssd1331Display"], "jscode": "// Block __Periph_ssd1331Init\nvar __Periph_ssd1331Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init SSD1331 OLED, SCK\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sck\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sck\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MOSI\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mosi\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mosi\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CS\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"D/C\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_dc\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_dc\"\n        }\n    ],\n    \"message8\": \"%1\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RES\"\n        }\n    ],\n    \"message9\": \"%1 %2\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_res\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_res\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ssd1331Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ssd1331Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ssd1331Init'] = function(block) {\n    \nvar _sck = block.getFieldValue('_sck');\n\nvar _mosi = block.getFieldValue('_mosi');\n\nvar _cs = block.getFieldValue('_cs');\n\nvar _dc = block.getFieldValue('_dc');\n\nvar _res = block.getFieldValue('_res');\nreturn `from machine import SPI as _SPI, Pin as _Pin\nfrom periph.connection.display_micropython import DisplayConnection as _periph_display_conn\nfrom periph.connection.output_pin import MicroPythonOutputPin as _periph_out_pin\nfrom periph.chips.display.ssd1331 import SSD1331Full as _SSD1331Full\n\n_periph_ssd1331 = _SSD1331Full(\n    _periph_display_conn(_SPI(2, baudrate=4000000, polarity=0, phase=0,\n                              sck=_Pin(${_sck}), mosi=_Pin(${_mosi})),\n                         _periph_out_pin(${_cs}), _periph_out_pin(${_dc}),\n                         _periph_out_pin(${_res}), None))\n`\n};\n// Block __Periph_ssd1331Clear\nvar __Periph_ssd1331Clear_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SSD1331 clear framebuffer color (0xRRGGBB)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ssd1331Clear'] = {\n    init: function() {\n        this.jsonInit(__Periph_ssd1331Clear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ssd1331Clear'] = function(block) {\n    \nvar _color = block.getFieldValue('_color');\nreturn `_periph_ssd1331.clear(_SSD1331Full.rgb(int(${_color}) >> 16, int(${_color}) >> 8, int(${_color}) & 0xFF))\n`\n};\n// Block __Periph_ssd1331SetPixel\nvar __Periph_ssd1331SetPixel_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SSD1331 set pixel x\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"color (0xRRGGBB)\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ssd1331SetPixel'] = {\n    init: function() {\n        this.jsonInit(__Periph_ssd1331SetPixel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ssd1331SetPixel'] = function(block) {\n    \nvar _x = block.getFieldValue('_x');\n\nvar _y = block.getFieldValue('_y');\n\nvar _color = block.getFieldValue('_color');\nreturn `_periph_ssd1331.set_pixel(int(${_x}), int(${_y}), _SSD1331Full.rgb(int(${_color}) >> 16, int(${_color}) >> 8, int(${_color}) & 0xFF))\n`\n};\n// Block __Periph_ssd1331DrawLine\nvar __Periph_ssd1331DrawLine_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SSD1331 draw line x0\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x0\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x0\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y0\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y0\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y0\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"x1\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x1\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x1\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y1\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y1\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y1\"\n        }\n    ],\n    \"message8\": \"%1\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"color (0xRRGGBB)\"\n        }\n    ],\n    \"message9\": \"%1 %2\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ssd1331DrawLine'] = {\n    init: function() {\n        this.jsonInit(__Periph_ssd1331DrawLine_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ssd1331DrawLine'] = function(block) {\n    \nvar _x0 = block.getFieldValue('_x0');\n\nvar _y0 = block.getFieldValue('_y0');\n\nvar _x1 = block.getFieldValue('_x1');\n\nvar _y1 = block.getFieldValue('_y1');\n\nvar _color = block.getFieldValue('_color');\nreturn `_periph_ssd1331.draw_line(int(${_x0}), int(${_y0}), int(${_x1}), int(${_y1}), _SSD1331Full.rgb(int(${_color}) >> 16, int(${_color}) >> 8, int(${_color}) & 0xFF))\n`\n};\n// Block __Periph_ssd1331DrawRect\nvar __Periph_ssd1331DrawRect_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SSD1331 draw rectangle x\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"width\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_w\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_w\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"height\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_h\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_h\"\n        }\n    ],\n    \"message8\": \"%1\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"color (0xRRGGBB)\"\n        }\n    ],\n    \"message9\": \"%1 %2\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"message10\": \"%1\",\n    \"args10\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"fill (0/1)\"\n        }\n    ],\n    \"message11\": \"%1 %2\",\n    \"args11\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_fill\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_fill\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ssd1331DrawRect'] = {\n    init: function() {\n        this.jsonInit(__Periph_ssd1331DrawRect_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ssd1331DrawRect'] = function(block) {\n    \nvar _x = block.getFieldValue('_x');\n\nvar _y = block.getFieldValue('_y');\n\nvar _w = block.getFieldValue('_w');\n\nvar _h = block.getFieldValue('_h');\n\nvar _color = block.getFieldValue('_color');\n\nvar _fill = block.getFieldValue('_fill');\nreturn `_periph_ssd1331.draw_rect(int(${_x}), int(${_y}), int(${_w}), int(${_h}), _SSD1331Full.rgb(int(${_color}) >> 16, int(${_color}) >> 8, int(${_color}) & 0xFF), bool(${_fill}))\n`\n};\n// Block __Periph_ssd1331Show\nvar __Periph_ssd1331Show_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SSD1331 show framebuffer\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ssd1331Show'] = {\n    init: function() {\n        this.jsonInit(__Periph_ssd1331Show_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ssd1331Show'] = function(block) {\n    \nreturn `_periph_ssd1331.show()\n`\n};\n// Block __Periph_ssd1331Display\nvar __Periph_ssd1331Display_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SSD1331 display on (1) / off (0)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ssd1331Display'] = {\n    init: function() {\n        this.jsonInit(__Periph_ssd1331Display_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ssd1331Display'] = function(block) {\n    \nvar _on = block.getFieldValue('_on');\nreturn `_periph_ssd1331.display_on() if int(${_on}) else _periph_ssd1331.display_off()\n`\n};\n"}