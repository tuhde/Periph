n(${_cs}), _periph_out_pin(${_dc}),\n                         _periph_out_pin(${_res}), _periph_in_pin(_Pin(${_busy}, _Pin.IN))))\n`\n};\n// Block __Periph_il0373Clear\nvar __Periph_il0373Clear_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"IL0373 clear framebuffer (0 black, 1 white)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_il0373Clear'] = {\n    init: function() {\n        this.jsonInit(__Periph_il0373Clear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_il0373Clear'] = function(block) {\n    \nvar _color = block.getFieldValue('_color');\nreturn `_periph_il0373.clear(int(${_color}))\n`\n};\n// Block __Periph_il0373SetPixel\nvar __Periph_il0373SetPixel_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"IL0373 set pixel x\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"color (0 black, 1 white)\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_il0373SetPixel'] = {\n    init: function() {\n        this.jsonInit(__Periph_il0373SetPixel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_il0373SetPixel'] = function(block) {\n    \nvar _x = block.getFieldValue('_x');\n\nvar _y = block.getFieldValue('_y');\n\nvar _color = block.getFieldValue('_color');\nreturn `_periph_il0373.set_pixel(int(${_x}), int(${_y}), int(${_color}))\n`\n};\n// Block __Periph_il0373DrawLine\nvar __Periph_il0373DrawLine_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"IL0373 draw line x0\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x0\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x0\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y0\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y0\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y0\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"x1\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x1\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x1\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y1\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y1\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y1\"\n        }\n    ],\n    \"message8\": \"%1\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"color (0 black, 1 white)\"\n        }\n    ],\n    \"message9\": \"%1 %2\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_il0373DrawLine'] = {\n    init: function() {\n        this.jsonInit(__Periph_il0373DrawLine_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_il0373DrawLine'] = function(block) {\n    \nvar _x0 = block.getFieldValue('_x0');\n\nvar _y0 = block.getFieldValue('_y0');\n\nvar _x1 = block.getFieldValue('_x1');\n\nvar _y1 = block.getFieldValue('_y1');\n\nvar _color = block.getFieldValue('_color');\nreturn `_periph_il0373.draw_line(int(${_x0}), int(${_y0}), int(${_x1}), int(${_y1}), int(${_color}))\n`\n};\n// Block __Periph_il0373DrawRect\nvar __Periph_il0373DrawRect_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n  