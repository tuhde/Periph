 \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"message10\": \"%1\",\n    \"args10\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"fill (0/1)\"\n        }\n    ],\n    \"message11\": \"%1 %2\",\n    \"args11\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_fill\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_fill\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_il0373DrawRect'] = {\n    init: function() {\n        this.jsonInit(__Periph_il0373DrawRect_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_il0373DrawRect'] = function(block) {\n    \nvar _x = block.getFieldValue('_x');\n\nvar _y = block.getFieldValue('_y');\n\nvar _w = block.getFieldValue('_w');\n\nvar _h = block.getFieldValue('_h');\n\nvar _color = block.getFieldValue('_color');\n\nvar _fill = block.getFieldValue('_fill');\nreturn `_periph_il0373.draw_rect(int(${_x}), int(${_y}), int(${_w}), int(${_h}), int(${_color}), bool(${_fill}))\n`\n};\n// Block __Periph_il0373Show\nvar __Periph_il0373Show_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"IL0373 refresh panel (blocks until BUSY is high)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_il0373Show'] = {\n    init: function() {\n        this.jsonInit(__Periph_il0373Show_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_il0373Show'] = function(block) {\n    \nreturn `_periph_il0373.show()\n`\n};\n// Block __Periph_il0373Sleep\nvar __Periph_il0373Sleep_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"IL0373 deep sleep