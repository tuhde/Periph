l,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC8276C draw rectangle x\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_y\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"width\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_w\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_w\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"height\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_h\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_h\"\n        }\n    ],\n    \"message8\": \"%1\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"color (0 black, 1 white, 2 red)\"\n        }\n    ],\n    \"message9\": \"%1 %2\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_color\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_color\"\n        }\n    ],\n    \"message10\": \"%1\",\n    \"args10\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"fill (0/1)\"\n        }\n    ],\n    \"message11\": \"%1 %2\",\n    \"args11\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_fill\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_fill\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc8276cDrawRect'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc8276cDrawRect_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc8276cDrawRect'] = function(block) {\n    \nvar _x = block.getFieldValue('_x');\n\nvar _y = block.getFieldValue('_y');\n\nvar _w = block.getFieldValue('_w');\n\nvar _h = block.getFieldValue('_h');\n\nvar _color = block.getFieldValue('_color');\n\nvar _fill = block.getFieldValue('_fill');\nreturn `_periph_uc8276c.draw_rect(int(${_x}), int(${_y}), int(${_w}), int(${_h}), int(${_color}), bool(${_fill}))\n`\n};\n// Block __Periph_uc8276cShow\nvar __Periph_uc8276cShow_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC8276C refresh panel (blocks about 17 s)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc8276cShow'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc8276cShow_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc8276cShow'] = function(block) {\n    \nreturn `_periph_uc8276c.show()\n`\n};\n// Block __Periph_uc8276cSleep\nvar __Periph_uc8276cSleep_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n      