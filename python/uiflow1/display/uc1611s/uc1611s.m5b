eriph.chips.display.uc1611s import UC1611sFull as _UC1611sFull\n\n_periph_uc1611s = _UC1611sFull(_periph_i2c_conn(int(${_address}), bus=int(${_bus})),\n                               _periph_i2c_conn(int(${_address}) + 1, bus=int(${_bus})))\n`\n};\n// Block __Periph_uc1611sInitSpi\nvar __Periph_uc1611sInitSpi_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init UC1611s LCD (4-wire SPI), SCK\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sck\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sck\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MOSI\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mosi\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mosi\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CS\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CD\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cd\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cd\"\n        }\n    ],\n    \"message8\": \"%1\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RST\"\n        }\n    ],\n    \"message9\": \"%1 %2\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_rst\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_rst\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc1611sInitSpi'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc1611sInitSpi_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc1611sInitSpi'] = function(block) {\n    \nvar _sck = block.getFieldValue('_sck');\n\nvar _mosi = block.getFieldValue('_mosi');\n\nvar _cs = block.getFieldValue('_cs');\n\nvar _cd = block.getFieldValue('_cd');\n\nvar _rst = block.getFieldValue('_rst');\nreturn `from machine import SPI as _SPI, Pin as _Pin\nfrom periph.connection.display_micropython import DisplayConnection as _periph_display_conn\nfrom periph.connection.output_pin import MicroPythonOutputPin as _periph_out_pin\nfrom periph.chips.display.uc1611s import UC1611sSpiFull as _UC1611sSpiFull\n\n_periph_uc1611s = _UC1611sSpiFull(\n    _periph_display_conn(_SPI(2, baudrate=4000000, polarity=0, phase=0,\n                              sck=_Pin(${_sck}), mosi=_Pin(${_mosi})),\n                         _periph_out_pin(${_cs}), _periph_out_pin(${_cd}),\n                         _periph_out_pin(${_rst}), None))\n`\n};\n// Block __Periph_uc1611sClear\nvar __Periph_uc1611sClear_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC1611s clear framebuffer\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc1611sClear'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc1611sClear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc1611sClear'] = function(block) {\n    \nreturn `_periph_uc1611s.clear()\n`\n};\n// Block __Periph_uc1611sFill\nvar __Periph_uc1611sFill_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC1611s fill all pixels on (1) / off (0)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_uc1611sFill'] = {\n    init: function() {\n        this.jsonInit(__Periph_uc1611sFill_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_uc1611sFill'] = function(block) {\n    \nvar _on = block.getFieldValue('_on');\nreturn `_periph_uc1611s.fill(bool(int(${_on})))\n`\n};\n// Block __Periph_uc1611sSetPixel\nvar __Periph_uc1611sSetPixel_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"UC1611s set pixel x\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_x\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_x\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"y\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_y\"\n        },\n        {\n  