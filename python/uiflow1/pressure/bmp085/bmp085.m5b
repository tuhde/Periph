{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_bmp085Init", "__Periph_bmp085ReadTemperature", "__Periph_bmp085ReadPressure", "__Periph_bmp085ReadAltitude"], "jscode": "// Block __Periph_bmp085Init\nvar __Periph_bmp085Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BMP085\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp085Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp085Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp085Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.bmp085 import BMP085Full as _BMP085Full\n\n_periph_bmp085 = _BMP085Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_bmp085ReadTemperature\nvar __Periph_bmp085ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP085 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp085ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp085ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp085ReadTemperature'] = function(block) {\n    \nreturn [`_periph_bmp085.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bmp085ReadPressure\nvar __Periph_bmp085ReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP085 pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp085ReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp085ReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp085ReadPressure'] = function(block) {\n    \nreturn [`_periph_bmp085.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bmp085ReadAltitude\nvar __Periph_bmp085ReadAltitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP085 altitude (m), sea-level pressure (Pa)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sea_level_pa\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sea_level_pa\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp085ReadAltitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp085ReadAltitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp085ReadAltitude'] = function(block) {\n    \nvar _sea_level_pa = block.getFieldValue('_sea_level_pa');\nreturn [`_periph_bmp085.altitude(sea_level_pa=${_sea_level_pa})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}