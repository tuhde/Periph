{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_bmp581Init", "__Periph_bmp581ReadPressure", "__Periph_bmp581ReadTemperature", "__Periph_bmp581ReadAltitude"], "jscode": "// Block __Periph_bmp581Init\nvar __Periph_bmp581Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BMP581\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp581Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp581Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp581Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.bmp581 import BMP581Full as _BMP581Full\n\n_periph_bmp581 = _BMP581Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_bmp581ReadPressure\nvar __Periph_bmp581ReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP581 pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp581ReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp581ReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp581ReadPressure'] = function(block) {\n    \nreturn [`_periph_bmp581.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bmp581ReadTemperature\nvar __Periph_bmp581ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP581 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp581ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp581ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp581ReadTemperature'] = function(block) {\n    \nreturn [`_periph_bmp581.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bmp581ReadAltitude\nvar __Periph_bmp581ReadAltitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP581 altitude (m), sea-level pressure (Pa)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sea_level_pa\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sea_level_pa\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp581ReadAltitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp581ReadAltitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp581ReadAltitude'] = function(block) {\n    \nvar _sea_level_pa = block.getFieldValue('_sea_level_pa');\nreturn [`_periph_bmp581.altitude(sea_level_pa=${_sea_level_pa})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}