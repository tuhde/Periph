ms5607.init()\n`\n};\n// Block __Periph_ms5607Temperature\nvar __Periph_ms5607Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MS5607 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ms5607Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_ms5607Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ms5607Temperature'] = function(block) {\n    \nreturn [`_periph_ms5607.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ms5607Pressure\nvar __Periph_ms5607Pressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MS5607 pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ms5607Pressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_ms5607Pressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ms5607Pressure'] = function(block) {\n    \nreturn [`_periph_ms5607.read_pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ms5607Altitude\nvar __Periph_ms5607Altitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MS5607 altitude vs 101325 Pa (m)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ms5607Altitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_ms5607Altitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ms5607Altitude'] = function(block) {\n    \nreturn [`_periph_ms5607.altitude()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ms5607SetOversampling\nvar __Periph_ms5607SetOversampling_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n   