{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_bmp280Init", "__Periph_bmp280ReadTemperature", "__Periph_bmp280ReadPressure", "__Periph_bmp280ReadAltitude"], "jscode": "// Block __Periph_bmp280Init\nvar __Periph_bmp280Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BMP280\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp280Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp280Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp280Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.bmp280 import BMP280Full as _BMP280Full\n\n_periph_bmp280 = _BMP280Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_bmp280ReadTemperature\nvar __Periph_bmp280ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP280 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp280ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp280ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp280ReadTemperature'] = function(block) {\n    \nreturn [`_periph_bmp280.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bmp280ReadPressure\nvar __Periph_bmp280ReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP280 pressure (hPa)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp280ReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp280ReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp280ReadPressure'] = function(block) {\n    \nreturn [`_periph_bmp280.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bmp280ReadAltitude\nvar __Periph_bmp280ReadAltitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMP280 altitude (m), sea-level pressure (hPa)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sea_level_hpa\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sea_level_hpa\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bmp280ReadAltitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_bmp280ReadAltitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bmp280ReadAltitude'] = function(block) {\n    \nvar _sea_level_hpa = block.getFieldValue('_sea_level_hpa');\nreturn [`_periph_bmp280.altitude(sea_level_hpa=${_sea_level_hpa})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}