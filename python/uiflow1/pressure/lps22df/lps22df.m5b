{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_lps22dfInit", "__Periph_lps22dfReadTemperature", "__Periph_lps22dfReadPressure", "__Periph_lps22dfReadAltitude"], "jscode": "// Block __Periph_lps22dfInit\nvar __Periph_lps22dfInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init LPS22DF\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22dfInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22dfInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22dfInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.lps22df import LPS22DFFull as _LPS22DFFull\n\n_periph_lps22df = _LPS22DFFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_lps22dfReadTemperature\nvar __Periph_lps22dfReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS22DF temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22dfReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22dfReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22dfReadTemperature'] = function(block) {\n    \nreturn [`_periph_lps22df.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps22dfReadPressure\nvar __Periph_lps22dfReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS22DF pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22dfReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22dfReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22dfReadPressure'] = function(block) {\n    \nreturn [`_periph_lps22df.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps22dfReadAltitude\nvar __Periph_lps22dfReadAltitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS22DF altitude (m), sea-level pressure (Pa)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sea_level_pa\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sea_level_pa\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22dfReadAltitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22dfReadAltitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22dfReadAltitude'] = function(block) {\n    \nvar _sea_level_pa = block.getFieldValue('_sea_level_pa');\nreturn [`_periph_lps22df.altitude(sea_level_pa=${_sea_level_pa})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}