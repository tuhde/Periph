{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_spl06Init", "__Periph_spl06ReadPressure", "__Periph_spl06ReadTemperature", "__Periph_spl06Altitude", "__Periph_spl06SetPressureConfig", "__Periph_spl06SetTemperatureConfig", "__Periph_spl06StartContinuous", "__Periph_spl06Stop", "__Periph_spl06Reset"], "jscode": "// Block __Periph_spl06Init\nvar __Periph_spl06Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init SPL06\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.spl06 import SPL06Full as _SPL06Full\n\n_periph_spl06 = _SPL06Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_spl06.init()\n`\n};\n// Block __Periph_spl06ReadPressure\nvar __Periph_spl06ReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06ReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06ReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06ReadPressure'] = function(block) {\n    \nreturn [`_periph_spl06.read_pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_spl06ReadTemperature\nvar __Periph_spl06ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06ReadTemperature'] = function(block) {\n    \nreturn [`_periph_spl06.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_spl06Altitude\nvar __Periph_spl06Altitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 altitude (m), sea level (Pa)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sea_level\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sea_level\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06Altitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06Altitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06Altitude'] = function(block) {\n    \nvar _sea_level = block.getFieldValue('_sea_level');\nreturn [`_periph_spl06.altitude(float(${_sea_level}))`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_spl06SetPressureConfig\nvar __Periph_spl06SetPressureConfig_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 pressure oversampling (1-128)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_oversampling\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_oversampling\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"rate (Hz)\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_rate\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_rate\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06SetPressureConfig'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06SetPressureConfig_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06SetPressureConfig'] = function(block) {\n    \nvar _oversampling = block.getFieldValue('_oversampling');\n\nvar _rate = block.getFieldValue('_rate');\nreturn `_periph_spl06.set_pressure_config(int(${_oversampling}), int(${_rate}))\n`\n};\n// Block __Periph_spl06SetTemperatureConfig\nvar __Periph_spl06SetTemperatureConfig_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 temperature oversampling (1-128)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_oversampling\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_oversampling\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"rate (Hz)\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_rate\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_rate\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06SetTemperatureConfig'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06SetTemperatureConfig_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06SetTemperatureConfig'] = function(block) {\n    \nvar _oversampling = block.getFieldValue('_oversampling');\n\nvar _rate = block.getFieldValue('_rate');\nreturn `_periph_spl06.set_temperature_config(int(${_oversampling}), int(${_rate}))\n`\n};\n// Block __Periph_spl06StartContinuous\nvar __Periph_spl06StartContinuous_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 start continuous (pressure and temperature)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06StartContinuous'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06StartContinuous_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06StartContinuous'] = function(block) {\n    \nreturn `_periph_spl06.start_continuous()\n`\n};\n// Block __Periph_spl06Stop\nvar __Periph_spl06Stop_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 stop continuous\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06Stop'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06Stop_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06Stop'] = function(block) {\n    \nreturn `_periph_spl06.stop()\n`\n};\n// Block __Periph_spl06Reset\nvar __Periph_spl06Reset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPL06 reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_spl06Reset'] = {\n    init: function() {\n        this.jsonInit(__Periph_spl06Reset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_spl06Reset'] = function(block) {\n    \nreturn `_periph_spl06.reset()\n`\n};\n"}