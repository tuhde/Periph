{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_lps22hbInit", "__Periph_lps22hbReadPressure", "__Periph_lps22hbReadTemperature", "__Periph_lps22hbOneShot"], "jscode": "// Block __Periph_lps22hbInit\nvar __Periph_lps22hbInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init LPS22HB\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22hbInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22hbInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22hbInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.lps22hb import LPS22HBFull as _LPS22HBFull\n\n_periph_lps22hb = _LPS22HBFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_lps22hbReadPressure\nvar __Periph_lps22hbReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS22HB pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22hbReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22hbReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22hbReadPressure'] = function(block) {\n    \nreturn [`_periph_lps22hb.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps22hbReadTemperature\nvar __Periph_lps22hbReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS22HB temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22hbReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22hbReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22hbReadTemperature'] = function(block) {\n    \nreturn [`_periph_lps22hb.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps22hbOneShot\nvar __Periph_lps22hbOneShot_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Trigger LPS22HB one-shot read\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps22hbOneShot'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps22hbOneShot_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps22hbOneShot'] = function(block) {\n    \nreturn `_periph_lps22hb.one_shot()\n`\n};\n"}