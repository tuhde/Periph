{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mpl115a2Init", "__Periph_mpl115a2ReadPressure", "__Periph_mpl115a2ReadTemperature", "__Periph_mpl115a2ReadPressureHpa", "__Periph_mpl115a2ReadAltitude", "__Periph_mpl115a2ReloadCoefficients"], "jscode": "// Block __Periph_mpl115a2Init\nvar __Periph_mpl115a2Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MPL115A2\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl115a2Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl115a2Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl115a2Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.mpl115a2 import MPL115A2Full as _MPL115A2Full\n\n_periph_mpl115a2 = _MPL115A2Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_mpl115a2ReadPressure\nvar __Periph_mpl115a2ReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL115A2 pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl115a2ReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl115a2ReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl115a2ReadPressure'] = function(block) {\n    \nreturn [`_periph_mpl115a2.read_pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpl115a2ReadTemperature\nvar __Periph_mpl115a2ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL115A2 temperature (°C, approximate)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl115a2ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl115a2ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl115a2ReadTemperature'] = function(block) {\n    \nreturn [`_periph_mpl115a2.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpl115a2ReadPressureHpa\nvar __Periph_mpl115a2ReadPressureHpa_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL115A2 pressure (hPa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl115a2ReadPressureHpa'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl115a2ReadPressureHpa_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl115a2ReadPressureHpa'] = function(block) {\n    \nreturn [`_periph_mpl115a2.pressure_hpa()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpl115a2ReadAltitude\nvar __Periph_mpl115a2ReadAltitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL115A2 altitude (m), sea-level pressure (Pa)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sea_level_pa\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sea_level_pa\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl115a2ReadAltitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl115a2ReadAltitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl115a2ReadAltitude'] = function(block) {\n    \nvar _sea_level_pa = block.getFieldValue('_sea_level_pa');\nreturn [`_periph_mpl115a2.altitude(sea_level_pa=${_sea_level_pa})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpl115a2ReloadCoefficients\nvar __Periph_mpl115a2ReloadCoefficients_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL115A2 reload coefficients\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl115a2ReloadCoefficients'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl115a2ReloadCoefficients_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl115a2ReloadCoefficients'] = function(block) {\n    \nreturn `_periph_mpl115a2.reload_coefficients()\n`\n};\n"}