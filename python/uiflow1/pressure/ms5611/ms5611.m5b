ms5611.init()\n`\n};\n// Block __Periph_ms5611Temperature\nvar __Periph_ms5611Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MS5611 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ms5611Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_ms5611Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ms5611Temperature'] = function(block) {\n    \nreturn [`_periph_ms5611.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ms5611Pressure\nvar __Periph_ms5611Pressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MS5611 pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ms5611Pressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_ms5611Pressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ms5611Pressure'] = function(block) {\n    \nreturn [`_periph_ms5611.read_pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ms5611Altitude\nvar __Periph_ms5611Altitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MS5611 altitude vs 101325 Pa (m)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ms5611Altitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_ms5611Altitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ms5611Altitude'] = function(block) {\n    \nreturn [`_periph_ms5611.altitude()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ms5611SetOversampling\nvar __Periph_ms5611SetOversampling_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n   