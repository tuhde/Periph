{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_lps28dfwInit", "__Periph_lps28dfwReadPressure", "__Periph_lps28dfwReadTemperature", "__Periph_lps28dfwConfigure", "__Periph_lps28dfwSetThreshold"], "jscode": "// Block __Periph_lps28dfwInit\nvar __Periph_lps28dfwInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init LPS28DFW\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps28dfwInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps28dfwInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps28dfwInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.lps28dfw import LPS28DFWFull as _LPS28DFWFull\n\n_periph_lps28dfw = _LPS28DFWFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_lps28dfwReadPressure\nvar __Periph_lps28dfwReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS28DFW pressure (hPa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps28dfwReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps28dfwReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps28dfwReadPressure'] = function(block) {\n    \nreturn [`_periph_lps28dfw.read_pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps28dfwReadTemperature\nvar __Periph_lps28dfwReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS28DFW temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps28dfwReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps28dfwReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps28dfwReadTemperature'] = function(block) {\n    \nreturn [`_periph_lps28dfw.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps28dfwConfigure\nvar __Periph_lps28dfwConfigure_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS28DFW configure\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ODR\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_odr\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_odr\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AVG\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_avg\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_avg\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"FS mode\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_fs_mode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_fs_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps28dfwConfigure'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps28dfwConfigure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps28dfwConfigure'] = function(block) {\n    \n\nvar _odr = block.getFieldValue('_odr');\n\nvar _avg = block.getFieldValue('_avg');\n\nvar _fs_mode = block.getFieldValue('_fs_mode');\nreturn `_periph_lps28dfw.configure(odr=${_odr}, avg=${_avg}, fs_mode=${_fs_mode}, lpf_en=True, lpf_cfg=0)\n`\n};\n// Block __Periph_lps28dfwSetThreshold\nvar __Periph_lps28dfwSetThreshold_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS28DFW threshold\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"threshold (hPa)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_threshold_hpa\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_threshold_hpa\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"high\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_high\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_high\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"low\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_low\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_low\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps28dfwSetThreshold'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps28dfwSetThreshold_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps28dfwSetThreshold'] = function(block) {\n    \n\nvar _threshold_hpa = block.getFieldValue('_threshold_hpa');\n\nvar _high = block.getFieldValue('_high');\n\nvar _low = block.getFieldValue('_low');\nreturn `_periph_lps28dfw.set_threshold(${_threshold_hpa}, high=bool(${_high}), low=bool(${_low}))\n`\n};\n"}