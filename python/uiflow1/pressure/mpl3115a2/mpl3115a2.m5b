{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mpl3115a2Init", "__Periph_mpl3115a2ReadPressure", "__Periph_mpl3115a2ReadTemperature", "__Periph_mpl3115a2ReadAltitude", "__Periph_mpl3115a2SetOversample", "__Periph_mpl3115a2SetSeaLevelPressure", "__Periph_mpl3115a2StartContinuous", "__Periph_mpl3115a2StopContinuous"], "jscode": "// Block __Periph_mpl3115a2Init\nvar __Periph_mpl3115a2Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MPL3115A2\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.mpl3115a2 import MPL3115A2Full as _MPL3115A2Full\n\n_periph_mpl3115a2 = _MPL3115A2Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_mpl3115a2.init()\n`\n};\n// Block __Periph_mpl3115a2ReadPressure\nvar __Periph_mpl3115a2ReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL3115A2 pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2ReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2ReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2ReadPressure'] = function(block) {\n    \nreturn [`_periph_mpl3115a2.read_pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpl3115a2ReadTemperature\nvar __Periph_mpl3115a2ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL3115A2 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2ReadTemperature'] = function(block) {\n    \nreturn [`_periph_mpl3115a2.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpl3115a2ReadAltitude\nvar __Periph_mpl3115a2ReadAltitude_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL3115A2 altitude (m)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2ReadAltitude'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2ReadAltitude_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2ReadAltitude'] = function(block) {\n    \nreturn [`_periph_mpl3115a2.read_altitude()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpl3115a2SetOversample\nvar __Periph_mpl3115a2SetOversample_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL3115A2 oversample ratio (1-128)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_ratio\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_ratio\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2SetOversample'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2SetOversample_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2SetOversample'] = function(block) {\n    \nvar _ratio = block.getFieldValue('_ratio');\nreturn `_periph_mpl3115a2.set_oversample(int(${_ratio}))\n`\n};\n// Block __Periph_mpl3115a2SetSeaLevelPressure\nvar __Periph_mpl3115a2SetSeaLevelPressure_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL3115A2 sea-level pressure (Pa)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pa\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pa\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2SetSeaLevelPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2SetSeaLevelPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2SetSeaLevelPressure'] = function(block) {\n    \nvar _pa = block.getFieldValue('_pa');\nreturn `_periph_mpl3115a2.set_sea_level_pressure(float(${_pa}))\n`\n};\n// Block __Periph_mpl3115a2StartContinuous\nvar __Periph_mpl3115a2StartContinuous_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL3115A2 start continuous, step 2^n s\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_step\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_step\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2StartContinuous'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2StartContinuous_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2StartContinuous'] = function(block) {\n    \nvar _step = block.getFieldValue('_step');\nreturn `_periph_mpl3115a2.start_continuous(int(${_step}))\n`\n};\n// Block __Periph_mpl3115a2StopContinuous\nvar __Periph_mpl3115a2StopContinuous_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPL3115A2 stop continuous\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpl3115a2StopContinuous'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpl3115a2StopContinuous_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpl3115a2StopContinuous'] = function(block) {\n    \nreturn `_periph_mpl3115a2.stop_continuous()\n`\n};\n"}