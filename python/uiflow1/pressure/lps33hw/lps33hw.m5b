{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_lps33hwInit", "__Periph_lps33hwReadPressure", "__Periph_lps33hwReadTemperature", "__Periph_lps33hwOneShot"], "jscode": "// Block __Periph_lps33hwInit\nvar __Periph_lps33hwInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init LPS33HW\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps33hwInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps33hwInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps33hwInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.pressure.lps33hw import LPS33HWFull as _LPS33HWFull\n\n_periph_lps33hw = _LPS33HWFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_lps33hwReadPressure\nvar __Periph_lps33hwReadPressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS33HW pressure (Pa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps33hwReadPressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps33hwReadPressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps33hwReadPressure'] = function(block) {\n    \nreturn [`_periph_lps33hw.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps33hwReadTemperature\nvar __Periph_lps33hwReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LPS33HW temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps33hwReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps33hwReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps33hwReadTemperature'] = function(block) {\n    \nreturn [`_periph_lps33hw.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lps33hwOneShot\nvar __Periph_lps33hwOneShot_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Trigger LPS33HW one-shot read\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lps33hwOneShot'] = {\n    init: function() {\n        this.jsonInit(__Periph_lps33hwOneShot_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lps33hwOneShot'] = function(block) {\n    \nreturn `_periph_lps33hw.one_shot()\n`\n};\n"}