{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_as7262Init", "__Periph_as7262Measure", "__Periph_as7262Channel", "__Periph_as7262RawChannel", "__Periph_as7262Temperature", "__Periph_as7262DataReady", "__Periph_as7262SetGain", "__Periph_as7262SetIntegrationTime", "__Periph_as7262SetMode", "__Periph_as7262SetLed", "__Periph_as7262SetIndicatorLed", "__Periph_as7262SoftReset"], "jscode": "// Block __Periph_as7262Init\nvar __Periph_as7262Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init AS7262\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.color.as7262 import AS7262Full as _AS7262Full\n\n_periph_as7262 = _AS7262Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_as7262Measure\nvar __Periph_as7262Measure_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 measure (one-shot)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262Measure'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262Measure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262Measure'] = function(block) {\n    \nreturn `_periph_as7262.read()\n`\n};\n// Block __Periph_as7262Channel\nvar __Periph_as7262Channel_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 calibrated channel (0=V 1=B 2=G 3=Y 4=O 5=R)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_index\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_index\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262Channel'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262Channel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262Channel'] = function(block) {\n    \nvar _index = block.getFieldValue('_index');\nreturn [`_periph_as7262.read_channel(int(${_index}), True)`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_as7262RawChannel\nvar __Periph_as7262RawChannel_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 raw channel (0=V 1=B 2=G 3=Y 4=O 5=R)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_index\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_index\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262RawChannel'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262RawChannel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262RawChannel'] = function(block) {\n    \nvar _index = block.getFieldValue('_index');\nreturn [`_periph_as7262.read_channel(int(${_index}), False)`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_as7262Temperature\nvar __Periph_as7262Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262Temperature'] = function(block) {\n    \nreturn [`_periph_as7262.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_as7262DataReady\nvar __Periph_as7262DataReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 data ready\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262DataReady'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262DataReady_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262DataReady'] = function(block) {\n    \nreturn [`_periph_as7262.data_ready()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_as7262SetGain\nvar __Periph_as7262SetGain_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 gain (0=1x, 1=3.7x, 2=16x, 3=64x)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_gain\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_gain\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262SetGain'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262SetGain_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262SetGain'] = function(block) {\n    \nvar _gain = block.getFieldValue('_gain');\nreturn `_periph_as7262.set_gain(int(${_gain}) if int(${_gain}) != 1 else 3.7)\n`\n};\n// Block __Periph_as7262SetIntegrationTime\nvar __Periph_as7262SetIntegrationTime_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 integration time (ms, 2.8-714)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_ms\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_ms\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262SetIntegrationTime'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262SetIntegrationTime_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262SetIntegrationTime'] = function(block) {\n    \nvar _ms = block.getFieldValue('_ms');\nreturn `_periph_as7262.set_integration_time(float(${_ms}))\n`\n};\n// Block __Periph_as7262SetMode\nvar __Periph_as7262SetMode_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 bank mode (0-2 continuous, 3 one-shot)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262SetMode'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262SetMode_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262SetMode'] = function(block) {\n    \nvar _mode = block.getFieldValue('_mode');\nreturn `_periph_as7262.set_mode(int(${_mode}))\n`\n};\n// Block __Periph_as7262SetLed\nvar __Periph_as7262SetLed_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 driver LED current (mA: 12.5/25/50/100, 0=off)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_current\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_current\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262SetLed'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262SetLed_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262SetLed'] = function(block) {\n    \nvar _current = block.getFieldValue('_current');\nreturn `_periph_as7262.set_led(float(${_current}) > 0, float(${_current}) or 12.5)\n`\n};\n// Block __Periph_as7262SetIndicatorLed\nvar __Periph_as7262SetIndicatorLed_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 indicator LED current (mA: 1/2/4/8, 0=off)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_current\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_current\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262SetIndicatorLed'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262SetIndicatorLed_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262SetIndicatorLed'] = function(block) {\n    \nvar _current = block.getFieldValue('_current');\nreturn `_periph_as7262.set_indicator_led(float(${_current}) > 0, float(${_current}) or 1)\n`\n};\n// Block __Periph_as7262SoftReset\nvar __Periph_as7262SoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AS7262 soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_as7262SoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_as7262SoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_as7262SoftReset'] = function(block) {\n    \nreturn `_periph_as7262.soft_reset()\n`\n};\n"}