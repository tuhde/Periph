', 'green_red', 'green_blue'][int(${_mode})])\n`\n};\n// Block __Periph_isl29125SetRange\nvar __Periph_isl29125SetRange_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ISL29125 range\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"range (375 or 10000 lux)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_lux\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_lux\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_isl29125SetRange'] = {\n    init: function() {\n        this.jsonInit(__Periph_isl29125SetRange_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_isl29125SetRange'] = function(block) {\n    \n\nvar _lux = block.getFieldValue('_lux');\nreturn `_periph_isl29125.set_range(int(${_lux}))\n`\n};\n// Block __Periph_isl29125SetResolution\nvar __Periph_isl29125SetResolution_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ISL29125 resolution\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"bits (12 or 16)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bits\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bits\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_isl29125SetResolution'] = {\n 