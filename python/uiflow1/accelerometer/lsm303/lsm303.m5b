sm303.read_magnetic()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lsm303MagY\nvar __Periph_lsm303MagY_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LSM303 magnetic field Y (µT)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lsm303MagY'] = {\n    init: function() {\n        this.jsonInit(__Periph_lsm303MagY_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lsm303MagY'] = function(block) {\n    \nreturn [`_periph_lsm303.read_magnetic()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lsm303MagZ\nvar __Periph_lsm303MagZ_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LSM303 magnetic field Z (µT)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lsm303MagZ'] = {\n    init: function() {\n        this.jsonInit(__Periph_lsm303MagZ_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lsm303MagZ'] = function(block) {\n    \nreturn [`_periph_lsm303.read_magnetic()[2]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lsm303Heading\nvar __Periph_lsm303Heading_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LSM303 tilt-compensated heading (°)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lsm303Heading'] = {\n    init: function() {\n        this.jsonInit(__Periph_lsm303Heading_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lsm303Heading'] = function(block) {\n    \nreturn [`_periph_lsm303.heading()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_lsm303Temperature\nvar __Periph_lsm303Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n     