n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lsm303SetMagDataRate'] = {\n    init: function() {\n        this.jsonInit(__Periph_lsm303SetMagDataRate_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lsm303SetMagDataRate'] = function(block) {\n    \nvar _rate_hz = block.getFieldValue('_rate_hz');\nreturn `_periph_lsm303.set_mag_data_rate(${_rate_hz})\n`\n};\n"}