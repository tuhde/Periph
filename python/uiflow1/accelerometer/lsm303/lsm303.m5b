{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_lsm303Init", "__Periph_lsm303AccelX", "__Periph_lsm303AccelY", "__Periph_lsm303AccelZ", "__Periph_lsm303MagX", "__Periph_lsm303MagY", "__Periph_lsm303MagZ", "__Periph_lsm303Heading", "__Periph_lsm303Temperature", "__Periph_lsm303SetRange", "__Periph_lsm303SetDataRate", "__Periph_lsm303SetMagRange", "__Periph_lsm303SetMagDataRate"], "jscode": "// Block __Periph_lsm303Init\nvar __Periph_lsm303Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init LSM303\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_lsm303Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_lsm303Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_lsm303Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.accelerometer.lsm303 import LSM303Full as _LSM303Full\n\n_periph_lsm303 = _LSM303Full(_periph_i2c_conn(0x19, bus=${_bus}), _periph_i2c_conn(0x1E, bus=${_bus}))\n`\n};\n// Block __Periph_lsm303AccelX\nvar __Periph_lsm303AccelX_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"LSM303 acceleration X (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_