{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_bma150Init", "__Periph_bma150X", "__Periph_bma150Y", "__Periph_bma150Z"], "jscode": "// Block __Periph_bma150Init\nvar __Periph_bma150Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BMA150\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bma150Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bma150Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bma150Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.accelerometer.bma150 import BMA150Full as _BMA150Full\n\n_periph_bma150 = _BMA150Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_bma150X\nvar __Periph_bma150X_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMA150 acceleration X (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bma150X'] = {\n    init: function() {\n        this.jsonInit(__Periph_bma150X_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bma150X'] = function(block) {\n    \nreturn [`_periph_bma150.read()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bma150Y\nvar __Periph_bma150Y_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMA150 acceleration Y (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bma150Y'] = {\n    init: function() {\n        this.jsonInit(__Periph_bma150Y_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bma150Y'] = function(block) {\n    \nreturn [`_periph_bma150.read()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bma150Z\nvar __Periph_bma150Z_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BMA150 acceleration Z (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bma150Z'] = {\n    init: function() {\n        this.jsonInit(__Periph_bma150Z_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bma150Z'] = function(block) {\n    \nreturn [`_periph_bma150.read()[2]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}