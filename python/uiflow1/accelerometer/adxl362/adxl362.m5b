{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_adxl362Init", "__Periph_adxl362X", "__Periph_adxl362Y", "__Periph_adxl362Z", "__Periph_adxl362Temperature", "__Periph_adxl362Awake", "__Periph_adxl362SetRange", "__Periph_adxl362SoftReset"], "jscode": "// Block __Periph_adxl362Init\nvar __Periph_adxl362Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init ADXL362 (SPI bus, CS pin)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs_pin\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362Init'] = function(block) {\n    \nvar _bus = block.getFieldValue('_bus');\nvar _cs_pin = block.getFieldValue('_cs_pin');\nreturn `from periph.connection.spi_auto import SPIConnection as _periph_spi_conn\nfrom periph.chips.accelerometer.adxl362 import ADXL362Full as _ADXL362Full\n\n_periph_adxl362 = _ADXL362Full(_periph_spi_conn(bus=${_bus}, cs_pin=${_cs_pin}))\n`\n};\n// Block __Periph_adxl362X\nvar __Periph_adxl362X_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL362 acceleration X (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362X'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362X_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362X'] = function(block) {\n    \nreturn [`_periph_adxl362.read()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_adxl362Y\nvar __Periph_adxl362Y_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL362 acceleration Y (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362Y'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362Y_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362Y'] = function(block) {\n    \nreturn [`_periph_adxl362.read()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_adxl362Z\nvar __Periph_adxl362Z_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL362 acceleration Z (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362Z'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362Z_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362Z'] = function(block) {\n    \nreturn [`_periph_adxl362.read()[2]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_adxl362Temperature\nvar __Periph_adxl362Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL362 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362Temperature'] = function(block) {\n    \nreturn [`_periph_adxl362.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_adxl362Awake\nvar __Periph_adxl362Awake_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL362 awake (1/0)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362Awake'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362Awake_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362Awake'] = function(block) {\n    \nreturn [`int(_periph_adxl362.awake())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_adxl362SetRange\nvar __Periph_adxl362SetRange_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL362 set range (g) — 2, 4, or 8\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_range_g\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_range_g\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362SetRange'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362SetRange_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362SetRange'] = function(block) {\n    \nvar _range_g = Blockly.Python.valueToCode(block, '_range_g', Blockly.Python.ORDER_NONE);\nreturn `_periph_adxl362.set_range(int(${_range_g}))\n`\n};\n// Block __Periph_adxl362SoftReset\nvar __Periph_adxl362SoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL362 soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl362SoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl362SoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl362SoftReset'] = function(block) {\n    \nreturn `_periph_adxl362.soft_reset()\n`\n};\n"}