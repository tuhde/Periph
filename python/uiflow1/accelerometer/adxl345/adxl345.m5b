{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_adxl345Init", "__Periph_adxl345X", "__Periph_adxl345Y", "__Periph_adxl345Z"], "jscode": "// Block __Periph_adxl345Init\nvar __Periph_adxl345Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init ADXL345\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl345Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl345Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl345Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.accelerometer.adxl345 import ADXL345Full as _ADXL345Full\n\n_periph_adxl345 = _ADXL345Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_adxl345X\nvar __Periph_adxl345X_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL345 acceleration X (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl345X'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl345X_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl345X'] = function(block) {\n    \nreturn [`_periph_adxl345.read()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_adxl345Y\nvar __Periph_adxl345Y_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL345 acceleration Y (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl345Y'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl345Y_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl345Y'] = function(block) {\n    \nreturn [`_periph_adxl345.read()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_adxl345Z\nvar __Periph_adxl345Z_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADXL345 acceleration Z (g)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_adxl345Z'] = {\n    init: function() {\n        this.jsonInit(__Periph_adxl345Z_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_adxl345Z'] = function(block) {\n    \nreturn [`_periph_adxl345.read()[2]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}