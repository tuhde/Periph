{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mcp4728Init", "__Periph_mcp4728SetVoltage", "__Periph_mcp4728SetRaw", "__Periph_mcp4728SetAll"], "jscode": "// Block __Periph_mcp4728Init\nvar __Periph_mcp4728Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MCP4728\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp4728Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp4728Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp4728Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.adc_dac.mcp4728 import MCP4728Full as _MCP4728Full\n\n_periph_mcp4728 = _MCP4728Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_mcp4728SetVoltage\nvar __Periph_mcp4728SetVoltage_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP4728 set channel output (fraction of V_DD)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"channel (0-3)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"fraction\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_fraction\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_fraction\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp4728SetVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp4728SetVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp4728SetVoltage'] = function(block) {\n    \n\nvar _channel = block.getFieldValue('_channel');\n\nvar _fraction = block.getFieldValue('_fraction');\nreturn `_periph_mcp4728.set_voltage(${_channel}, ${_fraction})\n`\n};\n// Block __Periph_mcp4728SetRaw\nvar __Periph_mcp4728SetRaw_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP4728 set channel raw 12-bit code\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"channel (0-3)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"code\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_code\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_code\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp4728SetRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp4728SetRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp4728SetRaw'] = function(block) {\n    \n\nvar _channel = block.getFieldValue('_channel');\n\nvar _code = block.getFieldValue('_code');\nreturn `_periph_mcp4728.set_raw(${_channel}, ${_code})\n`\n};\n// Block __Periph_mcp4728SetAll\nvar __Periph_mcp4728SetAll_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP4728 set all channels (fractions of V_DD)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"A\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_frac_a\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_frac_a\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"B\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_frac_b\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_frac_b\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"C\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_frac_c\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_frac_c\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"D\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_frac_d\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_frac_d\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp4728SetAll'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp4728SetAll_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp4728SetAll'] = function(block) {\n    \n\nvar _frac_a = block.getFieldValue('_frac_a');\n\nvar _frac_b = block.getFieldValue('_frac_b');\n\nvar _frac_c = block.getFieldValue('_frac_c');\n\nvar _frac_d = block.getFieldValue('_frac_d');\nreturn `_periph_mcp4728.set_all([${_frac_a}, ${_frac_b}, ${_frac_c}, ${_frac_d}])\n`\n};\n"}