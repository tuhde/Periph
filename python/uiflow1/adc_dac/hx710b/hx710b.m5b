ph.chips.adc_dac.hx710b import HX710BFull as _HX710BFull\n\n_periph_hx710b = _HX710BFull(_periph_hx711_conn(${_dout}, ${_pd_sck}))\n`\n};\n// Block __Periph_hx710bIsReady\nvar __Periph_hx710bIsReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX710B ready?\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hx710bIsReady'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx710bIsReady_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx710bIsReady'] = function(block) {\n    \nreturn [`_periph_hx710b.is_ready()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hx710bReadRaw\nvar __Periph_hx710bReadRaw_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX710B raw ADC value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hx710bReadRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx710bReadRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx710bReadRaw'] = function(block) {\n    \nreturn [`_periph_hx710b.read_raw()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hx710bSetRate\nvar __Periph_hx710bSetRate_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX710B set rate (10/40 SPS)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_rate\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_rate\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hx710bSetRate'] = {\n    init: function() {