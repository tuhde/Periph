viousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HX710B power up\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hx710bPowerUp'] = {\n    init: function() {\n        this.jsonInit(__Periph_hx710bPowerUp_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hx710bPowerUp'] = function(block) {\n    \nreturn `_periph_hx710b.power_up()\n`\n};\n"}