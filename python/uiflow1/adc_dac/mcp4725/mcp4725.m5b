{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mcp4725Init", "__Periph_mcp4725SetVoltage", "__Periph_mcp4725SetRaw"], "jscode": "// Block __Periph_mcp4725Init\nvar __Periph_mcp4725Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MCP4725\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp4725Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp4725Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp4725Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.adc_dac.mcp4725 import MCP4725Full as _MCP4725Full\n\n_periph_mcp4725 = _MCP4725Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_mcp4725SetVoltage\nvar __Periph_mcp4725SetVoltage_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP4725 set output (fraction of V_DD)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_fraction\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_fraction\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp4725SetVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp4725SetVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp4725SetVoltage'] = function(block) {\n    \nvar _fraction = block.getFieldValue('_fraction');\nreturn `_periph_mcp4725.set_voltage(${_fraction})\n`\n};\n// Block __Periph_mcp4725SetRaw\nvar __Periph_mcp4725SetRaw_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP4725 set raw 12-bit code\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_code\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_code\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp4725SetRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp4725SetRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp4725SetRaw'] = function(block) {\n    \nvar _code = block.getFieldValue('_code');\nreturn `_periph_mcp4725.set_raw(${_code})\n`\n};\n"}