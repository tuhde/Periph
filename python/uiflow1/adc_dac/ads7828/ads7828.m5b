{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_ads7828Init", "__Periph_ads7828ReadRaw", "__Periph_ads7828ReadVoltage", "__Periph_ads7828ReadDifferential", "__Periph_ads7828ReadSignedDifferential", "__Periph_ads7828SetReference", "__Periph_ads7828PowerDown"], "jscode": "// Block __Periph_ads7828Init\nvar __Periph_ads7828Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init ADS7828\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"external vref in V (0 = internal 2.5 V)\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_vref\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_vref\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ads7828Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ads7828Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ads7828Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\n\nvar _vref = block.getFieldValue('_vref');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.adc_dac.ads7828 import ADS7828Full as _ADS7828Full\n\n_periph_ads7828 = _ADS7828Full(_periph_i2c_conn(${_address}, bus=${_bus}), ${_vref} or None)\n`\n};\n// Block __Periph_ads7828ReadRaw\nvar __Periph_ads7828ReadRaw_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADS7828 read channel (raw 0-4095)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ads7828ReadRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_ads7828ReadRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ads7828ReadRaw'] = function(block) {\n    \nvar _channel = block.getFieldValue('_channel');\nreturn [`_periph_ads7828.read_raw(${_channel})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ads7828ReadVoltage\nvar __Periph_ads7828ReadVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADS7828 read channel voltage (V)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ads7828ReadVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_ads7828ReadVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ads7828ReadVoltage'] = function(block) {\n    \nvar _channel = block.getFieldValue('_channel');\nreturn [`_periph_ads7828.read_voltage(${_channel})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ads7828ReadDifferential\nvar __Periph_ads7828ReadDifferential_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADS7828 read differential pair (0-3) voltage (V)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pair\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pair\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"inverted (0/1)\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_inverted\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_inverted\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ads7828ReadDifferential'] = {\n    init: function() {\n        this.jsonInit(__Periph_ads7828ReadDifferential_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ads7828ReadDifferential'] = function(block) {\n    \nvar _pair = block.getFieldValue('_pair');\n\nvar _inverted = block.getFieldValue('_inverted');\nreturn [`_periph_ads7828.read_differential(${_pair}, ${_inverted} != 0)`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ads7828ReadSignedDifferential\nvar __Periph_ads7828ReadSignedDifferential_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADS7828 read signed differential pair (0-3) (V)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pair\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pair\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ads7828ReadSignedDifferential'] = {\n    init: function() {\n        this.jsonInit(__Periph_ads7828ReadSignedDifferential_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ads7828ReadSignedDifferential'] = function(block) {\n    \nvar _pair = block.getFieldValue('_pair');\nreturn [`_periph_ads7828.read_signed_differential(${_pair})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ads7828SetReference\nvar __Periph_ads7828SetReference_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADS7828 set reference in V (0 = internal 2.5 V)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_vref\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_vref\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ads7828SetReference'] = {\n    init: function() {\n        this.jsonInit(__Periph_ads7828SetReference_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ads7828SetReference'] = function(block) {\n    \nvar _vref = block.getFieldValue('_vref');\nreturn `_periph_ads7828.set_reference(${_vref} or None)\n`\n};\n// Block __Periph_ads7828PowerDown\nvar __Periph_ads7828PowerDown_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ADS7828 power down\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ads7828PowerDown'] = {\n    init: function() {\n        this.jsonInit(__Periph_ads7828PowerDown_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ads7828PowerDown'] = function(block) {\n    \nreturn `_periph_ads7828.power_down()\n`\n};\n"}