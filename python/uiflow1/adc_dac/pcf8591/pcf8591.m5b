{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_pcf8591Init", "__Periph_pcf8591ReadChannel", "__Periph_pcf8591ReadChannelVoltage", "__Periph_pcf8591SetDacVoltage"], "jscode": "// Block __Periph_pcf8591Init\nvar __Periph_pcf8591Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init PCF8591\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8591Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8591Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8591Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.adc_dac.pcf8591 import PCF8591Full as _PCF8591Full\n\n_periph_pcf8591 = _PCF8591Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_pcf8591ReadChannel\nvar __Periph_pcf8591ReadChannel_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8591 read channel (raw 0-255)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8591ReadChannel'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8591ReadChannel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8591ReadChannel'] = function(block) {\n    \nvar _channel = block.getFieldValue('_channel');\nreturn [`_periph_pcf8591.read_channel(${_channel})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_pcf8591ReadChannelVoltage\nvar __Periph_pcf8591ReadChannelVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8591 read channel voltage\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"channel\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"vref\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_vref\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_vref\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"vagnd\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_vagnd\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_vagnd\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8591ReadChannelVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8591ReadChannelVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8591ReadChannelVoltage'] = function(block) {\n    \n\nvar _channel = block.getFieldValue('_channel');\n\nvar _vref = block.getFieldValue('_vref');\n\nvar _vagnd = block.getFieldValue('_vagnd');\nreturn [`_periph_pcf8591.read_channel_voltage(${_channel}, ${_vref}, ${_vagnd})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_pcf8591SetDacVoltage\nvar __Periph_pcf8591SetDacVoltage_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8591 set DAC output (fraction of VREF-VAGND)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_fraction\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_fraction\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8591SetDacVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8591SetDacVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8591SetDacVoltage'] = function(block) {\n    \nvar _fraction = block.getFieldValue('_fraction');\nreturn `_periph_pcf8591.set_dac_voltage(${_fraction})\n`\n};\n"}