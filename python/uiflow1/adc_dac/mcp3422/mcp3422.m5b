ldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.adc_dac.mcp3422 import MCP3422Full as _MCP3422Full\n\n_periph_mcp3422 = _MCP3422Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_mcp3422ReadRaw\nvar __Periph_mcp3422ReadRaw_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP3422 raw code, channel (0-1)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp3422ReadRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp3422ReadRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp3422ReadRaw'] = function(block) {\n    \nvar _channel = block.getFieldValue('_channel');\nreturn [`_periph_mcp3422.read_raw(${_channel})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mcp3422ReadVoltage\nvar __Periph_mcp3422ReadVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP3422 voltage (V), channel (0-1)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp3422ReadVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp3422ReadVoltage_json);\n    }\n};\