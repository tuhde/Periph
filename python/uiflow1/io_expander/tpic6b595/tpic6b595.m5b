{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_tpic6b595Init", "__Periph_tpic6b595WritePin", "__Periph_tpic6b595WritePort", "__Periph_tpic6b595Fill", "__Periph_tpic6b595Off", "__Periph_tpic6b595Clear", "__Periph_tpic6b595SetOutputEnable", "__Periph_tpic6b595WriteAll"], "jscode": "// Block __Periph_tpic6b595Init\nvar __Periph_tpic6b595Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init TPIC6B595\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPI bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPI device\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_device\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_device\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RCK pin\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_rck\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_rck\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SRCLR pin (-1=none)\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_srclr\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_srclr\"\n        }\n    ],\n    \"message9\": \"%1\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"G pin (-1=none)\"\n        }\n    ],\n    \"message10\": \"%1 %2\",\n    \"args10\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_g\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_g\"\n        }\n    ],\n    \"message11\": \"%1\",\n    \"args11\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"num_devices\"\n        }\n    ],\n    \"message12\": \"%1 %2\",\n    \"args12\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_num_devices\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_num_devices\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _device = block.getFieldValue('_device');\n\nvar _rck = block.getFieldValue('_rck');\n\nvar _srclr = block.getFieldValue('_srclr');\n\nvar _g = block.getFieldValue('_g');\n\nvar _num_devices = block.getFieldValue('_num_devices');\nreturn `from machine import SPI, Pin\nfrom periph.connection.sipo_micropython import SiPoConnection\nfrom periph.chips.io_expander.tpic6b595 import Tpic6b595Full\n\n_spi = SPI(${_bus}, baudrate=1000000, polarity=0, phase=0,\n           sck=Pin(${_rck} + 1), mosi=Pin(${_rck} + 2))\n_rck = Pin(${_rck}, Pin.OUT)\n_srclr = Pin(${_srclr}, Pin.OUT) if ${_srclr} >= 0 else None\n_g = Pin(${_g}, Pin.OUT) if ${_g} >= 0 else None\n_periph_sipo = SiPoConnection(_spi, _rck, srclr=_srclr, g=_g)\n\n_periph_tpic6b595 = Tpic6b595Full(_periph_sipo, num_devices=${_num_devices})\n`\n};\n// Block __Periph_tpic6b595WritePin\nvar __Periph_tpic6b595WritePin_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TPIC6B595 write pin value (0/1)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595WritePin'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595WritePin_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595WritePin'] = function(block) {\n    \nvar _pin = block.getFieldValue('_pin');\nvar _value = block.getFieldValue('_value');\nreturn `_periph_tpic6b595.pin(${_pin}).value(${_value})\n`\n};\n// Block __Periph_tpic6b595WritePort\nvar __Periph_tpic6b595WritePort_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TPIC6B595 write device byte (port) (0x00-0xFF)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_port\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_port\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mask\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mask\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595WritePort'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595WritePort_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595WritePort'] = function(block) {\n    \nvar _port = block.getFieldValue('_port');\nvar _mask = block.getFieldValue('_mask');\nreturn `_periph_tpic6b595.write_port(${_port}, ${_mask})\n`\n};\n// Block __Periph_tpic6b595Fill\nvar __Periph_tpic6b595Fill_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TPIC6B595 fill all outputs (0/1)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595Fill'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595Fill_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595Fill'] = function(block) {\n    \nvar _value = block.getFieldValue('_value');\nreturn `_periph_tpic6b595.fill(bool(${_value}))\n`\n};\n// Block __Periph_tpic6b595Off\nvar __Periph_tpic6b595Off_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TPIC6B595 turn every output off\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595Off'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595Off_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595Off'] = function(block) {\n    \nreturn `_periph_tpic6b595.off()\n`\n};\n// Block __Periph_tpic6b595Clear\nvar __Periph_tpic6b595Clear_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TPIC6B595 pulse SRCLR\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595Clear'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595Clear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595Clear'] = function(block) {\n    \nreturn `_periph_tpic6b595.clear()\n`\n};\n// Block __Periph_tpic6b595SetOutputEnable\nvar __Periph_tpic6b595SetOutputEnable_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TPIC6B595 set output enable (0/1) via G\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_enabled\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_enabled\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595SetOutputEnable'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595SetOutputEnable_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595SetOutputEnable'] = function(block) {\n    \nvar _enabled = block.getFieldValue('_enabled');\nreturn `_periph_tpic6b595.set_output_enable(bool(${_enabled}))\n`\n};\n// Block __Periph_tpic6b595WriteAll\nvar __Periph_tpic6b595WriteAll_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TPIC6B595 write all device bytes [d0 d1 ...]\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_d0\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_d0\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_d1\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_d1\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tpic6b595WriteAll'] = {\n    init: function() {\n        this.jsonInit(__Periph_tpic6b595WriteAll_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tpic6b595WriteAll'] = function(block) {\n    \nvar _d0 = block.getFieldValue('_d0');\nvar _d1 = block.getFieldValue('_d1');\nreturn `_periph_tpic6b595.write_all([${_d0}, ${_d1}])\n`\n};\n"}