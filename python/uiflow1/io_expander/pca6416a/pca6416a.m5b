FieldValue('_mask');\nreturn `_periph_pca6416a.write_port(${_port}, ${_mask})\n`\n};\n// Block __Periph_pca6416aReadAll\nvar __Periph_pca6416aReadAll_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCA6416A read all 16 pins\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pca6416aReadAll'] = {\n    init: function() {\n        this.jsonInit(__Periph_pca6416aReadAll_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pca6416aReadAll'] = function(block) {\n    \nreturn [`_periph_pca6416a.read_all()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_pca6416aWriteAll\nvar __Periph_pca6416aWriteAll_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCA6416A write all 16 outputs (0-65535)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pca6416aWriteAll'] = {\n    init: function() {\n        this.jsonInit(__Periph_pca6416aWriteAll_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pca6416aWriteAll'] = function(block) {\n    \nvar _value = block.getFieldValue('_value');\nreturn `_periph_pca6416a.write_all(${_value})\n`\n};\n// Block __Periph_pca6416aConfigurePolarity\nvar __Periph_pca6416aConfigurePolarity_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCA6416A input polarity mask (0-65535)\"\n        }\n    ],\n    \