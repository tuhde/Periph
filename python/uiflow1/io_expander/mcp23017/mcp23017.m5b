{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mcp23017Init", "__Periph_mcp23017SetPinMode", "__Periph_mcp23017WritePin", "__Periph_mcp23017ReadPin"], "jscode": "// Block __Periph_mcp23017Init\nvar __Periph_mcp23017Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MCP23017\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp23017Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp23017Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp23017Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.io_expander.mcp23017 import Mcp23017Full as _Mcp23017Full\n\n_periph_mcp23017 = _Mcp23017Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_mcp23017SetPinMode\nvar __Periph_mcp23017SetPinMode_json = {\n    \