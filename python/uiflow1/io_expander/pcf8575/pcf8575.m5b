{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_pcf8575Init", "__Periph_pcf8575SetPinMode", "__Periph_pcf8575WritePin", "__Periph_pcf8575ReadPin"], "jscode": "// Block __Periph_pcf8575Init\nvar __Periph_pcf8575Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init PCF8575\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8575Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8575Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8575Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.io_expander.pcf8575 import Pcf8575Full as _Pcf8575Full\n\n_periph_pcf8575 = _Pcf8575Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_pcf8575SetPinMode\nvar __Periph_pcf8575SetPinMode_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8575 set pin (0-15) mode: IN=0, OUT=1\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8575SetPinMode'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8575SetPinMode_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8575SetPinMode'] = function(block) {\n    \nvar _pin = block.getFieldValue('_pin');\nvar _mode = block.getFieldValue('_mode');\nreturn `_periph_pcf8575.pin(${_pin}).init(${_mode})\n`\n};\n// Block __Periph_pcf8575WritePin\nvar __Periph_pcf8575WritePin_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8575 write pin (0-15) value (0/1)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8575WritePin'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8575WritePin_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8575WritePin'] = function(block) {\n    \nvar _pin = block.getFieldValue('_pin');\nvar _value = block.getFieldValue('_value');\nreturn `_periph_pcf8575.pin(${_pin}).value(${_value})\n`\n};\n// Block __Periph_pcf8575ReadPin\nvar __Periph_pcf8575ReadPin_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8575 read pin (0-15)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8575ReadPin'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8575ReadPin_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8575ReadPin'] = function(block) {\n    \nvar _pin = block.getFieldValue('_pin');\nreturn [`_periph_pcf8575.pin(${_pin}).value()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}