{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_pcf8574Init", "__Periph_pcf8574SetPinMode", "__Periph_pcf8574WritePin", "__Periph_pcf8574ReadPin"], "jscode": "// Block __Periph_pcf8574Init\nvar __Periph_pcf8574Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init PCF8574\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8574Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8574Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8574Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.io_expander.pcf8574 import Pcf8574Full as _Pcf8574Full\n\n_periph_pcf8574 = _Pcf8574Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_pcf8574SetPinMode\nvar __Periph_pcf8574SetPinMode_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8574 set pin (0-7) mode: IN=0, OUT=1\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8574SetPinMode'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8574SetPinMode_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8574SetPinMode'] = function(block) {\n    \nvar _pin = block.getFieldValue('_pin');\nvar _mode = block.getFieldValue('_mode');\nreturn `_periph_pcf8574.pin(${_pin}).init(${_mode})\n`\n};\n// Block __Periph_pcf8574WritePin\nvar __Periph_pcf8574WritePin_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8574 write pin (0-7) value (0/1)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8574WritePin'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8574WritePin_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8574WritePin'] = function(block) {\n    \nvar _pin = block.getFieldValue('_pin');\nvar _value = block.getFieldValue('_value');\nreturn `_periph_pcf8574.pin(${_pin}).value(${_value})\n`\n};\n// Block __Periph_pcf8574ReadPin\nvar __Periph_pcf8574ReadPin_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCF8574 read pin (0-7)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_pin\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pcf8574ReadPin'] = {\n    init: function() {\n        this.jsonInit(__Periph_pcf8574ReadPin_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pcf8574ReadPin'] = function(block) {\n    \nvar _pin = block.getFieldValue('_pin');\nreturn [`_periph_pcf8574.pin(${_pin}).value()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}