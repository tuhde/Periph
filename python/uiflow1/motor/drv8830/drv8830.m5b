e\": \"_in2\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_drv8830SetOutput'] = {\n    init: function() {\n        this.jsonInit(__Periph_drv8830SetOutput_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_drv8830SetOutput'] = function(block) {\n    \n\nvar _vset = block.getFieldValue('_vset');\n\nvar _in1 = block.getFieldValue('_in1');\n\nvar _in2 = block.getFieldValue('_in2');\nreturn `_periph_drv8830.set_output(${_vset}, bool(${_in1}), bool(${_in2}))\n`\n};\n// Block __Periph_drv8830GetOutputVoltage\nvar __Periph_drv8830GetOutputVoltage_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DRV8830 commanded voltage (V)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_drv8830GetOutputVoltage'] = {\n    init: function() {\n        this.jsonInit(__Periph_drv8830GetOutputVoltage_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_drv8830GetOutputVoltage'] = function(block) {\n    \nreturn [`_periph_drv8830.read_output()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_drv8830GetOutputDirection\nvar __Periph_drv8830GetOutputDirection_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DRV8830 direction\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_drv8830GetOutputDirection'] = {\n    init: function() {\n        this.jsonInit(__Periph_drv8830GetOutputDirection_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_drv8830GetOutputDirection'] = function(block) {\n    \nreturn [`_periph_drv8830.read_output()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_drv8830GetFault\nvar __Periph_drv8830GetFault_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"f