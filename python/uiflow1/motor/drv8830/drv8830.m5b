) {\n        this.jsonInit(__Periph_drv8830GetOts_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_drv8830GetOts'] = function(block) {\n    \nreturn [`_periph_drv8830.read_fault()[3]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_drv8830GetIlimit\nvar __Periph_drv8830GetIlimit_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DRV8830 current limit (ILIMIT)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_drv8830GetIlimit'] = {\n    init: function() {\n        this.jsonInit(__Periph_drv8830GetIlimit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_drv8830GetIlimit'] = function(block) {\n    \nreturn [`_periph_drv8830.read_fault()[4]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_drv8830ClearFault\nvar __Periph_drv8830ClearFault_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DRV8830 clear fault\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_drv8830ClearFault'] = {\n    init: function() {\n        this.jsonInit(__Periph_drv8830ClearFault_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_drv8830ClearFault'] = function(block) {\n    \nreturn `_periph_drv8830.clear_fault()\n`\n};\n// Block __Periph_drv8830PollInterrupt\nvar __Periph_drv8830PollInterrupt_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"DRV8830 poll fault\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_drv8830PollInterrupt'] = {\n    init: function() {\n        this.jsonInit(__Periph_drv8830PollInterrupt_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_drv8830PollInterrupt'] = function(