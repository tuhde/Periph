{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_am2315Init", "__Periph_am2315Temperature", "__Periph_am2315Humidity", "__Periph_am2315FreshTemperature", "__Periph_am2315FreshHumidity", "__Periph_am2315DeviceId", "__Periph_am2315UserRegister", "__Periph_am2315SetUserRegisters", "__Periph_am2315Wake"], "jscode": "// Block __Periph_am2315Init\nvar __Periph_am2315Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init AM2315\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.environmental.am2315 import AM2315Full as _AM2315Full\n\n_periph_am2315 = _AM2315Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_am2315Temperature\nvar __Periph_am2315Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315Temperature'] = function(block) {\n    \nreturn [`_periph_am2315.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_am2315Humidity\nvar __Periph_am2315Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315Humidity'] = function(block) {\n    \nreturn [`_periph_am2315.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_am2315FreshTemperature\nvar __Periph_am2315FreshTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 real-time temperature (°C, two reads)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315FreshTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315FreshTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315FreshTemperature'] = function(block) {\n    \nreturn [`_periph_am2315.read_fresh()['temperature_c']`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_am2315FreshHumidity\nvar __Periph_am2315FreshHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 real-time humidity (%RH, two reads)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315FreshHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315FreshHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315FreshHumidity'] = function(block) {\n    \nreturn [`_periph_am2315.read_fresh()['humidity_pct']`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_am2315DeviceId\nvar __Periph_am2315DeviceId_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 device ID\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315DeviceId'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315DeviceId_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315DeviceId'] = function(block) {\n    \nreturn [`_periph_am2315.read_device_info()['device_id']`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_am2315UserRegister\nvar __Periph_am2315UserRegister_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 user register\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"number (1 or 2)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_n\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_n\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315UserRegister'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315UserRegister_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315UserRegister'] = function(block) {\n    \n\nvar _n = block.getFieldValue('_n');\nreturn [`_periph_am2315.read_user_registers()[int(${_n}) - 1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_am2315SetUserRegisters\nvar __Periph_am2315SetUserRegisters_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 write user registers\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"user 1\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_user1\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_user1\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"user 2\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_user2\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_user2\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315SetUserRegisters'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315SetUserRegisters_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315SetUserRegisters'] = function(block) {\n    \n\nvar _user1 = block.getFieldValue('_user1');\n\nvar _user2 = block.getFieldValue('_user2');\nreturn `_periph_am2315.write_user_registers(int(${_user1}), int(${_user2}))\n`\n};\n// Block __Periph_am2315Wake\nvar __Periph_am2315Wake_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AM2315 wake\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_am2315Wake'] = {\n    init: function() {\n        this.jsonInit(__Periph_am2315Wake_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_am2315Wake'] = function(block) {\n    \nreturn `_periph_am2315.wake()\n`\n};\n"}