{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_bme680Init", "__Periph_bme680Temperature", "__Periph_bme680Pressure", "__Periph_bme680Humidity", "__Periph_bme680GasResistance"], "jscode": "// Block __Periph_bme680Init\nvar __Periph_bme680Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BME680\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bme680Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme680Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme680Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.environmental.bme680 import BME680Full as _BME680Full\n\n_periph_bme680 = _BME680Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_bme680Temperature\nvar __Periph_bme680Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME680 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bme680Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme680Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme680Temperature'] = function(block) {\n    \nreturn [`_periph_bme680.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme680Pressure\nvar __Periph_bme680Pressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME680 pressure (hPa)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bme680Pressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme680Pressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme680Pressure'] = function(block) {\n    \nreturn [`_periph_bme680.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme680Humidity\nvar __Periph_bme680Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME680 humidity (%)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bme680Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme680Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme680Humidity'] = function(block) {\n    \nreturn [`_periph_bme680.humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme680GasResistance\nvar __Periph_bme680GasResistance_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME680 gas resistance (Ω)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_bme680GasResistance'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme680GasResistance_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme680GasResistance'] = function(block) {\n    \nreturn [`_periph_bme680.gas_resistance()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}