{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_bme280Init", "__Periph_bme280Temperature", "__Periph_bme280Pressure", "__Periph_bme280Humidity"], "jscode": "// Block __Periph_bme280Init\nvar __Periph_bme280Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BME280\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme280Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme280Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme280Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.environmental.bme280 import BME280Full as _BME280Full\n\n_periph_bme280 = _BME280Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_bme280Temperature\nvar __Periph_bme280Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME280 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme280Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme280Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme280Temperature'] = function(block) {\n    \nreturn [`_periph_bme280.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme280Pressure\nvar __Periph_bme280Pressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME280 pressure (hPa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme280Pressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme280Pressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme280Pressure'] = function(block) {\n    \nreturn [`_periph_bme280.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme280Humidity\nvar __Periph_bme280Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME280 humidity (%)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme280Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme280Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme280Humidity'] = function(block) {\n    \nreturn [`_periph_bme280.humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}