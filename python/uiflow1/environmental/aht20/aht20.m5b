{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_aht20Init", "__Periph_aht20ReadTemperature", "__Periph_aht20ReadHumidity"], "jscode": "// Block __Periph_aht20Init\nvar __Periph_aht20Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init AHT20\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_aht20Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_aht20Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_aht20Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.environmental.aht20 import AHT20Full as _AHT20Full\n\n_periph_aht20 = _AHT20Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_aht20ReadTemperature\nvar __Periph_aht20ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AHT20 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_aht20ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_aht20ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_aht20ReadTemperature'] = function(block) {\n    \nreturn [`_periph_aht20.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_aht20ReadHumidity\nvar __Periph_aht20ReadHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"AHT20 humidity (%)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_aht20ReadHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_aht20ReadHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_aht20ReadHumidity'] = function(block) {\n    \nreturn [`_periph_aht20.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}