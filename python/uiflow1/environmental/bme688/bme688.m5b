{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_bme688Init", "__Periph_bme688Temperature", "__Periph_bme688Pressure", "__Periph_bme688Humidity", "__Periph_bme688GasResistance"], "jscode": "// Block __Periph_bme688Init\nvar __Periph_bme688Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BME688\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme688Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme688Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme688Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.environmental.bme688 import BME688Full as _BME688Full\n\n_periph_bme688 = _BME688Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_bme688Temperature\nvar __Periph_bme688Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME688 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme688Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme688Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme688Temperature'] = function(block) {\n    \nreturn [`_periph_bme688.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme688Pressure\nvar __Periph_bme688Pressure_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME688 pressure (hPa)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme688Pressure'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme688Pressure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme688Pressure'] = function(block) {\n    \nreturn [`_periph_bme688.pressure()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme688Humidity\nvar __Periph_bme688Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME688 humidity (%)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme688Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme688Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme688Humidity'] = function(block) {\n    \nreturn [`_periph_bme688.humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bme688GasResistance\nvar __Periph_bme688GasResistance_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BME688 gas resistance (Ω)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bme688GasResistance'] = {\n    init: function() {\n        this.jsonInit(__Periph_bme688GasResistance_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bme688GasResistance'] = function(block) {\n    \nreturn [`_periph_bme688.gas_resistance()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}