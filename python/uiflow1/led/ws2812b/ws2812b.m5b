{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_ws2812bInit", "__Periph_ws2812bFill", "__Periph_ws2812bSetPixel", "__Periph_ws2812bShow", "__Periph_ws2812bOff"], "jscode": "// Block __Periph_ws2812bInit\nvar __Periph_ws2812bInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init WS2812B\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MOSI pin\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mosi\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mosi\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SCK pin\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sck\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sck\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MISO pin\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_miso\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_miso\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"pixel count\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_n\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_n\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ws2812bInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_ws2812bInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ws2812bInit'] = function(block) {\n    \n\nvar _mosi = block.getFieldValue('_mosi');\n\nvar _sck = block.getFieldValue('_sck');\n\nvar _miso = block.getFieldValue('_miso');\n\nvar _n = block.getFieldValue('_n');\nreturn `from periph.connection.neopixel_auto import NeoPixelConnection as _periph_neopixel_conn\nfrom periph.chips.led.ws2812b import WS2812BFull as _WS2812BFull\n\n_periph_ws2812b = _WS2812BFull(_periph_neopixel_conn(mosi=${_mosi}, sck=${_sck}, miso=${_miso}), ${_n})\n`\n};\n// Block __Periph_ws2812bFill\nvar __Periph_ws2812bFill_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"WS2812B fill all pixels\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"R\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_r\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_r\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"G\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_g\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_g\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"B\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_b\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_b\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ws2812bFill'] = {\n    init: function() {\n        this.jsonInit(__Periph_ws2812bFill_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ws2812bFill'] = function(block) {\n    \n\nvar _r = block.getFieldValue('_r');\n\nvar _g = block.getFieldValue('_g');\n\nvar _b = block.getFieldValue('_b');\nreturn `_periph_ws2812b.fill(${_r}, ${_g}, ${_b})\n`\n};\n// Block __Periph_ws2812bSetPixel\nvar __Periph_ws2812bSetPixel_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"WS2812B set pixel\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"index\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_index\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_index\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"R\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_r\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_r\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"G\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_g\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_g\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"B\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_b\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_b\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ws2812bSetPixel'] = {\n    init: function() {\n        this.jsonInit(__Periph_ws2812bSetPixel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ws2812bSetPixel'] = function(block) {\n    \n\nvar _index = block.getFieldValue('_index');\n\nvar _r = block.getFieldValue('_r');\n\nvar _g = block.getFieldValue('_g');\n\nvar _b = block.getFieldValue('_b');\nreturn `_periph_ws2812b.set_pixel(${_index}, ${_r}, ${_g}, ${_b})\n`\n};\n// Block __Periph_ws2812bShow\nvar __Periph_ws2812bShow_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"WS2812B show (transmit buffer)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ws2812bShow'] = {\n    init: function() {\n        this.jsonInit(__Periph_ws2812bShow_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ws2812bShow'] = function(block) {\n    \nreturn `_periph_ws2812b.show()\n`\n};\n// Block __Periph_ws2812bOff\nvar __Periph_ws2812bOff_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"WS2812B off (all pixels)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ws2812bOff'] = {\n    init: function() {\n        this.jsonInit(__Periph_ws2812bOff_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ws2812bOff'] = function(block) {\n    \nreturn `_periph_ws2812b.off()\n`\n};\n"}