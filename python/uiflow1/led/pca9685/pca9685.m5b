85Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.led.pca9685 import PCA9685Full as _PCA9685Full\n\n_periph_pca9685 = _PCA9685Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_pca9685SetDuty\nvar __Periph_pca9685SetDuty_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PCA9685 set duty\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"channel (0-15)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_channel\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_channel\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"duty (0.0-1.0)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_duty\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_duty\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pca9685SetDuty'] = {\n    init: function() {\n        this.jsonInit(__Periph_pca9685SetDuty_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pca9685SetDuty'] = function(block) {\n    \n\nvar _channel = block.getFieldValue('_channel');\n\nvar _duty = block.getFieldValue('_duty');\nreturn `_periph_pca9685.set_duty(${_channel}, ${_duty})\n`\n};\n// Block __Periph_pca9685SetPwm\nvar __Periph_pca968