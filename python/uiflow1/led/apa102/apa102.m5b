{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_apa102Init", "__Periph_apa102Fill", "__Periph_apa102SetPixel", "__Periph_apa102Show", "__Periph_apa102Off", "__Periph_apa102Brightness", "__Periph_apa102SetBrightness", "__Periph_apa102Rotate", "__Periph_apa102FillHsv"], "jscode": "// Block __Periph_apa102Init\nvar __Periph_apa102Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init APA102\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPI bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPI device\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_device\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_device\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"pixel count\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_n\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_n\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _device = block.getFieldValue('_device');\n\nvar _n = block.getFieldValue('_n');\nreturn `from periph.connection.spi_auto import SPIConnection as _periph_spi_conn\nfrom periph.chips.led.apa102 import APA102Full as _APA102Full\n\n_periph_apa102 = _APA102Full(_periph_spi_conn(bus=${_bus}, device=${_device}, polarity=0, phase=0, baudrate=1000000), ${_n})\n`\n};\n// Block __Periph_apa102Fill\nvar __Periph_apa102Fill_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 fill all pixels\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"R\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_r\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_r\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"G\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_g\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_g\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"B\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_b\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_b\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102Fill'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102Fill_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102Fill'] = function(block) {\n    \n\nvar _r = block.getFieldValue('_r');\n\nvar _g = block.getFieldValue('_g');\n\nvar _b = block.getFieldValue('_b');\nreturn `_periph_apa102.fill(${_r}, ${_g}, ${_b})\n`\n};\n// Block __Periph_apa102SetPixel\nvar __Periph_apa102SetPixel_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 set pixel\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"index\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_index\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_index\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"R\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_r\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_r\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"G\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_g\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_g\"\n        }\n    ],\n    \"message7\": \"%1\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"B\"\n        }\n    ],\n    \"message8\": \"%1 %2\",\n    \"args8\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_b\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_b\"\n        }\n    ],\n    \"message9\": \"%1\",\n    \"args9\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"hardware brightness\"\n        }\n    ],\n    \"message10\": \"%1 %2\",\n    \"args10\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_brightness\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_brightness\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102SetPixel'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102SetPixel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102SetPixel'] = function(block) {\n    \n\nvar _index = block.getFieldValue('_index');\n\nvar _r = block.getFieldValue('_r');\n\nvar _g = block.getFieldValue('_g');\n\nvar _b = block.getFieldValue('_b');\n\nvar _brightness = block.getFieldValue('_brightness');\nreturn `_periph_apa102.set_pixel(${_index}, ${_r}, ${_g}, ${_b}, ${_brightness})\n`\n};\n// Block __Periph_apa102Show\nvar __Periph_apa102Show_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 show (transmit buffer)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102Show'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102Show_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102Show'] = function(block) {\n    \nreturn `_periph_apa102.show()\n`\n};\n// Block __Periph_apa102Off\nvar __Periph_apa102Off_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 off (all pixels)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102Off'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102Off_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102Off'] = function(block) {\n    \nreturn `_periph_apa102.off()\n`\n};\n// Block __Periph_apa102Brightness\nvar __Periph_apa102Brightness_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 brightness\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102Brightness'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102Brightness_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102Brightness'] = function(block) {\n    \nvar _value = block.getFieldValue('_value');\nreturn [`${_value} = _periph_apa102.brightness`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_apa102SetBrightness\nvar __Periph_apa102SetBrightness_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 set brightness\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102SetBrightness'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102SetBrightness_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102SetBrightness'] = function(block) {\n    \n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_apa102.brightness = ${_value}\n`\n};\n// Block __Periph_apa102Rotate\nvar __Periph_apa102Rotate_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 rotate buffer\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"steps\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_steps\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_steps\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102Rotate'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102Rotate_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102Rotate'] = function(block) {\n    \n\nvar _steps = block.getFieldValue('_steps');\nreturn `_periph_apa102.rotate(${_steps})\n`\n};\n// Block __Periph_apa102FillHsv\nvar __Periph_apa102FillHsv_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"APA102 fill HSV\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"H (0–1)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_h\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_h\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"S (0–1)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_s\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_s\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"V (0–1)\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_v\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_v\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_apa102FillHsv'] = {\n    init: function() {\n        this.jsonInit(__Periph_apa102FillHsv_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_apa102FillHsv'] = function(block) {\n    \n\nvar _h = block.getFieldValue('_h');\n\nvar _s = block.getFieldValue('_s');\n\nvar _v = block.getFieldValue('_v');\nreturn `_periph_apa102.fill_hsv(${_h}, ${_s}, ${_v})\n`\n};\n"}