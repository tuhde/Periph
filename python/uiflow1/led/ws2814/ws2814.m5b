block.getFieldValue('_g');\n\nvar _b = block.getFieldValue('_b');\n\nvar _w = block.getFieldValue('_w');\nreturn `_periph_ws2814.set_pixel(${_index}, ${_r}, ${_g}, ${_b}, ${_w})\n`\n};\n// Block __Periph_ws2814Show\nvar __Periph_ws2814Show_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"WS2814 show (transmit buffer)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ws2814Show'] = {\n    init: function() {\n        this.jsonInit(__Periph_ws2814Show_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ws2814Show'] = function(block) {\n    \nreturn `_periph_ws2814.show()\n`\n};\n// Block __Periph_ws2814Off\nvar __Periph_ws2814Off_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"WS2814 off (all pixels)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ws2814Off'] = {\n    init: function() {\n        this.jsonInit(__Periph_ws2814Off_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ws2814Off'] = function(block) {\n    \nreturn `_periph_ws2814.off()\n`\n};\n"}