t16k33.wake()\n`\n};\n// Block __Periph_ht16k33SetIntOutput\nvar __Periph_ht16k33SetIntOutput_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 set INT output\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"enable (1/0)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_enable\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_enable\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"active high (1/0)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_active_high\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_active_high\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33SetIntOutput'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33SetIntOutput_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33SetIntOutput'] = function(block) {\n    \n\nvar _enable = block.getFieldValue('_enable');\n\nvar _active_high = block.getFieldValue('_active_high');\nreturn `_periph_ht16k33.set_int_output(${_enable} != 0, ${_active_high} != 0)\n`\n};\n// Block __Periph_ht16k33ReadKeys\nvar __Periph_ht16k33ReadKeys_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 read keys\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33ReadKeys'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33ReadKeys_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33ReadKeys'] = function(block) {\n    \nreturn [`_periph_ht16k33.read_keys()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ht16k33KeyPressed\nvar __Periph_ht16k33KeyPressed_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 key pressed\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33KeyPressed'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33KeyPressed_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33KeyPressed'] = function(block) {\n    \nreturn [`_periph_ht16k33.key_pressed()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ht16k33GetPixel\nvar __Periph_ht16k33GetPixel_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 get pixel\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"COM (0-7)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_com\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_com\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ROW (0-15)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_row\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_row\"\n        }\n    ]