{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_ht16k33Init", "__Periph_ht16k33Clear", "__Periph_ht16k33SetPixel", "__Periph_ht16k33Show", "__Periph_ht16k33SetBrightness", "__Periph_ht16k33DisplayOn", "__Periph_ht16k33DisplayOff", "__Periph_ht16k33SetBlink", "__Periph_ht16k33Standby", "__Periph_ht16k33Wake", "__Periph_ht16k33SetIntOutput", "__Periph_ht16k33ReadKeys", "__Periph_ht16k33KeyPressed", "__Periph_ht16k33GetPixel"], "jscode": "// Block __Periph_ht16k33Init\nvar __Periph_ht16k33Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HT16K33\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.led.ht16k33 import HT16K33Full as _HT16K33Full\n\n_periph_ht16k33 = _HT16K33Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_ht16k33Clear\nvar __Periph_ht16k33Clear_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 clear\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33Clear'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33Clear_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33Clear'] = function(block) {\n    \nreturn `_periph_ht16k33.clear()\n`\n};\n// Block __Periph_ht16k33SetPixel\nvar __Periph_ht16k33SetPixel_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 set pixel\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"COM (0-7)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_com\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_com\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ROW (0-15)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_row\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_row\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on (1/0)\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33SetPixel'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33SetPixel_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33SetPixel'] = function(block) {\n    \n\nvar _com = block.getFieldValue('_com');\n\nvar _row = block.getFieldValue('_row');\n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_ht16k33.set_pixel(${_com}, ${_row}, ${_on} != 0)\n`\n};\n// Block __Periph_ht16k33Show\nvar __Periph_ht16k33Show_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 show\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33Show'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33Show_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33Show'] = function(block) {\n    \nreturn `_periph_ht16k33.show()\n`\n};\n// Block __Periph_ht16k33SetBrightness\nvar __Periph_ht16k33SetBrightness_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 set brightness\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"level (0-15)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_level\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_level\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33SetBrightness'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33SetBrightness_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33SetBrightness'] = function(block) {\n    \n\nvar _level = block.getFieldValue('_level');\nreturn `_periph_ht16k33.set_brightness(${_level})\n`\n};\n// Block __Periph_ht16k33DisplayOn\nvar __Periph_ht16k33DisplayOn_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 display on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33DisplayOn'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33DisplayOn_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33DisplayOn'] = function(block) {\n    \nreturn `_periph_ht16k33.display_on()\n`\n};\n// Block __Periph_ht16k33DisplayOff\nvar __Periph_ht16k33DisplayOff_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 display off\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ht16k33DisplayOff'] = {\n    init: function() {\n        this.jsonInit(__Periph_ht16k33DisplayOff_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ht16k33DisplayOff'] = function(block) {\n    \nreturn `_periph_ht16k33.display_off()\n`\n};\n// Block __Periph_ht16k33SetBlink\nvar __Periph_ht16k33SetBlink_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HT16K33 set blink\"