mp102Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.temperature.tmp102 import TMP102Full as _TMP102Full\n\n_periph_tmp102 = _TMP102Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_tmp102ReadTemperature\nvar __Periph_tmp102ReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TMP102 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tmp102ReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_tmp102ReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tmp102ReadTemperature'] = function(block) {\n    \nreturn [`_periph_tmp102.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_tmp102ReadRaw\nvar __Periph_tmp102ReadRaw_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TMP102 raw count\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tmp102ReadRaw'] = {\n    init: function() {\n        this.jsonInit(__Periph_tmp102ReadRaw_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tmp102ReadRaw'] = function(block) {\n    \nreturn [`_periph_tmp102.read_raw()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_tmp102ReadConfig\nvar __Periph_tmp102ReadConfig_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TMP102 CONFIGURATION\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tmp102ReadConfig'] = {\n    init: function() {\n        this.jsonInit(__Periph_tmp102ReadConfig_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tmp102ReadConfig'] = function(block) {\n    \nreturn [`_periph_tmp102.read_config()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_tmp102WriteConfig\nvar __Periph_tmp102WriteConfig_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TMP102 write CONFIGURATION\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"value\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_value\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_value\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_tmp102WriteConfig'] = {\n    init: function() {\n        this.jsonInit(__Periph_tmp102WriteConfig_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_tmp102WriteConfig'] = function(block) {\n    \n\nvar _value = block.getFieldValue('_value');\nreturn `_periph_tmp102.write_config(${_value})\n`\n};\n// Block __Periph_tmp102SetConversionRate\nvar __Periph_tmp102SetConversionRate_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"TMP102 set conversion rate (0.25/1/4/8 Hz)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"hz\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_hz\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"