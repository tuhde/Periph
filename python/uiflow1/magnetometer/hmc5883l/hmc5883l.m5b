{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_hmc5883lInit", "__Periph_hmc5883lFieldX", "__Periph_hmc5883lFieldY", "__Periph_hmc5883lFieldZ", "__Periph_hmc5883lConfigure", "__Periph_hmc5883lSetGain", "__Periph_hmc5883lSetMode", "__Periph_hmc5883lDataReady", "__Periph_hmc5883lStatus", "__Periph_hmc5883lSingleMeasurementX", "__Periph_hmc5883lSingleMeasurementY", "__Periph_hmc5883lSingleMeasurementZ", "__Periph_hmc5883lIdentifyIdA", "__Periph_hmc5883lIdentifyIdB", "__Periph_hmc5883lIdentifyIdC", "__Periph_hmc5883lSelfTestX", "__Periph_hmc5883lSelfTestY", "__Periph_hmc5883lSelfTestZ"], "jscode": "// Block __Periph_hmc5883lInit\nvar __Periph_hmc5883lInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HMC5883L\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.magnetometer.hmc5883l import HMC5883LFull as _HMC5883LFull\n\n_periph_hmc5883l = _HMC5883LFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_hmc5883lFieldX\nvar __Periph_hmc5883lFieldX_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L magnetic field X (T)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lFieldX'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lFieldX_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lFieldX'] = function(block) {\n    \nreturn [`_periph_hmc5883l.magnetic_field()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hmc5883lFieldY\nvar __Periph_hmc5883lFieldY_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L magnetic field Y (T)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lFieldY'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lFieldY_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lFieldY'] = function(block) {\n    \nreturn [`_periph_hmc5883l.magnetic_field()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hmc5883lFieldZ\nvar __Periph_hmc5883lFieldZ_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L magnetic field Z (T)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lFieldZ'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc58