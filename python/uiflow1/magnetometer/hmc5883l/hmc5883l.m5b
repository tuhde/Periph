Value('_averaging');\n\nvar _gain = block.getFieldValue('_gain');\nreturn `_periph_hmc5883l.configure(${_odr}, ${_averaging}, ${_gain})\n`\n};\n// Block __Periph_hmc5883lSetGain\nvar __Periph_hmc5883lSetGain_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L set gain (0-7)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_gain\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_gain\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lSetGain'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lSetGain_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lSetGain'] = function(block) {\n    \nvar _gain = block.getFieldValue('_gain');\nreturn `_periph_hmc5883l.set_gain(${_gain})\n`\n};\n// Block __Periph_hmc5883lSetMode\nvar __Periph_hmc5883lSetMode_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L set mode (0=continuous, 1=single, 2=idle)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lSetMode'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lSetMode_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lSetMode'] = function(block) {\n    \nvar _mode = block.getFieldValue('_mode');\nreturn `_periph_hmc5883l.set_mode(('continuous', 'single', 'idle')[${_mode}])\n`\n};\n// Block __Periph_hmc5883lDataReady\nvar __Periph_hmc5883lDataReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L data ready?\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lDataReady'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lDataReady_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lDataReady'] = function(block) {\n    \nreturn [`_periph_hmc5883l.data_ready()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hmc5883lStatus\nvar __Periph_hmc5883lStatus_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L status register (raw)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lStatus'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lStatus_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lStatus'] = function(block) {\n    \nreturn [`_periph_hmc5883l.status()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hmc5883lSingleMeasurementX\nvar __Periph_hmc5883lSingleMeasurementX_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HMC5883L single measurement X (T)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hmc5883lSingleMeasurementX'] = {\n    init: function() {\n        this.jsonInit(__Periph_hmc5883lSingleMeasurementX_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hmc5883lSingleMeasurementX'] = function(block) {\n    \nreturn [`_periph_hmc5883l.single_measurement()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hmc5