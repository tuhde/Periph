it'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.rfid.pn532 import PN532Full as _PN532Full\n\n_periph_pn532 = _PN532Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_pn532.init()\n`\n};\n// Block __Periph_pn532ReadUid\nvar __Periph_pn532ReadUid_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PN532 card UID (hex, empty if none)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pn532ReadUid'] = {\n    init: function() {\n        this.jsonInit(__Periph_pn532ReadUid_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pn532ReadUid'] = function(block) {\n    \nreturn [`(_periph_pn532.read_uid() or b'').hex()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_pn532FirmwareVersion\nvar __Periph_pn532FirmwareVersion_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PN532 firmware version\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_pn532FirmwareVersion'] = {\n    init: function() {\n        this.jsonInit(__Periph_pn532FirmwareVersion_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_pn532FirmwareVersion'] = function(block) {\n    \nreturn [`'%d.%d' % tuple(_periph_pn532.firmware_version()[k] for k in ('version', 'revision'))`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_pn532FieldPresent\nvar __Periph_pn532FieldPresent_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"PN532 external RF field present?\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Bl