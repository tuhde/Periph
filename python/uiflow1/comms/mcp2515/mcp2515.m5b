{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mcp2515Init", "__Periph_mcp2515Send", "__Periph_mcp2515Recv", "__Periph_mcp2515SetMode", "__Periph_mcp2515SetFilter", "__Periph_mcp2515SetMask", "__Periph_mcp2515SetOneShot", "__Periph_mcp2515ReadErrors", "__Periph_mcp2515Reset"], "jscode": "// Block __Periph_mcp2515Init\nvar __Periph_mcp2515Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MCP2515 (SPI bus, CS pin)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs_pin\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"bitrate (kbit/s)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bitrate_kbps\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bitrate_kbps\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515Init'] = function(block) {\n    \nvar _bus = block.getFieldValue('_bus');\nvar _cs_pin = block.getFieldValue('_cs_pin');\n\nvar _bitrate_kbps = block.getFieldValue('_bitrate_kbps');\nreturn `from periph.connection.spi_auto import SPIConnection as _periph_spi_conn\nfrom periph.chips.comms.mcp2515 import MCP2515Full as _MCP2515Full\n\n_periph_mcp2515 = _MCP2515Full(_periph_spi_conn(bus=${_bus}, cs_pin=${_cs_pin}),\n                               bitrate_kbps=int(${_bitrate_kbps}))\n`\n};\n// Block __Periph_mcp2515Send\nvar __Periph_mcp2515Send_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 send (id hex, data hex, extended 1/0)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_id\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_id\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_data\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_data\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_extended\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_extended\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515Send'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515Send_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515Send'] = function(block) {\n    \nvar _id = Blockly.Python.valueToCode(block, '_id', Blockly.Python.ORDER_NONE);\nvar _data = Blockly.Python.valueToCode(block, '_data', Blockly.Python.ORDER_NONE);\nvar _extended = Blockly.Python.valueToCode(block, '_extended', Blockly.Python.ORDER_NONE);\nreturn `_periph_mcp2515.send(int(${_id}), bytes.fromhex(${_data}), extended=bool(${_extended}))\n`\n};\n// Block __Periph_mcp2515Recv\nvar __Periph_mcp2515Recv_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 receive (hex string 'id,extended,data' or empty), timeout (ms)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_timeout_ms\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_timeout_ms\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515Recv'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515Recv_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515Recv'] = function(block) {\n    \nvar _timeout_ms = block.getFieldValue('_timeout_ms');\nreturn [`_frame = _periph_mcp2515.recv(int(${_timeout_ms}))\nif _frame is None:\n    ''\nelse:\n    '%X,%d,%s' % (_frame.id, 1 if _frame.extended else 0, _frame.data.hex())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mcp2515SetMode\nvar __Periph_mcp2515SetMode_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 set mode (normal/loopback/listen_only/sleep/config)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mode\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515SetMode'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515SetMode_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515SetMode'] = function(block) {\n    \nvar _mode = Blockly.Python.valueToCode(block, '_mode', Blockly.Python.ORDER_NONE);\nreturn `_periph_mcp2515.set_mode(${_mode})\n`\n};\n// Block __Periph_mcp2515SetFilter\nvar __Periph_mcp2515SetFilter_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 set filter (0-5, id, extended 1/0)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_filter_num\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_filter_num\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_id\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_id\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_extended\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_extended\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515SetFilter'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515SetFilter_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515SetFilter'] = function(block) {\n    \nvar _filter_num = block.getFieldValue('_filter_num');\nvar _id = Blockly.Python.valueToCode(block, '_id', Blockly.Python.ORDER_NONE);\nvar _extended = Blockly.Python.valueToCode(block, '_extended', Blockly.Python.ORDER_NONE);\nreturn `_periph_mcp2515.set_filter(int(${_filter_num}), int(${_id}), extended=bool(${_extended}))\n`\n};\n// Block __Periph_mcp2515SetMask\nvar __Periph_mcp2515SetMask_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 set mask (0/1, mask, extended 1/0)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mask_num\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mask_num\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mask\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_mask\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_extended\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_extended\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515SetMask'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515SetMask_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515SetMask'] = function(block) {\n    \nvar _mask_num = block.getFieldValue('_mask_num');\nvar _mask = Blockly.Python.valueToCode(block, '_mask', Blockly.Python.ORDER_NONE);\nvar _extended = Blockly.Python.valueToCode(block, '_extended', Blockly.Python.ORDER_NONE);\nreturn `_periph_mcp2515.set_mask(int(${_mask_num}), int(${_mask}), extended=bool(${_extended}))\n`\n};\n// Block __Periph_mcp2515SetOneShot\nvar __Periph_mcp2515SetOneShot_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 set one-shot mode (1/0)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_enable\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_enable\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515SetOneShot'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515SetOneShot_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515SetOneShot'] = function(block) {\n    \nvar _enable = Blockly.Python.valueToCode(block, '_enable', Blockly.Python.ORDER_NONE);\nreturn `_periph_mcp2515.set_one_shot(bool(${_enable}))\n`\n};\n// Block __Periph_mcp2515ReadErrors\nvar __Periph_mcp2515ReadErrors_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 read errors (TEC, REC, EFLG)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515ReadErrors'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515ReadErrors_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515ReadErrors'] = function(block) {\n    \nreturn [`_errs = _periph_mcp2515.read_errors()\n'%d,%d,%02X' % (_errs['tec'], _errs['rec'], _errs['eflg'])`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mcp2515Reset\nvar __Periph_mcp2515Reset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MCP2515 reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mcp2515Reset'] = {\n    init: function() {\n        this.jsonInit(__Periph_mcp2515Reset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mcp2515Reset'] = function(block) {\n    \nreturn `_periph_mcp2515.reset()\n`\n};\n"}