{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_rfm9xInit", "__Periph_rfm9xSend", "__Periph_rfm9xReceive", "__Periph_rfm9xConfigure", "__Periph_rfm9xSetTxPower", "__Periph_rfm9xLastPacketRssi", "__Periph_rfm9xLastPacketSnr", "__Periph_rfm9xSleep"], "jscode": "// Block __Periph_rfm9xInit\nvar __Periph_rfm9xInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init RFM95W (LoRa)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SPI bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CS pin\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_cs_pin\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_cs_pin\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"frequency (Hz)\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_frequency_hz\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_frequency_hz\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_rfm9xInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_rfm9xInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_rfm9xInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _cs_pin = block.getFieldValue('_cs_pin');\n\nvar _frequency_hz = block.getFieldValue('_frequency_hz');\nreturn `from periph.connection.spi_auto import SPIConnection as _periph_spi_conn\nfrom periph.chips.comms.rfm9x import RFM95Full as _RFM95Full\n\n_periph_rfm9x = _RFM95Full(_periph_spi_conn(bus=${_bus}, cs_pin=${_cs_pin}),\n                            frequency_hz=${_frequency_hz})\n`\n};\n// Block __Periph_rfm9xSend\nvar __Periph_rfm9xSend_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RFM95W send packet\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_data\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_data\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_rfm9xSend'] = {\n    init: function() {\n        this.jsonInit(__Periph_rfm9xSend_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_rfm9xSend'] = function(block) {\n    \nvar _data = Blockly.Python.valueToCode(block, '_data', Blockly.Python.ORDER_NONE);\nreturn `_periph_rfm9x.send(${_data}.encode())\n`\n};\n// Block __Periph_rfm9xReceive\nvar __Periph_rfm9xReceive_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RFM95W receive packet (hex, empty if none), timeout (ms)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_timeout_ms\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_timeout_ms\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_rfm9xReceive'] = {\n    init: function() {\n        this.jsonInit(__Periph_rfm9xReceive_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_rfm9xReceive'] = function(block) {\n    \nvar _timeout_ms = block.getFieldValue('_timeout_ms');\nreturn [`(_periph_rfm9x.receive(timeout_ms=${_timeout_ms}) or b'').hex()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_rfm9xConfigure\nvar __Periph_rfm9xConfigure_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RFM95W configure LoRa: spreading factor\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_sf\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_sf\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"bandwidth (kHz)\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bandwidth_khz\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bandwidth_khz\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"coding rate denominator\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_coding_rate\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_coding_rate\"\n        }\n    ],\n    \"message6\": \"%1\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CRC enabled?\"\n        }\n    ],\n    \"message7\": \"%1 %2\",\n    \"args7\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_crc\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_crc\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_rfm9xConfigure'] = {\n    init: function() {\n        this.jsonInit(__Periph_rfm9xConfigure_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_rfm9xConfigure'] = function(block) {\n    \nvar _sf = block.getFieldValue('_sf');\n\nvar _bandwidth_khz = block.getFieldValue('_bandwidth_khz');\n\nvar _coding_rate = block.getFieldValue('_coding_rate');\n\nvar _crc = Blockly.Python.valueToCode(block, '_crc', Blockly.Python.ORDER_NONE);\nreturn `_periph_rfm9x.configure(${_sf}, ${_bandwidth_khz}, ${_coding_rate}, crc=${_crc})\n`\n};\n// Block __Periph_rfm9xSetTxPower\nvar __Periph_rfm9xSetTxPower_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"RFM95W set TX power (dBm)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_power_dbm\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_power_dbm\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"use PA_BOOST?\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_use_pa_boost\"\n        },\n        {\n            \"type\": \"input_value\",\n            \"name\": \"_use_pa_boost\"\n        }\n    ],\n    \"colour\": \"#C084FC