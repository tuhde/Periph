{"category": "Periph", "color": "#a6bbcf", "blocks": ["__Periph_ens160Init", "__Periph_ens160ReadAqi", "__Periph_ens160ReadTvoc", "__Periph_ens160ReadEco2"], "jscode": "// Block __Periph_ens160Init\nvar __Periph_ens160Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init ENS160\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ens160Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ens160Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ens160Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.gas.ens160 import ENS160Full as _ENS160Full\n\n_periph_ens160 = _ENS160Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_ens160ReadAqi\nvar __Periph_ens160ReadAqi_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ENS160 AQI (1-5)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ens160ReadAqi'] = {\n    init: function() {\n        this.jsonInit(__Periph_ens160ReadAqi_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ens160ReadAqi'] = function(block) {\n    \nreturn [`_periph_ens160.read_aqi()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ens160ReadTvoc\nvar __Periph_ens160ReadTvoc_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ENS160 TVOC (ppb)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ens160ReadTvoc'] = {\n    init: function() {\n        this.jsonInit(__Periph_ens160ReadTvoc_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ens160ReadTvoc'] = function(block) {\n    \nreturn [`_periph_ens160.read_tvoc()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ens160ReadEco2\nvar __Periph_ens160ReadEco2_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ENS160 eCO2 (ppm)\"\n        }\n    ],\n    \"colour\": \"#a6bbcf\"\n};\nwindow['Blockly'].Blocks['__Periph_ens160ReadEco2'] = {\n    init: function() {\n        this.jsonInit(__Periph_ens160ReadEco2_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ens160ReadEco2'] = function(block) {\n    \nreturn [`_periph_ens160.read_eco2()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n"}