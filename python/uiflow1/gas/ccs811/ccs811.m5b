{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_ccs811Init", "__Periph_ccs811ReadEco2", "__Periph_ccs811ReadTvoc", "__Periph_ccs811DataReady", "__Periph_ccs811SetMode", "__Periph_ccs811SetEnvironment", "__Periph_ccs811SetThresholds", "__Periph_ccs811GetBaseline", "__Periph_ccs811SetBaseline", "__Periph_ccs811Status", "__Periph_ccs811Error", "__Periph_ccs811SoftReset"], "jscode": "// Block __Periph_ccs811Init\nvar __Periph_ccs811Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init CCS811\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.gas.ccs811 import CCS811Full as _CCS811Full\n\n_periph_ccs811 = _CCS811Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_ccs811.init()\n`\n};\n// Block __Periph_ccs811ReadEco2\nvar __Periph_ccs811ReadEco2_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 eCO2 (ppm)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811ReadEco2'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811ReadEco2_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811ReadEco2'] = function(block) {\n    \nreturn [`_periph_ccs811.read_eco2()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ccs811ReadTvoc\nvar __Periph_ccs811ReadTvoc_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 TVOC (ppb)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811ReadTvoc'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811ReadTvoc_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811ReadTvoc'] = function(block) {\n    \nreturn [`_periph_ccs811.read_tvoc()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ccs811DataReady\nvar __Periph_ccs811DataReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 data ready\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811DataReady'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811DataReady_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811DataReady'] = function(block) {\n    \nreturn [`_periph_ccs811.data_ready()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ccs811SetMode\nvar __Periph_ccs811SetMode_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 drive mode (0-4)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811SetMode'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811SetMode_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811SetMode'] = function(block) {\n    \nvar _mode = block.getFieldValue('_mode');\nreturn `_periph_ccs811.set_mode(int(${_mode}))\n`\n};\n// Block __Periph_ccs811SetEnvironment\nvar __Periph_ccs811SetEnvironment_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 environment humidity (%RH)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_humidity\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_humidity\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"temperature (°C)\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_temperature\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_temperature\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811SetEnvironment'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811SetEnvironment_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811SetEnvironment'] = function(block) {\n    \nvar _humidity = block.getFieldValue('_humidity');\n\nvar _temperature = block.getFieldValue('_temperature');\nreturn `_periph_ccs811.set_environment(float(${_humidity}), float(${_temperature}))\n`\n};\n// Block __Periph_ccs811SetThresholds\nvar __Periph_ccs811SetThresholds_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 thresholds low/medium (ppm)\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_low_medium\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_low_medium\"\n        }\n    ],\n    \"message2\": \"%1\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"medium/high (ppm)\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_medium_high\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_medium_high\"\n        }\n    ],\n    \"message4\": \"%1\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"hysteresis (ppm)\"\n        }\n    ],\n    \"message5\": \"%1 %2\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_hysteresis\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_hysteresis\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811SetThresholds'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811SetThresholds_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811SetThresholds'] = function(block) {\n    \nvar _low_medium = block.getFieldValue('_low_medium');\n\nvar _medium_high = block.getFieldValue('_medium_high');\n\nvar _hysteresis = block.getFieldValue('_hysteresis');\nreturn `_periph_ccs811.set_thresholds(int(${_low_medium}), int(${_medium_high}), int(${_hysteresis}))\n`\n};\n// Block __Periph_ccs811GetBaseline\nvar __Periph_ccs811GetBaseline_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 baseline\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811GetBaseline'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811GetBaseline_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811GetBaseline'] = function(block) {\n    \nreturn [`_periph_ccs811.get_baseline()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ccs811SetBaseline\nvar __Periph_ccs811SetBaseline_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 set baseline\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_baseline\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_baseline\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811SetBaseline'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811SetBaseline_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811SetBaseline'] = function(block) {\n    \nvar _baseline = block.getFieldValue('_baseline');\nreturn `_periph_ccs811.set_baseline(int(${_baseline}))\n`\n};\n// Block __Periph_ccs811Status\nvar __Periph_ccs811Status_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 status\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811Status'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811Status_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811Status'] = function(block) {\n    \nreturn [`_periph_ccs811.status()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ccs811Error\nvar __Periph_ccs811Error_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 error ID\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811Error'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811Error_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811Error'] = function(block) {\n    \nreturn [`_periph_ccs811.error()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_ccs811SoftReset\nvar __Periph_ccs811SoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"CCS811 soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_ccs811SoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_ccs811SoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_ccs811SoftReset'] = function(block) {\n    \nreturn `_periph_ccs811.soft_reset()\n`\n};\n"}