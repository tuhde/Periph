{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_hs30xxInit", "__Periph_hs30xxTemperature", "__Periph_hs30xxHumidity", "__Periph_hs30xxDewPoint", "__Periph_hs30xxRawHumidity", "__Periph_hs30xxRawTemperature", "__Periph_hs30xxSetWait"], "jscode": "// Block __Periph_hs30xxInit\nvar __Periph_hs30xxInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HS30xx\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs30xxInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs30xxInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs30xxInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.hs30xx import HS30xxFull as _HS30xxFull\n\n_periph_hs30xx = _HS30xxFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_hs30xxTemperature\nvar __Periph_hs30xxTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS30xx temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs30xxTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs30xxTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs30xxTemperature'] = function(block) {\n    \nreturn [`_periph_hs30xx.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs30xxHumidity\nvar __Periph_hs30xxHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS30xx relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs30xxHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs30xxHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs30xxHumidity'] = function(block) {\n    \nreturn [`_periph_hs30xx.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs30xxDewPoint\nvar __Periph_hs30xxDewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS30xx dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs30xxDewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs30xxDewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs30xxDewPoint'] = function(block) {\n    \nreturn [`_periph_hs30xx.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs30xxRawHumidity\nvar __Periph_hs30xxRawHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS30xx raw humidity (14 bit)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs30xxRawHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs30xxRawHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs30xxRawHumidity'] = function(block) {\n    \nreturn [`_periph_hs30xx.read_raw()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs30xxRawTemperature\nvar __Periph_hs30xxRawTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS30xx raw temperature (14 bit)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs30xxRawTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs30xxRawTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs30xxRawTemperature'] = function(block) {\n    \nreturn [`_periph_hs30xx.read_raw()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs30xxSetWait\nvar __Periph_hs30xxSetWait_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS30xx measurement wait (ms)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"ms\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_ms\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_ms\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs30xxSetWait'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs30xxSetWait_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs30xxSetWait'] = function(block) {\n    \n\nvar _ms = block.getFieldValue('_ms');\nreturn `_periph_hs30xx.set_measurement_wait(float(${_ms}))\n`\n};\n"}