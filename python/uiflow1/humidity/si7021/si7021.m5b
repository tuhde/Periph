{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_si7021Init", "__Periph_si7021Temperature", "__Periph_si7021Humidity", "__Periph_si7021DewPoint", "__Periph_si7021SetResolution", "__Periph_si7021SetHeater", "__Periph_si7021HeaterOn", "__Periph_si7021VddLow", "__Periph_si7021DeviceType", "__Periph_si7021FirmwareRevision", "__Periph_si7021SoftReset"], "jscode": "// Block __Periph_si7021Init\nvar __Periph_si7021Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init Si7021\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.si7021 import Si7021Full as _Si7021Full\n\n_periph_si7021 = _Si7021Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_si7021Temperature\nvar __Periph_si7021Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021Temperature'] = function(block) {\n    \nreturn [`_periph_si7021.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si7021Humidity\nvar __Periph_si7021Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021Humidity'] = function(block) {\n    \nreturn [`_periph_si7021.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si7021DewPoint\nvar __Periph_si7021DewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021DewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021DewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021DewPoint'] = function(block) {\n    \nreturn [`_periph_si7021.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si7021SetResolution\nvar __Periph_si7021SetResolution_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 resolution (0=12/14 1=8/12 2=10/13 3=11/11 bit RH/T)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"level\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_level\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_level\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021SetResolution'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021SetResolution_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021SetResolution'] = function(block) {\n    \n\nvar _level = block.getFieldValue('_level');\nreturn `_periph_si7021.set_resolution(*[(12, 14), (8, 12), (10, 13), (11, 11)][int(${_level})])\n`\n};\n// Block __Periph_si7021SetHeater\nvar __Periph_si7021SetHeater_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 heater (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021SetHeater'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021SetHeater_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021SetHeater'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_si7021.set_heater(bool(int(${_on})))\n`\n};\n// Block __Periph_si7021HeaterOn\nvar __Periph_si7021HeaterOn_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 heater on (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021HeaterOn'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021HeaterOn_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021HeaterOn'] = function(block) {\n    \nreturn [`int(_periph_si7021.is_heater_on())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si7021VddLow\nvar __Periph_si7021VddLow_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 supply low (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021VddLow'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021VddLow_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021VddLow'] = function(block) {\n    \nreturn [`int(_periph_si7021.vdd_low())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si7021DeviceType\nvar __Periph_si7021DeviceType_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 device type (0x15 = Si7021)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021DeviceType'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021DeviceType_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021DeviceType'] = function(block) {\n    \nreturn [`_periph_si7021.device_type()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si7021FirmwareRevision\nvar __Periph_si7021FirmwareRevision_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 firmware revision\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021FirmwareRevision'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021FirmwareRevision_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021FirmwareRevision'] = function(block) {\n    \nreturn [`_periph_si7021.firmware_revision()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si7021SoftReset\nvar __Periph_si7021SoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si7021 soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si7021SoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_si7021SoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si7021SoftReset'] = function(block) {\n    \nreturn `_periph_si7021.software_reset()\n`\n};\n"}