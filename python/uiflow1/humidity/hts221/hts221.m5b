{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_hts221Init", "__Periph_hts221Temperature", "__Periph_hts221Humidity", "__Periph_hts221DewPoint", "__Periph_hts221WhoAmI", "__Periph_hts221DataReady", "__Periph_hts221SetOutputDataRate", "__Periph_hts221SetAveraging", "__Periph_hts221SetHeater", "__Periph_hts221HeaterOn", "__Periph_hts221PowerDown", "__Periph_hts221PowerUp", "__Periph_hts221Reboot"], "jscode": "// Block __Periph_hts221Init\nvar __Periph_hts221Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HTS221\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.hts221 import HTS221Full as _HTS221Full\n\n_periph_hts221 = _HTS221Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_hts221Temperature\nvar __Periph_hts221Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221Temperature'] = function(block) {\n    \nreturn [`_periph_hts221.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hts221Humidity\nvar __Periph_hts221Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 relative humidity (%rH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221Humidity'] = function(block) {\n    \nreturn [`_periph_hts221.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hts221DewPoint\nvar __Periph_hts221DewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221DewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221DewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221DewPoint'] = function(block) {\n    \nreturn [`_periph_hts221.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hts221WhoAmI\nvar __Periph_hts221WhoAmI_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 WHO_AM_I\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221WhoAmI'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221WhoAmI_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221WhoAmI'] = function(block) {\n    \nreturn [`_periph_hts221.who_am_i()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hts221DataReady\nvar __Periph_hts221DataReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 data ready (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221DataReady'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221DataReady_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221DataReady'] = function(block) {\n    \nreturn [`int(_periph_hts221.data_ready())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hts221SetOutputDataRate\nvar __Periph_hts221SetOutputDataRate_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 output data rate (0, 1, 7 or 12.5 Hz)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Hz\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_hz\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_hz\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221SetOutputDataRate'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221SetOutputDataRate_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221SetOutputDataRate'] = function(block) {\n    \n\nvar _hz = block.getFieldValue('_hz');\nreturn `_periph_hts221.set_output_data_rate(float(${_hz}))\n`\n};\n// Block __Periph_hts221SetAveraging\nvar __Periph_hts221SetAveraging_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 averaging (T 2-256, RH 4-512 samples)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"temperature samples\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_tsamples\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_tsamples\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"humidity samples\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_hsamples\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_hsamples\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221SetAveraging'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221SetAveraging_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221SetAveraging'] = function(block) {\n    \n\nvar _tsamples = block.getFieldValue('_tsamples');\n\nvar _hsamples = block.getFieldValue('_hsamples');\nreturn `_periph_hts221.set_averaging(int(${_tsamples}), int(${_hsamples}))\n`\n};\n// Block __Periph_hts221SetHeater\nvar __Periph_hts221SetHeater_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 heater (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221SetHeater'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221SetHeater_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221SetHeater'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_hts221.set_heater(bool(int(${_on})))\n`\n};\n// Block __Periph_hts221HeaterOn\nvar __Periph_hts221HeaterOn_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 heater on (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221HeaterOn'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221HeaterOn_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221HeaterOn'] = function(block) {\n    \nreturn [`int(_periph_hts221.is_heater_on())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hts221PowerDown\nvar __Periph_hts221PowerDown_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 power down\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221PowerDown'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221PowerDown_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221PowerDown'] = function(block) {\n    \nreturn `_periph_hts221.power_down()\n`\n};\n// Block __Periph_hts221PowerUp\nvar __Periph_hts221PowerUp_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 power up\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221PowerUp'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221PowerUp_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221PowerUp'] = function(block) {\n    \nreturn `_periph_hts221.power_up()\n`\n};\n// Block __Periph_hts221Reboot\nvar __Periph_hts221Reboot_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTS221 reload calibration (reboot)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hts221Reboot'] = {\n    init: function() {\n        this.jsonInit(__Periph_hts221Reboot_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hts221Reboot'] = function(block) {\n    \nreturn `_periph_hts221.reboot()\n`\n};\n"}