{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_hs40xxInit", "__Periph_hs40xxTemperature", "__Periph_hs40xxHumidity", "__Periph_hs40xxDewPoint", "__Periph_hs40xxRawHumidity", "__Periph_hs40xxRawTemperature", "__Periph_hs40xxSensorId", "__Periph_hs40xxSetResolution", "__Periph_hs40xxStartPeriodic", "__Periph_hs40xxStopPeriodic", "__Periph_hs40xxPeriodicHumidity", "__Periph_hs40xxPeriodicTemperature", "__Periph_hs40xxSoftReset"], "jscode": "// Block __Periph_hs40xxInit\nvar __Periph_hs40xxInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HS40xx\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.hs40xx import HS40xxFull as _HS40xxFull\n\n_periph_hs40xx = _HS40xxFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_hs40xxTemperature\nvar __Periph_hs40xxTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxTemperature'] = function(block) {\n    \nreturn [`_periph_hs40xx.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxHumidity\nvar __Periph_hs40xxHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxHumidity'] = function(block) {\n    \nreturn [`_periph_hs40xx.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxDewPoint\nvar __Periph_hs40xxDewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxDewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxDewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxDewPoint'] = function(block) {\n    \nreturn [`_periph_hs40xx.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxRawHumidity\nvar __Periph_hs40xxRawHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx raw humidity (14 bit)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxRawHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxRawHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxRawHumidity'] = function(block) {\n    \nreturn [`_periph_hs40xx.read_raw()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxRawTemperature\nvar __Periph_hs40xxRawTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx raw temperature (14 bit)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxRawTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxRawTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxRawTemperature'] = function(block) {\n    \nreturn [`_periph_hs40xx.read_raw()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxSensorId\nvar __Periph_hs40xxSensorId_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx sensor ID\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxSensorId'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxSensorId_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxSensorId'] = function(block) {\n    \nreturn [`_periph_hs40xx.read_id()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxSetResolution\nvar __Periph_hs40xxSetResolution_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx resolution (bits, 8/10/12/14)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"humidity\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_humidity_bits\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_humidity_bits\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"temperature\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_temperature_bits\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_temperature_bits\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxSetResolution'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxSetResolution_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxSetResolution'] = function(block) {\n    \n\nvar _humidity_bits = block.getFieldValue('_humidity_bits');\n\nvar _temperature_bits = block.getFieldValue('_temperature_bits');\nreturn `_periph_hs40xx.set_resolution(int(${_humidity_bits}), int(${_temperature_bits}))\n`\n};\n// Block __Periph_hs40xxStartPeriodic\nvar __Periph_hs40xxStartPeriodic_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx start periodic mode (period s: 0.5, 1 or 2.5)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"period\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_period\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_period\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxStartPeriodic'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxStartPeriodic_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxStartPeriodic'] = function(block) {\n    \n\nvar _period = block.getFieldValue('_period');\nreturn `_periph_hs40xx.start_periodic(float(${_period}))\n`\n};\n// Block __Periph_hs40xxStopPeriodic\nvar __Periph_hs40xxStopPeriodic_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx stop periodic mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxStopPeriodic'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxStopPeriodic_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxStopPeriodic'] = function(block) {\n    \nreturn `_periph_hs40xx.stop_periodic()\n`\n};\n// Block __Periph_hs40xxPeriodicHumidity\nvar __Periph_hs40xxPeriodicHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx periodic relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxPeriodicHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxPeriodicHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxPeriodicHumidity'] = function(block) {\n    \nreturn [`_periph_hs40xx.read_periodic()['humidity_pct']`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxPeriodicTemperature\nvar __Periph_hs40xxPeriodicTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx periodic temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxPeriodicTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxPeriodicTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxPeriodicTemperature'] = function(block) {\n    \nreturn [`_periph_hs40xx.read_periodic()['temperature_c']`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hs40xxSoftReset\nvar __Periph_hs40xxSoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HS40xx soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hs40xxSoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_hs40xxSoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hs40xxSoftReset'] = function(block) {\n    \nreturn `_periph_hs40xx.soft_reset()\n`\n};\n"}