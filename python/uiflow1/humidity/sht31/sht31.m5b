{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_sht31Init", "__Periph_sht31Temperature", "__Periph_sht31Humidity", "__Periph_sht31DewPoint", "__Periph_sht31SetRepeatability", "__Periph_sht31SetHeater", "__Periph_sht31Status", "__Periph_sht31ClearStatus", "__Periph_sht31StartPeriodic", "__Periph_sht31StopPeriodic", "__Periph_sht31FetchTemperature", "__Periph_sht31SoftReset"], "jscode": "// Block __Periph_sht31Init\nvar __Periph_sht31Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init SHT31\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.sht31 import SHT31Full as _SHT31Full\n\n_periph_sht31 = _SHT31Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_sht31Temperature\nvar __Periph_sht31Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31Temperature'] = function(block) {\n    \nreturn [`_periph_sht31.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sht31Humidity\nvar __Periph_sht31Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31Humidity'] = function(block) {\n    \nreturn [`_periph_sht31.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sht31DewPoint\nvar __Periph_sht31DewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31DewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31DewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31DewPoint'] = function(block) {\n    \nreturn [`_periph_sht31.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sht31SetRepeatability\nvar __Periph_sht31SetRepeatability_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 repeatability (0=low 1=medium 2=high)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"level\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_level\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_level\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31SetRepeatability'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31SetRepeatability_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31SetRepeatability'] = function(block) {\n    \n\nvar _level = block.getFieldValue('_level');\nreturn `_periph_sht31.set_repeatability(['low', 'medium', 'high'][int(${_level})])\n`\n};\n// Block __Periph_sht31SetHeater\nvar __Periph_sht31SetHeater_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 heater (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31SetHeater'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31SetHeater_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31SetHeater'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_sht31.set_heater(bool(int(${_on})))\n`\n};\n// Block __Periph_sht31Status\nvar __Periph_sht31Status_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 status register\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31Status'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31Status_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31Status'] = function(block) {\n    \nreturn [`_periph_sht31.read_status()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sht31ClearStatus\nvar __Periph_sht31ClearStatus_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 clear status\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31ClearStatus'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31ClearStatus_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31ClearStatus'] = function(block) {\n    \nreturn `_periph_sht31.clear_status()\n`\n};\n// Block __Periph_sht31StartPeriodic\nvar __Periph_sht31StartPeriodic_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 start periodic mode, rate in tenths of mps (5, 10, 20, 40, 100)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"rate\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_rate\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_rate\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31StartPeriodic'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31StartPeriodic_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31StartPeriodic'] = function(block) {\n    \n\nvar _rate = block.getFieldValue('_rate');\nreturn `_periph_sht31.start_periodic(int(${_rate}) / 10.0)\n`\n};\n// Block __Periph_sht31StopPeriodic\nvar __Periph_sht31StopPeriodic_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 stop periodic mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31StopPeriodic'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31StopPeriodic_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31StopPeriodic'] = function(block) {\n    \nreturn `_periph_sht31.stop_periodic()\n`\n};\n// Block __Periph_sht31FetchTemperature\nvar __Periph_sht31FetchTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 periodic temperature (°C, -999 if no data)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31FetchTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31FetchTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31FetchTemperature'] = function(block) {\n    \nreturn [`(lambda r: r[0] if r else -999.0)(_periph_sht31.fetch())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_sht31SoftReset\nvar __Periph_sht31SoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHT31 soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_sht31SoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_sht31SoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_sht31SoftReset'] = function(block) {\n    \nreturn `_periph_sht31.soft_reset()\n`\n};\n"}