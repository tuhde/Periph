{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_htu31dInit", "__Periph_htu31dTemperature", "__Periph_htu31dHumidity", "__Periph_htu31dDewPoint", "__Periph_htu31dSerialNumber", "__Periph_htu31dDiagnostic", "__Periph_htu31dSetResolution", "__Periph_htu31dSetHeater", "__Periph_htu31dHeaterOn", "__Periph_htu31dSoftwareReset"], "jscode": "// Block __Periph_htu31dInit\nvar __Periph_htu31dInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HTU31D\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.htu31d import HTU31DFull as _HTU31DFull\n\n_periph_htu31d = _HTU31DFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_htu31d.init()\n`\n};\n// Block __Periph_htu31dTemperature\nvar __Periph_htu31dTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dTemperature'] = function(block) {\n    \nreturn [`_periph_htu31d.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu31dHumidity\nvar __Periph_htu31dHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dHumidity'] = function(block) {\n    \nreturn [`_periph_htu31d.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu31dDewPoint\nvar __Periph_htu31dDewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dDewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dDewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dDewPoint'] = function(block) {\n    \nreturn [`_periph_htu31d.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu31dSerialNumber\nvar __Periph_htu31dSerialNumber_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D serial number\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dSerialNumber'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dSerialNumber_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dSerialNumber'] = function(block) {\n    \nreturn [`_periph_htu31d.serial_number()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu31dDiagnostic\nvar __Periph_htu31dDiagnostic_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D diagnostic byte\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dDiagnostic'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dDiagnostic_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dDiagnostic'] = function(block) {\n    \nreturn [`_periph_htu31d.diagnostic()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu31dSetResolution\nvar __Periph_htu31dSetResolution_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D oversampling (0-3)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"humidity OSR\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_osr_rh\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_osr_rh\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"temperature OSR\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_osr_t\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_osr_t\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dSetResolution'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dSetResolution_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dSetResolution'] = function(block) {\n    \n\nvar _osr_rh = block.getFieldValue('_osr_rh');\n\nvar _osr_t = block.getFieldValue('_osr_t');\nreturn `_periph_htu31d.set_resolution(int(${_osr_rh}), int(${_osr_t}))\n`\n};\n// Block __Periph_htu31dSetHeater\nvar __Periph_htu31dSetHeater_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D heater (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dSetHeater'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dSetHeater_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dSetHeater'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_htu31d.set_heater(bool(int(${_on})))\n`\n};\n// Block __Periph_htu31dHeaterOn\nvar __Periph_htu31dHeaterOn_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D heater on (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dHeaterOn'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dHeaterOn_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dHeaterOn'] = function(block) {\n    \nreturn [`int(_periph_htu31d.is_heater_on())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu31dSoftwareReset\nvar __Periph_htu31dSoftwareReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU31D software reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu31dSoftwareReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu31dSoftwareReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu31dSoftwareReset'] = function(block) {\n    \nreturn `_periph_htu31d.software_reset()\n`\n};\n"}