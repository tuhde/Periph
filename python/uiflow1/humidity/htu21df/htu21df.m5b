{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_htu21dfInit", "__Periph_htu21dfTemperature", "__Periph_htu21dfHumidity", "__Periph_htu21dfHumidityCompensated", "__Periph_htu21dfDewPoint", "__Periph_htu21dfSetResolution", "__Periph_htu21dfSetHeater", "__Periph_htu21dfHeaterOn", "__Periph_htu21dfBatteryLow", "__Periph_htu21dfSoftReset"], "jscode": "// Block __Periph_htu21dfInit\nvar __Periph_htu21dfInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HTU21D-F\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.htu21df import HTU21DFFull as _HTU21DFFull\n\n_periph_htu21df = _HTU21DFFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_htu21df.init()\n`\n};\n// Block __Periph_htu21dfTemperature\nvar __Periph_htu21dfTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfTemperature'] = function(block) {\n    \nreturn [`_periph_htu21df.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu21dfHumidity\nvar __Periph_htu21dfHumidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfHumidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfHumidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfHumidity'] = function(block) {\n    \nreturn [`_periph_htu21df.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu21dfHumidityCompensated\nvar __Periph_htu21dfHumidityCompensated_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F compensated humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfHumidityCompensated'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfHumidityCompensated_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfHumidityCompensated'] = function(block) {\n    \nreturn [`_periph_htu21df.read_humidity_compensated()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu21dfDewPoint\nvar __Periph_htu21dfDewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfDewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfDewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfDewPoint'] = function(block) {\n    \nreturn [`_periph_htu21df.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu21dfSetResolution\nvar __Periph_htu21dfSetResolution_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F resolution (0=12/14 1=8/12 2=10/13 3=11/11 bit RH/T)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"level\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_level\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_level\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfSetResolution'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfSetResolution_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfSetResolution'] = function(block) {\n    \n\nvar _level = block.getFieldValue('_level');\nreturn `_periph_htu21df.set_resolution(int(${_level}))\n`\n};\n// Block __Periph_htu21dfSetHeater\nvar __Periph_htu21dfSetHeater_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F heater (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfSetHeater'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfSetHeater_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfSetHeater'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_htu21df.set_heater(bool(int(${_on})))\n`\n};\n// Block __Periph_htu21dfHeaterOn\nvar __Periph_htu21dfHeaterOn_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F heater on (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfHeaterOn'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfHeaterOn_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfHeaterOn'] = function(block) {\n    \nreturn [`int(_periph_htu21df.heater())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu21dfBatteryLow\nvar __Periph_htu21dfBatteryLow_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F battery low (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfBatteryLow'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfBatteryLow_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfBatteryLow'] = function(block) {\n    \nreturn [`int(_periph_htu21df.battery_low())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_htu21dfSoftReset\nvar __Periph_htu21dfSoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HTU21D-F soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_htu21dfSoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_htu21dfSoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_htu21dfSoftReset'] = function(block) {\n    \nreturn `_periph_htu21df.soft_reset()\n`\n};\n"}