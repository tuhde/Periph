{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_hdc1080Init", "__Periph_hdc1080Temperature", "__Periph_hdc1080Humidity", "__Periph_hdc1080SetResolution", "__Periph_hdc1080SetHeater", "__Periph_hdc1080HeaterOn", "__Periph_hdc1080BatteryLow", "__Periph_hdc1080SerialId", "__Periph_hdc1080SoftReset"], "jscode": "// Block __Periph_hdc1080Init\nvar __Periph_hdc1080Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init HDC1080\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.hdc1080 import HDC1080Full as _HDC1080Full\n\n_periph_hdc1080 = _HDC1080Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_hdc1080.init()\n`\n};\n// Block __Periph_hdc1080Temperature\nvar __Periph_hdc1080Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080Temperature'] = function(block) {\n    \nreturn [`_periph_hdc1080.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hdc1080Humidity\nvar __Periph_hdc1080Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080Humidity'] = function(block) {\n    \nreturn [`_periph_hdc1080.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hdc1080SetResolution\nvar __Periph_hdc1080SetResolution_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 resolution (T 14/11 bit, RH 14/11/8 bit)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"temperature bits\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_tbits\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_tbits\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"humidity bits\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_hbits\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_hbits\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080SetResolution'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080SetResolution_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080SetResolution'] = function(block) {\n    \n\nvar _tbits = block.getFieldValue('_tbits');\n\nvar _hbits = block.getFieldValue('_hbits');\nreturn `_periph_hdc1080.set_resolution(int(${_tbits}), int(${_hbits}))\n`\n};\n// Block __Periph_hdc1080SetHeater\nvar __Periph_hdc1080SetHeater_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 heater (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080SetHeater'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080SetHeater_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080SetHeater'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_hdc1080.set_heater(bool(int(${_on})))\n`\n};\n// Block __Periph_hdc1080HeaterOn\nvar __Periph_hdc1080HeaterOn_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 heater on (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080HeaterOn'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080HeaterOn_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080HeaterOn'] = function(block) {\n    \nreturn [`int(_periph_hdc1080.is_heater_on())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hdc1080BatteryLow\nvar __Periph_hdc1080BatteryLow_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 battery low (1=yes 0=no)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080BatteryLow'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080BatteryLow_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080BatteryLow'] = function(block) {\n    \nreturn [`int(_periph_hdc1080.battery_low())`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hdc1080SerialId\nvar __Periph_hdc1080SerialId_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 serial ID\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080SerialId'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080SerialId_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080SerialId'] = function(block) {\n    \nreturn [`_periph_hdc1080.serial_id()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_hdc1080SoftReset\nvar __Periph_hdc1080SoftReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"HDC1080 soft reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_hdc1080SoftReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_hdc1080SoftReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_hdc1080SoftReset'] = function(block) {\n    \nreturn `_periph_hdc1080.software_reset()\n`\n};\n"}