{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_shtc3Init", "__Periph_shtc3Temperature", "__Periph_shtc3Humidity", "__Periph_shtc3DewPoint", "__Periph_shtc3Id", "__Periph_shtc3SetLowPower", "__Periph_shtc3SetSleepBetween", "__Periph_shtc3Wake", "__Periph_shtc3Sleep", "__Periph_shtc3SoftwareReset"], "jscode": "// Block __Periph_shtc3Init\nvar __Periph_shtc3Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init SHTC3\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.humidity.shtc3 import SHTC3Full as _SHTC3Full\n\n_periph_shtc3 = _SHTC3Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_shtc3.init()\n`\n};\n// Block __Periph_shtc3Temperature\nvar __Periph_shtc3Temperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 temperature (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3Temperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3Temperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3Temperature'] = function(block) {\n    \nreturn [`_periph_shtc3.read_temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_shtc3Humidity\nvar __Periph_shtc3Humidity_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 relative humidity (%RH)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3Humidity'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3Humidity_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3Humidity'] = function(block) {\n    \nreturn [`_periph_shtc3.read_humidity()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_shtc3DewPoint\nvar __Periph_shtc3DewPoint_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 dew point (°C)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3DewPoint'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3DewPoint_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3DewPoint'] = function(block) {\n    \nreturn [`_periph_shtc3.dew_point()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_shtc3Id\nvar __Periph_shtc3Id_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 ID word\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3Id'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3Id_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3Id'] = function(block) {\n    \nreturn [`_periph_shtc3.read_id()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_shtc3SetLowPower\nvar __Periph_shtc3SetLowPower_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 low-power mode (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3SetLowPower'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3SetLowPower_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3SetLowPower'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_shtc3.set_low_power(bool(int(${_on})))\n`\n};\n// Block __Periph_shtc3SetSleepBetween\nvar __Periph_shtc3SetSleepBetween_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 sleep between reads (1=on 0=off)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"on\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_on\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_on\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3SetSleepBetween'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3SetSleepBetween_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3SetSleepBetween'] = function(block) {\n    \n\nvar _on = block.getFieldValue('_on');\nreturn `_periph_shtc3.set_sleep_between(bool(int(${_on})))\n`\n};\n// Block __Periph_shtc3Wake\nvar __Periph_shtc3Wake_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 wake up\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3Wake'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3Wake_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3Wake'] = function(block) {\n    \nreturn `_periph_shtc3.wake()\n`\n};\n// Block __Periph_shtc3Sleep\nvar __Periph_shtc3Sleep_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 sleep\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3Sleep'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3Sleep_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3Sleep'] = function(block) {\n    \nreturn `_periph_shtc3.sleep()\n`\n};\n// Block __Periph_shtc3SoftwareReset\nvar __Periph_shtc3SoftwareReset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"SHTC3 software reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_shtc3SoftwareReset'] = {\n    init: function() {\n        this.jsonInit(__Periph_shtc3SoftwareReset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_shtc3SoftwareReset'] = function(block) {\n    \nreturn `_periph_shtc3.soft_reset()\n`\n};\n"}