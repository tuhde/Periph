{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_bh1750Init", "__Periph_bh1750Lux", "__Periph_bh1750LuxMode", "__Periph_bh1750SetMtreg", "__Periph_bh1750Mtreg", "__Periph_bh1750SetSensitivity", "__Periph_bh1750PowerDown", "__Periph_bh1750PowerOn", "__Periph_bh1750Reset"], "jscode": "// Block __Periph_bh1750Init\nvar __Periph_bh1750Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init BH1750\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bh1750Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_bh1750Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bh1750Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.light.bh1750 import BH1750Full as _BH1750Full\n\n_periph_bh1750 = _BH1750Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n_periph_bh1750.init()\n`\n};\n// Block __Periph_bh1750Lux\nvar __Periph_bh1750Lux_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BH1750 illuminance (lx)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bh1750Lux'] = {\n    init: function() {\n        this.jsonInit(__Periph_bh1750Lux_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bh1750Lux'] = function(block) {\n    \nreturn [`_periph_bh1750.read()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bh1750LuxMode\nvar __Periph_bh1750LuxMode_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BH1750 illuminance (lx), mode (0=H 1=H2 2=L)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"mode\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_mode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_bh1750LuxMode'] = {\n    init: function() {\n        this.jsonInit(__Periph_bh1750LuxMode_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_bh1750LuxMode'] = function(block) {\n    \n\nvar _mode = block.getFieldValue('_mode');\nreturn [`_periph_bh1750.measure_once(int(${_mode}))`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_bh1750SetMtreg\nvar __Periph_bh1750SetMtreg_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BH1750 measurement time register (31-254)\"\n    