{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_si1132Init", "__Periph_si1132ReadUvIndex", "__Periph_si1132ReadVisible", "__Periph_si1132ReadInfrared", "__Periph_si1132ReadTemperatureRaw", "__Periph_si1132ReadVddRaw", "__Periph_si1132SetChannels", "__Periph_si1132SetGain", "__Periph_si1132SetHighRange", "__Periph_si1132StartAutonomous", "__Periph_si1132Pause", "__Periph_si1132MeasurementReady", "__Periph_si1132Reset"], "jscode": "// Block __Periph_si1132Init\nvar __Periph_si1132Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init Si1132\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.light.si1132 import Si1132Full as _Si1132Full\n\n_periph_si1132 = _Si1132Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_si1132ReadUvIndex\nvar __Periph_si1132ReadUvIndex_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 UV index\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132ReadUvIndex'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132ReadUvIndex_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132ReadUvIndex'] = function(block) {\n    \nreturn [`_periph_si1132.read_uv_index()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si1132ReadVisible\nvar __Periph_si1132ReadVisible_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 visible count\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132ReadVisible'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132ReadVisible_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132ReadVisible'] = function(block) {\n    \nreturn [`_periph_si1132.read_visible()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si1132ReadInfrared\nvar __Periph_si1132ReadInfrared_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 infrared count\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132ReadInfrared'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132ReadInfrared_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132ReadInfrared'] = function(block) {\n    \nreturn [`_periph_si1132.read_infrared()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n