  ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"visible (0/1)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_visible\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_visible\"\n        }\n    ],\n    \"message5\": \"%1\",\n    \"args5\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"infrared (0/1)\"\n        }\n    ],\n    \"message6\": \"%1 %2\",\n    \"args6\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_infrared\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_infrared\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132SetChannels'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132SetChannels_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132SetChannels'] = function(block) {\n    \n\nvar _uv = block.getFieldValue('_uv');\n\nvar _visible = block.getFieldValue('_visible');\n\nvar _infrared = block.getFieldValue('_infrared');\nreturn `_periph_si1132.set_channels(bool(${_uv}), bool(${_visible}), bool(${_infrared}))\n`\n};\n// Block __Periph_si1132SetGain\nvar __Periph_si1132SetGain_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 gain (0-7)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"visible gain (0-7)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_visible\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_visible\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"infrared gain (0-7)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_infrared\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_infrared\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132SetGain'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132SetGain_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132SetGain'] = function(block) {\n    \n\nvar _visible = block.getFieldValue('_visible');\n\nvar _infrared = block.getFieldValue('_infrared');\nreturn `_periph_si1132.set_gain(int(${_visible}), int(${_infrared}))\n`\n};\n// Block __Periph_si1132SetHighRange\nvar __Periph_si1132SetHighRange_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 high range (1 = sunlight)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"visible (0/1)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_visible\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_visible\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"infrared (0/1)\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_infrared\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_infrared\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132SetHighRange'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132SetHighRange_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132SetHighRange'] = function(block) {\n    \n\nvar _visible = block.getFieldValue('_visible');\n\nvar _infrared = block.getFieldValue('_infrared');\nreturn `_periph_si1132.set_high_range(bool(${_visible}), bool(${_infrared}))\n`\n};\n// Block __Periph_si1132StartAutonomous\nvar __Periph_si1132StartAutonomous_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 autonomous interval (ms, 0 = forced)\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"interval (ms, 0-2000)\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_interval_ms\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_interval_ms\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132StartAutonomous'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132StartAutonomous_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132StartAutonomous'] = function(block) {\n    \n\nvar _interval_ms = block.getFieldValue('_interval_ms');\nreturn `_periph_si1132.start_autonomous(int(${_interval_ms}) / 1000.0)\n`\n};\n// Block __Periph_si1132Pause\nvar __Periph_si1132Pause_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 pause autonomous mode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132Pause'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132Pause_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132Pause'] = function(block) {\n    \nreturn `_periph_si1132.pause()\n`\n};\n// Block __Periph_si1132MeasurementReady\nvar __Periph_si1132MeasurementReady_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 measurement ready\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132MeasurementReady'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132MeasurementReady_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132MeasurementReady'] = function(block) {\n    \nreturn [`_periph_si1132.measurement_ready()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_si1132Reset\nvar __Periph_si1132Reset_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Si1132 reset\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_si1132Reset'] = {\n    init: function() {\n        this.jsonInit(__Periph_si1132Reset_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_si1132Reset'] = function(block) {\n    \nreturn `_periph_si1132.reset()\n`\n};\n"}