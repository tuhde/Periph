{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_mpu9255Init", "__Periph_mpu9255AccelX", "__Periph_mpu9255AccelY", "__Periph_mpu9255AccelZ", "__Periph_mpu9255GyroX", "__Periph_mpu9255GyroY", "__Periph_mpu9255GyroZ", "__Periph_mpu9255Temperature", "__Periph_mpu9255DataReady"], "jscode": "// Block __Periph_mpu9255Init\nvar __Periph_mpu9255Init_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init MPU9255\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpu9255Init'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpu9255Init_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpu9255Init'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.imu.mpu9255 import MPU9255Full as _MPU9255Full\n\n_periph_mpu9255 = _MPU9255Full(_periph_i2c_conn(${_address}, bus=${_bus}), _periph_i2c_conn(0x0C, bus=${_bus}))\n`\n};\n// Block __Periph_mpu9255AccelX\nvar __Periph_mpu9255AccelX_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPU9255 acceleration X (m/s²)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpu9255AccelX'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpu9255AccelX_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpu9255AccelX'] = function(block) {\n    \nreturn [`_periph_mpu9255.accel()[0]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpu9255AccelY\nvar __Periph_mpu9255AccelY_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPU9255 acceleration Y (m/s²)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpu9255AccelY'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpu9255AccelY_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpu9255AccelY'] = function(block) {\n    \nreturn [`_periph_mpu9255.accel()[1]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpu9255AccelZ\nvar __Periph_mpu9255AccelZ_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPU9255 acceleration Z (m/s²)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpu9255AccelZ'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpu9255AccelZ_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpu9255AccelZ'] = function(block) {\n    \nreturn [`_periph_mpu9255.accel()[2]`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpu9255GyroX\nvar __Periph_mpu9255GyroX_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\