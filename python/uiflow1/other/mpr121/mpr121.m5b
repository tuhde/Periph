iph_i2c_conn\nfrom periph.chips.other.mpr121 import Mpr121Full as _Mpr121Full\n\n_periph_mpr121 = _Mpr121Full(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_mpr121Touched\nvar __Periph_mpr121Touched_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPR121 touched bitmask\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpr121Touched'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpr121Touched_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpr121Touched'] = function(block) {\n    \nreturn [`_periph_mpr121.touched()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpr121IsTouched\nvar __Periph_mpr121IsTouched_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"MPR121 is_touched\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"electrode\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_electrode\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_electrode\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_mpr121IsTouched'] = {\n    init: function() {\n        this.jsonInit(__Periph_mpr121IsTouched_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_mpr121IsTouched'] = function(block) {\n    \n\nvar _electrode = block.getFieldValue('_electrode');\nreturn [`_periph_mpr121.is_touched(${_electrode})`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_mpr121Filtered\nvar __Periph_mpr121Filtered_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n     