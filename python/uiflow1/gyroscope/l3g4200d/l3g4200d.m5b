{"category": "Periph", "color": "#C084FC", "blocks": ["__Periph_l3g4200dInit", "__Periph_l3g4200dReadAngularRate", "__Periph_l3g4200dReadTemperature", "__Periph_l3g4200dWhoAmI", "__Periph_l3g4200dDataReady", "__Periph_l3g4200dStatus", "__Periph_l3g4200dFifoSamples"], "jscode": "// Block __Periph_l3g4200dInit\nvar __Periph_l3g4200dInit_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Init L3G4200D\"\n        }\n    ],\n    \"message1\": \"%1\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"I2C bus\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_bus\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_bus\"\n        }\n    ],\n    \"message3\": \"%1\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"address\"\n        }\n    ],\n    \"message4\": \"%1 %2\",\n    \"args4\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"_address\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"_address\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_l3g4200dInit'] = {\n    init: function() {\n        this.jsonInit(__Periph_l3g4200dInit_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_l3g4200dInit'] = function(block) {\n    \n\nvar _bus = block.getFieldValue('_bus');\n\nvar _address = block.getFieldValue('_address');\nreturn `from periph.connection.i2c_auto import I2CConnection as _periph_i2c_conn\nfrom periph.chips.gyroscope.l3g4200d import L3G4200DFull as _L3G4200DFull\n\n_periph_l3g4200d = _L3G4200DFull(_periph_i2c_conn(${_address}, bus=${_bus}))\n`\n};\n// Block __Periph_l3g4200dReadAngularRate\nvar __Periph_l3g4200dReadAngularRate_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"L3G4200D angular rate (x, y, z rad/s)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_l3g4200dReadAngularRate'] = {\n    init: function() {\n        this.jsonInit(__Periph_l3g4200dReadAngularRate_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_l3g4200dReadAngularRate'] = function(block) {\n    \nreturn [`_periph_l3g4200d.angular_rate()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_l3g4200dReadTemperature\nvar __Periph_l3g4200dReadTemperature_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"L3G4200D temperature (counts)\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_l3g4200dReadTemperature'] = {\n    init: function() {\n        this.jsonInit(__Periph_l3g4200dReadTemperature_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_l3g4200dReadTemperature'] = function(block) {\n    \nreturn [`_periph_l3g4200d.temperature()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_l3g4200dWhoAmI\nvar __Periph_l3g4200dWhoAmI_json = {\n    \"output\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"L3G4200D WHO_AM_I\"\n        }\n    ],\n    \"colour\": \"#C084FC\"\n};\nwindow['Blockly'].Blocks['__Periph_l3g4200dWhoAmI'] = {\n    init: function() {\n        this.jsonInit(__Periph_l3g4200dWhoAmI_json);\n    }\n};\n\nwindow['Blockly'].Python['__Periph_l3g4200dWhoAmI'] = function(block) {\n    \nreturn [`_periph_l3g4200d.who_am_i()`, Blockly.Python.ORDER_CONDITIONAL]\n};\n// Block __Periph_l3g4200dDataReady\nvar __Periph_l3g4200dDataReady_json = {\n 