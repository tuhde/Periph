  "uiflow2": {
    "jscode": "const CUSTOM_AS5600_LANGUAGES = {\n  \"CUSTOM_AS5600_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_AS5600_ANGLE\": {\n    \"en\": \"%1 angle (°)\"\n  },\n  \"CUSTOM_AS5600_ANGLE_RAW\": {\n    \"en\": \"%1 raw angle count\"\n  },\n  \"CUSTOM_AS5600_IS_MAGNET_DETECTED\": {\n    \"en\": \"%1 magnet detected?\"\n  },\n  \"CUSTOM_AS5600_IS_MAGNET_TOO_STRONG\": {\n    \"en\": \"%1 magnet too strong?\"\n  },\n  \"CUSTOM_AS5600_IS_MAGNET_TOO_WEAK\": {\n    \"en\": \"%1 magnet too weak?\"\n  }\n};\n\nconst initType = 'custom_as5600_init';\nBlockly.BlockRegExpList['custom_as5600'] = {\n  regexp: new RegExp(/^custom_as5600_/),\n  code: \"from AS5600 import AS5600\",\n  initBlockType: initType,\n  categoryId: 'custom_as5600',\n}\nBlockly.utils.registerLanguages(CUSTOM_AS5600_LANGUAGES)\n\nBlockly.Msg.CUSTOM_AS5600_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_AS5600 = 'AS5600'\n\nBlockly.utils.getcustom_as5600Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['as5600_0', 'as5600_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_as5600_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AS5600_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_as5600Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'as5600_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_as5600_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = AS5600(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_as5600_angle\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AS5600_ANGLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_as5600Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_as5600_angle\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.angle()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_as5600_angle_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AS5600_ANGLE_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_as5600Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_as5600_angle_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.angle_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_as5600_is_magnet_detected\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AS5600_IS_MAGNET_DETECTED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_as5600Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_as5600_is_magnet_detected\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_magnet_detected()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_as5600_is_magnet_too_strong\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AS5600_IS_MAGNET_TOO_STRONG,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_as5600Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_as5600_is_magnet_too_strong\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_magnet_too_strong()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_as5600_is_magnet_too_weak\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AS5600_IS_MAGNET_TOO_WEAK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_as5600Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_as5600_is_magnet_too_weak\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_magnet_too_weak()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"AS5600\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_as5600\"><title text=\"AS5600\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_as5600_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">54</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_as5600_angle\"/><block type=\"custom_as5600_angle_raw\"/><block type=\"custom_as5600_is_magnet_detected\"/><block type=\"custom_as5600_is_magnet_too_strong\"/><block type=\"custom_as5600_is_magnet_too_weak\"/>\n</category>\n",
