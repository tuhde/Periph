    "jscode": "const CUSTOM_HMC5883L_LANGUAGES = {\n  \"CUSTOM_HMC5883L_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_HMC5883L_FIELD_X\": {\n    \"en\": \"%1 magnetic field X (T)\"\n  },\n  \"CUSTOM_HMC5883L_FIELD_Y\": {\n    \"en\": \"%1 magnetic field Y (T)\"\n  },\n  \"CUSTOM_HMC5883L_FIELD_Z\": {\n    \"en\": \"%1 magnetic field Z (T)\"\n  },\n  \"CUSTOM_HMC5883L_CONFIGURE\": {\n    \"en\": \"%1 configure ODR %2 averaging %3 gain %4\"\n  },\n  \"CUSTOM_HMC5883L_SET_GAIN\": {\n    \"en\": \"%1 set gain %2\"\n  },\n  \"CUSTOM_HMC5883L_SET_MODE\": {\n    \"en\": \"%1 set mode %2\"\n  },\n  \"CUSTOM_HMC5883L_DATA_READY\": {\n    \"en\": \"%1 data ready?\"\n  },\n  \"CUSTOM_HMC5883L_STATUS\": {\n    \"en\": \"%1 status register (raw)\"\n  },\n  \"CUSTOM_HMC5883L_SINGLE_MEASUREMENT_X\": {\n    \"en\": \"%1 single measurement X (T)\"\n  },\n  \"CUSTOM_HMC5883L_SINGLE_MEASUREMENT_Y\": {\n    \"en\": \"%1 single measurement Y (T)\"\n  },\n  \"CUSTOM_HMC5883L_SINGLE_MEASUREMENT_Z\": {\n    \"en\": \"%1 single measurement Z (T)\"\n  },\n  \"CUSTOM_HMC5883L_IDENTIFY_ID_A\": {\n    \"en\": \"%1 identification byte A\"\n  },\n  \"CUSTOM_HMC5883L_IDENTIFY_ID_B\": {\n    \"en\": \"%1 identification byte B\"\n  },\n  \"CUSTOM_HMC5883L_IDENTIFY_ID_C\": {\n    \"en\": \"%1 identification byte C\"\n  },\n  \"CUSTOM_HMC5883L_SELF_TEST_X\": {\n    \"en\": \"%1 self-test X (T) positive bias %2\"\n  },\n  \"CUSTOM_HMC5883L_SELF_TEST_Y\": {\n    \"en\": \"%1 self-test Y (T) positive bias %2\"\n  },\n  \"CUSTOM_HMC5883L_SELF_TEST_Z\": {\n    \"en\": \"%1 self-test Z (T) positive bias %2\"\n  }\n};\n\nconst initType = 'custom_hmc5883l_init';\nBlockly.BlockRegExpList['custom_hmc5883l'] = {\n  regexp: new RegExp(/^custom_hmc5883l_/),\n  code: \"from HMC5883L import HMC5883L\",\n  initBlockType: initType,\n  categoryId: 'custom_hmc5883l',\n}\nBlockly.utils.registerLanguages(CUSTOM_HMC5883L_LANGUAGES)\n\nBlockly.Msg.CUSTOM_HMC5883L_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_HMC5883L = 'HMC5883L'\n\nBlockly.utils.getcustom_hmc5883lOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['hmc5883l_0', 'hmc5883l_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_hmc5883l_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HMC5883L_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_hmc5883lOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'hmc5883l_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_hmc5883l_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = HMC5883L(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_hmc5883l_field_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HMC5883L_FIELD_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hmc5883lOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hmc5883l_field_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.field_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hmc5883l_field_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HMC5883L_FIELD_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hmc5883lOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hmc5883l_field_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.field_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hmc5883l_field_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HMC5883L_FIELD_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hmc5883lOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hmc5883l_field_z\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.field_z()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hmc5883l_configure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HMC5883L_CONFIGURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hmc5883lOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'odr'\n        },\n        {\n          'type': 'input_value',\n          'name': 'averaging'\n        },\n        {\n          'type': 'input_value',\n          'name': 'gain'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hmc5883l_configure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var odr = Blockly.Python.valueToCode(block, 'odr', Blockly.Python.ORDER_FUNCTION_CALL);\n  var averaging = Blockly.Python.valueToCode(block, 'averaging', Blockly.Python.ORDER_FUNCTION_CALL);\n  var gain = Blockly.Python.valueToCode(block, 'gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure(${odr}, ${averaging}, ${gain})\\n`\n}\n\nBlockly.Blocks[\"custom_hmc5883l_set_gain\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HMC5883L_SET_GAIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hmc5883lOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'gain'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hmc5883l_set_gain\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var gain = Blockly.Python.valueToCode(block, 'gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_gain(${gain})\\n`\n}\n\nBlockly.Blocks[\"custom_hmc5883l_set_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HMC5883L_SET_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.ge