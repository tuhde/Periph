  "uiflow2": {
    "jscode": "const CUSTOM_TMP102_LANGUAGES = {\n  \"CUSTOM_TMP102_INIT\": {\n    \"en\": \"%1 init bus %2 address (72-75) %3\"\n  },\n  \"CUSTOM_TMP102_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_TMP102_READ_RAW\": {\n    \"en\": \"%1 raw count\"\n  },\n  \"CUSTOM_TMP102_READ_CONFIG\": {\n    \"en\": \"%1 CONFIGURATION register\"\n  },\n  \"CUSTOM_TMP102_WRITE_CONFIG\": {\n    \"en\": \"%1 write CONFIGURATION %2\"\n  },\n  \"CUSTOM_TMP102_SET_CONVERSION_RATE\": {\n    \"en\": \"%1 set conversion rate (0.25/1/4/8 Hz) %2\"\n  },\n  \"CUSTOM_TMP102_SET_EXTENDED_MODE\": {\n    \"en\": \"%1 extended 13-bit mode (0=off 1=on) %2\"\n  },\n  \"CUSTOM_TMP102_SET_T_HIGH\": {\n    \"en\": \"%1 set T_HIGH (°C) %2\"\n  },\n  \"CUSTOM_TMP102_GET_T_HIGH\": {\n    \"en\": \"%1 T_HIGH (°C)\"\n  },\n  \"CUSTOM_TMP102_SET_T_LOW\": {\n    \"en\": \"%1 set T_LOW (°C) %2\"\n  },\n  \"CUSTOM_TMP102_GET_T_LOW\": {\n    \"en\": \"%1 T_LOW (°C)\"\n  },\n  \"CUSTOM_TMP102_SET_FAULT_QUEUE\": {\n    \"en\": \"%1 set fault queue (1/2/4/6) %2\"\n  },\n  \"CUSTOM_TMP102_SET_POLARITY\": {\n    \"en\": \"%1 ALERT polarity (0=active low 1=active high) %2\"\n  },\n  \"CUSTOM_TMP102_SET_THERMOSTAT_MODE\": {\n    \"en\": \"%1 thermostat mode (0=comparator 1=interrupt) %2\"\n  },\n  \"CUSTOM_TMP102_SHUTDOWN\": {\n    \"en\": \"%1 shut down\"\n  },\n  \"CUSTOM_TMP102_WAKE\": {\n    \"en\": \"%1 wake\"\n  },\n  \"CUSTOM_TMP102_ONE_SHOT\": {\n    \"en\": \"%1 one-shot temperature (°C)\"\n  },\n  \"CUSTOM_TMP102_ALERT_STATE\": {\n    \"en\": \"%1 alert active?\"\n  },\n  \"CUSTOM_TMP102_RESET\": {\n    \"en\": \"%1 general-call reset\"\n  },\n  \"CUSTOM_TMP102_POLL_INTERRUPT\": {\n    \"en\": \"%1 poll interrupt (alert active?)\"\n  }\n};\n\nconst initType = 'custom_tmp102_init';\nBlockly.BlockRegExpList['custom_tmp102'] = {\n  regexp: new RegExp(/^custom_tmp102_/),\n  code: \"from TMP102 import TMP102\",\n  initBlockType: initType,\n  categoryId: 'custom_tmp102',\n}\nBlockly.utils.registerLanguages(CUSTOM_TMP102_LANGUAGES)\n\nBlockly.Msg.CUSTOM_TMP102_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_TMP102 = 'TMP102'\n\nBlockly.utils.getcustom_tmp102Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['tmp102_0', 'tmp102_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_tmp102_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_tmp102Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'tmp102_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = TMP102(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp102_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp102_read_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_READ_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_read_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp102_read_config\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_READ_CONFIG,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_read_config\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_config()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp102_write_config\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_WRITE_CONFIG,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_write_config\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_config(${value})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp102_set_conversion_rate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_SET_CONVERSION_RATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'hz'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_set_conversion_rate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var hz = Blockly.Python.valueToCode(block, 'hz', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_conversion_rate(${hz})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp102_set_extended_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_SET_EXTENDED_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'True'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_set_extended_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var True = Blockly.Python.valueToCode(block, 'True', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_extended_mode(${True})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp102_set_t_high\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_SET_T_HIGH,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'celsius'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_set_t_high\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var celsius = Blockly.Python.valueToCode(block, 'celsius', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_t_high(${celsius})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp102_get_t_high\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_GET_T_HIGH,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_get_t_high\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_t_high()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp102_set_t_low\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_SET_T_LOW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'celsius'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_set_t_low\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var celsius = Blockly.Python.valueToCode(block, 'celsius', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_t_low(${celsius})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp102_get_t_low\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_GET_T_LOW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp102_get_t_low\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_t_low()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp102_set_fault_queue\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP102_SET_FAULT_QUEUE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp102Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'count'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n