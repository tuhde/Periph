{
  "category": "TMP117",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_TMP117_LANGUAGES = {\n  \"CUSTOM_TMP117_INIT\": {\n    \"en\": \"%1 init bus %2 address (72-75) %3\"\n  },\n  \"CUSTOM_TMP117_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_TMP117_CONFIGURE\": {\n    \"en\": \"%1 configure mode (0=continuous 1=shutdown 2=one-shot) %2 averaging (0/8/32/64) %3 cycle (s) %4\"\n  },\n  \"CUSTOM_TMP117_GET_CONFIG\": {\n    \"en\": \"%1 config [mode, averaging, cycle s]\"\n  },\n  \"CUSTOM_TMP117_IS_SHUTDOWN\": {\n    \"en\": \"%1 is shut down?\"\n  },\n  \"CUSTOM_TMP117_TRIGGER_ONE_SHOT\": {\n    \"en\": \"%1 trigger one-shot conversion\"\n  },\n  \"CUSTOM_TMP117_IS_DATA_READY\": {\n    \"en\": \"%1 data ready?\"\n  },\n  \"CUSTOM_TMP117_SET_HIGH_LIMIT\": {\n    \"en\": \"%1 set high limit (°C) %2\"\n  },\n  \"CUSTOM_TMP117_GET_HIGH_LIMIT\": {\n    \"en\": \"%1 high limit (°C)\"\n  },\n  \"CUSTOM_TMP117_SET_LOW_LIMIT\": {\n    \"en\": \"%1 set low limit (°C) %2\"\n  },\n  \"CUSTOM_TMP117_GET_LOW_LIMIT\": {\n    \"en\": \"%1 low limit (°C)\"\n  },\n  \"CUSTOM_TMP117_SET_TEMPERATURE_OFFSET\": {\n    \"en\": \"%1 set temperature offset (°C) %2\"\n  },\n  \"CUSTOM_TMP117_GET_TEMPERATURE_OFFSET\": {\n    \"en\": \"%1 temperature offset (°C)\"\n  },\n  \"CUSTOM_TMP117_RESET\": {\n    \"en\": \"%1 soft reset\"\n  },\n  \"CUSTOM_TMP117_UNLOCK_EEPROM\": {\n    \"en\": \"%1 unlock EEPROM\"\n  },\n  \"CUSTOM_TMP117_LOCK_EEPROM\": {\n    \"en\": \"%1 lock EEPROM\"\n  },\n  \"CUSTOM_TMP117_IS_EEPROM_BUSY\": {\n    \"en\": \"%1 EEPROM busy?\"\n  },\n  \"CUSTOM_TMP117_READ_EEPROM_SCRATCH\": {\n    \"en\": \"%1 EEPROM scratch slot (1-3) %2\"\n  },\n  \"CUSTOM_TMP117_WRITE_EEPROM_SCRATCH\": {\n    \"en\": \"%1 write EEPROM scratch slot (2) %2 value (0-65535) %3\"\n  },\n  \"CUSTOM_TMP117_CONFIGURE_ALERT\": {\n    \"en\": \"%1 configure alert mode (0=alert 1=therm) %2 polarity (0=active low 1=active high) %3 pin (0=alert 1=data ready) %4\"\n  },\n  \"CUSTOM_TMP117_POLL_INTERRUPT\": {\n    \"en\": \"%1 alert status (1=high 2=low)\"\n  }\n};\n\nconst initType = 'custom_tmp117_init';\nBlockly.BlockRegExpList['custom_tmp117'] = {\n  regexp: new RegExp(/^custom_tmp117_/),\n  code: \"from TMP117 import TMP117\",\n  initBlockType: initType,\n  categoryId: 'custom_tmp117',\n}\nBlockly.utils.registerLanguages(CUSTOM_TMP117_LANGUAGES)\n\nBlockly.Msg.CUSTOM_TMP117_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_TMP117 = 'TMP117'\n\nBlockly.utils.getcustom_tmp117Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['tmp117_0', 'tmp117_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_tmp117_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_tmp117Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'tmp117_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = TMP117(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_configure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_CONFIGURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n        {\n          'type': 'input_value',\n          'name': 'averaging'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cycle_seconds'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_configure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  var averaging = Blockly.Python.valueToCode(block, 'averaging', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cycle_seconds = Blockly.Python.valueToCode(block, 'cycle_seconds', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure(${mode}, ${averaging}, ${cycle_seconds})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_get_config\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_GET_CONFIG,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_get_config\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_config()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_is_shutdown\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_IS_SHUTDOWN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_is_shutdown\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_shutdown()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_trigger_one_shot\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_TRIGGER_ONE_SHOT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_trigger_one_shot\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.trigger_one_shot()\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_is_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_IS_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_is_data_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_data_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_set_high_limit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_SET_HIGH_LIMIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'celsius'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_set_high_limit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var celsius = Blockly.Python.valueToCode(block, 'celsius', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_high_limit(${celsius})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_get_high_limit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_GET_HIGH_LIMIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_get_high_limit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_high_limit()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_set_low_limit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_SET_LOW_LIMIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'celsius'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_set_low_limit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var celsius = Blockly.Python.valueToCode(block, 'celsius', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_low_limit(${celsius})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_get_low_limit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_GET_LOW_LIMIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_get_low_limit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_low_limit()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_set_temperature_offset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_SET_TEMPERATURE_OFFSET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'celsius'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_set_temperature_offset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var celsius = Blockly.Python.valueToCode(block, 'celsius', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_temperature_offset(${celsius})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_get_temperature_offset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_GET_TEMPERATURE_OFFSET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_get_temperature_offset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_temperature_offset()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_unlock_eeprom\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_UNLOCK_EEPROM,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_unlock_eeprom\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.unlock_eeprom()\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_lock_eeprom\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_LOCK_EEPROM,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_lock_eeprom\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.lock_eeprom()\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_is_eeprom_busy\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_IS_EEPROM_BUSY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_is_eeprom_busy\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_eeprom_busy()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_read_eeprom_scratch\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_READ_EEPROM_SCRATCH,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'slot'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_read_eeprom_scratch\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var slot = Blockly.Python.valueToCode(block, 'slot', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_eeprom_scratch(${slot})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmp117_write_eeprom_scratch\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_WRITE_EEPROM_SCRATCH,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'slot'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_write_eeprom_scratch\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var slot = Blockly.Python.valueToCode(block, 'slot', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_eeprom_scratch(${slot}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_configure_alert\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_CONFIGURE_ALERT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n        {\n          'type': 'input_value',\n          'name': 'polarity'\n        },\n        {\n          'type': 'input_value',\n          'name': 'pin_function'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_configure_alert\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  var polarity = Blockly.Python.valueToCode(block, 'polarity', Blockly.Python.ORDER_FUNCTION_CALL);\n  var pin_function = Blockly.Python.valueToCode(block, 'pin_function', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure_alert(${mode}, ${polarity}, ${pin_function})\\n`\n}\n\nBlockly.Blocks[\"custom_tmp117_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMP117_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmp117Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmp117_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"TMP117\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_tmp117\">\n<title text=\"TMP117\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_tmp117_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">72</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_read_temperature\"/><block type=\"custom_tmp117_configure\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"averaging\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">8</field>\n    </shadow>\n  </value>\n  <value name=\"cycle_seconds\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_get_config\"/><block type=\"custom_tmp117_is_shutdown\"/><block type=\"custom_tmp117_trigger_one_shot\"/><block type=\"custom_tmp117_is_data_ready\"/><block type=\"custom_tmp117_set_high_limit\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">30.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_get_high_limit\"/><block type=\"custom_tmp117_set_low_limit\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_get_low_limit\"/><block type=\"custom_tmp117_set_temperature_offset\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_get_temperature_offset\"/><block type=\"custom_tmp117_reset\"/><block type=\"custom_tmp117_unlock_eeprom\"/><block type=\"custom_tmp117_lock_eeprom\"/><block type=\"custom_tmp117_is_eeprom_busy\"/><block type=\"custom_tmp117_read_eeprom_scratch\">\n  <value name=\"slot\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_write_eeprom_scratch\">\n  <value name=\"slot\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_configure_alert\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"polarity\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"pin_function\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmp117_poll_interrupt\"/>\n</category>\n",
