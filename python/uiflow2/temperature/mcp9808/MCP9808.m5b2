e}.clear_interrupt()\\n`\n}\n\nBlockly.Blocks[\"custom_mcp9808_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP9808_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp9808Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp9808_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"MCP9808\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mcp9808\">\n<title text=\"MCP9808\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mcp9808_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">24</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp9808_read_temperature\"/><block type=\"custom_mcp9808_set_resolution\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.0625</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp9808_get_resolution\"/><block type=\"custom_mcp9808_shutdown\"/><block type=\"custom_mcp9808_wake\"/><block type=\"custom_mcp9808_is_shutdown\"/><block type=\"custom_mcp9808_set_upper_limit\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">30.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp9808_get_upper_limit\"/><block type=\"custom_mcp9808_set_lower_limit\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp9808_get_lower_limit\"/><block type=\"custom_mcp9808_set_critical_limit\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">45.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp9808_get_critical_limit\"/><block type=\"custom_mcp9808_set_hysteresis\">\n  <value name=\"celsius\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp9808_get_hysteresis\"/><block type=\"custom_mcp9808_lock_critical_limit\"/><block type=\"custom_mcp9808_lock_window_limits\"/><block type=\"custom_mcp9808_is_critical_limit_locked\"/>