{
  "category": "MCP9808",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_MCP9808_LANGUAGES = {\n  \"CUSTOM_MCP9808_INIT\": {\n    \"en\": \"%1 init bus %2 address (24-31) %3\"\n  },\n  \"CUSTOM_MCP9808_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_MCP9808_SET_RESOLUTION\": {\n    \"en\": \"%1 set resolution (°C: 0.5/0.25/0.125/0.0625) %2\"\n  },\n  \"CUSTOM_MCP9808_GET_RESOLUTION\": {\n    \"en\": \"%1 resolution (°C)\"\n  },\n  \"CUSTOM_MCP9808_SHUTDOWN\": {\n    \"en\": \"%1 shutdown\"\n  },\n  \"CUSTOM_MCP9808_WAKE\": {\n    \"en\": \"%1 wake\"\n  },\n  \"CUSTOM_MCP9808_IS_SHUTDOWN\": {\n    \"en\": \"%1 is shut down?\"\n  },\n  \"CUSTOM_MCP9808_SET_UPPER_LIMIT\": {\n    \"en\": \"%1 set upper limit (°C) %2\"\n  },\n  \"CUSTOM_MCP9808_GET_UPPER_LIMIT\": {\n    \"en\": \"%1 upper limit (°C)\"\n  },\n  \"CUSTOM_MCP9808_SET_LOWER_LIMIT\": {\n    \"en\": \"%1 set lower limit (°C) %2\"\n  },\n  \"CUSTOM_MCP9808_GET_LOWER_LIMIT\": {\n    \"en\": \"%1 lower limit (°C)\"\n  },\n  \"CUSTOM_MCP9808_SET_CRITICAL_LIMIT\": {\n    \"en\": \"%1 set critical limit (°C) %2\"\n  },\n  \"CUSTOM_MCP9808_GET_CRITICAL_LIMIT\": {\n    \"en\": \"%1 critical limit (°C)\"\n  },\n  \"CUSTOM_MCP9808_SET_HYSTERESIS\": {\n    \"en\": \"%1 set hysteresis (°C: 0/1.5/3.0/6.0) %2\"\n  },\n  \"CUSTOM_MCP9808_GET_HYSTERESIS\": {\n    \"en\": \"%1 hysteresis (°C)\"\n  },\n  \"CUSTOM_MCP9808_LOCK_CRITICAL_LIMIT\": {\n    \"en\": \"%1 lock critical limit (until power cycle)\"\n  },\n  \"CUSTOM_MCP9808_LOCK_WINDOW_LIMITS\": {\n    \"en\": \"%1 lock window limits (until power cycle)\"\n  },\n  \"CUSTOM_MCP9808_IS_CRITICAL_LIMIT_LOCKED\": {\n    \"en\": \"%1 critical limit locked?\"\n  },\n  \"CUSTOM_MCP9808_IS_WINDOW_LIMITS_LOCKED\": {\n    \"en\": \"%1 window limits locked?\"\n  },\n  \"CUSTOM_MCP9808_CONFIGURE_ALERT\": {\n    \"en\": \"%1 configure alert mode (0=all 1=critical only) %2 output (0=comparator 1=interrupt) %3 polarity (0=active low 1=active high) %4\"\n  },\n  \"CUSTOM_MCP9808_ENABLE_ALERT\": {\n    \"en\": \"%1 enable alert\"\n  },\n  \"CUSTOM_MCP9808_DISABLE_ALERT\": {\n    \"en\": \"%1 disable alert\"\n  },\n  \"CUSTOM_MCP9808_IS_ALERT_ASSERTED\": {\n    \"en\": \"%1 alert asserted?\"\n  },\n  \"CUSTOM_MCP9808_CLEAR_INTERRUPT\": {\n    \"en\": \"%1 clear interrupt\"\n  },\n  \"CUSTOM_MCP9808_POLL_INTERRUPT\": {\n    \"en\": \"%1 boundary status (1=lower 2=upper 4=critical)\"\n  }\n};\n\nconst initType = 'custom_mcp9808_init';\nBlockly.BlockRegExpList['custom_mcp9808'] = {\n  regexp: new RegExp(/^custom_mcp9808_/),\n  code: \"from MCP9808 import MCP9808\",\n  initBlockType: initType,\n  categoryId: 'custom_mcp9808',\n}\nBlockly.utils.registerLanguages(CUSTOM_MCP9808_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MCP9808_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MCP9808 = 'MCP9808'\n\nBlockly.utils.getcustom_mcp9808Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['mcp9808_0', 'mcp9808_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_mcp9808_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP9808_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_mcp9808Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'mcp9808_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp9808_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MCP9808(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp9808_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP9808_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp9808Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp9808_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp9808_set_resolution\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP9808_SET_RESOLUTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp9808Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'celsius'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp9808_set_resolution\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var celsius = Blockly.Python.valueToCode(block, 'celsius', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resolution(${celsius})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp9808_get_resolution\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _