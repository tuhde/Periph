  "uiflow2": {
    "jscode": "const CUSTOM_SDSPI_LANGUAGES = {\n  \"CUSTOM_SDSPI_INIT\": {\n    \"en\": \"%1 init bus %2 CS pin %3\"\n  },\n  \"CUSTOM_SDSPI_BLOCK_COUNT\": {\n    \"en\": \"%1 capacity (512-byte blocks)\"\n  },\n  \"CUSTOM_SDSPI_CARD_TYPE\": {\n    \"en\": \"%1 card type (1 SDv1, 2 SDv2, 3 SDHC)\"\n  },\n  \"CUSTOM_SDSPI_READ_BYTE\": {\n    \"en\": \"%1 read byte block %2 offset %3\"\n  },\n  \"CUSTOM_SDSPI_WRITE_BYTE\": {\n    \"en\": \"%1 write byte block %2 offset %3 value %4\"\n  },\n  \"CUSTOM_SDSPI_FILL_BLOCK\": {\n    \"en\": \"%1 fill block %2 with value %3\"\n  },\n  \"CUSTOM_SDSPI_MOUNT\": {\n    \"en\": \"%1 mount as FAT at /sd\"\n  }\n};\n\nconst initType = 'custom_sdspi_init';\nBlockly.BlockRegExpList['custom_sdspi'] = {\n  regexp: new RegExp(/^custom_sdspi_/),\n  code: \"from SDSPI import SDSPI\",\n  initBlockType: initType,\n  categoryId: 'custom_sdspi',\n}\nBlockly.utils.registerLanguages(CUSTOM_SDSPI_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SDSPI_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SDSPI = 'SDSPI'\n\nBlockly.utils.getcustom_sdspiOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['sdspi_0', 'sdspi_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_sdspi_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SDSPI_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_sdspiOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'sdspi_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_sdspi_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = SDSPI(${bus}, ${cs_pin})\\n`\n}\n\nBlockly.Blocks[\"custom_sdspi_block_count\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SDSPI_BLOCK_COUNT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sdspiOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sdspi_block_count\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.block_count()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_sdspi_card_type\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SDSPI_CARD_TYPE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sdspiOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sdspi_card_type\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.card_type()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_sdspi_read_byte\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SDSPI_READ_BYTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sdspiOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'block'\n        },\n        {\n          'type': 'input_value',\n          'name': 'offset'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sdspi_read_byte\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var block = Blockly.Python.valueToCode(block, 'block', Blockly.Python.ORDER_FUNCTION_CALL);\n  var offset = Blockly.Python.valueToCode(block, 'offset', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_byte(${block}, ${offset})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_sdspi_write_byte\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SDSPI_WRITE_BYTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sdspiOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'block'\n        },\n        {\n          'type': 'input_value',\n          'name': 'offset'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sdspi_write_byte\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var block = Blockly.Python.valueToCode(block, 'block', Blockly.Python.ORDER_FUNCTION_CALL);\n  var offset = Blockly.Python.valueToCode(block, 'offset', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_byte(${block}, ${offset}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_sdspi_fill_block\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SDSPI_FILL_BLOCK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sdspiOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'block'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sdspi_fill_block\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var block = Blockly.Python.valueToCode(block, 'block', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill_block(${block}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_sdspi_mount\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SDSPI_MOUNT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sdspiOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sdspi_mount\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.mount()\\n`\n}\n",
    "toolbox": "\n<category name=\"SDSPI\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_sdspi\">\n<title text=\"SDSPI\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_sdspi_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n  <value name=\"cs_pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_sdspi_block_count\"/><block type=\"custom_sdspi_card_type\"/><block type=\"custom_sdspi_read_byte\">\n  <value name=\"block\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\"></field>\n    </shadow>\n  </value>\n  <value name=\"offset\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\"></field>\n    </shadow>\n  </value>\n</block><block type=\"custom_sdspi_write_byte\">\n  <value name=\"block\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\"></field>\n    </shadow>\n  </value>\n  <value name=\"offset\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\"></field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\"></field>\n    </shadow>\n  </value>\n</block><block type=\"custom_sdspi_fill_block\">\n  <value name=\"block\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\"></field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_sdspi_mount\"/>\n</category>\n",
