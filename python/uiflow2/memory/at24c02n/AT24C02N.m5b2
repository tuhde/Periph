  "pyCode": "\"\"\"\nfile     AT24C02N\ntime     2026-11-14\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.i2c_auto import I2CConnection\nfrom periph.chips.memory.at24c02n import AT24C02NFull\n\n\nclass AT24C02N:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 0, address: int = 80):\n        \"\"\"\n        label:\n            en: '%1 init bus %2 address %3'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '0'\n                field: number\n            address:\n                name: address\n                type: int\n                default: '80'\n                field: number\n        \"\"\"\n        self._bus = bus\n        self._address = address\n        connection = I2CConnection(address, bus=bus)\n        self._driver = AT24C02NFull(connection)\n\n    def read_byte(self, address: int) -> int:\n        \"\"\"\n        label:\n            en: '%1 read byte address %2'\n        params:\n            address:\n                name: address\n                type: int\n                field: number\n        \"\"\"\n        return self._driver.read_byte(address)\n\n    def write_byte(self, address: int, value: int):\n        \"\"\"\n        label:\n            en: '%1 write byte address %2 value %3'\n        params:\n            address:\n                name: address\n                type: int\n                field: number\n            value:\n                name: value\n                type: int\n                field: number\n        \"\"\"\n        self._driver.write_byte(address, value)\n\n    def read(self, address: int, length: int) -> str:\n        \"\"\"\n        label:\n            en: '%1 read address %2 length %3 (hex)'\n        params:\n            address:\n                name: address\n                type: int\n                field: number\n            length:\n                name: length\n                type: int\n                field: number\n        \"\"\"\n        return self._driver.read(address, length).hex()\n\n    def write(self, address: int, data: str):\n        \"\"\"\n        label:\n            en: '%1 write address %2 data (hex) %3'\n        params:\n            address:\n                name: address\n                type: int\n                field: number\n            data:\n                name: data\n                type: str\n        \"\"\"\n        self._driver.write(address, bytes.fromhex(data))\n\n    def fill(self, address: int, length: int, value: int = 0):\n        \"\"\"\n        label:\n            en: '%1 fill address %2 length %3 value %4'\n        params:\n            address:\n                name: address\n                type: int\n                field: number\n            length:\n                name: length\n                type: int\n                field: number\n            value:\n                name: value\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.fill(address, length, value)\n\n    def size(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 size (bytes)'\n        \"\"\"\n        return self._driver.size()\n\n    def page_size(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 page size (bytes)'\n        \"\"\"\n        return self._driver.page_size()\n\n    def wait_ready(self, timeout: int = 10) -> bool:\n        \"\"\"\n        label:\n            en: '%1 ready within %2 ms'\n        params:\n            timeout:\n                name: timeout\n                type: int\n                default: '10'\n                field: number\n        \"\"\"\n        return self._driver.wait_ready(timeout)\n",
  "version": "alpha2"
}
