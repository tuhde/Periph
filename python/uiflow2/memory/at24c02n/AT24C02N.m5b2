    "jscode": "const CUSTOM_AT24C02N_LANGUAGES = {\n  \"CUSTOM_AT24C02N_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_AT24C02N_READ_BYTE\": {\n    \"en\": \"%1 read byte address %2\"\n  },\n  \"CUSTOM_AT24C02N_WRITE_BYTE\": {\n    \"en\": \"%1 write byte address %2 value %3\"\n  },\n  \"CUSTOM_AT24C02N_READ\": {\n    \"en\": \"%1 read address %2 length %3 (hex)\"\n  },\n  \"CUSTOM_AT24C02N_WRITE\": {\n    \"en\": \"%1 write address %2 data (hex) %3\"\n  },\n  \"CUSTOM_AT24C02N_FILL\": {\n    \"en\": \"%1 fill address %2 length %3 value %4\"\n  },\n  \"CUSTOM_AT24C02N_SIZE\": {\n    \"en\": \"%1 size (bytes)\"\n  },\n  \"CUSTOM_AT24C02N_PAGE_SIZE\": {\n    \"en\": \"%1 page size (bytes)\"\n  },\n  \"CUSTOM_AT24C02N_WAIT_READY\": {\n    \"en\": \"%1 ready within %2 ms\"\n  }\n};\n\nconst initType = 'custom_at24c02n_init';\nBlockly.BlockRegExpList['custom_at24c02n'] = {\n  regexp: new RegExp(/^custom_at24c02n_/),\n  code: \"from AT24C02N import AT24C02N\",\n  initBlockType: initType,\n  categoryId: 'custom_at24c02n',\n}\nBlockly.utils.registerLanguages(CUSTOM_AT24C02N_LANGUAGES)\n\nBlockly.Msg.CUSTOM_AT24C02N_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_AT24C02N = 'AT24C02N'\n\nBlockly.utils.getcustom_at24c02nOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['at24c02n_0', 'at24c02n_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_at24c02n_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_at24c02nOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'at24c02n_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = AT24C02N(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_at24c02n_read_byte\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_READ_BYTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_read_byte\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_byte(${address})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_at24c02n_write_byte\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_WRITE_BYTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_write_byte\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_byte(${address}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_at24c02n_read\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_READ,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'length'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_read\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var length = Blockly.Python.valueToCode(block, 'length', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read(${address}, ${length})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_at24c02n_write\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_WRITE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'data'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_write\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var data = Blockly.Python.valueToCode(block, 'data', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write(${address}, ${data})\\n`\n}\n\nBlockly.Blocks[\"custom_at24c02n_fill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_FILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'length'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_fill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var length = Blockly.Python.valueToCode(block, 'length', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill(${address}, ${length}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_at24c02n_size\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_SIZE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_size\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.size()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_at24c02n_page_size\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_PAGE_SIZE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_page_size\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.page_size()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_at24c02n_wait_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AT24C02N_WAIT_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_at24c02nOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'timeout'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_at24c02n_wait_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var timeout = Blockly.Python.valueToCode(block, 'timeout', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.wait_ready(${timeout})`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"AT24C02N\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_at24c02n\">\n<title text=\"AT24C02N\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_at24c02n_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">80</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_at24c02n_read_byte\">\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_at24c02n_write_byte\">\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_at24c02n_read\">\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"length\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_at24c02n_write\">\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"data\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"></field>\n    </shadow>\n  </value>\n</block><block type=\"custom_at24c02n_fill\">\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"length\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><blo