    "jscode": "const CUSTOM_SRAM23X1024_LANGUAGES = {\n  \"CUSTOM_SRAM23X1024_INIT\": {\n    \"en\": \"%1 init bus %2 CS pin %3\"\n  },\n  \"CUSTOM_SRAM23X1024_READ_BYTE\": {\n    \"en\": \"%1 read byte address %2\"\n  },\n  \"CUSTOM_SRAM23X1024_WRITE_BYTE\": {\n    \"en\": \"%1 write byte address %2 value %3\"\n  },\n  \"CUSTOM_SRAM23X1024_FILL\": {\n    \"en\": \"%1 fill address %2 length %3 value %4\"\n  },\n  \"CUSTOM_SRAM23X1024_SIZE\": {\n    \"en\": \"%1 size (bytes)\"\n  },\n  \"CUSTOM_SRAM23X1024_SET_MODE\": {\n    \"en\": \"%1 set mode (0 byte, 128 page, 64 sequential) %2\"\n  },\n  \"CUSTOM_SRAM23X1024_GET_MODE\": {\n    \"en\": \"%1 mode (0 byte, 128 page, 64 sequential)\"\n  },\n  \"CUSTOM_SRAM23X1024_RESET_IO\": {\n    \"en\": \"%1 reset I/O (back to SPI mode)\"\n  }\n};\n\nconst initType = 'custom_sram23x1024_init';\nBlockly.BlockRegExpList['custom_sram23x1024'] = {\n  regexp: new RegExp(/^custom_sram23x1024_/),\n  code: \"from SRAM23X1024 import SRAM23X1024\",\n  initBlockType: initType,\n  categoryId: 'custom_sram23x1024',\n}\nBlockly.utils.registerLanguages(CUSTOM_SRAM23X1024_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SRAM23X1024_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SRAM23X1024 = 'SRAM23X1024'\n\nBlockly.utils.getcustom_sram23x1024Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['sram23x1024_0', 'sram23x1024_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_sram23x1024_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_sram23x1024Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'sram23x1024_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = SRAM23X1024(${bus}, ${cs_pin})\\n`\n}\n\nBlockly.Blocks[\"custom_sram23x1024_read_byte\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_READ_BYTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sram23x1024Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_read_byte\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_byte(${address})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_sram23x1024_write_byte\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_WRITE_BYTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sram23x1024Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_write_byte\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_byte(${address}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_sram23x1024_fill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_FILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sram23x1024Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'length'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_fill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var length = Blockly.Python.valueToCode(block, 'length', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill(${address}, ${length}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_sram23x1024_size\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_SIZE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sram23x1024Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_size\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.size()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_sram23x1024_set_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_SET_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sram23x1024Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_set_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_mode(${mode})\\n`\n}\n\nBlockly.Blocks[\"custom_sram23x1024_get_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_GET_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sram23x1024Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_get_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_mode()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_sram23x1024_reset_io\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SRAM23X1024_RESET_IO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_sram23x1024Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_sram23x1024_reset_io\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset_io()\\n`\n}\n",
