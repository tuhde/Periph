{
  "category": "DS3231",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_DS3231_LANGUAGES = {\n  \"CUSTOM_DS3231_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_DS3231_SET_DATETIME\": {\n    \"en\": \"%1 set date/time year %2 month %3 day %4 weekday %5 hour %6 minute %7 second %8\"\n  },\n  \"CUSTOM_DS3231_YEAR\": {\n    \"en\": \"%1 year\"\n  },\n  \"CUSTOM_DS3231_MONTH\": {\n    \"en\": \"%1 month\"\n  },\n  \"CUSTOM_DS3231_DAY\": {\n    \"en\": \"%1 day\"\n  },\n  \"CUSTOM_DS3231_WEEKDAY\": {\n    \"en\": \"%1 weekday (1=Mon..7=Sun)\"\n  },\n  \"CUSTOM_DS3231_HOUR\": {\n    \"en\": \"%1 hour\"\n  },\n  \"CUSTOM_DS3231_MINUTE\": {\n    \"en\": \"%1 minute\"\n  },\n  \"CUSTOM_DS3231_SECOND\": {\n    \"en\": \"%1 second\"\n  },\n  \"CUSTOM_DS3231_READ_TEMPERATURE\": {\n    \"en\": \"%1 read temperature (°C)\"\n  },\n  \"CUSTOM_DS3231_FORCE_TEMPERATURE_CONVERSION\": {\n    \"en\": \"%1 force temperature conversion\"\n  },\n  \"CUSTOM_DS3231_SET_ALARM1\": {\n    \"en\": \"%1 set alarm 1 second %2 minute %3 hour %4 day/date %5 is day of week %6 match mode %7\"\n  },\n  \"CUSTOM_DS3231_SET_ALARM2\": {\n    \"en\": \"%1 set alarm 2 minute %2 hour %3 day/date %4 is day of week %5 match mode %6\"\n  },\n  \"CUSTOM_DS3231_ENABLE_SQUARE_WAVE\": {\n    \"en\": \"%1 enable square wave rate %2 Hz battery backed %3\"\n  },\n  \"CUSTOM_DS3231_DISABLE_SQUARE_WAVE\": {\n    \"en\": \"%1 disable square wave\"\n  },\n  \"CUSTOM_DS3231_ENABLE_32KHZ_OUTPUT\": {\n    \"en\": \"%1 enable 32kHz output\"\n  },\n  \"CUSTOM_DS3231_DISABLE_32KHZ_OUTPUT\": {\n    \"en\": \"%1 disable 32kHz output\"\n  },\n  \"CUSTOM_DS3231_OSCILLATOR_STOPPED\": {\n    \"en\": \"%1 oscillator stopped?\"\n  },\n  \"CUSTOM_DS3231_CLEAR_OSCILLATOR_STOPPED\": {\n    \"en\": \"%1 clear oscillator stop flag\"\n  },\n  \"CUSTOM_DS3231_GET_AGING_OFFSET\": {\n    \"en\": \"%1 aging offset\"\n  },\n  \"CUSTOM_DS3231_SET_AGING_OFFSET\": {\n    \"en\": \"%1 set aging offset %2\"\n  },\n  \"CUSTOM_DS3231_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt source %2\"\n  },\n  \"CUSTOM_DS3231_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt source %2\"\n  },\n  \"CUSTOM_DS3231_POLL_INTERRUPT\": {\n    \"en\": \"%1 poll interrupt status\"\n  }\n};\n\nconst initType = 'custom_ds3231_init';\nBlockly.BlockRegExpList['custom_ds3231'] = {\n  regexp: new RegExp(/^custom_ds3231_/),\n  code: \"from DS3231 import DS3231\",\n  initBlockType: initType,\n  categoryId: 'custom_ds3231',\n}\nBlockly.utils.registerLanguages(CUSTOM_DS3231_LANGUAGES)\n\nBlockly.Msg.CUSTOM_DS3231_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_DS3231 = 'DS3231'\n\nBlockly.utils.getcustom_ds3231Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ds3231_0', 'ds3231_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ds3231_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ds3231Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ds3231_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = DS3231(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_ds3231_set_datetime\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_SET_DATETIME,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        },\n        {\n          'type': 'input_value',\n          'name': 'month'\n        },\n        {\n          'type': 'input_value',\n          'name': 'day'\n        },\n        {\n          'type': 'input_value',\n          'name': 'weekday'\n        },\n        {\n          'type': 'input_value',\n          'name': 'hour'\n        },\n        {\n          'type': 'input_value',\n          'name': 'minute'\n        },\n        {\n          'type': 'input_value',\n          'name': 'second'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_set_datetime\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  var weekday = Blockly.Python.valueToCode(block, 'weekday', Blockly.Python.ORDER_FUNCTION_CALL);\n  var hour = Blockly.Python.valueToCode(block, 'hour', Blockly.Python.ORDER_FUNCTION_CALL);\n  var minute = Blockly.Python.valueToCode(block, 'minute', Blockly.Python.ORDER_FUNCTION_CALL);\n  var second = Blockly.Python.valueToCode(block, 'second', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_datetime(${year}, ${month}, ${day}, ${weekday}, ${hour}, ${minute}, ${second})\\n`\n}\n\nBlockly.Blocks[\"custom_ds3231_year\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_YEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_year\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.year()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ds3231_month\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_MONTH,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_month\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.month()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ds3231_day\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_DAY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_day\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.day()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ds3231_weekday\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_WEEKDAY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_weekday\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.weekday()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ds3231_hour\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_HOUR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_hour\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.hour()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ds3231_minute\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_MINUTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_minute\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.minute()`, Blockly.Python.ORDER_NO