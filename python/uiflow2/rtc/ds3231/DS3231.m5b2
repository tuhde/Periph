 {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.force_temperature_conversion()\\n`\n}\n\nBlockly.Blocks[\"custom_ds3231_set_alarm1\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_SET_ALARM1,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'second'\n        },\n        {\n          'type': 'input_value',\n          'name': 'minute'\n        },\n        {\n          'type': 'input_value',\n          'name': 'hour'\n        },\n        {\n          'type': 'input_value',\n          'name': 'day_or_date'\n        },\n        {\n          'type': 'input_value',\n          'name': 'is_day_of_week'\n        },\n        {\n          'type': 'input_value',\n          'name': 'match_mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_set_alarm1\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var second = Blockly.Python.valueToCode(block, 'second', Blockly.Python.ORDER_FUNCTION_CALL);\n  var minute = Blockly.Python.valueToCode(block, 'minute', Blockly.Python.ORDER_FUNCTION_CALL);\n  var hour = Blockly.Python.valueToCode(block, 'hour', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day_or_date = Blockly.Python.valueToCode(block, 'day_or_date', Blockly.Python.ORDER_FUNCTION_CALL);\n  var is_day_of_week = Blockly.Python.valueToCode(block, 'is_day_of_week', Blockly.Python.ORDER_FUNCTION_CALL);\n  var match_mode = Blockly.Python.valueToCode(block, 'match_mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_alarm1(${second}, ${minute}, ${hour}, ${day_or_date}, ${is_day_of_week}, ${match_mode})\\n`\n}\n\nBlockly.Blocks[\"custom_ds3231_set_alarm2\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_SET_ALARM2,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3231Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'minute'\n        },\n        {\n          'type': 'input_value',\n          'name': 'hour'\n        },\n        {\n          'type': 'input_value',\n          'name': 'day_or_date'\n        },\n        {\n          'type': 'input_value',\n          'name': 'is_day_of_week'\n        },\n        {\n          'type': 'input_value',\n          'name': 'match_mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3231_set_alarm2\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var minute = Blockly.Python.valueToCode(block, 'minute', Blockly.Python.ORDER_FUNCTION_CALL);\n  var hour = Blockly.Python.valueToCode(block, 'hour', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day_or_date = Blockly.Python.valueToCode(block, 'day_or_date', Blockly.Python.ORDER_FUNCTION_CALL);\n  var is_day_of_week = Blockly.Python.valueToCode(block, 'is_day_of_week', Blockly.Python.ORDER_FUNCTION_CALL);\n  var match_mode = Blockly.Python.valueToCode(block, 'match_mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_alarm2(${minute}, ${hour}, ${day_or_date}, ${is_day_of_week}, ${match_mode})\\n`\n}\n\nBlockly.Blocks[\"custom_ds3231_enable_square_wave\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3231_ENABLE_SQUARE_WAVE,\n      'args0': [\n        {\n          'type': '