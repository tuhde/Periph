{\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8523_CONFIGURE_TIMER_A,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8523Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'watchdog'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n        {\n          'type': 'input_value',\n          'name': 'source_clock'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8523_configure_timer_a\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var watchdog = Blockly.Python.valueToCode(block, 'watchdog', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  var source_clock = Blockly.Python.valueToCode(block, 'source_clock', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure_timer_a(${watchdog}, ${value}, ${source_clock})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8523_disable_timer_a\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8523_DISABLE_TIMER_A,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8523Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8523_disable_timer_a\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.disable_timer_a()\\n`\n}\n\nBlockly.Blocks[\"custo