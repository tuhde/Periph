{
  "category": "PCF8523",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_PCF8523_LANGUAGES = {\n  \"CUSTOM_PCF8523_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_PCF8523_SET_DATETIME\": {\n    \"en\": \"%1 set date/time year %2 month %3 day %4 weekday (0=Sun) %5 hour %6 minute %7 second %8\"\n  },\n  \"CUSTOM_PCF8523_YEAR\": {\n    \"en\": \"%1 year\"\n  },\n  \"CUSTOM_PCF8523_MONTH\": {\n    \"en\": \"%1 month\"\n  },\n  \"CUSTOM_PCF8523_DAY\": {\n    \"en\": \"%1 day\"\n  },\n  \"CUSTOM_PCF8523_WEEKDAY\": {\n    \"en\": \"%1 weekday (0=Sun..6=Sat)\"\n  },\n  \"CUSTOM_PCF8523_HOUR\": {\n    \"en\": \"%1 hour\"\n  },\n  \"CUSTOM_PCF8523_MINUTE\": {\n    \"en\": \"%1 minute\"\n  },\n  \"CUSTOM_PCF8523_SECOND\": {\n    \"en\": \"%1 second\"\n  },\n  \"CUSTOM_PCF8523_SET_ALARM\": {\n    \"en\": \"%1 set alarm (-1 = ignore) minute %2 hour %3 day %4 weekday %5\"\n  },\n  \"CUSTOM_PCF8523_ALARM_MINUTE\": {\n    \"en\": \"%1 alarm minute (-1 = ignored)\"\n  },\n  \"CUSTOM_PCF8523_ALARM_HOUR\": {\n    \"en\": \"%1 alarm hour (-1 = ignored)\"\n  },\n  \"CUSTOM_PCF8523_ALARM_DAY\": {\n    \"en\": \"%1 alarm day (-1 = ignored)\"\n  },\n  \"CUSTOM_PCF8523_ALARM_WEEKDAY\": {\n    \"en\": \"%1 alarm weekday (-1 = ignored)\"\n  },\n  \"CUSTOM_PCF8523_CONFIGURE_TIMER_A\": {\n    \"en\": \"%1 start timer A watchdog (0/1) %2 value %3 source clock (0=4096Hz 1=64Hz 2=1Hz 3=1/60Hz 4=1/3600Hz) %4\"\n  },\n  \"CUSTOM_PCF8523_DISABLE_TIMER_A\": {\n    \"en\": \"%1 stop timer A\"\n  },\n  \"CUSTOM_PCF8523_READ_TIMER_A\": {\n    \"en\": \"%1 timer A counter\"\n  },\n  \"CUSTOM_PCF8523_CONFIGURE_TIMER_B\": {\n    \"en\": \"%1 start timer B value %2 source clock (0=4096Hz 1=64Hz 2=1Hz 3=1/60Hz 4=1/3600Hz) %3\"\n  },\n  \"CUSTOM_PCF8523_DISABLE_TIMER_B\": {\n    \"en\": \"%1 stop timer B\"\n  },\n  \"CUSTOM_PCF8523_READ_TIMER_B\": {\n    \"en\": \"%1 timer B counter\"\n  },\n  \"CUSTOM_PCF8523_SET_CLOCK_OUTPUT\": {\n    \"en\": \"%1 CLKOUT frequency (32768/16384/8192/4096/1024/32/1 Hz) %2\"\n  },\n  \"CUSTOM_PCF8523_DISABLE_CLOCK_OUTPUT\": {\n    \"en\": \"%1 disable CLKOUT\"\n  },\n  \"CUSTOM_PCF8523_OFFSET\": {\n    \"en\": \"%1 offset (LSB)\"\n  },\n  \"CUSTOM_PCF8523_SET_OFFSET\": {\n    \"en\": \"%1 set offset (LSB) %2 every minute (0/1) %3\"\n  },\n  \"CUSTOM_PCF8523_CONFIGURE_BATTERY_BACKUP\": {\n    \"en\": \"%1 battery backup mode (0=standard 1=direct 2=disabled) %2 low detection (0/1) %3\"\n  },\n  \"CUSTOM_PCF8523_IS_BATTERY_SWITCHED_OVER\": {\n    \"en\": \"%1 battery switch-over occurred?\"\n  },\n  \"CUSTOM_PCF8523_CLEAR_BATTERY_SWITCHOVER\": {\n    \"en\": \"%1 clear battery switch-over flag\"\n  },\n  \"CUSTOM_PCF8523_IS_BATTERY_LOW\": {\n    \"en\": \"%1 battery low?\"\n  },\n  \"CUSTOM_PCF8523_OSCILLATOR_STOPPED\": {\n    \"en\": \"%1 oscillator stopped?\"\n  },\n  \"CUSTOM_PCF8523_SOFTWARE_RESET\": {\n    \"en\": \"%1 software reset\"\n  },\n  \"CUSTOM_PCF8523_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt source (1=second 2=timer A 4=timer B 8=alarm 16=battery switch 32=battery low) %2\"\n  },\n  \"CUSTOM_PCF8523_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt source (1=second 2=timer A 4=timer B 8=alarm 16=battery switch 32=battery low) %2\"\n  },\n  \"CUSTOM_PCF8523_POLL_INTERRUPT\": {\n    \"en\": \"%1 poll interrupt status\"\n  }\n};\n\nconst initType = 'custom_pcf8523_init';\nBlockly.BlockRegExpList['custom_pcf8523'] = {\n  regexp: new RegExp(/^custom_pcf8523_/),\n  code: \"from PCF8523 import PCF8523\",\n  initBlockType: initType,\n  categoryId: 'custom_pcf8523',\n}\nBlockly.utils.registerLanguages(CUSTOM_PCF8523_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PCF8523_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_PCF8523 = 'PCF8523'\n\nBlockly.utils.getcustom_pcf8523Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pcf8523_0', 'pcf8523_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_pcf8523_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8523_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pcf8523Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pcf8523_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8523_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = PCF8523(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8523_set_datetime\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8523_SET_DATETIME,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8523Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'year'\n        },\n        {\n          'type': 'input_value',\n          'name': 'month'\n        },\n        {\n          'type': 'input_value',\n          'name': 'day'\n        },\n        {\n          'type': 'input_value',\n          'name': 'weekday'\n        },\n        {\n          'type': 'input_value',\n          'name': 'hour'\n        },\n        {\n          'type': 'input_value',\n          'name': 'minute'\n        },\n        {\n          'type': 'input_value',\n          'name': 'second'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8523_set_datetime\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var year = Blockly.Python.valueToCode(block, 'year', Blockly.Python.ORDER_FUNCTION_CALL);\n  var month = Blockly.Python.valueToCode(block, 'month', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  var weekday = Blockly.Python.valueToCode(block, 'weekday', Blockly.Python.ORDER_FUNCTION_CALL);\n  var hour = Blockly.Python.valueToCode(block, 'hour', Blockly.Python.ORDER_FUNCTION_CALL);\n  var minute = Blockly.Python.valueToCode(block, 'minute', Blockly.Python.ORDER_FUNCTION_CALL);\n  var second = Blockly.Python.valueToCode(block, 'second', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_datetime(${year}, ${month}, ${day}, ${weekday}, ${hour}, ${minute}, ${second})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8523_year\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8523_YEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8523Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8523_year\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.year()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pcf8523_month\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'me