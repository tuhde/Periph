rgs0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8523Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'minute'\n        },\n        {\n          'type': 'input_value',\n          'name': 'hour'\n        },\n        {\n          'type': 'input_value',\n          'name': 'day'\n        },\n        {\n          'type': 'input_value',\n          'name': 'weekday'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8523_set_alarm\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var minute = Blockly.Python.valueToCode(block, 'minute', Blockly.Python.ORDER_FUNCTION_CALL);\n  var hour = Blockly.Python.valueToCode(block, 'hour', Blockly.Python.ORDER_FUNCTION_CALL);\n  var day = Blockly.Python.valueToCode(block, 'day', Blockly.Python.ORDER_FUNCTION_CALL);\n  var weekday = Blockly.Python.valueToCode(block, 'weekday', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_alarm(${minute}, ${hour}, ${day}, ${weekday})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8523_alarm_minute\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8523_ALARM_MINUTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8523Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8523_alarm_minute\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.alarm_minute()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pcf8523_alarm_hour\"] = {\n  init: function() {\n    this.jsonInit(