{"category": "RFM95W", "color": "#C084FC", "uiflow2": {"jscode": "const CUSTOM_RFM95W_LANGUAGES = {\n  \"CUSTOM_RFM95W_INIT\": {\n    \"en\": \"%1 init bus %2 cs_pin %3 frequency (Hz) %4\"\n  },\n  \"CUSTOM_RFM95W_SEND\": {\n    \"en\": \"%1 send packet data %2\"\n  },\n  \"CUSTOM_RFM95W_RECEIVE\": {\n    \"en\": \"%1 receive packet (hex, empty if none) timeout (ms) %2\"\n  },\n  \"CUSTOM_RFM95W_CONFIGURE\": {\n    \"en\": \"%1 configure LoRa sf %2 bandwidth (kHz) %3 coding_rate %4 crc on (1) / off (0) %5\"\n  },\n  \"CUSTOM_RFM95W_SET_TX_POWER\": {\n    \"en\": \"%1 set TX power (dBm) power_dbm %2 use PA_BOOST (1) / RFO (0) %3\"\n  },\n  \"CUSTOM_RFM95W_LAST_PACKET_RSSI\": {\n    \"en\": \"%1 last packet RSSI (dBm)\"\n  },\n  \"CUSTOM_RFM95W_LAST_PACKET_SNR\": {\n    \"en\": \"%1 last packet SNR (dB)\"\n  },\n  \"CUSTOM_RFM95W_SLEEP\": {\n    \"en\": \"%1 sleep\"\n  }\n};\n\nconst initType = 'custom_rfm95w_init';\nBlockly.BlockRegExpList['custom_rfm95w'] = {\n  regexp: new RegExp(/^custom_rfm95w_/),\n  code: \"from RFM95W import RFM95W\",\n  initBlockType: initType,\n  categoryId: 'custom_rfm95w',\n}\nBlockly.utils.registerLanguages(CUSTOM_RFM95W_LANGUAGES)\n\nBlockly.Msg.CUSTOM_RFM95W_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_RFM95W = 'RFM95W'\n\nBlockly.utils.getcustom_rfm95wOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['rfm95w_0', 'rfm95w_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_rfm95w_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_rfm95wOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'rfm95w_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'frequency_hz'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var frequency_hz = Blockly.Python.valueToCode(block, 'frequency_hz', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = RFM95W(${bus}, ${cs_pin}, ${frequency_hz})\\n`\n}\n\nBlockly.Blocks[\"custom_rfm95w_send\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_SEND,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rfm95wOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'data'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_send\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var data = Blockly.Python.valueToCode(block, 'data', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.send(${data})\\n`\n}\n\nBlockly.Blocks[\"custom_rfm95w_receive\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_RECEIVE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rfm95wOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'timeout_ms'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_receive\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var timeout_ms = Blockly.Python.valueToCode(block, 'timeout_ms', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.receive(${timeout_ms})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rfm95w_configure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_CONFIGURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rfm95wOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'sf'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bandwidth_khz'\n        },\n        {\n          'type': 'input_value',\n          'name': 'coding_rate'\n        },\n        {\n          'type': 'input_value',\n          'name': 'crc'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_configure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var sf = Blockly.Python.valueToCode(block, 'sf', Blockly.Python.ORDER_FUNCTION_CALL);\n  var bandwidth_khz = Blockly.Python.valueToCode(block, 'bandwidth_khz', Blockly.Python.ORDER_FUNCTION_CALL);\n  var coding_rate = Blockly.Python.valueToCode(block, 'coding_rate', Blockly.Python.ORDER_FUNCTION_CALL);\n  var crc = Blockly.Python.valueToCode(block, 'crc', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure(${sf}, ${bandwidth_khz}, ${coding_rate}, ${crc})\\n`\n}\n\nBlockly.Blocks[\"custom_rfm95w_set_tx_power\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_SET_TX_POWER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rfm95wOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'power_dbm'\n        },\n        {\n          'type': 'input_value',\n          'name': 'use_pa_boost'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_set_tx_power\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var power_dbm = Blockly.Python.valueToCode(block, 'power_dbm', Blockly.Python.ORDER_FUNCTION_CALL);\n  var use_pa_boost = Blockly.Python.valueToCode(block, 'use_pa_boost', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_tx_power(${power_dbm}, ${use_pa_boost})\\n`\n}\n\nBlockly.Blocks[\"custom_rfm95w_last_packet_rssi\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_LAST_PACKET_RSSI,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rfm95wOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_last_packet_rssi\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.last_packet_rssi()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rfm95w_last_packet_snr\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_LAST_PACKET_SNR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rfm95wOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_last_packet_snr\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.last_packet_snr()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rfm95w_sleep\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RFM95W_SLEEP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rfm95wOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rfm95w_sleep\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.sleep()\\n`\n}", "toolbox": "\n<category name=\"RFM95W\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_rfm95w\"><title text=\"RFM95W\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_rfm95w_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"cs_pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5</field>\n    </shadow>\n  </value>\n  <value name=\"frequency_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">915000000</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rfm95w_send\">\n  <value name=\"data\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"></field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rfm95w_receive\">\n  <value name=\"timeout_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2000</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rfm95w_configure\">\n  <value name=\"sf\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">7</field>\n    </shadow>\n  </value>\n  <value name=\"bandwidth_khz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">125.0</field>\n    </shadow>\n  </value>\n  <value name=\"coding_rate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5</field>\n    </shadow>\n  </value>\n  <value name=\"crc\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rfm95w_set_tx_power\">\n  <value name=\"power_dbm\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">17</field>\n    </shadow>\n  </value>\n  <value name=\"use_pa_boost\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rfm95w_last_packet_rssi\"/><block type=\"custom_rfm95w_last_packet_snr\"/><block type=\"custom_rfm95w_sleep\"/>\n</category>\n", "toolboxitemid": "custom_rfm95w", "block_type": ["custom_rfm95w___init__", "custom_rfm95w_send", "custom_rfm95w_receive", "custom_rfm95w_configure", "custom_rfm95w_set_tx_power", "custom_rfm95w_last_packet_rssi", "custom_rfm95w_last_packet_snr", "custom_rfm95w_sleep"]}, "data": {"name": "RFM95W", "note": {"en": ""}, "details": {"color": "#C084FC", "link": "https://github.com/tuhde/Periph", "image": "", "category": "Custom"}, "header": {"file": "RFM95W", "time": "2026-09-11", "author": "", "email": "", "license": "Apache License 2.0"}, "assignments": [], "example": "", "source_internal": "", "source_external": "from periph.connection.spi_auto import SPIConnection\nfrom periph.chips.comms.rfm9x import RFM95Full", "members": [{"name": "__init__", "note": {}, "label": {"en": "%1 init bus %2 cs_pin %3 frequency (Hz) %4"}, "params": [{"name": "bus", "type": "int", "default": "1", "note": {}, "field": "number"}, {"name": "cs_pin", "type": "int", "default": "5", "note": {}, "field": "number"}, {"name": "frequency_hz", "type": "int", "default": "915000000", "note": {}, "field": "number", "max": "1020000000", "min": "862000000"}], "return": "", "source": "        connection = SPIConnection(bus=bus, cs_pin=cs_pin)\n        self._driver = RFM95Full(connection, frequency_hz)", "ast_return": {"code": null, "id": null}, "doc_return": null}, {"name": "send", "note": {}, "label": {"en": "%1 send packet data %2"}, "params": [{"name": "data", "type": "str", "note": {}}], "return": "", "source": "        self._driver.send(data.encode())", "ast_return": {"code": null, "id": null}, "doc_return": null}, {"name": "receive", "note": {}, "label": {"en": "%1 receive packet (hex, empty if none) timeout (ms) %2"}, "params": [{"name": "timeout_ms", "type": "int", "default": "2000", "note": {}, "field": "number"}], "return": "", "source": "        return (self._driver.receive(timeout_ms=timeout_ms) or b'').hex()", "ast_return": {"code": "(self._driver.receive(timeout_ms=timeout_ms) or b'').hex()", "id": "str"}, "doc_return": null}, {"name": "configure", "note": {}, "label": {"en": "%1 configure LoRa sf %2 bandwidth (kHz) %3 coding_rate %4 crc on (1) / off (0) %5"}, "params": [{"name": "sf", "type": "int", "default": "7", "note": {}, "field": "number", "max": "12", "min": "6"}, {"name": "bandwidth_khz", "type": "float", "default": "125.0", "note": {}, "field": "number"}, {"name": "coding_rate", "type": "int", "default": "5", "note": {}, "field": "number", "max": "8", "min": "5"}, {"name": "crc", "type": "int", "default": "1", "note": {}, "field": "number"}], "return": "", "source": "        self._driver.configure(sf, bandwidth_khz, coding_rate, crc=bool(crc))", "ast_return": {"code": null, "id": null}, "doc_return": null}, {"name": "set_tx_power", "note": {}, "label": {"en": "%1 set TX power (dBm) power_dbm %2 use PA_BOOST (1) / RFO (0) %3"}, "params": [{"name": "power_dbm", "type": "int", "default": "17", "note": {}, "field": "number", "max": "20", "min": "-1"}, {"name": "use_pa_boost", "type": "int", "default": "1", "note": {}, "field": "number"}], "return": "", "source": "        self._driver.set_tx_power(power_dbm, use_pa_boost=bool(use_pa_boost))", "ast_return": {"code": null, "id": null}, "doc_return": null}, {"name": "last_packet_rssi", "note": {}, "label": {"en": "%1 last packet RSSI (dBm)"}, "params": [], "return": "", "source": "        return self._driver.last_packet_rssi()", "ast_return": {"code": "self._driver.last_packet_rssi()", "id": "float"}, "doc_return": null}, {"name": "last_packet_snr", "note": {}, "label": {"en": "%1 last packet SNR (dB)"}, "params": [], "return": "", "source": "        return self._driver.last_packet_snr()", "ast_return": {"code": "self._driver.last_packet_snr()", "id": "float"}, "doc_return": null}, {"name": "sleep", "note": {}, "label": {"en": "%1 sleep"}, "params": [], "return": "", "source": "        self._driver.sleep()", "ast_return": {"code": null, "id": null}, "doc_return": null}], "python_file_name": "rfm95w"}, "pyCode": "\"\"\"\nfile     RFM95W\ntime     2026-09-11\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.spi_auto import SPIConnection\nfrom periph.chips.comms.rfm9x import RFM95Full\n\n\nclass RFM95W:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 1, cs_pin: int = 5, frequency_hz: int = 915000000):\n        \"\"\"\n        label:\n            en: '%1 init bus %2 cs_pin %3 frequency (Hz) %4'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '1'\n                field: number\n            cs_pin:\n                name: cs_pin\n                type: int\n                default: '5'\n                field: number\n            frequency_hz:\n                name: frequency_hz\n                type: int\n                default: '915000000'\n                field: number\n                min: '862000000'\n                max: '1020000000'\n        \"\"\"\n        connection = SPIConnection(bus=bus, cs_pin=cs_pin)\n        self._driver = RFM95Full(connection, frequency_hz)\n\n    def send(self, data: str):\n        \"\"\"\n        label:\n            en: '%1 send packet data %2'\n        params:\n            data:\n                name: data\n                type: str\n        \"\"\"\n        self._driver.send(data.encode())\n\n    def receive(self, timeout_ms: int = 2000) -> str:\n        \"\"\"\n        label:\n            en: '%1 receive packet (hex, empty if none) timeout (ms) %2'\n        params:\n            timeout_ms:\n                name: timeout_ms\n                type: int\n                default: '2000'\n                field: number\n        \"\"\"\n        return (self._driver.receive(timeout_ms=timeout_ms) or b'').hex()\n\n    def configure(self, sf: int = 7, bandwidth_khz: float = 125.0, coding_rate: int = 5, crc: int = 1):\n        \"\"\"\n        label:\n            en: '%1 configure LoRa sf %2 bandwidth (kHz) %3 coding_rate %4 crc on (1) / off (0) %5'\n        params:\n            sf:\n                name: sf\n                type: int\n                default: '7'\n                field: number\n                min: '6'\n                max: '12'\n            bandwidth_khz:\n                name: bandwidth_khz\n                type: float\n                default: '125.0'\n                field: number\n            coding_rate:\n                name: coding_rate\n                type: int\n                default: '5'\n                field: number\n                min: '5'\n                max: '8'\n            crc:\n                name: crc\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.configure(sf, bandwidth_khz, coding_rate, crc=bool(crc))\n\n    def set_tx_power(self, power_dbm: int = 17, use_pa_boost: int = 1):\n        \"\"\"\n        label:\n            en: '%1 set TX power (dBm) power_dbm %2 use PA_BOOST (1) / RFO (0) %3'\n        params:\n            power_dbm:\n                name: power_dbm\n                type: int\n                default: '17'\n                field: number\n                min: '-1'\n                max: '20'\n            use_pa_boost:\n                name: use_pa_boost\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.set_tx_power(power_dbm, use_pa_boost=bool(use_pa_boost))\n\n    def last_packet_rssi(self) -> float:\n        \"\"\"\n        label:\n            en: '%1 last packet RSSI (dBm)'\n        \"\"\"\n        return self._driver.last_packet_rssi()\n\n    def last_packet_snr(self) -> float:\n        \"\"\"\n        label:\n            en: '%1 last packet SNR (dB)'\n        \"\"\"\n        return self._driver.last_packet_snr()\n\n    def sleep(self):\n        \"\"\"\n        label:\n            en: '%1 sleep'\n        \"\"\"\n        self._driver.sleep()\n", "version": "alpha2"}