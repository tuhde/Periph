  "uiflow2": {
    "jscode": "const CUSTOM_RDA5807M_LANGUAGES = {\n  \"CUSTOM_RDA5807M_INIT\": {\n    \"en\": \"%1 init bus %2 address %3 frequency_mhz %4 volume %5\"\n  },\n  \"CUSTOM_RDA5807M_SET_FREQUENCY\": {\n    \"en\": \"%1 tune to frequency (MHz) frequency_mhz %2\"\n  },\n  \"CUSTOM_RDA5807M_FREQUENCY\": {\n    \"en\": \"%1 current frequency (MHz)\"\n  },\n  \"CUSTOM_RDA5807M_SET_VOLUME\": {\n    \"en\": \"%1 set volume (0-15) level %2\"\n  },\n  \"CUSTOM_RDA5807M_MUTE\": {\n    \"en\": \"%1 mute (1) / unmute (0) enable %2\"\n  },\n  \"CUSTOM_RDA5807M_SEEK\": {\n    \"en\": \"%1 seek next station (MHz), up (1) / down (0) up %2\"\n  }\n};\n\nconst initType = 'custom_rda5807m_init';\nBlockly.BlockRegExpList['custom_rda5807m'] = {\n  regexp: new RegExp(/^custom_rda5807m_/),\n  code: \"from RDA5807M import RDA5807M\",\n  initBlockType: initType,\n  categoryId: 'custom_rda5807m',\n}\nBlockly.utils.registerLanguages(CUSTOM_RDA5807M_LANGUAGES)\n\nBlockly.Msg.CUSTOM_RDA5807M_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_RDA5807M = 'RDA5807M'\n\nBlockly.utils.getcustom_rda5807mOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['rda5807m_0', 'rda5807m_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_rda5807m_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RDA5807M_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_rda5807mOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'rda5807m_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'frequency_mhz'\n        },\n        {\n          'type': 'input_value',\n          'name': 'volume'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_rda5807m_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var frequency_mhz = Blockly.Python.valueToCode(block, 'frequency_mhz', Blockly.Python.ORDER_FUNCTION_CALL);\n  var volume = Blockly.Python.valueToCode(block, 'volume', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = RDA5807M(${bus}, ${address}, ${frequency_mhz}, ${volume})\\n`\n}\n\nBlockly.Blocks[\"custom_rda5807m_set_frequency\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RDA5807M_SET_FREQUENCY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rda5807mOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'frequency_mhz'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rda5807m_set_frequency\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var frequency_mhz = Blockly.Python.valueToCode(block, 'frequency_mhz', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_frequency(${frequency_mhz})\\n`\n}\n\nBlockly.Blocks[\"custom_rda5807m_frequency\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RDA5807M_FREQUENCY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rda5807mOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rda5807m_frequency\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.frequency()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rda5807m_set_volume\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RDA5807M_SET_VOLUME,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rda5807mOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'level'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rda5807m_set_volume\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var level = Blockly.Python.valueToCode(block, 'level', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_volume(${level})\\n`\n}\n\nBlockly.Blocks[\"custom_rda5807m_mute\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RDA5807M_MUTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rda5807mOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'enable'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rda5807m_mute\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enable = Blockly.Python.valueToCode(block, 'enable', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.mute(${enable})\\n`\n}\n\nBlockly.Blocks[\"custom_rda5807m_seek\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RDA5807M_SEEK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rda5807mOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'up'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rda5807m_seek\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var up = Blockly.Python.valueToCode(block, 'up', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.seek(${up})`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"RDA5807M\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_rda5807m\"><title text=\"RDA5807M\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_rda5807m_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"frequency_mhz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">100</field>\n    </shadow>\n  </value>\n  <value name=\"volume\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">8</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rda5807m_set_frequency\">\n  <value name=\"frequency_mhz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rda5807m_frequency\"/><block type=\"custom_rda5807m_set_volume\">\n  <value name=\"level\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rda5807m_mute\">\n  <value name=\"enable\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rda5807m_seek\">\n  <value name=\"up\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
