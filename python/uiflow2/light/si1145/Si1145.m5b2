init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_SET_LED_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'led'\n        },\n        {\n          'type': 'input_value',\n          'name': 'level'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_set_led_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var led = Blockly.Python.valueToCode(block, 'led', Blockly.Python.ORDER_FUNCTION_CALL);\n  var level = Blockly.Python.valueToCode(block, 'level', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_led_current(${led}, ${level})\\n`\n}\n\nBlockly.Blocks[\"custom_si1145_set_ps_photodiode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_SET_PS_PHOTODIODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'large'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_set_ps_photodiode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var large = Blockly.Python.valueToCode(block, 'large', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_ps_photodiode(${channel}, ${large})\\n`\n}\n\nBlockly.Blocks[\"custom_si1145_set_gain\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_SET_GAIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'visible'\n        },\n        {\n          'type': 'input_value',\n          'name': 'infrared'\n        },\n        {\n          'type': 'input_value',\n          'name': 'proximity'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_set_gain\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var visible = Blockly.Python.valueToCode(block, 'visible', Blockly.Python.ORDER_FUNCTION_CALL);\n  var infrared = Blockly.Python.valueToCode(block, 'infrared', Blockly.Python.ORDER_FUNCTION_CALL);\n  var proximity = Blockly.Python.valueToCode(block, 'proximity', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_gain(${visible}, ${infrared}, ${proximity})\\n`\n}\n\nBlockly.Blocks[\"custom_si1145_set_high_range\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_SET_HIGH_RANGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'visible'\n        },\n        {\n          'type': 'input_value',\n          'name': 'infrared'\n        },\n        {\n          'type': 'input_value',\n          'name': 'proximity'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_set_high_range\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var visible = Blockly.Python.valueToCode(block, 'visible', Blockly.Python.ORDER_FUNCTION_CALL);\n  var infrared = Blockly.Python.valueToCode(block, 'infrared', Blockly.Python.ORDER_FUNCTION_CALL);\n  var proximity = Blockly.Python.valueToCode(block, 'proximity', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_high_range(${visible}, ${infrared}, ${proximity})\\n`\n}\n\nBlockly.Blocks[\"custom_si1145_start_autonomous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_START_AUTONOMOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'interval'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_start_autonomous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var interval = Blockly.Python.valueToCode(block, 'interval', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.start_autonomous(${interval})\\n`\n}\n\nBlockly.Blocks[\"custom_si1145_pause\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_PAUSE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,