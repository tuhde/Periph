  "uiflow2": {
    "jscode": "const CUSTOM_SI1145_LANGUAGES = {\n  \"CUSTOM_SI1145_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_SI1145_PROXIMITY\": {\n    \"en\": \"%1 proximity (counts)\"\n  },\n  \"CUSTOM_SI1145_UV_INDEX\": {\n    \"en\": \"%1 UV index\"\n  },\n  \"CUSTOM_SI1145_VISIBLE\": {\n    \"en\": \"%1 visible light (counts)\"\n  },\n  \"CUSTOM_SI1145_INFRARED\": {\n    \"en\": \"%1 infrared light (counts)\"\n  },\n  \"CUSTOM_SI1145_READ_PROXIMITY\": {\n    \"en\": \"%1 proximity channel (1-3) %2\"\n  },\n  \"CUSTOM_SI1145_READ_TEMPERATURE_RAW\": {\n    \"en\": \"%1 die temperature (raw)\"\n  },\n  \"CUSTOM_SI1145_READ_VDD_RAW\": {\n    \"en\": \"%1 VDD (raw)\"\n  },\n  \"CUSTOM_SI1145_SET_CHANNELS\": {\n    \"en\": \"%1 channels UV %2 visible %3 infrared %4 proximity (1/0) %5\"\n  },\n  \"CUSTOM_SI1145_SET_LED_CURRENT\": {\n    \"en\": \"%1 LED %2 current level (0-15) %3\"\n  },\n  \"CUSTOM_SI1145_SET_PS_PHOTODIODE\": {\n    \"en\": \"%1 proximity channel %2 large photodiode (1/0) %3\"\n  },\n  \"CUSTOM_SI1145_SET_GAIN\": {\n    \"en\": \"%1 gain (0-7) visible %2 infrared %3 proximity %4\"\n  },\n  \"CUSTOM_SI1145_SET_HIGH_RANGE\": {\n    \"en\": \"%1 high range (1/0) visible %2 infrared %3 proximity %4\"\n  },\n  \"CUSTOM_SI1145_START_AUTONOMOUS\": {\n    \"en\": \"%1 start autonomous interval (s) %2\"\n  },\n  \"CUSTOM_SI1145_PAUSE\": {\n    \"en\": \"%1 pause\"\n  },\n  \"CUSTOM_SI1145_FORCE\": {\n    \"en\": \"%1 force measurement\"\n  },\n  \"CUSTOM_SI1145_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt sources\"\n  },\n  \"CUSTOM_SI1145_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_si1145_init';\nBlockly.BlockRegExpList['custom_si1145'] = {\n  regexp: new RegExp(/^custom_si1145_/),\n  code: \"from Si1145 import Si1145\",\n  initBlockType: initType,\n  categoryId: 'custom_si1145',\n}\nBlockly.utils.registerLanguages(CUSTOM_SI1145_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SI1145_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SI1145 = 'Si1145'\n\nBlockly.utils.getcustom_si1145Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['si1145_0', 'si1145_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_si1145_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_si1145Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'si1145_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Si1145(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_si1145_proximity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_PROXIMITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_proximity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.proximity()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1145_uv_index\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_UV_INDEX,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_uv_index\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.uv_index()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1145_visible\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_VISIBLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_visible\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.visible()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1145_infrared\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_INFRARED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_infrared\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.infrared()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1145_read_proximity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_READ_PROXIMITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_read_proximity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.read_proximity(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1145_read_temperature_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_READ_TEMPERATURE_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1145Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1145_read_temperature_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1145_read_vdd_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1145_READ_VDD_RAW,\n      'args0': [\n        {\n        