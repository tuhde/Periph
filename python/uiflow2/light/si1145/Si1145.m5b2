    "toolbox": "\n<category name=\"Si1145\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_si1145\">\n<title text=\"Si1145\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_si1145_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">96</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1145_proximity\"/><block type=\"custom_si1145_uv_index\"/><block type=\"custom_si1145_visible\"/><block type=\"custom_si1145_infrared\"/><block type=\"custom_si1145_read_proximity\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1145_read_temperature_raw\"/><block type=\"custom_si1145_read_vdd_raw\"/><block type=\"custom_si1145_set_channels\">\n  <value name=\"uv\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"visible\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"infrared\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"ps1\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1145_set_led_current\">\n  <value name=\"led\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"level\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1145_set_ps_photodiode\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"large\">\n    <shadow typ