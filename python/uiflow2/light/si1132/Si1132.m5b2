  "uiflow2": {
    "jscode": "const CUSTOM_SI1132_LANGUAGES = {\n  \"CUSTOM_SI1132_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_SI1132_READ_UV_INDEX\": {\n    \"en\": \"%1 UV index\"\n  },\n  \"CUSTOM_SI1132_READ_VISIBLE\": {\n    \"en\": \"%1 visible count\"\n  },\n  \"CUSTOM_SI1132_READ_INFRARED\": {\n    \"en\": \"%1 infrared count\"\n  },\n  \"CUSTOM_SI1132_READ_TEMPERATURE_RAW\": {\n    \"en\": \"%1 raw die temperature\"\n  },\n  \"CUSTOM_SI1132_READ_VDD_RAW\": {\n    \"en\": \"%1 raw supply voltage\"\n  },\n  \"CUSTOM_SI1132_SET_CHANNELS\": {\n    \"en\": \"%1 set channels UV %2 visible %3 infrared %4 (1 = on)\"\n  },\n  \"CUSTOM_SI1132_SET_GAIN\": {\n    \"en\": \"%1 set gain visible %2 infrared %3 (0-7)\"\n  },\n  \"CUSTOM_SI1132_SET_HIGH_RANGE\": {\n    \"en\": \"%1 set high range visible %2 infrared %3 (1 = direct sunlight)\"\n  },\n  \"CUSTOM_SI1132_START_AUTONOMOUS\": {\n    \"en\": \"%1 start autonomous interval %2 ms (0 = forced mode)\"\n  },\n  \"CUSTOM_SI1132_PAUSE\": {\n    \"en\": \"%1 pause autonomous mode\"\n  },\n  \"CUSTOM_SI1132_MEASUREMENT_READY\": {\n    \"en\": \"%1 measurement ready\"\n  },\n  \"CUSTOM_SI1132_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_si1132_init';\nBlockly.BlockRegExpList['custom_si1132'] = {\n  regexp: new RegExp(/^custom_si1132_/),\n  code: \"from Si1132 import Si1132\",\n  initBlockType: initType,\n  categoryId: 'custom_si1132',\n}\nBlockly.utils.registerLanguages(CUSTOM_SI1132_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SI1132_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SI1132 = 'Si1132'\n\nBlockly.utils.getcustom_si1132Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['si1132_0', 'si1132_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_si1132_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_si1132Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'si1132_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Si1132(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_si1132_read_uv_index\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_READ_UV_INDEX,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_read_uv_index\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_uv_index()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1132_read_visible\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_READ_VISIBLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_read_visible\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_visible()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1132_read_infrared\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_READ_INFRARED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_read_infrared\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_infrared()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1132_read_temperature_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_READ_TEMPERATURE_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_read_temperature_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1132_read_vdd_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_READ_VDD_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_read_vdd_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_vdd_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1132_set_channels\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_SET_CHANNELS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'uv'\n        },\n        {\n          'type': 'input_value',\n          'name': 'visible'\n        },\n        {\n          'type': 'input_value',\n          'name': 'infrared'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_set_channels\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var uv = Blockly.Python.valueToCode(block, 'uv', Blockly.Python.ORDER_FUNCTION_CALL);\n  var visible = Blockly.Python.valueToCode(block, 'visible', Blockly.Python.ORDER_FUNCTION_CALL);\n  var infrared = Blockly.Python.valueToCode(block, 'infrared', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_channels(${uv}, ${visible}, ${infrared})\\n`\n}\n\nBlockly.Blocks[\"custom_si1132_set_gain\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_SET_GAIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'visible'\n        },\n        {\n          'type': 'input_value',\n          'name': 'infrared'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_set_gain\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var visible = Blockly.Python.valueToCode(block, 'visible', Blockly.Python.ORDER_FUNCTION_CALL);\n  var infrared = Blockly.Python.valueToCode(block, 'infrared', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_gain(${visible}, ${infrared})\\n`\n}\n\nBlockly.Blocks[\"custom_si1132_set_high_range\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_SET_HIGH_RANGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'visible'\n        },\n        {\n          'type': 'input_value',\n          'name': 'infrared'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_set_high_range\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var visible = Blockly.Python.valueToCode(block, 'visible', Blockly.Python.ORDER_FUNCTION_CALL);\n  var infrared = Blockly.Python.valueToCode(block, 'infrared', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_high_range(${visible}, ${infrared})\\n`\n}\n\nBlockly.Blocks[\"custom_si1132_start_autonomous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_START_AUTONOMOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'interval_ms'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_start_autonomous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var interval_ms = Blockly.Python.valueToCode(block, 'interval_ms', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.start_autonomous(${interval_ms})\\n`\n}\n\nBlockly.Blocks[\"custom_si1132_pause\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_PAUSE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_pause\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.pause()\\n`\n}\n\nBlockly.Blocks[\"custom_si1132_measurement_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_MEASUREMENT_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_measurement_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.measurement_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1132_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1132_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1132Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1132_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}\n",
    "toolbox": "\n<category name=\"Si1132\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_si1132\">\n<title text=\"Si1132\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_si1132_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">96</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1132_read_uv_index\"/><block type=\"custom_si1132_read_visible\"/><block type=\"custom_si1132_read_infrared\"/><block type=\"custom_si1132_read_temperature_raw\"/><block type=\"custom_si1132_read_vdd_raw\"/><block type=\"custom_si1132_set_channels\">\n  <value name=\"uv\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"visible\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"infrared\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1132_set_gain\">\n  <value name=\"visible\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"infrared\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1132_set_high_range\">\n  <value name=\"visible\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"infrared\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1132_start_autonomous\">\n  <value name=\"interval_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">500</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1132_pause\"/><block type=\"custom_si1132_measurement_ready\"/><block type=\"custom_si1132_reset\"/>\n</category>\n",
