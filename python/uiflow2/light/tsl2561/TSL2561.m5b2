    "toolbox": "\n<category name=\"TSL2561\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_tsl2561\">\n<title text=\"TSL2561\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_tsl2561_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">57</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tsl2561_read_lux\"/><block type=\"custom_tsl2561_auto_range\"/><block type=\"custom_tsl2561_ch0\"/><block type=\"custom_tsl2561_ch1\"/><block type=\"custom_tsl2561_set_gain\">\n  <value name=\"gain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tsl2561_get_gain\"/><block type=\"custom_tsl2561_set_integration_time\">\n  <value name=\"ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">402</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tsl2561_get_integration_time\"/><block type=\"custom_tsl2561_set_package\">\n  <value name=\"package\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"></field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tsl2561_power_up\"/><block type=\"custom_tsl2561_power_down\"/><block type=\"custom_tsl2561_is_powered\"/><block type=\"custom_tsl2561_start_manual\"/><block type=\"custom_tsl2561_stop_manual\"/><block type=\"custom_tsl2561_set_thresholds\">\n  <value name=\"low\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"high\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">65535</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tsl2561_get_low_threshold\"/><block type=\"custom_tsl2561_get_high_threshold\"/><block type=\"custom_tsl2561_configure_interrupt\">\n  <value name=\"mode\">\n    <shadow type=\"math_