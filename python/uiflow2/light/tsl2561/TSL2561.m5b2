{
  "category": "TSL2561",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_TSL2561_LANGUAGES = {\n  \"CUSTOM_TSL2561_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_TSL2561_READ_LUX\": {\n    \"en\": \"%1 illuminance (lx)\"\n  },\n  \"CUSTOM_TSL2561_AUTO_RANGE\": {\n    \"en\": \"%1 auto-ranged illuminance (lx)\"\n  },\n  \"CUSTOM_TSL2561_CH0\": {\n    \"en\": \"%1 channel 0 count (visible + IR)\"\n  },\n  \"CUSTOM_TSL2561_CH1\": {\n    \"en\": \"%1 channel 1 count (IR)\"\n  },\n  \"CUSTOM_TSL2561_SET_GAIN\": {\n    \"en\": \"%1 set gain (1 or 16) %2\"\n  },\n  \"CUSTOM_TSL2561_GET_GAIN\": {\n    \"en\": \"%1 gain\"\n  },\n  \"CUSTOM_TSL2561_SET_INTEGRATION_TIME\": {\n    \"en\": \"%1 set integration time (ms) — 14, 101 or 402 %2\"\n  },\n  \"CUSTOM_TSL2561_GET_INTEGRATION_TIME\": {\n    \"en\": \"%1 integration time (ms)\"\n  },\n  \"CUSTOM_TSL2561_SET_PACKAGE\": {\n    \"en\": \"%1 set package — T, FN, CL or CS %2\"\n  },\n  \"CUSTOM_TSL2561_POWER_UP\": {\n    \"en\": \"%1 power up\"\n  },\n  \"CUSTOM_TSL2561_POWER_DOWN\": {\n    \"en\": \"%1 power down\"\n  },\n  \"CUSTOM_TSL2561_IS_POWERED\": {\n    \"en\": \"%1 powered\"\n  },\n  \"CUSTOM_TSL2561_START_MANUAL\": {\n    \"en\": \"%1 start manual integration\"\n  },\n  \"CUSTOM_TSL2561_STOP_MANUAL\": {\n    \"en\": \"%1 stop manual integration\"\n  },\n  \"CUSTOM_TSL2561_SET_THRESHOLDS\": {\n    \"en\": \"%1 interrupt window (ch0 counts) low %2 high %3\"\n  },\n  \"CUSTOM_TSL2561_GET_LOW_THRESHOLD\": {\n    \"en\": \"%1 low threshold (counts)\"\n  },\n  \"CUSTOM_TSL2561_GET_HIGH_THRESHOLD\": {\n    \"en\": \"%1 high threshold (counts)\"\n  },\n  \"CUSTOM_TSL2561_CONFIGURE_INTERRUPT\": {\n    \"en\": \"%1 interrupt mode (0 off, 1 level, 2 SMBAlert) %2 persist %3\"\n  },\n  \"CUSTOM_TSL2561_POLL_INTERRUPT\": {\n    \"en\": \"%1 ch0 outside window\"\n  },\n  \"CUSTOM_TSL2561_CLEAR_INTERRUPT\": {\n    \"en\": \"%1 clear interrupt\"\n  },\n  \"CUSTOM_TSL2561_READ_ID\": {\n    \"en\": \"%1 ID register\"\n  }\n};\n\nconst initType = 'custom_tsl2561_init';\nBlockly.BlockRegExpList['custom_tsl2561'] = {\n  regexp: new RegExp(/^custom_tsl2561_/),\n  code: \"from TSL2561 import TSL2561\",\n  initBlockType: initType,\n  categoryId: 'custom_tsl2561',\n}\nBlockly.utils.registerLanguages(CUSTOM_TSL2561_LANGUAGES)\n\nBlockly.Msg.CUSTOM_TSL2561_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_TSL2561 = 'TSL2561'\n\nBlockly.utils.getcustom_tsl2561Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['tsl2561_0', 'tsl2561_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_tsl2561_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TSL2561_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_tsl2561Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'tsl2561_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_tsl2561_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = TSL2561(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_tsl2561_read_lux\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TSL2561_READ_LUX,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tsl2561Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tsl2561_read_lux\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_lux()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tsl2561_auto_range\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TSL2561_AUTO_RANGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tsl2561Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tsl2561_auto_range\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.auto_range()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tsl2561_ch0\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TSL2561_CH0,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tsl2561Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tsl2561_ch0\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.ch0()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tsl2561_ch1\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TSL2561_CH1,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tsl2561Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tsl2561_ch1\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.ch1()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tsl2561_set_gain\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TSL2561_SET_GAIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tsl2561Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'gain'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tsl2561_set_gain\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var gain = Blockly.Python.valueToCode(block, 'gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_gain(${gain})\\n`\n}\n\nBlockly.Blocks[\"custom_tsl2561_get_gain\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TSL2561_GET_GAIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tsl2561Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tsl2561_get_gain\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_gain()`, Bloc