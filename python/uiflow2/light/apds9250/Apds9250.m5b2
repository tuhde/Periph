  "uiflow2": {
    "jscode": "const CUSTOM_APDS9250_LANGUAGES = {\n  \"CUSTOM_APDS9250_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_APDS9250_READ_RED\": {\n    \"en\": \"%1 red count\"\n  },\n  \"CUSTOM_APDS9250_READ_GREEN\": {\n    \"en\": \"%1 green count\"\n  },\n  \"CUSTOM_APDS9250_READ_BLUE\": {\n    \"en\": \"%1 blue count\"\n  },\n  \"CUSTOM_APDS9250_READ_IR\": {\n    \"en\": \"%1 IR count\"\n  },\n  \"CUSTOM_APDS9250_DATA_READY\": {\n    \"en\": \"%1 data ready\"\n  },\n  \"CUSTOM_APDS9250_SET_MODE\": {\n    \"en\": \"%1 set colour mode %2 (1 = RGB+IR, 0 = ALS/IR)\"\n  },\n  \"CUSTOM_APDS9250_ENABLE\": {\n    \"en\": \"%1 enable\"\n  },\n  \"CUSTOM_APDS9250_DISABLE\": {\n    \"en\": \"%1 disable\"\n  },\n  \"CUSTOM_APDS9250_SET_RESOLUTION\": {\n    \"en\": \"%1 set resolution bits %2\"\n  },\n  \"CUSTOM_APDS9250_SET_MEASUREMENT_RATE\": {\n    \"en\": \"%1 set measurement rate ms %2\"\n  },\n  \"CUSTOM_APDS9250_SET_GAIN\": {\n    \"en\": \"%1 set gain %2\"\n  },\n  \"CUSTOM_APDS9250_SET_THRESHOLDS\": {\n    \"en\": \"%1 set thresholds low %2 high %3\"\n  },\n  \"CUSTOM_APDS9250_SET_INTERRUPT_CHANNEL\": {\n    \"en\": \"%1 set interrupt channel %2 (0 IR, 1 green, 2 red, 3 blue)\"\n  },\n  \"CUSTOM_APDS9250_SET_PERSISTENCE\": {\n    \"en\": \"%1 set persistence %2\"\n  },\n  \"CUSTOM_APDS9250_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt %2 (1 threshold, 2 variation)\"\n  },\n  \"CUSTOM_APDS9250_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt\"\n  },\n  \"CUSTOM_APDS9250_STATUS\": {\n    \"en\": \"%1 status byte\"\n  },\n  \"CUSTOM_APDS9250_SOFT_RESET\": {\n    \"en\": \"%1 soft reset\"\n  }\n};\n\nconst initType = 'custom_apds9250_init';\nBlockly.BlockRegExpList['custom_apds9250'] = {\n  regexp: new RegExp(/^custom_apds9250_/),\n  code: \"from Apds9250 import Apds9250\",\n  initBlockType: initType,\n  categoryId: 'custom_apds9250',\n}\nBlockly.utils.registerLanguages(CUSTOM_APDS9250_LANGUAGES)\n\nBlockly.Msg.CUSTOM_APDS9250_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_APDS9250 = 'Apds9250'\n\nBlockly.utils.getcustom_apds9250Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['apds9250_0', 'apds9250_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_apds9250_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9250_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_apds9250Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'apds9250_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9250_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Apds9250(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_apds9250_read_red\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9250_READ_RED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9250_read_red\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_red()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9250_read_green\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9250_READ_GREEN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9250_read_green\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_green()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9250_read_blue\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9250_READ_BLUE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9250_read_blue\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_blue()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9250_read_ir\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9250_READ_IR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9250_read_ir\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_ir()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9250_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9250_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9250_data_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.data_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9250_set_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9250_SET_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9250Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'colour'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9250_set_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colour = Blockly.Python.valueToCode(block, 'colour', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_mode(${colour})\\n`\n}\n\nBlockly.Blocks[\"custom_apds9250_enable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUST