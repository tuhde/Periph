  "uiflow2": {
    "jscode": "const CUSTOM_APDS9960_LANGUAGES = {\n  \"CUSTOM_APDS9960_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_APDS9960_COLOR_CLEAR\": {\n    \"en\": \"%1 clear channel\"\n  },\n  \"CUSTOM_APDS9960_COLOR_RED\": {\n    \"en\": \"%1 red channel\"\n  },\n  \"CUSTOM_APDS9960_COLOR_GREEN\": {\n    \"en\": \"%1 green channel\"\n  },\n  \"CUSTOM_APDS9960_COLOR_BLUE\": {\n    \"en\": \"%1 blue channel\"\n  },\n  \"CUSTOM_APDS9960_ENABLE_PROXIMITY\": {\n    \"en\": \"%1 enable (1) / disable (0) proximity enabled %2\"\n  },\n  \"CUSTOM_APDS9960_PROXIMITY\": {\n    \"en\": \"%1 proximity count (0-255)\"\n  }\n};\n\nconst initType = 'custom_apds9960_init';\nBlockly.BlockRegExpList['custom_apds9960'] = {\n  regexp: new RegExp(/^custom_apds9960_/),\n  code: \"from APDS9960 import APDS9960\",\n  initBlockType: initType,\n  categoryId: 'custom_apds9960',\n}\nBlockly.utils.registerLanguages(CUSTOM_APDS9960_LANGUAGES)\n\nBlockly.Msg.CUSTOM_APDS9960_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_APDS9960 = 'APDS9960'\n\nBlockly.utils.getcustom_apds9960Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['apds9960_0', 'apds9960_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_apds9960_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9960_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_apds9960Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'apds9960_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9960_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = APDS9960(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_apds9960_color_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9960_COLOR_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9960Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9960_color_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.color_clear()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9960_color_red\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9960_COLOR_RED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9960Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9960_color_red\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.color_red()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9960_color_green\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9960_COLOR_GREEN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9960Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9960_color_green\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.color_green()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9960_color_blue\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9960_COLOR_BLUE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9960Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9960_color_blue\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.color_blue()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_apds9960_enable_proximity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9960_ENABLE_PROXIMITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9960Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9960_enable_proximity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.enable_proximity(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_apds9960_proximity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_APDS9960_PROXIMITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_apds9960Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_apds9960_proximity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.proximity()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"APDS9960\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_apds9960\"><title text=\"APDS9960\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_apds9960_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">57</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_apds9960_color_clear\"/><block type=\"custom_apds9960_color_red\"/><block type=\"custom_apds9960_color_green\"/><block type=\"custom_apds9960_color_blue\"/><block type=\"custom_apds9960_enable_proximity\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_apds9960_proximity\"/>\n</category>\n",
