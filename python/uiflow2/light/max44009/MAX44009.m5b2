    "jscode": "const CUSTOM_MAX44009_LANGUAGES = {\n  \"CUSTOM_MAX44009_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_MAX44009_LUX\": {\n    \"en\": \"%1 illuminance (lx)\"\n  },\n  \"CUSTOM_MAX44009_IS_OVERRANGE\": {\n    \"en\": \"%1 overrange\"\n  },\n  \"CUSTOM_MAX44009_RESOLUTION\": {\n    \"en\": \"%1 resolution (lx per LSB)\"\n  },\n  \"CUSTOM_MAX44009_SET_CONTINUOUS\": {\n    \"en\": \"%1 continuous mode (1 = yes) %2\"\n  },\n  \"CUSTOM_MAX44009_SET_AUTOMATIC\": {\n    \"en\": \"%1 automatic range\"\n  },\n  \"CUSTOM_MAX44009_SET_MANUAL\": {\n    \"en\": \"%1 manual range integration (ms) %2 divide by 8 (1 = yes) %3\"\n  },\n  \"CUSTOM_MAX44009_SET_THRESHOLDS\": {\n    \"en\": \"%1 interrupt window low (lx) %2 high (lx) %3\"\n  },\n  \"CUSTOM_MAX44009_GET_LOW_THRESHOLD\": {\n    \"en\": \"%1 lower threshold (lx)\"\n  },\n  \"CUSTOM_MAX44009_GET_HIGH_THRESHOLD\": {\n    \"en\": \"%1 upper threshold (lx)\"\n  },\n  \"CUSTOM_MAX44009_SET_THRESHOLD_DELAY\": {\n    \"en\": \"%1 threshold delay (s) %2\"\n  },\n  \"CUSTOM_MAX44009_GET_THRESHOLD_DELAY\": {\n    \"en\": \"%1 threshold delay (s)\"\n  },\n  \"CUSTOM_MAX44009_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt\"\n  },\n  \"CUSTOM_MAX44009_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt\"\n  },\n  \"CUSTOM_MAX44009_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status\"\n  }\n};\n\nconst initType = 'custom_max44009_init';\nBlockly.BlockRegExpList['custom_max44009'] = {\n  regexp: new RegExp(/^custom_max44009_/),\n  code: \"from MAX44009 import MAX44009\",\n  initBlockType: initType,\n  categoryId: 'custom_max44009',\n}\nBlockly.utils.registerLanguages(CUSTOM_MAX44009_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MAX44009_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MAX44009 = 'MAX44009'\n\nBlockly.utils.getcustom_max44009Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['max44009_0', 'max44009_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_max44009_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_max44009Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'max44009_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MAX44009(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_max44009_lux\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_LUX,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_lux\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.lux()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_max44009_is_overrange\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_IS_OVERRANGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_is_overrange\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_overrange()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_max44009_resolution\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_RESOLUTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_resolution\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.resolution()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_max44009_set_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_SET_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'continuous'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_set_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var continuous = Blockly.Python.valueToCode(block, 'continuous', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_continuous(${continuous})\\n`\n}\n\nBlockly.Blocks[\"custom_max44009_set_automatic\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_SET_AUTOMATIC,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_set_automatic\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.set_automatic()\\n`\n}\n\nBlockly.Blocks[\"custom_max44009_set_manual\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_SET_MANUAL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'integration_ms'\n        },\n        {\n          'type': 'input_value',\n          'name': 'divide_by_8'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_set_manual\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var integration_ms = Blockly.Python.valueToCode(block, 'integration_ms', Blockly.Python.ORDER_FUNCTION_CALL);\n  var divide_by_8 = Blockly.Python.valueToCode(block, 'divide_by_8', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_manual(${integration_ms}, ${divide_by_8})\\n`\n}\n\nBlockly.Blocks[\"custom_max44009_set_thresholds\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_SET_THRESHOLDS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'low_lux'\n        },\n        {\n          'type': 'input_value',\n          'name': 'high_lux'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_set_thresholds\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var low_lux = Blockly.Python.valueToCode(block, 'low_lux', Blockly.Python.ORDER_FUNCTION_CALL);\n  var high_lux = Blockly.Python.valueToCode(block, 'high_lux', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_thresholds(${low_lux}, ${high_lux})\\n`\n}\n\nBlockly.Blocks[\"custom_max44009_get_low_threshold\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_GET_LOW_THRESHOLD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_get_low_threshold\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_low_threshold()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_max44009_get_high_threshold\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_GET_HIGH_THRESHOLD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_get_high_threshold\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_high_threshold()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_max44009_set_threshold_delay\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_SET_THRESHOLD_DELAY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'seconds'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max44009_set_threshold_delay\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var seconds = Blockly.Python.valueToCode(block, 'seconds', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_threshold_delay(${seconds})\\n`\n}\n\nBlockly.Blocks[\"custom_max44009_get_threshold_delay\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX44009_GET_THRESHOLD_DELAY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max44009Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colo