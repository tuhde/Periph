    "toolbox": "\n<category name=\"MAX44009\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_max44009\">\n<title text=\"MAX44009\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_max44009_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">74</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_max44009_lux\"/><block type=\"custom_max44009_is_overrange\"/><block type=\"custom_max44009_resolution\"/><block type=\"custom_max44009_set_continuous\">\n  <value name=\"continuous\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_max44009_set_automatic\"/><block type=\"custom_max44009_set_manual\">\n  <value name=\"integration_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">100.0</field>\n    </shadow>\n  </value>\n  <value name=\"divide_by_8\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_max44009_set_thresholds\">\n  <value name=\"low_lux\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">50.0</field>\n    </shadow>\n  </value>\n  <value name=\"high_lux\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">500.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_max44009_get_low_threshold\"/><block type=\"custom_max44009_get_high_threshold\"/><block type=\"custom_max44009_set_threshold_delay\">\n  <value name=\"seconds\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_max44009_get_threshold_delay\"/><block type=\"custom_max44009_enable_interrupt\"/><block type=\"custom_max44009_disable_interrupt\"/><block type=\"custom_max44009_poll_interrupt\"/>\n</cat