  "uiflow2": {
    "jscode": "const CUSTOM_BH1750_LANGUAGES = {\n  \"CUSTOM_BH1750_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_BH1750_LUX\": {\n    \"en\": \"%1 illuminance (lx)\"\n  },\n  \"CUSTOM_BH1750_LUX_MODE\": {\n    \"en\": \"%1 illuminance (lx) mode (0=H 1=H2 2=L) %2\"\n  },\n  \"CUSTOM_BH1750_SET_MEASUREMENT_TIME\": {\n    \"en\": \"%1 measurement time register (31-254) %2\"\n  },\n  \"CUSTOM_BH1750_MEASUREMENT_TIME_REGISTER\": {\n    \"en\": \"%1 measurement time register\"\n  },\n  \"CUSTOM_BH1750_SET_SENSITIVITY\": {\n    \"en\": \"%1 sensitivity factor (0.45-3.68) %2\"\n  },\n  \"CUSTOM_BH1750_POWER_DOWN\": {\n    \"en\": \"%1 power down\"\n  },\n  \"CUSTOM_BH1750_POWER_ON\": {\n    \"en\": \"%1 power on\"\n  },\n  \"CUSTOM_BH1750_RESET\": {\n    \"en\": \"%1 reset data register\"\n  }\n};\n\nconst initType = 'custom_bh1750_init';\nBlockly.BlockRegExpList['custom_bh1750'] = {\n  regexp: new RegExp(/^custom_bh1750_/),\n  code: \"from Bh1750 import Bh1750\",\n  initBlockType: initType,\n  categoryId: 'custom_bh1750',\n}\nBlockly.utils.registerLanguages(CUSTOM_BH1750_LANGUAGES)\n\nBlockly.Msg.CUSTOM_BH1750_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_BH1750 = 'Bh1750'\n\nBlockly.utils.getcustom_bh1750Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['bh1750_0', 'bh1750_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_bh1750_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_bh1750Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'bh1750_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Bh1750(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_bh1750_lux\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_LUX,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_lux\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.lux()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bh1750_lux_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_LUX_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_lux_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.lux_mode(${mode})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bh1750_set_measurement_time\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_SET_MEASUREMENT_TIME,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mtreg'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_set_measurement_time\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mtreg = Blockly.Python.valueToCode(block, 'mtreg', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_measurement_time(${mtreg})\\n`\n}\n\nBlockly.Blocks[\"custom_bh1750_measurement_time_register\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_MEASUREMENT_TIME_REGISTER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_measurement_time_register\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.measurement_time_register()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bh1750_set_sensitivity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_SET_SENSITIVITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'factor'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_set_sensitivity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var factor = Blockly.Python.valueToCode(block, 'factor', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_sensitivity(${factor})\\n`\n}\n\nBlockly.Blocks[\"custom_bh1750_power_down\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_POWER_DOWN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_power_down\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.power_down()\\n`\n}\n\nBlockly.Blocks[\"custom_bh1750_power_on\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_POWER_ON,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_power_on\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.power_on()\\n`\n}\n\nBlockly.Blocks[\"custom_bh1750_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BH1750_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bh1750Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bh1750_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}\n",
    "toolbox": "\n<category name=\"Bh1750\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_bh1750\">\n<title text=\"Bh1750\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_bh1750_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">35</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bh1750_lux\"/><block type=\"custom_bh1750_lux_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bh1750_set_measurement_time\">\n  <value name=\"mtreg\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">69</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bh1750_measurement_time_register\"/><block type=\"custom_bh1750_set_sensitivity\">\n  <value name=\"factor\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bh1750_power_down\"/><block type=\"custom_bh1750_power_on\"/><block type=\"custom_bh1750_reset\"/>\n</category>\n",
