  "uiflow2": {
    "jscode": "const CUSTOM_SI1133_LANGUAGES = {\n  \"CUSTOM_SI1133_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_SI1133_UV\": {\n    \"en\": \"%1 UV (counts)\"\n  },\n  \"CUSTOM_SI1133_WHITE\": {\n    \"en\": \"%1 white light (counts)\"\n  },\n  \"CUSTOM_SI1133_READ_IR\": {\n    \"en\": \"%1 IR (counts) photodiode (0-2) %2\"\n  },\n  \"CUSTOM_SI1133_CONFIGURE_CHANNEL\": {\n    \"en\": \"%1 channel %2 photodiode mux %3 hw gain (0-11) %4 sw gain (0-7) %5\"\n  },\n  \"CUSTOM_SI1133_ENABLE_CHANNELS\": {\n    \"en\": \"%1 enable channels mask %2\"\n  },\n  \"CUSTOM_SI1133_READ_CHANNEL\": {\n    \"en\": \"%1 channel result index %2\"\n  },\n  \"CUSTOM_SI1133_FORCE\": {\n    \"en\": \"%1 force measurement\"\n  },\n  \"CUSTOM_SI1133_START_AUTONOMOUS\": {\n    \"en\": \"%1 start autonomous rate (s) %2 counters %3 %4 %5\"\n  },\n  \"CUSTOM_SI1133_PAUSE\": {\n    \"en\": \"%1 pause\"\n  },\n  \"CUSTOM_SI1133_SET_BURST\": {\n    \"en\": \"%1 burst readings (0 = off) %2\"\n  },\n  \"CUSTOM_SI1133_SET_THRESHOLD\": {\n    \"en\": \"%1 threshold index (0-2) %2 value %3\"\n  },\n  \"CUSTOM_SI1133_SET_CHANNEL_THRESHOLD\": {\n    \"en\": \"%1 channel %2 threshold select (0 = off, 1-3) %3\"\n  },\n  \"CUSTOM_SI1133_DATA_READY\": {\n    \"en\": \"%1 data ready mask\"\n  },\n  \"CUSTOM_SI1133_READ_PARAMETER\": {\n    \"en\": \"%1 parameter %2\"\n  },\n  \"CUSTOM_SI1133_WRITE_PARAMETER\": {\n    \"en\": \"%1 set parameter %2 value %3\"\n  },\n  \"CUSTOM_SI1133_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_si1133_init';\nBlockly.BlockRegExpList['custom_si1133'] = {\n  regexp: new RegExp(/^custom_si1133_/),\n  code: \"from Si1133 import Si1133\",\n  initBlockType: initType,\n  categoryId: 'custom_si1133',\n}\nBlockly.utils.registerLanguages(CUSTOM_SI1133_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SI1133_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SI1133 = 'Si1133'\n\nBlockly.utils.getcustom_si1133Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['si1133_0', 'si1133_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_si1133_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_si1133Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'si1133_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Si1133(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_uv\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_UV,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_uv\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.uv()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1133_white\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_WHITE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_white\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.white()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1133_read_ir\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_READ_IR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'photodiode'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_read_ir\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var photodiode = Blockly.Python.valueToCode(block, 'photodiode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.read_ir(${photodiode})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1133_configure_channel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_CONFIGURE_CHANNEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'adcmux'\n        },\n        {\n          'type': 'input_value',\n          'name': 'hw_gain'\n        },\n        {\n          'type': 'input_value',\n          'name': 'sw_gain'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_configure_channel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var adcmux = Blockly.Python.valueToCode(block, 'adcmux', Blockly.Python.ORDER_FUNCTION_CALL);\n  var hw_gain = Blockly.Python.valueToCode(block, 'hw_gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  var sw_gain = Blockly.Python.valueToCode(block, 'sw_gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure_channel(${channel}, ${adcmux}, ${hw_gain}, ${sw_gain})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_enable_channels\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_ENABLE_CHANNELS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mask'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_enable_channels\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mask = Blockly.Python.valueToCode(block, 'mask', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.enable_channels(${mask})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_read_channel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_READ_CHANNEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'index'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_read_channel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var index = Blockly.Python.valueToCode(block, 'index', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.read_channel(${index})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1133_force\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_FORCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_force\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.force()\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_start_autonomous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_START_AUTONOMOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'rate'\n        },\n        {\n          'type': 'input_value',\n          'name': 'count0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'count1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'count2'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_start_autonomous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var rate = Blockly.Python.valueToCode(block, 'rate', Blockly.Python.ORDER_FUNCTION_CALL);\n  var count0 = Blockly.Python.valueToCode(block, 'count0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var count1 = Blockly.Python.valueToCode(block, 'count1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var count2 = Blockly.Python.valueToCode(block, 'count2', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.start_autonomous(${rate}, ${count0}, ${count1}, ${count2})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_pause\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_PAUSE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_pause\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.pause()\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_set_burst\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_SET_BURST,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'count'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_set_burst\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var count = Blockly.Python.valueToCode(block, 'count', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_burst(${count})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_set_threshold\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_SET_THRESHOLD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'index'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_set_threshold\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var index = Blockly.Python.valueToCode(block, 'index', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_threshold(${index}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_set_channel_threshold\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_SET_CHANNEL_THRESHOLD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'index'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_set_channel_threshold\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var index = Blockly.Python.valueToCode(block, 'index', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_channel_threshold(${channel}, ${index})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_data_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.data_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1133_read_parameter\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_READ_PARAMETER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_read_parameter\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.read_parameter(${address})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_si1133_write_parameter\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_WRITE_PARAMETER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_write_parameter\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_parameter(${address}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_si1133_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SI1133_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_si1133Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_si1133_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}",
    "toolbox": "\n<category name=\"Si1133\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_si1133\">\n<title text=\"Si1133\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_si1133_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">85</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_uv\"/><block type=\"custom_si1133_white\"/><block type=\"custom_si1133_read_ir\">\n  <value name=\"photodiode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_configure_channel\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n  <value name=\"adcmux\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">11</field>\n    </shadow>\n  </value>\n  <value name=\"hw_gain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">7</field>\n    </shadow>\n  </value>\n  <value name=\"sw_gain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_enable_channels\">\n  <value name=\"mask\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_read_channel\">\n  <value name=\"index\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_force\"/><block type=\"custom_si1133_start_autonomous\">\n  <value name=\"rate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.0</field>\n    </shadow>\n  </value>\n  <value name=\"count0\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"count1\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"count2\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_pause\"/><block type=\"custom_si1133_set_burst\">\n  <value name=\"count\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_set_threshold\">\n  <value name=\"index\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1000</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_set_channel_threshold\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"index\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_data_ready\"/><block type=\"custom_si1133_read_parameter\">\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_write_parameter\">\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_si1133_reset\"/>\n</category>\n",
