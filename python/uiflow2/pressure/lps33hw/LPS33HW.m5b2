  "uiflow2": {
    "jscode": "const CUSTOM_LPS33HW_LANGUAGES = {\n  \"CUSTOM_LPS33HW_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_LPS33HW_READ_PRESSURE\": {\n    \"en\": \"%1 pressure (Pa)\"\n  },\n  \"CUSTOM_LPS33HW_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_LPS33HW_ONE_SHOT\": {\n    \"en\": \"%1 trigger one-shot\"\n  }\n};\n\nconst initType = 'custom_lps33hw_init';\nBlockly.BlockRegExpList['custom_lps33hw'] = {\n  regexp: new RegExp(/^custom_lps33hw_/),\n  code: \"from LPS33HW import LPS33HW\",\n  initBlockType: initType,\n  categoryId: 'custom_lps33hw',\n}\nBlockly.utils.registerLanguages(CUSTOM_LPS33HW_LANGUAGES)\n\nBlockly.Msg.CUSTOM_LPS33HW_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_LPS33HW = 'LPS33HW'\n\nBlockly.utils.getcustom_lps33hwOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['lps33hw_0', 'lps33hw_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_lps33hw_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS33HW_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_lps33hwOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'lps33hw_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps33hw_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = LPS33HW(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_lps33hw_read_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS33HW_READ_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lps33hwOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps33hw_read_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_pressure()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lps33hw_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS33HW_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lps33hwOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps33hw_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lps33hw_one_shot\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS33HW_ONE_SHOT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lps33hwOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps33hw_one_shot\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.one_shot()\\n`\n}\n",
    "toolbox": "\n<category name=\"LPS33HW\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_lps33hw\">\n<title text=\"LPS33HW\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_lps33hw_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">92</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_lps33hw_read_pressure\"/><block type=\"custom_lps33hw_read_temperature\"/><block type=\"custom_lps33hw_one_shot\"/>\n</category>\n",
