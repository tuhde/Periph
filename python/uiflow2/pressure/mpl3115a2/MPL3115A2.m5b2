    "jscode": "const CUSTOM_MPL3115A2_LANGUAGES = {\n  \"CUSTOM_MPL3115A2_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_MPL3115A2_PRESSURE\": {\n    \"en\": \"%1 pressure (Pa)\"\n  },\n  \"CUSTOM_MPL3115A2_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_MPL3115A2_ALTITUDE\": {\n    \"en\": \"%1 altitude (m)\"\n  },\n  \"CUSTOM_MPL3115A2_SET_OVERSAMPLE\": {\n    \"en\": \"%1 oversample ratio (1-128) %2\"\n  },\n  \"CUSTOM_MPL3115A2_SET_SEA_LEVEL_PRESSURE\": {\n    \"en\": \"%1 sea-level pressure (Pa) %2\"\n  },\n  \"CUSTOM_MPL3115A2_START_CONTINUOUS\": {\n    \"en\": \"%1 start continuous, step 2^n s, n = %2\"\n  },\n  \"CUSTOM_MPL3115A2_STOP_CONTINUOUS\": {\n    \"en\": \"%1 stop continuous\"\n  }\n};\n\nconst initType = 'custom_mpl3115a2_init';\nBlockly.BlockRegExpList['custom_mpl3115a2'] = {\n  regexp: new RegExp(/^custom_mpl3115a2_/),\n  code: \"from MPL3115A2 import MPL3115A2\",\n  initBlockType: initType,\n  categoryId: 'custom_mpl3115a2',\n}\nBlockly.utils.registerLanguages(CUSTOM_MPL3115A2_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MPL3115A2_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MPL3115A2 = 'MPL3115A2'\n\nBlockly.utils.getcustom_mpl3115a2Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['mpl3115a2_0', 'mpl3115a2_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_mpl3115a2Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'mpl3115a2_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MPL3115A2(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl3115a2Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.pressure()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl3115a2Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_altitude\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_ALTITUDE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl3115a2Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_altitude\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.altitude()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_set_oversample\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_SET_OVERSAMPLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl3115a2Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'ratio'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_set_oversample\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var ratio = Blockly.Python.valueToCode(block, 'ratio', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_oversample(${ratio})\\n`\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_set_sea_level_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_SET_SEA_LEVEL_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl3115a2Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'pa'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_set_sea_level_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pa = Blockly.Python.valueToCode(block, 'pa', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_sea_level_pressure(${pa})\\n`\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_start_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_START_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl3115a2Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'step_exp'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_start_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var step_exp = Blockly.Python.valueToCode(block, 'step_exp', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.start_continuous(${step_exp})\\n`\n}\n\nBlockly.Blocks[\"custom_mpl3115a2_stop_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL3115A2_STOP_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl3115a2Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl3115a2_stop_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.stop_continuous()\\n`\n}\n",
    "toolbox": "\n<category name=\"MPL3115A2\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mpl3115a2\">\n<title text=\"MPL3115A2\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mpl3115a2_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">96</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpl3115a2_pressure\"/><block type=\"custom_mpl3115a2_temperature\"/><block type=\"custom_mpl3115a2_altitude\"/><block type=\"custom_mpl3115a2_set_oversample\">\n  <value name=\"ratio\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">128</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpl3115a2_set_sea_level_pressure\">\n  <value name=\"pa\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">101325</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpl3115a2_start_continuous\">\n  <value name=\"step_exp\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpl3115a2_stop_continuous\"/>\n</category>\n",
