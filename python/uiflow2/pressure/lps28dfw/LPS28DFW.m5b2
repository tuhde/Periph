  "uiflow2": {
    "jscode": "const CUSTOM_LPS28DFW_LANGUAGES = {\n  \"CUSTOM_LPS28DFW_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_LPS28DFW_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_LPS28DFW_READ_PRESSURE\": {\n    \"en\": \"%1 pressure (hPa)\"\n  },\n  \"CUSTOM_LPS28DFW_CONFIGURE\": {\n    \"en\": \"%1 configure ODR %2 AVG %3 FS mode %4\"\n  },\n  \"CUSTOM_LPS28DFW_SET_THRESHOLD\": {\n    \"en\": \"%1 threshold %2 hPa high %3 low %4\"\n  }\n};\n\nconst initType = 'custom_lps28dfw_init';\nBlockly.BlockRegExpList['custom_lps28dfw'] = {\n  regexp: new RegExp(/^custom_lps28dfw_/),\n  code: \"from LPS28DFW import LPS28DFW\",\n  initBlockType: initType,\n  categoryId: 'custom_lps28dfw',\n}\nBlockly.utils.registerLanguages(CUSTOM_LPS28DFW_LANGUAGES)\n\nBlockly.Msg.CUSTOM_LPS28DFW_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_LPS28DFW = 'LPS28DFW'\n\nBlockly.utils.getcustom_lps28dfwOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['lps28dfw_0', 'lps28dfw_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_lps28dfw_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS28DFW_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_lps28dfwOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'lps28dfw_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps28dfw_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = LPS28DFW(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_lps28dfw_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS28DFW_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lps28dfwOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps28dfw_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lps28dfw_read_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS28DFW_READ_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lps28dfwOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps28dfw_read_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_pressure()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lps28dfw_configure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS28DFW_CONFIGURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lps28dfwOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'odr'\n        },\n        {\n          'type': 'input_value',\n          'name': 'avg'\n        },\n        {\n          'type': 'input_value',\n          'name': 'fs_mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps28dfw_configure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var odr = Blockly.Python.valueToCode(block, 'odr', Blockly.Python.ORDER_FUNCTION_CALL);\n  var avg = Blockly.Python.valueToCode(block, 'avg', Blockly.Python.ORDER_FUNCTION_CALL);\n  var fs_mode = Blockly.Python.valueToCode(block, 'fs_mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure(${odr}, ${avg}, ${fs_mode})\\n`\n}\n\nBlockly.Blocks[\"custom_lps28dfw_set_threshold\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LPS28DFW_SET_THRESHOLD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lps28dfwOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'threshold_hpa'\n        },\n        {\n          'type': 'input_value',\n          'name': 'high'\n        },\n        {\n          'type': 'input_value',\n          'name': 'low'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lps28dfw_set_threshold\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var threshold_hpa = Blockly.Python.valueToCode(block, 'threshold_hpa', Blockly.Python.ORDER_FUNCTION_CALL);\n  var high = Blockly.Python.valueToCode(block, 'high', Blockly.Python.ORDER_FUNCTION_CALL);\n  var low = Blockly.Python.valueToCode(block, 'low', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_threshold(${threshold_hpa}, ${high}, ${low})\\n`\n}\n",
    "toolbox": "\n<category name=\"LPS28DFW\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_lps28dfw\">\n<title text=\"LPS28DFW\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_lps28dfw_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">92</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_lps28dfw_read_temperature\"/><block type=\"custom_lps28dfw_read_pressure\"/><block type=\"custom_lps28dfw_configure\">\n  <value name=\"odr\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n  <value name=\"avg\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n  <value name=\"fs_mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_lps28dfw_set_threshold\">\n  <value name=\"threshold_hpa\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"high\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"low\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
