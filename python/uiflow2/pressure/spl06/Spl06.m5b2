  "uiflow2": {
    "jscode": "const CUSTOM_SPL06_LANGUAGES = {\n  \"CUSTOM_SPL06_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_SPL06_PRESSURE\": {\n    \"en\": \"%1 pressure (Pa)\"\n  },\n  \"CUSTOM_SPL06_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_SPL06_ALTITUDE\": {\n    \"en\": \"%1 altitude (m, 101325 Pa sea level)\"\n  },\n  \"CUSTOM_SPL06_SET_PRESSURE_CONFIG\": {\n    \"en\": \"%1 pressure oversampling (1-128) %2 rate (Hz) %3\"\n  },\n  \"CUSTOM_SPL06_SET_TEMPERATURE_CONFIG\": {\n    \"en\": \"%1 temperature oversampling (1-128) %2 rate (Hz) %3\"\n  },\n  \"CUSTOM_SPL06_START_CONTINUOUS\": {\n    \"en\": \"%1 start continuous (pressure and temperature)\"\n  },\n  \"CUSTOM_SPL06_STOP\": {\n    \"en\": \"%1 stop continuous\"\n  },\n  \"CUSTOM_SPL06_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_spl06_init';\nBlockly.BlockRegExpList['custom_spl06'] = {\n  regexp: new RegExp(/^custom_spl06_/),\n  code: \"from Spl06 import Spl06\",\n  initBlockType: initType,\n  categoryId: 'custom_spl06',\n}\nBlockly.utils.registerLanguages(CUSTOM_SPL06_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SPL06_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SPL06 = 'Spl06'\n\nBlockly.utils.getcustom_spl06Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['spl06_0', 'spl06_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_spl06_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_spl06Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'spl06_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Spl06(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_spl06_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.pressure()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_spl06_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_spl06_altitude\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_ALTITUDE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_altitude\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.altitude()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_spl06_set_pressure_config\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_SET_PRESSURE_CONFIG,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'oversampling'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rate'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_set_pressure_config\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var oversampling = Blockly.Python.valueToCode(block, 'oversampling', Blockly.Python.ORDER_FUNCTION_CALL);\n  var rate = Blockly.Python.valueToCode(block, 'rate', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pressure_config(${oversampling}, ${rate})\\n`\n}\n\nBlockly.Blocks[\"custom_spl06_set_temperature_config\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_SET_TEMPERATURE_CONFIG,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'oversampling'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rate'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_set_temperature_config\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var oversampling = Blockly.Python.valueToCode(block, 'oversampling', Blockly.Python.ORDER_FUNCTION_CALL);\n  var rate = Blockly.Python.valueToCode(block, 'rate', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_temperature_config(${oversampling}, ${rate})\\n`\n}\n\nBlockly.Blocks[\"custom_spl06_start_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_START_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_start_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.start_continuous()\\n`\n}\n\nBlockly.Blocks[\"custom_spl06_stop\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_STOP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_stop\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.stop()\\n`\n}\n\nBlockly.Blocks[\"custom_spl06_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SPL06_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_spl06Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_spl06_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}",
    "toolbox": "\n<category name=\"Spl06\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_spl06\">\n<title text=\"Spl06\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_spl06_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">119</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_spl06_pressure\"/><block type=\"custom_spl06_temperature\"/><block type=\"custom_spl06_altitude\"/><block type=\"custom_spl06_set_pressure_config\">\n  <value name=\"oversampling\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">16</field>\n    </shadow>\n  </value>\n  <value name=\"rate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_spl06_set_temperature_config\">\n  <value name=\"oversampling\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"rate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_spl06_start_continuous\"/><block type=\"custom_spl06_stop\"/><block type=\"custom_spl06_reset\"/>\n</category>\n",
