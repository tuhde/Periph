  "uiflow2": {
    "jscode": "const CUSTOM_MPL115A2_LANGUAGES = {\n  \"CUSTOM_MPL115A2_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_MPL115A2_READ_PRESSURE\": {\n    \"en\": \"%1 pressure (Pa)\"\n  },\n  \"CUSTOM_MPL115A2_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C, approximate)\"\n  },\n  \"CUSTOM_MPL115A2_READ_PRESSURE_HPA\": {\n    \"en\": \"%1 pressure (hPa)\"\n  },\n  \"CUSTOM_MPL115A2_READ_ALTITUDE\": {\n    \"en\": \"%1 altitude (m), sea-level pressure (Pa) sea_level_pa %2\"\n  },\n  \"CUSTOM_MPL115A2_COMPENSATE\": {\n    \"en\": \"%1 compensate pressure (Pa) from Padc %2 Tadc %3\"\n  },\n  \"CUSTOM_MPL115A2_RELOAD_COEFFICIENTS\": {\n    \"en\": \"%1 reload coefficients\"\n  }\n};\n\nconst initType = 'custom_mpl115a2_init';\nBlockly.BlockRegExpList['custom_mpl115a2'] = {\n  regexp: new RegExp(/^custom_mpl115a2_/),\n  code: \"from MPL115A2 import MPL115A2\",\n  initBlockType: initType,\n  categoryId: 'custom_mpl115a2',\n}\nBlockly.utils.registerLanguages(CUSTOM_MPL115A2_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MPL115A2_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MPL115A2 = 'MPL115A2'\n\nBlockly.utils.getcustom_mpl115a2Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['mpl115a2_0', 'mpl115a2_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_mpl115a2_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL115A2_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_mpl115a2Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'mpl115a2_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl115a2_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MPL115A2(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_mpl115a2_read_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL115A2_READ_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl115a2Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl115a2_read_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_pressure()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl115a2_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL115A2_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl115a2Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl115a2_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl115a2_read_pressure_hpa\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL115A2_READ_PRESSURE_HPA,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl115a2Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl115a2_read_pressure_hpa\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_pressure_hpa()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl115a2_read_altitude\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL115A2_READ_ALTITUDE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl115a2Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'sea_level_pa'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl115a2_read_altitude\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var sea_level_pa = Blockly.Python.valueToCode(block, 'sea_level_pa', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_altitude(${sea_level_pa})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl115a2_compensate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL115A2_COMPENSATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl115a2Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'padc'\n        },\n        {\n          'type': 'input_value',\n          'name': 'tadc'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl115a2_compensate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var padc = Blockly.Python.valueToCode(block, 'padc', Blockly.Python.ORDER_FUNCTION_CALL);\n  var tadc = Blockly.Python.valueToCode(block, 'tadc', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.compensate(${padc}, ${tadc})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpl115a2_reload_coefficients\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPL115A2_RELOAD_COEFFICIENTS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpl115a2Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpl115a2_reload_coefficients\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reload_coefficients()\\n`\n}\n",
    "toolbox": "\n<category name=\"MPL115A2\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mpl115a2\">\n<title text=\"MPL115A2\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mpl115a2_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">96</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpl115a2_read_pressure\"/><block type=\"custom_mpl115a2_read_temperature\"/><block type=\"custom_mpl115a2_read_pressure_hpa\"/><block type=\"custom_mpl115a2_read_altitude\">\n  <value name=\"sea_level_pa\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpl115a2_compensate\">\n  <value name=\"padc\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"tadc\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpl115a2_reload_coefficients\"/>\n</category>\n",
