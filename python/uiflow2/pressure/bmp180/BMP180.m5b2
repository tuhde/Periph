{
  "category": "BMP180",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_BMP180_LANGUAGES = {\n  \"CUSTOM_BMP180_INIT\": {\n    \"en\": \"%1 init bus %2 address %3 oss %4\"\n  },\n  \"CUSTOM_BMP180_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_BMP180_READ_PRESSURE\": {\n    \"en\": \"%1 pressure (hPa)\"\n  },\n  \"CUSTOM_BMP180_READ_ALTITUDE\": {\n    \"en\": \"%1 altitude (m), sea-level pressure (hPa) sea_level_hpa %2\"\n  }\n};\n\nconst initType = 'custom_bmp180_init';\nBlockly.BlockRegExpList['custom_bmp180'] = {\n  regexp: new RegExp(/^custom_bmp180_/),\n  code: \"from BMP180 import BMP180\",\n  initBlockType: initType,\n  categoryId: 'custom_bmp180',\n}\nBlockly.utils.registerLanguages(CUSTOM_BMP180_LANGUAGES)\n\nBlockly.Msg.CUSTOM_BMP180_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_BMP180 = 'BMP180'\n\nBlockly.utils.getcustom_bmp180Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['bmp180_0', 'bmp180_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_bmp180_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BMP180_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_bmp180Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'bmp180_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'oss'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_bmp180_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var oss = Blockly.Python.valueToCode(block, 'oss', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = BMP180(${bus}, ${address}, ${oss})\\n`\n}\n\nBlockly.Blocks[\"custom_bmp180_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BMP180_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bmp180Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bmp180_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bmp180_read_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BMP180_READ_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bmp180Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bmp180_read_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_pressure()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bmp180_read_altitude\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BMP180_READ_ALTITUDE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bmp180Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'sea_level_hpa'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bmp180_read_altitude\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var sea_level_hpa = Blockly.Python.valueToCode(block, 'sea_level_hpa', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_altitude(${sea_level_hpa})`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"BMP180\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_bmp180\"><title text=\"BMP180\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_bmp180_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">119</field>\n    </shadow>\n  </value>\n  <value name=\"oss\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bmp180_read_temperature\"/><block type=\"custom_bmp180_read_pressure\"/><block type=\"custom_bmp180_read_altitude\">\n  <value name=\"sea_level_hpa\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
