    "toolbox": "\n<category name=\"ADE7953\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ade7953\">\n<title text=\"ADE7953\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ade7953___init__\"/>\n<block type=\"custom_ade7953_voltage\"/>\n<block type=\"custom_ade7953_current\"/>\n<block type=\"custom_ade7953_current_b\"/>\n<block type=\"custom_ade7953_active_power\"/>\n<block type=\"custom_ade7953_active_energy\"/>\n<block type=\"custom_ade7953_reactive_power\"/>\n<block type=\"custom_ade7953_apparent_power\"/>\n<block type=\"custom_ade7953_power_factor\"/>\n<block type=\"custom_ade7953_line_frequency\"/>\n<block type=\"custom_ade7953_line_period\"/>\n<block type=\"custom_ade7953_waveform_sample\"/>\n</category>\n",
