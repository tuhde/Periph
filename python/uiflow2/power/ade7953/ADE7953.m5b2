    "jscode": "const CUSTOM_ADE7953_LANGUAGES = {\n  \"CUSTOM_ADE7953_INIT\": {\n    \"en\": \"%1 init ADE7953 voltage_gain %2 current_gain %3\"\n  },\n  \"CUSTOM_ADE7953_VOLTAGE\": {\n    \"en\": \"%1 read voltage (V)\"\n  },\n  \"CUSTOM_ADE7953_CURRENT\": {\n    \"en\": \"%1 read current Channel A (A)\"\n  },\n  \"CUSTOM_ADE7953_CURRENT_B\": {\n    \"en\": \"%1 read current Channel B (A)\"\n  },\n  \"CUSTOM_ADE7953_ACTIVE_POWER\": {\n    \"en\": \"%1 read active power (W)\"\n  },\n  \"CUSTOM_ADE7953_ACTIVE_ENERGY\": {\n    \"en\": \"%1 read active energy (Wh)\"\n  },\n  \"CUSTOM_ADE7953_REACTIVE_POWER\": {\n    \"en\": \"%1 read reactive power (VAR)\"\n  },\n  \"CUSTOM_ADE7953_APPARENT_POWER\": {\n    \"en\": \"%1 read apparent power (VA)\"\n  },\n  \"CUSTOM_ADE7953_POWER_FACTOR\": {\n    \"en\": \"%1 read power factor\"\n  },\n  \"CUSTOM_ADE7953_LINE_FREQUENCY\": {\n    \"en\": \"%1 read line frequency (Hz)\"\n  },\n  \"CUSTOM_ADE7953_LINE_PERIOD\": {\n    \"en\": \"%1 read line period (s)\"\n  },\n  \"CUSTOM_ADE7953_WAVEFORM_SAMPLE\": {\n    \"en\": \"%1 read waveform sample (dict)\"\n  }\n};\n\nconst initType = 'custom_ade7953_init';\nBlockly.BlockRegExpList['custom_ade7953'] = {\n  regexp: new RegExp(/^custom_ade7953_/),\n  code: \"from ADE7953 import ADE7953\",\n  initBlockType: initType,\n  categoryId: 'custom_ade7953',\n}\nBlockly.utils.registerLanguages(CUSTOM_ADE7953_LANGUAGES)\n\nBlockly.Msg.CUSTOM_ADE7953_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_ADE7953 = 'ADE7953'\n\nBlockly.utils.getcustom_ade7953Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ade7953_0', 'ade7953_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ade7953_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADE7953_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ade7953Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ade7953_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'voltage_gain'\n        },\n        {\n          'type': 'input_value',\n          'name': 'current_gain'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ade7953_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var voltage_gain = Blockly.Python.valueToCode(block, 'voltage_gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  var current_gain = Blockly.Python.valueToCode(block, 'current_gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = ADE7953(${voltage_gain}, ${current_gain})\\n`\n}\n\nBlockly.Blocks[\"custom_ade7953_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADE7953_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ade7953Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ade7953_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ade7953_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADE7953_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          '