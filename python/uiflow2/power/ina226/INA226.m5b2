  "uiflow2": {
    "jscode": "const CUSTOM_INA226_LANGUAGES = {\n  \"CUSTOM_INA226_INIT\": {\n    \"en\": \"%1 init bus %2 address %3 r_shunt %4 max_current %5\"\n  },\n  \"CUSTOM_INA226_READ_VOLTAGE\": {\n    \"en\": \"%1 bus voltage (V)\"\n  },\n  \"CUSTOM_INA226_READ_CURRENT\": {\n    \"en\": \"%1 current (A)\"\n  },\n  \"CUSTOM_INA226_READ_POWER\": {\n    \"en\": \"%1 power (W)\"\n  }\n};\n\nconst initType = 'custom_ina226_init';\nBlockly.BlockRegExpList['custom_ina226'] = {\n  regexp: new RegExp(/^custom_ina226_/),\n  code: \"from INA226 import INA226\",\n  initBlockType: initType,\n  categoryId: 'custom_ina226',\n}\nBlockly.utils.registerLanguages(CUSTOM_INA226_LANGUAGES)\n\nBlockly.Msg.CUSTOM_INA226_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_INA226 = 'INA226'\n\nBlockly.utils.getcustom_ina226Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ina226_0', 'ina226_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ina226_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_INA226_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ina226Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ina226_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_shunt'\n        },\n        {\n          'type': 'input_value',\n          'name': 'max_current'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ina226_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_shunt = Blockly.Python.valueToCode(block, 'r_shunt', Blockly.Python.ORDER_FUNCTION_CALL);\n  var max_current = Blockly.Python.valueToCode(block, 'max_current', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = INA226(${bus}, ${address}, ${r_shunt}, ${max_current})\\n`\n}\n\nBlockly.Blocks[\"custom_ina226_read_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_INA226_READ_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ina226Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ina226_read_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ina226_read_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_INA226_READ_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ina226Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ina226_read_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_current()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ina226_read_power\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_INA226_READ_POWER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ina226Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ina226_read_power\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_power()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"INA226\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ina226\"><title text=\"INA226\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ina226_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">64</field>\n    </shadow>\n  </value>\n  <value name=\"r_shunt\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.1</field>\n    </shadow>\n  </value>\n  <value name=\"max_current\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ina226_read_voltage\"/><block type=\"custom_ina226_read_current\"/><block type=\"custom_ina226_read_power\"/>\n</category>\n",
