  "uiflow2": {
    "jscode": "const CUSTOM_MAX17048_LANGUAGES = {\n  \"CUSTOM_MAX17048_INIT\": {\n    \"en\": \"%1 init bus %2 address %3 cells (1 = MAX17048, 2 = MAX17049) %4\"\n  },\n  \"CUSTOM_MAX17048_VOLTAGE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_PERCENT\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_RAW_VOLTAGE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_RAW_SOC\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_CHARGE_RATE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_VERSION\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_CHIP_ID\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SET_RCOMP\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_GET_RCOMP\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_COMPENSATE_TEMPERATURE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SET_ALERT_SOC\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_GET_ALERT_SOC\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SET_SOC_CHANGE_ALERT\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SET_VOLTAGE_ALERT\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SET_RESET_VOLTAGE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_GET_RESET_VOLTAGE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_ENABLE_VOLTAGE_RESET_ALERT\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SET_COMPARATOR_DISABLED\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SET_HIBERNATE_THRESHOLDS\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_DISABLE_HIBERNATE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_FORCE_HIBERNATE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_IS_HIBERNATING\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_ENABLE_SLEEP\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_SLEEP\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_WAKE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_READ_STATUS\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_CLEAR_STATUS\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_POLL_INTERRUPT\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_QUICK_START\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_MAX17048_RESET\": {\n    \"en\": \"{l}\"\n  }\n};\n\nconst initType = 'custom_max17048_init';\nBlockly.BlockRegExpList['custom_max17048'] = {\n  regexp: new RegExp(/^custom_max17048_/),\n  code: \"from MAX17048 import MAX17048\",\n  initBlockType: initType,\n  categoryId: 'custom_max17048',\n}\nBlockly.utils.registerLanguages(CUSTOM_MAX17048_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MAX17048_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MAX17048 = 'MAX17048'\n\nBlockly.utils.getcustom_max17048Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['max17048_0', 'max17048_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_max17048_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX17048_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_max17048Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'max17048_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cells'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_max17048_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cells = Blockly.Python.valueToCode(block, 'cells', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MAX17048(${bus}, ${address}, ${cells})\\n`\n}\n\nBlockly.Blocks[\"custom_max17048_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX17048_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max17048Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max17048_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_max17048_percent\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX17048_PERCENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max17048Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_max17048_percent\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.percent()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_max17048_raw_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MAX17048_RAW_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_max17048Options\n        },\n      ],\n 