    "jscode": "const CUSTOM_AXP2101_LANGUAGES = {\n  \"CUSTOM_AXP2101_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_AXP2101_BATTERY_VOLTAGE\": {\n    \"en\": \"%1 battery voltage (V)\"\n  },\n  \"CUSTOM_AXP2101_BATTERY_PERCENT\": {\n    \"en\": \"%1 battery level (%)\"\n  },\n  \"CUSTOM_AXP2101_CHARGE_STATE\": {\n    \"en\": \"%1 charge state (0=trickle 1=pre 2=CC 3=CV 4=done 5=none)\"\n  },\n  \"CUSTOM_AXP2101_VBUS_PRESENT\": {\n    \"en\": \"%1 VBUS present?\"\n  },\n  \"CUSTOM_AXP2101_VBUS_VOLTAGE\": {\n    \"en\": \"%1 VBUS voltage (V)\"\n  },\n  \"CUSTOM_AXP2101_SYSTEM_VOLTAGE\": {\n    \"en\": \"%1 system voltage (V)\"\n  },\n  \"CUSTOM_AXP2101_DIE_TEMPERATURE\": {\n    \"en\": \"%1 die temperature (C)\"\n  },\n  \"CUSTOM_AXP2101_SET_CHARGING\": {\n    \"en\": \"%1 charging (0=off 1=on) %2\"\n  },\n  \"CUSTOM_AXP2101_SET_CHARGE_VOLTAGE\": {\n    \"en\": \"%1 set charge voltage (V: 4.0 4.1 4.2 4.35 4.4) %2\"\n  },\n  \"CUSTOM_AXP2101_SET_CHARGE_CURRENT\": {\n    \"en\": \"%1 set charge current (A, 0 to 1.5) %2\"\n  },\n  \"CUSTOM_AXP2101_SET_INPUT_CURRENT_LIMIT\": {\n    \"en\": \"%1 set input current limit (A: 0.1 0.5 0.9 1.0 1.5 2.0) %2\"\n  },\n  \"CUSTOM_AXP2101_SET_GPIO1\": {\n    \"en\": \"%1 GPIO1 (0=Hi-Z 1=drive low) %2\"\n  }\n};\n\nconst initType = 'custom_axp2101_init';\nBlockly.BlockRegExpList['custom_axp2101'] = {\n  regexp: new RegExp(/^custom_axp2101_/),\n  code: \"from AXP2101 import AXP2101\",\n  initBlockType: initType,\n  categoryId: 'custom_axp2101',\n}\nBlockly.utils.registerLanguages(CUSTOM_AXP2101_LANGUAGES)\n\nBlockly.Msg.CUSTOM_AXP2101_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_AXP2101 = 'AXP2101'\n\nBlockly.utils.getcustom_axp2101Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['axp2101_0', 'axp2101_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_axp2101_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_axp2101Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'axp2101_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = AXP2101(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_axp2101_battery_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_BATTERY_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_battery_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.battery_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_axp2101_battery_percent\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_BATTERY_PERCENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_battery_percent\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.battery_percent()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_axp2101_charge_state\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_CHARGE_STATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_charge_state\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.charge_state()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_axp2101_vbus_present\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_VBUS_PRESENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_vbus_present\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.vbus_present()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_axp2101_vbus_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_VBUS_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_vbus_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.vbus_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_axp2101_system_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_SYSTEM_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_system_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.system_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_axp2101_die_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_DIE_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_die_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.die_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_axp2101_set_charging\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_SET_CHARGING,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_set_charging\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_charging(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_axp2101_set_charge_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_SET_CHARGE_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'volts'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_set_charge_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var volts = Blockly.Python.valueToCode(block, 'volts', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_charge_voltage(${volts})\\n`\n}\n\nBlockly.Blocks[\"custom_axp2101_set_charge_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_SET_CHARGE_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'amps'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_set_charge_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var amps = Blockly.Python.valueToCode(block, 'amps', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_charge_current(${amps})\\n`\n}\n\nBlockly.Blocks[\"custom_axp2101_set_input_current_limit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_SET_INPUT_CURRENT_LIMIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'amps'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_set_input_current_limit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var amps = Blockly.Python.valueToCode(block, 'amps', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_input_current_limit(${amps})\\n`\n}\n\nBlockly.Blocks[\"custom_axp2101_set_gpio1\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AXP2101_SET_GPIO1,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_axp2101Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'low'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_axp2101_set_gpio1\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var low = Blockly.Python.valueToCode(block, 'low', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_gpio1(${low})\\n`\n}\n",
    "toolbox": "\n<category name=\"AXP2101\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_axp2101\">\n<title text=\"AXP2101\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_axp2101_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">52</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_axp2101_battery_voltage\"/><block type=\"custom_axp2101_battery_percent\"/><block type=\"custom_axp2101_charge_state\"/><block type=\"custom_axp2101_vbus_present\"/><block type=\"custom_axp2101_vbus_voltage\"/><block type=\"custom_axp2101_system_voltage\"/><block type=\"custom_axp2101_die_temperature\"/><block type=\"custom_axp2101_set_charging\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_axp2101_set_charge_voltage\">\n  <value name=\"volts\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4.2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_axp2101_set_charge_current\">\n  <value name=\"amps\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_axp2101_set_input_current_limit\">\n  <value name=\"amps\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_axp2101_set_gpio1\">\n  <value name=\"low\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
