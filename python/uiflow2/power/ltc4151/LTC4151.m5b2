    "jscode": "const CUSTOM_LTC4151_LANGUAGES = {\n  \"CUSTOM_LTC4151_INIT\": {\n    \"en\": \"%1 init bus %2 address %3 sense resistor (mOhm) %4\"\n  },\n  \"CUSTOM_LTC4151_VOLTAGE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_CURRENT\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_POWER\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_SENSE_VOLTAGE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_ADIN_VOLTAGE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_READ_RAW\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_SET_SENSE_RESISTOR\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_GET_SENSE_RESISTOR\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_SNAPSHOT\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_SET_CONTINUOUS\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_IS_SNAPSHOT_MODE\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_IS_BUSY\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_SET_STUCK_BUS_TIMER\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_SET_PAGE_RW\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_READ_CONTROL\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_WRITE_CONTROL\": {\n    \"en\": \"{l}\"\n  },\n  \"CUSTOM_LTC4151_TEMPERATURE_FROM_ADIN\": {\n    \"en\": \"{l}\"\n  }\n};\n\nconst initType = 'custom_ltc4151_init';\nBlockly.BlockRegExpList['custom_ltc4151'] = {\n  regexp: new RegExp(/^custom_ltc4151_/),\n  code: \"from LTC4151 import LTC4151\",\n  initBlockType: initType,\n  categoryId: 'custom_ltc4151',\n}\nBlockly.utils.registerLanguages(CUSTOM_LTC4151_LANGUAGES)\n\nBlockly.Msg.CUSTOM_LTC4151_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_LTC4151 = 'LTC4151'\n\nBlockly.utils.getcustom_ltc4151Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ltc4151_0', 'ltc4151_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ltc4151_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ltc4151Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ltc4151_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'sense_milliohms'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var sense_milliohms = Blockly.Python.valueToCode(block, 'sense_milliohms', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = LTC4151(${bus}, ${address}, ${sense_milliohms})\\n`\n}\n\nBlockly.Blocks[\"custom_ltc4151_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.current()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_power\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_POWER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_power\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.power()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_sense_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_SENSE_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_sense_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.sense_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_adin_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_ADIN_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_adin_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.adin_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_read_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_READ_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_read_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.read_raw(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_set_sense_resistor\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_SET_SENSE_RESISTOR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'milliohms'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_set_sense_resistor\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var milliohms = Blockly.Python.valueToCode(block, 'milliohms', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_sense_resistor(${milliohms})\\n`\n}\n\nBlockly.Blocks[\"custom_ltc4151_get_sense_resistor\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_GET_SENSE_RESISTOR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_get_sense_resistor\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_sense_resistor()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_snapshot\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_SNAPSHOT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_snapshot\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.snapshot(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_set_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_SET_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_set_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.set_continuous()\\n`\n}\n\nBlockly.Blocks[\"custom_ltc4151_is_snapshot_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_IS_SNAPSHOT_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_is_snapshot_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_snapshot_mode()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_is_busy\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_IS_BUSY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_is_busy\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.is_busy(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_set_stuck_bus_timer\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_SET_STUCK_BUS_TIMER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_set_stuck_bus_timer\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_stuck_bus_timer(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_ltc4151_set_page_rw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_SET_PAGE_RW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_set_page_rw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_page_rw(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_ltc4151_read_control\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_READ_CONTROL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_read_control\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_control()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ltc4151_write_control\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_WRITE_CONTROL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_write_control\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_control(${value})\\n`\n}\n\nBlockly.Blocks[\"custom_ltc4151_temperature_from_adin\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LTC4151_TEMPERATURE_FROM_ADIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ltc4151Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'adin_code'\n        },\n        {\n          'type': 'input_value',\n          'name': 'vin_code'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ltc4151_temperature_from_adin\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var adin_code = Blockly.Python.valueToCode(block, 'adin_code', Blockly.Python.ORDER_FUNCTION_CALL);\n  var vin_code = Blockly.Python.valueToCode(block, 'vin_code', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.temperature_from_adin(${adin_code}, ${vin_code})`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"LTC4151\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ltc4151\">\n<title text=\"LTC4151\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ltc4151_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">106</field>\n    </shadow>\n  </value>\n  <value name=\"sense_milliohms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">20</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_voltage\"/><block type=\"custom_ltc4151_current\"/><block type=\"custom_ltc4151_power\"/><block type=\"custom_ltc4151_sense_voltage\"/><block type=\"custom_ltc4151_adin_voltage\"/><block type=\"custom_ltc4151_read_raw\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_set_sense_resistor\">\n  <value name=\"milliohms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">20</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_get_sense_resistor\"/><block type=\"custom_ltc4151_snapshot\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_set_continuous\"/><block type=\"custom_ltc4151_is_snapshot_mode\"/><block type=\"custom_ltc4151_is_busy\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_set_stuck_bus_timer\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_set_page_rw\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_read_control\"/><block type=\"custom_ltc4151_write_control\">\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">12</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ltc4151_temperature_from_adin\">\n  <value name=\"adin_code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">900</field>\n    </shadow>\n  </value>\n  <value name=\"vin_code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1200</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
