  "uiflow2": {
    "jscode": "const CUSTOM_TPIC6B595_LANGUAGES = {\n  \"CUSTOM_TPIC6B595_INIT\": {\n    \"en\": \"%1 init bus %2 device %3 rck %4 srclr %5 g %6 num_devices %7\"\n  },\n  \"CUSTOM_TPIC6B595_WRITE_PIN\": {\n    \"en\": \"%1 write pin value (0/1) pin %2 value %3\"\n  },\n  \"CUSTOM_TPIC6B595_WRITE_PORT\": {\n    \"en\": \"%1 write device byte (port) %2 mask (0x00-0xFF) %3\"\n  },\n  \"CUSTOM_TPIC6B595_FILL\": {\n    \"en\": \"%1 fill all outputs (0/1) value %2\"\n  },\n  \"CUSTOM_TPIC6B595_OFF\": {\n    \"en\": \"%1 turn every output off\"\n  },\n  \"CUSTOM_TPIC6B595_CLEAR\": {\n    \"en\": \"%1 pulse SRCLR (shift-register clear)\"\n  },\n  \"CUSTOM_TPIC6B595_SET_OUTPUT_ENABLE\": {\n    \"en\": \"%1 set output enable (0/1) via G enabled %2\"\n  },\n  \"CUSTOM_TPIC6B595_WRITE_ALL\": {\n    \"en\": \"%1 write all device bytes [d0 %2 d1 %3]\"\n  }\n};\n\nconst initType = 'custom_tpic6b595_init';\nBlockly.BlockRegExpList['custom_tpic6b595'] = {\n  regexp: new RegExp(/^custom_tpic6b595_/),\n  code: \"from Tpic6b595 import Tpic6b595\",\n  initBlockType: initType,\n  categoryId: 'custom_tpic6b595',\n}\nBlockly.utils.registerLanguages(CUSTOM_TPIC6B595_LANGUAGES)\n\nBlockly.Msg.CUSTOM_TPIC6B595_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_TPIC6B595 = 'Tpic6b595'\n\nBlockly.utils.getcustom_tpic6b595Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['tpic6b595_0', 'tpic6b595_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_tpic6b595_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_tpic6b595Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'tpic6b595_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'device'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rck'\n        },\n        {\n          'type': 'input_value',\n          'name': 'srclr'\n        },\n        {\n          'type': 'input_value',\n          'name': 'g'\n        },\n        {\n          'type': 'input_value',\n          'name': 'num_devices'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var device = Blockly.Python.valueToCode(block, 'device', Blockly.Python.ORDER_FUNCTION_CALL);\n  var rck = Blockly.Python.valueToCode(block, 'rck', Blockly.Python.ORDER_FUNCTION_CALL);\n  var srclr = Blockly.Python.valueToCode(block, 'srclr', Blockly.Python.ORDER_FUNCTION_CALL);\n  var g = Blockly.Python.valueToCode(block, 'g', Blockly.Python.ORDER_FUNCTION_CALL);\n  var num_devices = Blockly.Python.valueToCode(block, 'num_devices', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Tpic6b595(${bus}, ${device}, ${rck}, ${srclr}, ${g}, ${num_devices})\\n`\n}\n\nBlockly.Blocks[\"custom_tpic6b595_write_pin\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_WRITE_PIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tpic6b595Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_write_pin\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pin = Blockly.Python.valueToCode(block, 'pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_pin(${pin}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_tpic6b595_write_port\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_WRITE_PORT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tpic6b595Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'port'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mask'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_write_port\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var port = Blockly.Python.valueToCode(block, 'port', Blockly.Python.ORDER_FUNCTION_CALL);\n  var mask = Blockly.Python.valueToCode(block, 'mask', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_port(${port}, ${mask})\\n`\n}\n\nBlockly.Blocks[\"custom_tpic6b595_fill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_FILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tpic6b595Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_fill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill(${value})\\n`\n}\n\nBlockly.Blocks[\"custom_tpic6b595_off\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_OFF,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tpic6b595Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_off\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.off()\\n`\n}\n\nBlockly.Blocks[\"custom_tpic6b595_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tpic6b595Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear()\\n`\n}\n\nBlockly.Blocks[\"custom_tpic6b595_set_output_enable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_SET_OUTPUT_ENABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tpic6b595Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_set_output_enable\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_output_enable(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_tpic6b595_write_all\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TPIC6B595_WRITE_ALL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tpic6b595Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'd0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'd1'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tpic6b595_write_all\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var d0 = Blockly.Python.valueToCode(block, 'd0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var d1 = Blockly.Python.valueToCode(block, 'd1', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_all(${d0}, ${d1})\\n`\n}\n",
    "toolbox": "\n<category name=\"Tpic6b595\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_tpic6b595\">\n<title text=\"Tpic6b595\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_tpic6b595_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"device\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"rck\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">17</field>\n    </shadow>\n  </value>\n  <value name=\"srclr\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">-1</field>\n    </shadow>\n  </value>\n  <value name=\"g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">-1</field>\n    </shadow>\n  </value>\n  <value name=\"num_devices\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tpic6b595_write_pin\">\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tpic6b595_write_port\">\n  <value name=\"port\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"mask\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tpic6b595_fill\">\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tpic6b595_off\"/><block type=\"custom_tpic6b595_clear\"/><block type=\"custom_tpic6b595_set_output_enable\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tpic6b595_write_all\">\n  <value name=\"d0\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"d1\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
