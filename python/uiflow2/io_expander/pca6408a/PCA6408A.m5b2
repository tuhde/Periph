  "uiflow2": {
    "jscode": "const CUSTOM_PCA6408A_LANGUAGES = {\n  \"CUSTOM_PCA6408A_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_PCA6408A_SET_PIN_MODE\": {\n    \"en\": \"%1 set pin mode: IN=0, OUT=1 pin %2 mode %3\"\n  },\n  \"CUSTOM_PCA6408A_WRITE_PIN\": {\n    \"en\": \"%1 write pin value (0/1) pin %2 value %3\"\n  },\n  \"CUSTOM_PCA6408A_READ_PIN\": {\n    \"en\": \"%1 read pin pin %2\"\n  },\n  \"CUSTOM_PCA6408A_READ_PORT\": {\n    \"en\": \"%1 read port (8 pins)\"\n  },\n  \"CUSTOM_PCA6408A_WRITE_PORT\": {\n    \"en\": \"%1 write port mask (0-255) mask %2\"\n  },\n  \"CUSTOM_PCA6408A_CONFIGURE_POLARITY\": {\n    \"en\": \"%1 input polarity mask (0-255) mask %2\"\n  },\n  \"CUSTOM_PCA6408A_SET_DIRECTION\": {\n    \"en\": \"%1 direction mask, 1=input (0-255) mask %2\"\n  },\n  \"CUSTOM_PCA6408A_GET_DIRECTION\": {\n    \"en\": \"%1 read direction mask\"\n  },\n  \"CUSTOM_PCA6408A_POLL_INTERRUPT\": {\n    \"en\": \"%1 poll changed-pin mask (clears INT)\"\n  },\n  \"CUSTOM_PCA6408A_RESET\": {\n    \"en\": \"%1 reset registers to defaults\"\n  }\n};\n\nconst initType = 'custom_pca6408a_init';\nBlockly.BlockRegExpList['custom_pca6408a'] = {\n  regexp: new RegExp(/^custom_pca6408a_/),\n  code: \"from PCA6408A import PCA6408A\",\n  initBlockType: initType,\n  categoryId: 'custom_pca6408a',\n}\nBlockly.utils.registerLanguages(CUSTOM_PCA6408A_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PCA6408A_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_PCA6408A = 'PCA6408A'\n\nBlockly.utils.getcustom_pca6408aOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pca6408a_0', 'pca6408a_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_pca6408a_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pca6408aOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pca6408a_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = PCA6408A(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_pca6408a_set_pin_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_SET_PIN_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_set_pin_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pin = Blockly.Python.valueToCode(block, 'pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pin_mode(${pin}, ${mode})\\n`\n}\n\nBlockly.Blocks[\"custom_pca6408a_write_pin\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_WRITE_PIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_write_pin\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pin = Blockly.Python.valueToCode(block, 'pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_pin(${pin}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_pca6408a_read_pin\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_READ_PIN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'pin'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_read_pin\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pin = Blockly.Python.valueToCode(block, 'pin', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_pin(${pin})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca6408a_read_port\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_READ_PORT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_read_port\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_port()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca6408a_write_port\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_WRITE_PORT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'mask'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_write_port\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mask = Blockly.Python.valueToCode(block, 'mask', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_port(${mask})\\n`\n}\n\nBlockly.Blocks[\"custom_pca6408a_configure_polarity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_CONFIGURE_POLARITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'mask'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_configure_polarity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mask = Blockly.Python.valueToCode(block, 'mask', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure_polarity(${mask})\\n`\n}\n\nBlockly.Blocks[\"custom_pca6408a_set_direction\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_SET_DIRECTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'mask'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_set_direction\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mask = Blockly.Python.valueToCode(block, 'mask', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_direction(${mask})\\n`\n}\n\nBlockly.Blocks[\"custom_pca6408a_get_direction\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_GET_DIRECTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_get_direction\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_direction()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca6408a_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca6408a_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA6408A_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca6408aOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca6408a_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}\n",
    "toolbox": "\n<category name=\"PCA6408A\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_pca6408a\">\n<title text=\"PCA6408A\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_pca6408a_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">32</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pca6408a_set_pin_mode\">\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pca6408a_write_pin\">\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pca6408a_read_pin\">\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pca6408a_read_port\"/><block type=\"custom_pca6408a_write_port\">\n  <value name=\"mask\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pca6408a_configure_polarity\">\n  <value name=\"mask\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pca6408a_set_direction\">\n  <value name=\"mask\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pca6408a_get_direction\"/><block type=\"custom_pca6408a_poll_interrupt\"/><block type=\"custom_pca6408a_reset\"/>\n</catego