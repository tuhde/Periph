{
  "category": "LIS3DH",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_LIS3DH_LANGUAGES = {\n  \"CUSTOM_LIS3DH_INIT\": {\n    \"en\": \"%1 init I2C bus %2 address %3\"\n  },\n  \"CUSTOM_LIS3DH_X\": {\n    \"en\": \"%1 acceleration X (g)\"\n  },\n  \"CUSTOM_LIS3DH_Y\": {\n    \"en\": \"%1 acceleration Y (g)\"\n  },\n  \"CUSTOM_LIS3DH_Z\": {\n    \"en\": \"%1 acceleration Z (g)\"\n  },\n  \"CUSTOM_LIS3DH_SET_RANGE\": {\n    \"en\": \"%1 set range %2 g\"\n  },\n  \"CUSTOM_LIS3DH_SET_DATA_RATE\": {\n    \"en\": \"%1 set data rate %2 Hz\"\n  },\n  \"CUSTOM_LIS3DH_SET_MODE\": {\n    \"en\": \"%1 set mode %2 (0=low-power 8-bit, 1=normal 10-bit, 2=high-res 12-bit)\"\n  },\n  \"CUSTOM_LIS3DH_SET_AXES\": {\n    \"en\": \"%1 set axes X %2 Y %3 Z %4\"\n  },\n  \"CUSTOM_LIS3DH_POWER_DOWN\": {\n    \"en\": \"%1 power down (stop conversions)\"\n  },\n  \"CUSTOM_LIS3DH_READ_RAW\": {\n    \"en\": \"%1 raw acceleration (x, y, z counts)\"\n  },\n  \"CUSTOM_LIS3DH_NEW_DATA_AVAILABLE\": {\n    \"en\": \"%1 new data available?\"\n  },\n  \"CUSTOM_LIS3DH_READ_STATUS\": {\n    \"en\": \"%1 STATUS_REG (overrun and data-ready flags)\"\n  },\n  \"CUSTOM_LIS3DH_READ_TEMPERATURE_DELTA\": {\n    \"en\": \"%1 relative temperature (°C)\"\n  },\n  \"CUSTOM_LIS3DH_READ_ADC\": {\n    \"en\": \"%1 aux ADC voltage (V), channel %2\"\n  },\n  \"CUSTOM_LIS3DH_ENABLE_ADC\": {\n    \"en\": \"%1 enable aux ADC %2 (1=on, 0=off)\"\n  },\n  \"CUSTOM_LIS3DH_SET_HIGH_PASS\": {\n    \"en\": \"%1 set high-pass mode %2 cutoff %3 output %4 generator1 %5 generator2 %6 click %7\"\n  },\n  \"CUSTOM_LIS3DH_RESET_HIGH_PASS\": {\n    \"en\": \"%1 reset high-pass filter (returns REFERENCE)\"\n  },\n  \"CUSTOM_LIS3DH_SET_REFERENCE\": {\n    \"en\": \"%1 set high-pass reference %2\"\n  },\n  \"CUSTOM_LIS3DH_SET_FIFO\": {\n    \"en\": \"%1 set FIFO mode %2 (0=bypass, 1=FIFO, 2=stream, 3=stream-to-FIFO) watermark %3 trigger INT2 %4\"\n  },\n  \"CUSTOM_LIS3DH_FIFO_LEVEL\": {\n    \"en\": \"%1 FIFO level (unread sample sets)\"\n  },\n  \"CUSTOM_LIS3DH_READ_FIFO\": {\n    \"en\": \"%1 read FIFO samples (x, y, z in g), count 0 = all\"\n  },\n  \"CUSTOM_LIS3DH_READ_FIFO_STATUS\": {\n    \"en\": \"%1 FIFO status (watermark, overrun, empty, level)\"\n  },\n  \"CUSTOM_LIS3DH_SET_MOTION_INTERRUPT\": {\n    \"en\": \"%1 set motion interrupt generator %2 events %3 threshold %4 g duration %5 ms AND %6\"\n  },\n  \"CUSTOM_LIS3DH_SET_FREE_FALL\": {\n    \"en\": \"%1 set free-fall generator %2 threshold %3 g duration %4 ms\"\n  },\n  \"CUSTOM_LIS3DH_SET_ORIENTATION\": {\n    \"en\": \"%1 set orientation generator %2 position %3 4D %4\"\n  },\n  \"CUSTOM_LIS3DH_SET_LATCH\": {\n    \"en\": \"%1 latch generator %2 interrupt %3 (1=on, 0=off)\"\n  },\n  \"CUSTOM_LIS3DH_READ_INTERRUPT_SOURCE\": {\n    \"en\": \"%1 read INTx_SRC generator %2 (reading clears the interrupt)\"\n  },\n  \"CUSTOM_LIS3DH_SET_CLICK\": {\n    \"en\": \"%1 set click single %2 double %3 threshold %4 g limit %5 ms latency %6 ms window %7 ms latch %8\"\n  },\n  \"CUSTOM_LIS3DH_READ_CLICK_SOURCE\": {\n    \"en\": \"%1 read CLICK_SRC (reading clears the interrupt)\"\n  },\n  \"CUSTOM_LIS3DH_SET_ACTIVITY\": {\n    \"en\": \"%1 set activity threshold %2 g duration %3 ms\"\n  },\n  \"CUSTOM_LIS3DH_SET_INTERRUPT_POLARITY\": {\n    \"en\": \"%1 interrupt polarity active-low %2 (1=active-low, 0=active-high)\"\n  },\n  \"CUSTOM_LIS3DH_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt source %2 on INT%3\"\n  },\n  \"CUSTOM_LIS3DH_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt source %2 on INT%3\"\n  },\n  \"CUSTOM_LIS3DH_OFF_INTERRUPT\": {\n    \"en\": \"%1 unsubscribe from INT%2 interrupts\"\n  },\n  \"CUSTOM_LIS3DH_POLL_INTERRUPT\": {\n    \"en\": \"%1 poll interrupt status (bitmask)\"\n  },\n  \"CUSTOM_LIS3DH_REBOOT\": {\n    \"en\": \"%1 reboot (reload factory trim)\"\n  },\n  \"CUSTOM_LIS3DH_SET_SDO_PULLUP\": {\n    \"en\": \"%1 SDO/SA0 pull-up connected %2 (1=connected, 0=disconnected)\"\n  },\n  \"CUSTOM_LIS3DH_SELF_TEST\": {\n    \"en\": \"%1 self-test mode %2 (1=self-test 0, 2=self-test 1)\"\n  }\n};\n\nconst initType = 'custom_lis3dh_init';\nBlockly.BlockRegExpList['custom_lis3dh'] = {\n  regexp: new RegExp(/^custom_lis3dh_/),\n  code: \"from LIS3DH import LIS3DH\",\n  initBlockType: initType,\n  categoryId: 'custom_lis3dh',\n}\nBlockly.utils.registerLanguages(CUSTOM_LIS3DH_LANGUAGES)\n\nBlockly.Msg.CUSTOM_LIS3DH_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_LIS3DH = 'LIS3DH'\n\nBlockly.utils.getcustom_lis3dhOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['lis3dh_0', 'lis3dh_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_lis3dh_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_lis3dhOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'lis3dh_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = LIS3DH(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_lis3dh_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lis3dh_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lis3dh_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_z\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.z()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lis3dh_set_range\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_SET_RANGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'range_g'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_set_range\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var range_g = Blockly.Python.valueToCode(block, 'range_g', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_range(${range_g})\\n`\n}\n\nBlockly.Blocks[\"custom_lis3dh_set_data_rate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_SET_DATA_RATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'rate_hz'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_set_data_rate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var rate_hz = Blockly.Python.valueToCode(block, 'rate_hz', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_data_rate(${rate_hz})\\n`\n}\n\nBlockly.Blocks[\"custom_lis3dh_set_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_SET_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n        {\n          'type': 'input_value',\n     