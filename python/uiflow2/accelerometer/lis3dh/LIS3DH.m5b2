nit: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_ENABLE_ADC,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_enable_adc\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.enable_adc(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_lis3dh_set_high_pass\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LIS3DH_SET_HIGH_PASS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lis3dhOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cutoff'\n        },\n        {\n          'type': 'input_value',\n          'name': 'filter_output'\n        },\n        {\n          'type': 'input_value',\n          'name': 'on_ia1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'on_ia2'\n        },\n        {\n          'type': 'input_value',\n          'name': 'on_click'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lis3dh_set_high_pass\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var 