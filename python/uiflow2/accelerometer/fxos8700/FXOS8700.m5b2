{
  "category": "FXOS8700",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_FXOS8700_LANGUAGES = {\n  \"CUSTOM_FXOS8700_INIT\": {\n    \"en\": \"%1 init I2C bus %2 address %3 (0x1C-0x1F; default 0x1E = 30)\"\n  },\n  \"CUSTOM_FXOS8700_ACCEL_X\": {\n    \"en\": \"%1 acceleration X (g)\"\n  },\n  \"CUSTOM_FXOS8700_ACCEL_Y\": {\n    \"en\": \"%1 acceleration Y (g)\"\n  },\n  \"CUSTOM_FXOS8700_ACCEL_Z\": {\n    \"en\": \"%1 acceleration Z (g)\"\n  },\n  \"CUSTOM_FXOS8700_MAG_X\": {\n    \"en\": \"%1 magnetic field X (µT)\"\n  },\n  \"CUSTOM_FXOS8700_MAG_Y\": {\n    \"en\": \"%1 magnetic field Y (µT)\"\n  },\n  \"CUSTOM_FXOS8700_MAG_Z\": {\n    \"en\": \"%1 magnetic field Z (µT)\"\n  },\n  \"CUSTOM_FXOS8700_HEADING\": {\n    \"en\": \"%1 tilt-compensated heading (deg), declination %2 deg\"\n  },\n  \"CUSTOM_FXOS8700_TEMPERATURE\": {\n    \"en\": \"%1 die temperature (°C, relative)\"\n  },\n  \"CUSTOM_FXOS8700_NEW_ACCEL_DATA\": {\n    \"en\": \"%1 new accelerometer data?\"\n  },\n  \"CUSTOM_FXOS8700_NEW_MAG_DATA\": {\n    \"en\": \"%1 new magnetometer data?\"\n  },\n  \"CUSTOM_FXOS8700_SYSTEM_MODE\": {\n    \"en\": \"%1 system mode (0=standby, 1=wake, 2=sleep)\"\n  },\n  \"CUSTOM_FXOS8700_SET_MODE\": {\n    \"en\": \"%1 set mode %2 (0=accel only, 1=mag only, 2=hybrid)\"\n  },\n  \"CUSTOM_FXOS8700_SET_RANGE\": {\n    \"en\": \"%1 set accelerometer range %2 g (2, 4 or 8)\"\n  },\n  \"CUSTOM_FXOS8700_SET_DATA_RATE\": {\n    \"en\": \"%1 set system data rate %2 Hz\"\n  },\n  \"CUSTOM_FXOS8700_SET_ACCEL_OVERSAMPLING\": {\n    \"en\": \"%1 set accelerometer oversampling %2 (0=normal, 1=low-noise, 2=high-res, 3=low-power)\"\n  },\n  \"CUSTOM_FXOS8700_SET_MAG_OVERSAMPLING\": {\n    \"en\": \"%1 set magnetometer oversampling ratio code %2 (0-7)\"\n  },\n  \"CUSTOM_FXOS8700_SET_LOW_NOISE\": {\n    \"en\": \"%1 set low-noise mode %2 (1=on, 0=off)\"\n  },\n  \"CUSTOM_FXOS8700_STANDBY\": {\n    \"en\": \"%1 enter standby\"\n  },\n  \"CUSTOM_FXOS8700_ACTIVATE\": {\n    \"en\": \"%1 activate (leave standby)\"\n  },\n  \"CUSTOM_FXOS8700_RESET\": {\n    \"en\": \"%1 software reset (call init afterwards)\"\n  },\n  \"CUSTOM_FXOS8700_SET_ACCEL_OFFSET\": {\n    \"en\": \"%1 set accelerometer offset X %2 Y %3 Z %4 (g)\"\n  },\n  \"CUSTOM_FXOS8700_SET_MAG_OFFSET\": {\n    \"en\": \"%1 set hard-iron offset X %2 Y %3 Z %4 (µT)\"\n  },\n  \"CUSTOM_FXOS8700_SET_MAG_AUTO_CALIBRATION\": {\n    \"en\": \"%1 set hard-iron auto-calibration %2 (1=on, 0=off)\"\n  },\n  \"CUSTOM_FXOS8700_RESET_MAG_MIN_MAX\": {\n    \"en\": \"%1 reset magnetic min/max tracker\"\n  },\n  \"CUSTOM_FXOS8700_TRIGGER_MAG_RESET\": {\n    \"en\": \"%1 trigger one-shot magnetic reset\"\n  },\n  \"CUSTOM_FXOS8700_SET_FIFO\": {\n    \"en\": \"%1 set FIFO mode %2 (0=off, 1=circular, 2=fill, 3=trigger) watermark %3\"\n  },\n  \"CUSTOM_FXOS8700_FIFO_LEVEL\": {\n    \"en\": \"%1 FIFO level (samples)\"\n  },\n  \"CUSTOM_FXOS8700_SET_FREEFALL_MOTION\": {\n    \"en\": \"%1 set freefall/motion: motion %2 (1=motion, 0=freefall) threshold %3 g debounce %4 ms latch %5\"\n  },\n  \"CUSTOM_FXOS8700_READ_MOTION_SOURCE\": {\n    \"en\": \"%1 freefall/motion source register\"\n  },\n  \"CUSTOM_FXOS8700_SET_TRANSIENT\": {\n    \"en\": \"%1 set transient detector threshold %2 g debounce %3 ms\"\n  },\n  \"CUSTOM_FXOS8700_READ_TRANSIENT_SOURCE\": {\n    \"en\": \"%1 transient source register (clears interrupt)\"\n  },\n  \"CUSTOM_FXOS8700_SET_PULSE\": {\n    \"en\": \"%1 set tap detection single axes %2 double axes %3 (mask X=1 Y=2 Z=4)\"\n  },\n  \"CUSTOM_FXOS8700_READ_PULSE_SOURCE\": {\n    \"en\": \"%1 tap source register (clears interrupt)\"\n  },\n  \"CUSTOM_FXOS8700_SET_ORIENTATION\": {\n    \"en\": \"%1 set orientation detection debounce %2 ms\"\n  },\n  \"CUSTOM_FXOS8700_ORIENTATION\": {\n    \"en\": \"%1 orientation (0=portrait up, 1=down, 2=landscape right, 3=left)\"\n  },\n  \"CUSTOM_FXOS8700_SET_AUTO_SLEEP\": {\n    \"en\": \"%1 set auto-sleep %2 (1=on) rate %3 Hz timeout %4 s wake sources %5\"\n  },\n  \"CUSTOM_FXOS8700_SET_INTERRUPT_PINS\": {\n    \"en\": \"%1 set INT pins active-high %2 open-drain %3 (1=yes)\"\n  },\n  \"CUSTOM_FXOS8700_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt source %2 on INT pin %3\"\n  },\n  \"CUSTOM_FXOS8700_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt source %2\"\n  },\n  \"CUSTOM_FXOS8700_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status (clears pending sources)\"\n  },\n  \"CUSTOM_FXOS8700_SELF_TEST\": {\n    \"en\": \"%1 accelerometer self-test passed?\"\n  }\n};\n\nconst initType = 'custom_fxos8700_init';\nBlockly.BlockRegExpList['custom_fxos8700'] = {\n  regexp: new RegExp(/^custom_fxos8700_/),\n  code: \"from FXOS8700 import FXOS8700\",\n  initBlockType: initType,\n  categoryId: 'custom_fxos8700',\n}\nBlockly.utils.registerLanguages(CUSTOM_FXOS8700_LANGUAGES)\n\nBlockly.Msg.CUSTOM_FXOS8700_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_FXOS8700 = 'FXOS8700'\n\nBlockly.utils.getcustom_fxos8700Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['fxos8700_0', 'fxos8700_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_fxos8700_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_FXOS8700_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_fxos8700Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'fxos8700_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_fxos8700_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = FXOS8700(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_fxos8700_accel_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_FXOS8700_ACCEL_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_fxos8700Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_fxos8700_accel_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_fxos8700_accel_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_FXOS8700_ACCEL_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_fxos8700Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_fxos8700_accel_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_fxos8700_accel_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_FXOS8700_ACCEL_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n