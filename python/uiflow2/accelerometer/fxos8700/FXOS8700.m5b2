    "toolbox": "\n<category name=\"FXOS8700\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_fxos8700\">\n<title text=\"FXOS8700\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_fxos8700_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">30</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_accel_x\"/><block type=\"custom_fxos8700_accel_y\"/><block type=\"custom_fxos8700_accel_z\"/><block type=\"custom_fxos8700_mag_x\"/><block type=\"custom_fxos8700_mag_y\"/><block type=\"custom_fxos8700_mag_z\"/><block type=\"custom_fxos8700_heading\">\n  <value name=\"declination_deg\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_temperature\"/><block type=\"custom_fxos8700_new_accel_data\"/><block type=\"custom_fxos8700_new_mag_data\"/><block type=\"custom_fxos8700_system_mode\"/><block type=\"custom_fxos8700_set_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_range\">\n  <value name=\"range_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_data_rate\">\n  <value name=\"rate_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">200</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_accel_oversampling\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_mag_oversampling\">\n  <value name=\"ratio\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">7</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_low_noise\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_standby\"/><block type=\"custom_fxos8700_activate\"/><block type=\"custom_fxos8700_reset\"/><block type=\"custom_fxos8700_set_accel_offset\">\n  <value name=\"x_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"y_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"z_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_mag_offset\">\n  <value name=\"x_ut\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"y_ut\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"z_ut\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_mag_auto_calibration\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_reset_mag_min_max\"/><block type=\"custom_fxos8700_trigger_mag_reset\"/><block type=\"custom_fxos8700_set_fifo\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"watermark\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_fifo_level\"/><block type=\"custom_fxos8700_set_freefall_motion\">\n  <value name=\"motion\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"threshold_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.3</field>\n    </shadow>\n  </value>\n  <value name=\"debounce_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"latch\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_read_motion_source\"/><block type=\"custom_fxos8700_set_transient\">\n  <value name=\"threshold_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.3</field>\n    </shadow>\n  </value>\n  <value name=\"debounce_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_read_transient_source\"/><block type=\"custom_fxos8700_set_pulse\">\n  <value name=\"single\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n  <value name=\"double\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_read_pulse_source\"/><block type=\"custom_fxos8700_set_orientation\">\n  <value name=\"debounce_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">100</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_orientation\"/><block type=\"custom_fxos8700_set_auto_sleep\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"sleep_rate_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">12.5</field>\n    </shadow>\n  </value>\n  <value name=\"timeout_s\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10</field>\n    </shadow>\n  </value>\n  <value name=\"wake_sources\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_set_interrupt_pins\">\n  <value name=\"active_high\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"open_drain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_enable_interrupt\">\n  <value name=\"source\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_disable_interrupt\">\n  <value name=\"source\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_fxos8700_poll_interrupt\"/><block type=\"custom_fxos8700_self_test\"/>\n</category>\n",
