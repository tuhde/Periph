{
  "category": "LSM303",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_LSM303_LANGUAGES = {\n  \"CUSTOM_LSM303_INIT\": {\n    \"en\": \"%1 init I2C bus %2 accelerometer address %3 magnetometer address %4\"\n  },\n  \"CUSTOM_LSM303_X\": {\n    \"en\": \"%1 acceleration X (g)\"\n  },\n  \"CUSTOM_LSM303_Y\": {\n    \"en\": \"%1 acceleration Y (g)\"\n  },\n  \"CUSTOM_LSM303_Z\": {\n    \"en\": \"%1 acceleration Z (g)\"\n  },\n  \"CUSTOM_LSM303_MX\": {\n    \"en\": \"%1 magnetic X (uT)\"\n  },\n  \"CUSTOM_LSM303_MY\": {\n    \"en\": \"%1 magnetic Y (uT)\"\n  },\n  \"CUSTOM_LSM303_MZ\": {\n    \"en\": \"%1 magnetic Z (uT)\"\n  },\n  \"CUSTOM_LSM303_HEADING\": {\n    \"en\": \"%1 heading (degrees), tilt compensated %2\"\n  },\n  \"CUSTOM_LSM303_SET_RANGE\": {\n    \"en\": \"%1 set accelerometer range %2 g\"\n  },\n  \"CUSTOM_LSM303_SET_DATA_RATE\": {\n    \"en\": \"%1 set accelerometer data rate %2 Hz\"\n  },\n  \"CUSTOM_LSM303_SET_MODE\": {\n    \"en\": \"%1 set accelerometer mode %2 (0=low-power, 1=normal, 2=high-res)\"\n  },\n  \"CUSTOM_LSM303_SET_AXES\": {\n    \"en\": \"%1 set accelerometer axes X %2 Y %3 Z %4\"\n  },\n  \"CUSTOM_LSM303_POWER_DOWN\": {\n    \"en\": \"%1 power down accelerometer\"\n  },\n  \"CUSTOM_LSM303_READ_ACCELERATION_RAW\": {\n    \"en\": \"%1 raw acceleration (x, y, z counts)\"\n  },\n  \"CUSTOM_LSM303_NEW_DATA_AVAILABLE\": {\n    \"en\": \"%1 new acceleration data available?\"\n  },\n  \"CUSTOM_LSM303_READ_STATUS\": {\n    \"en\": \"%1 STATUS_REG_A (overrun and data-ready flags)\"\n  },\n  \"CUSTOM_LSM303_RESET_HIGH_PASS\": {\n    \"en\": \"%1 reset high-pass filter (returns REFERENCE_A)\"\n  },\n  \"CUSTOM_LSM303_SET_REFERENCE\": {\n    \"en\": \"%1 set high-pass reference %2\"\n  },\n  \"CUSTOM_LSM303_FIFO_LEVEL\": {\n    \"en\": \"%1 FIFO level (unread sample sets)\"\n  },\n  \"CUSTOM_LSM303_READ_FIFO\": {\n    \"en\": \"%1 read FIFO samples (x, y, z in g), count 0 = all\"\n  },\n  \"CUSTOM_LSM303_READ_FIFO_STATUS\": {\n    \"en\": \"%1 FIFO status (watermark, overrun, empty, level)\"\n  },\n  \"CUSTOM_LSM303_READ_INTERRUPT_SOURCE\": {\n    \"en\": \"%1 read INTx_SRC generator %2 (reading clears the interrupt)\"\n  },\n  \"CUSTOM_LSM303_READ_CLICK_SOURCE\": {\n    \"en\": \"%1 read CLICK_SRC (reading clears the interrupt)\"\n  },\n  \"CUSTOM_LSM303_READ_MAGNETIC_RAW\": {\n    \"en\": \"%1 raw magnetic (x, y, z counts)\"\n  },\n  \"CUSTOM_LSM303_MAG_DATA_READY\": {\n    \"en\": \"%1 new magnetometer data available?\"\n  },\n  \"CUSTOM_LSM303_READ_MAG_STATUS\": {\n    \"en\": \"%1 magnetometer status (drdy, lock)\"\n  },\n  \"CUSTOM_LSM303_READ_MAG_IDENTITY\": {\n    \"en\": \"%1 magnetometer identity\"\n  },\n  \"CUSTOM_LSM303_READ_TEMPERATURE_DELTA\": {\n    \"en\": \"%1 relative temperature (C)\"\n  },\n  \"CUSTOM_LSM303_POLL_INTERRUPT\": {\n    \"en\": \"%1 poll interrupt status (bitmask)\"\n  },\n  \"CUSTOM_LSM303_SET_HIGH_PASS\": {\n    \"en\": \"%1 set high-pass mode %2 cutoff %3 output %4 generator1 %5 generator2 %6 click %7\"\n  },\n  \"CUSTOM_LSM303_SET_FIFO\": {\n    \"en\": \"%1 set FIFO mode %2 (0=bypass, 1=FIFO, 2=stream, 3=trigger) watermark %3 trigger INT2 %4\"\n  },\n  \"CUSTOM_LSM303_SET_MOTION_INTERRUPT\": {\n    \"en\": \"%1 set motion interrupt generator %2 events %3 threshold %4 g duration %5 ms AND %6\"\n  },\n  \"CUSTOM_LSM303_SET_FREE_FALL\": {\n    \"en\": \"%1 set free-fall generator %2 threshold %3 g duration %4 ms\"\n  },\n  \"CUSTOM_LSM303_SET_ORIENTATION\": {\n    \"en\": \"%1 set orientation generator %2 position %3 4D %4\"\n  },\n  \"CUSTOM_LSM303_SET_LATCH\": {\n    \"en\": \"%1 latch generator %2 interrupt %3 (1=on, 0=off)\"\n  },\n  \"CUSTOM_LSM303_SET_CLICK\": {\n    \"en\": \"%1 set click single %2 double %3 threshold %4 g limit %5 ms latency %6 ms window %7 ms\"\n  },\n  \"CUSTOM_LSM303_SET_INTERRUPT_POLARITY\": {\n    \"en\": \"%1 interrupt polarity active-low %2 (1=active-low, 0=active-high)\"\n  },\n  \"CUSTOM_LSM303_SET_MAG_RANGE\": {\n    \"en\": \"%1 set magnetometer range %2 uT\"\n  },\n  \"CUSTOM_LSM303_SET_MAG_DATA_RATE\": {\n    \"en\": \"%1 set magnetometer data rate %2 Hz\"\n  },\n  \"CUSTOM_LSM303_SET_MAG_MODE\": {\n    \"en\": \"%1 set magnetometer mode %2 (0=continuous, 1=single, 2=sleep)\"\n  },\n  \"CUSTOM_LSM303_ENABLE_TEMPERATURE\": {\n    \"en\": \"%1 enable temperature sensor %2 (1=on, 0=off)\"\n  },\n  \"CUSTOM_LSM303_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt source %2 on INT%3\"\n  },\n  \"CUSTOM_LSM303_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt source %2 on INT%3\"\n  },\n  \"CUSTOM_LSM303_OFF_INTERRUPT\": {\n    \"en\": \"%1 unsubscribe from INT%2 interrupts\"\n  },\n  \"CUSTOM_LSM303_REBOOT\": {\n    \"en\": \"%1 reboot (reload factory trim)\"\n  }\n};\n\nconst initType = 'custom_lsm303_init';\nBlockly.BlockRegExpList['custom_lsm303'] = {\n  regexp: new RegExp(/^custom_lsm303_/),\n  code: \"from LSM303 import LSM303\",\n  initBlockType: initType,\n  categoryId: 'custom_lsm303',\n}\nBlockly.utils.registerLanguages(CUSTOM_LSM303_LANGUAGES)\n\nBlockly.Msg.CUSTOM_LSM303_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_LSM303 = 'LSM303'\n\nBlockly.utils.getcustom_lsm303Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['lsm303_0', 'lsm303_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_lsm303_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_INIT,\n      'args0': [\n        // NAME is an editable variable name, not a dropdown.\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'lsm303_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'accel_address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mag_address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var accel_address = Blockly.Python.valueToCode(block, 'accel_address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var mag_address = Blockly.Python.valueToCode(block, 'mag_address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.LSM303(${bus}, ${accel_address}, ${mag_address})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_z\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.z()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_mx\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_MX,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_mx\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.mx()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_my\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_MY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_my\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.my()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_mz\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_MZ,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_mz\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.mz()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_heading\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_HEADING,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'tilt_compensate'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_heading\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var tilt_compensate = Blockly.Python.valueToCode(block, 'tilt_compensate', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.heading(${tilt_compensate})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_set_range\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_SET_RANGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'range_g'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_set_range\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var range_g = Blockly.Python.valueToCode(block, 'range_g', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_range(${range_g})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_set_data_rate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_SET_DATA_RATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'rate_hz'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_set_data_rate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var rate_hz = Blockly.Python.valueToCode(block, 'rate_hz', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_data_rate(${rate_hz})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_set_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_SET_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_set_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_mode(${mode})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_set_axes\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_SET_AXES,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        {\n          'type': 'input_value',\n          'name': 'z'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_set_axes\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n  var z = Blockly.Python.valueToCode(block, 'z', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_axes(${x}, ${y}, ${z})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_power_down\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_POWER_DOWN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_power_down\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.power_down()\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_read_acceleration_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_READ_ACCELERATION_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_read_acceleration_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.read_acceleration_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_new_data_available\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_NEW_DATA_AVAILABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_new_data_available\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [`${varname}.new_data_available()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_read_status\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_READ_STATUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_read_status\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n