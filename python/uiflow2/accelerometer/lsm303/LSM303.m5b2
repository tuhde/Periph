{
  "category": "LSM303",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_LSM303_LANGUAGES = {\n  \"CUSTOM_LSM303_INIT\": {\n    \"en\": \"%1 init I2C bus %2 (accel 0x19, mag 0x1E)\"\n  },\n  \"CUSTOM_LSM303_ACCEL_X\": {\n    \"en\": \"%1 acceleration X (g)\"\n  },\n  \"CUSTOM_LSM303_ACCEL_Y\": {\n    \"en\": \"%1 acceleration Y (g)\"\n  },\n  \"CUSTOM_LSM303_ACCEL_Z\": {\n    \"en\": \"%1 acceleration Z (g)\"\n  },\n  \"CUSTOM_LSM303_MAG_X\": {\n    \"en\": \"%1 magnetic X (µT)\"\n  },\n  \"CUSTOM_LSM303_MAG_Y\": {\n    \"en\": \"%1 magnetic Y (µT)\"\n  },\n  \"CUSTOM_LSM303_MAG_Z\": {\n    \"en\": \"%1 magnetic Z (µT)\"\n  },\n  \"CUSTOM_LSM303_READ_ACCELERATION\": {\n    \"en\": \"%1 read acceleration (x, y, z)\"\n  },\n  \"CUSTOM_LSM303_READ_MAGNETIC\": {\n    \"en\": \"%1 read magnetic field (x, y, z)\"\n  },\n  \"CUSTOM_LSM303_READ_ACCELERATION_RAW\": {\n    \"en\": \"%1 read raw acceleration (x, y, z)\"\n  },\n  \"CUSTOM_LSM303_READ_MAGNETIC_RAW\": {\n    \"en\": \"%1 read raw magnetic field (x, y, z)\"\n  },\n  \"CUSTOM_LSM303_SET_RANGE\": {\n    \"en\": \"%1 set range (g: 2, 4, 8 or 16) %2\"\n  },\n  \"CUSTOM_LSM303_SET_DATA_RATE\": {\n    \"en\": \"%1 set data rate (Hz) %2\"\n  },\n  \"CUSTOM_LSM303_SET_MODE\": {\n    \"en\": \"%1 set mode (0 low-power, 1 normal, 2 high-res) %2\"\n  },\n  \"CUSTOM_LSM303_SET_AXES\": {\n    \"en\": \"%1 enable axes (x %2, y %3, z %4)\"\n  },\n  \"CUSTOM_LSM303_POWER_DOWN\": {\n    \"en\": \"%1 power down the accelerometer\"\n  },\n  \"CUSTOM_LSM303_NEW_DATA_AVAILABLE\": {\n    \"en\": \"%1 new data available (1/0)\"\n  },\n  \"CUSTOM_LSM303_READ_STATUS\": {\n    \"en\": \"%1 status register (raw)\"\n  },\n  \"CUSTOM_LSM303_SET_HIGH_PASS\": {\n    \"en\": \"%1 set high-pass (mode %2, cutoff %3)\"\n  },\n  \"CUSTOM_LSM303_RESET_HIGH_PASS\": {\n    \"en\": \"%1 reset high-pass, returns the reference\"\n  },\n  \"CUSTOM_LSM303_SET_REFERENCE\": {\n    \"en\": \"%1 set the high-pass reference %2\"\n  },\n  \"CUSTOM_LSM303_SET_FIFO\": {\n    \"en\": \"%1 set FIFO (mode %2, watermark %3)\"\n  },\n  \"CUSTOM_LSM303_FIFO_LEVEL\": {\n    \"en\": \"%1 FIFO level (sample sets)\"\n  },\n  \"CUSTOM_LSM303_READ_FIFO\": {\n    \"en\": \"%1 read the FIFO samples\"\n  },\n  \"CUSTOM_LSM303_READ_FIFO_STATUS\": {\n    \"en\": \"%1 read the FIFO status\"\n  },\n  \"CUSTOM_LSM303_SET_MOTION_INTERRUPT\": {\n    \"en\": \"%1 set motion interrupt (generator %2, events %3, threshold g %4, duration ms %5)\"\n  },\n  \"CUSTOM_LSM303_SET_FREE_FALL\": {\n    \"en\": \"%1 set free-fall (generator %2, threshold g %3, duration ms %4)\"\n  },\n  \"CUSTOM_LSM303_SET_ORIENTATION\": {\n    \"en\": \"%1 set orientation (generator %2, position %3, four_d %4)\"\n  },\n  \"CUSTOM_LSM303_SET_LATCH\": {\n    \"en\": \"%1 latch the interrupt (generator %2, enabled %3)\"\n  },\n  \"CUSTOM_LSM303_READ_INTERRUPT_SOURCE\": {\n    \"en\": \"%1 read the interrupt source (generator %2)\"\n  },\n  \"CUSTOM_LSM303_SET_CLICK\": {\n    \"en\": \"%1 set click (single mask %2, double mask %3, threshold g %4)\"\n  },\n  \"CUSTOM_LSM303_READ_CLICK_SOURCE\": {\n    \"en\": \"%1 read the click source (raw)\"\n  },\n  \"CUSTOM_LSM303_SET_INTERRUPT_POLARITY\": {\n    \"en\": \"%1 set interrupt polarity (1 = active low) %2\"\n  },\n  \"CUSTOM_LSM303_SET_MAG_RANGE\": {\n    \"en\": \"%1 set magnetometer range (µT) %2\"\n  },\n  \"CUSTOM_LSM303_SET_MAG_DATA_RATE\": {\n    \"en\": \"%1 set magnetometer data rate (Hz) %2\"\n  },\n  \"CUSTOM_LSM303_SET_MAG_MODE\": {\n    \"en\": \"%1 set magnetometer mode (0 continuous, 1 single, 2 sleep) %2\"\n  },\n  \"CUSTOM_LSM303_MAG_DATA_READY\": {\n    \"en\": \"%1 magnetometer data ready (1/0)\"\n  },\n  \"CUSTOM_LSM303_READ_MAG_STATUS\": {\n    \"en\": \"%1 read the magnetometer status\"\n  },\n  \"CUSTOM_LSM303_READ_MAG_IDENTITY\": {\n    \"en\": \"%1 magnetometer identity (hex)\"\n  },\n  \"CUSTOM_LSM303_ENABLE_TEMPERATURE\": {\n    \"en\": \"%1 enable the temperature sensor %2\"\n  },\n  \"CUSTOM_LSM303_READ_TEMPERATURE_DELTA\": {\n    \"en\": \"%1 temperature delta (°C)\"\n  },\n  \"CUSTOM_LSM303_HEADING\": {\n    \"en\": \"%1 compass heading (deg) %2\"\n  },\n  \"CUSTOM_LSM303_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable an interrupt source (source %2, pin %3)\"\n  },\n  \"CUSTOM_LSM303_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable an interrupt source (source %2, pin %3)\"\n  },\n  \"CUSTOM_LSM303_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status (mask)\"\n  },\n  \"CUSTOM_LSM303_REBOOT\": {\n    \"en\": \"%1 reboot the accelerometer\"\n  },\n};\n\nconst initType = 'custom_lsm303_init';\nBlockly.BlockRegExpList['custom_lsm303'] = {\n  regexp: new RegExp(/^custom_lsm303_/),\n  code: \"from LSM303 import LSM303\",\n  initBlockType: initType,\n  categoryId: 'custom_lsm303',\n}\nBlockly.utils.registerLanguages(CUSTOM_LSM303_LANGUAGES)\n\nBlockly.Msg.CUSTOM_LSM303_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_LSM303 = 'LSM303'\n\nBlockly.utils.getlsm303Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['lsm303_0', 'lsm303_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_lsm303_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getlsm303Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'lsm303_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = LSM303(${bus})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_accel_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_ACCEL_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_accel_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_accel_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_ACCEL_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_accel_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_accel_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_ACCEL_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_accel_z\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_z()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_mag_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_MAG_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_mag_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.mag_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_mag_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_MAG_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_mag_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.mag_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_mag_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_MAG_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_mag_z\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\