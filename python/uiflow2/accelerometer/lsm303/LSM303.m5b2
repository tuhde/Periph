pe': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_lsm303Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_reboot\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.reboot()\\n`\n}\n\n",
