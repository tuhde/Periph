ath_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_mag_data_ready\"/>\n<block type=\"custom_lsm303_read_mag_status\"/>\n<block type=\"custom_lsm303_read_mag_identity\"/>\n<block type=\"custom_lsm303_enable_temperature\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_read_temperature_delta\"/>\n<block type=\"custom_lsm303_heading\">\n  <value name=\"tilt_compensate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_enable_interrupt\">\n  <value name=\"source\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_disable_interrupt\">\n  <value name=\"source\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_poll_interrupt\"/>\n<block type=\"custom_lsm303_reboot\"/>\n</category>\n",
