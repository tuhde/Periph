ck) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var source = Blockly.Python.valueToCode(block, 'source', Blockly.Python.ORDER_FUNCTION_CALL);\n  var pin = Blockly.Python.valueToCode(block, 'pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.enable_interrupt(${source}, ${pin})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_disable_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_DISABLE_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'source'\n        },\n        {\n          'type': 'input_value',\n          'name': 'pin'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_disable_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var source = Blockly.Python.valueToCode(block, 'source', Blockly.Python.ORDER_FUNCTION_CALL);\n  var pin = Blockly.Python.valueToCode(block, 'pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.disable_interrupt(${source}, ${pin})\\n`\n}\n\nBlockly.Blocks[\"custom_lsm303_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_lsm303_reboot\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_LSM303_REBOOT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getlsm303Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_lsm303_reboot\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.reboot()\\n`\n}\n",
    "toolbox": "\n<category name=\"LSM303\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_lsm303\">\n<title text=\"LSM303\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_lsm303_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_accel_x\"/>\n<block type=\"custom_lsm303_accel_y\"/>\n<block type=\"custom_lsm303_accel_z\"/>\n<block type=\"custom_lsm303_mag_x\"/>\n<block type=\"custom_lsm303_mag_y\"/>\n<block type=\"custom_lsm303_mag_z\"/>\n<block type=\"custom_lsm303_read_acceleration\"/>\n<block type=\"custom_lsm303_read_magnetic\"/>\n<block type=\"custom_lsm303_read_acceleration_raw\"/>\n<block type=\"custom_lsm303_read_magnetic_raw\"/>\n<block type=\"custom_lsm303_set_range\">\n  <value name=\"range_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_set_data_rate\">\n  <value name=\"rate_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">100</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_set_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_set_axes\">\n  <value name=\"x\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"y\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"z\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_power_down\"/>\n<block type=\"custom_lsm303_new_data_available\"/>\n<block type=\"custom_lsm303_read_status\"/>\n<block type=\"custom_lsm303_set_high_pass\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"cutoff\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_reset_high_pass\"/>\n<block type=\"custom_lsm303_set_reference\">\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_set_fifo\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"watermark\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_fifo_level\"/>\n<block type=\"custom_lsm303_read_fifo\"/>\n<block type=\"custom_lsm303_read_fifo_status\"/>\n<block type=\"custom_lsm303_set_motion_interrupt\">\n  <value name=\"generator\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"events\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"threshold_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </shadow>\n  </value>\n  <value name=\"duration_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_set_free_fall\">\n  <value name=\"generator\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"threshold_g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.35</field>\n    </shadow>\n  </value>\n  <value name=\"duration_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">30</field>\n    </shadow>\n  </value>\n</block>\n<block type=\"custom_lsm303_set_orientation\">\n  <value name=\"generator\">\n    <shadow t