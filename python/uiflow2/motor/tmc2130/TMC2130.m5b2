{
  "category": "TMC2130",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_TMC2130_LANGUAGES = {\n  \"CUSTOM_TMC2130_INIT\": {\n    \"en\": \"%1 init SPI bus %2 CS pin %3 STEP pin %4 DIR pin %5 ENN pin %6 sense resistor (ohm) %7\"\n  },\n  \"CUSTOM_TMC2130_ENABLE\": {\n    \"en\": \"%1 enable driver\"\n  },\n  \"CUSTOM_TMC2130_DISABLE\": {\n    \"en\": \"%1 disable driver\"\n  },\n  \"CUSTOM_TMC2130_SET_CURRENT\": {\n    \"en\": \"%1 set run current (A RMS) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_HOLD_CURRENT\": {\n    \"en\": \"%1 set hold current (A RMS) %2\"\n  },\n  \"CUSTOM_TMC2130_MOVE\": {\n    \"en\": \"%1 move full steps %2 at full steps/s %3\"\n  },\n  \"CUSTOM_TMC2130_SET_MICROSTEPS\": {\n    \"en\": \"%1 set microsteps (1-256) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_INTERPOLATION\": {\n    \"en\": \"%1 set interpolation (0/1) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_CHOPPER_MODE\": {\n    \"en\": \"%1 set SpreadCycle (1) / StealthChop (0) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_STEALTHCHOP_THRESHOLD\": {\n    \"en\": \"%1 set StealthChop threshold (TPWMTHRS) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_DIRECTION_INVERTED\": {\n    \"en\": \"%1 invert direction (0/1) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_FREEWHEEL\": {\n    \"en\": \"%1 set standstill mode (0-3) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_STALL_THRESHOLD\": {\n    \"en\": \"%1 set StallGuard threshold (SGT) %2\"\n  },\n  \"CUSTOM_TMC2130_SET_COOLSTEP_THRESHOLD\": {\n    \"en\": \"%1 set CoolStep/stall threshold (TCOOLTHRS) %2\"\n  },\n  \"CUSTOM_TMC2130_IS_STANDSTILL\": {\n    \"en\": \"%1 is standstill\"\n  },\n  \"CUSTOM_TMC2130_READ_FAULT\": {\n    \"en\": \"%1 fault flags\"\n  },\n  \"CUSTOM_TMC2130_READ_STALLGUARD\": {\n    \"en\": \"%1 StallGuard result (SG_RESULT)\"\n  },\n  \"CUSTOM_TMC2130_IS_STALLED\": {\n    \"en\": \"%1 is stalled\"\n  },\n  \"CUSTOM_TMC2130_MICROSTEP_POSITION\": {\n    \"en\": \"%1 microstep position\"\n  },\n  \"CUSTOM_TMC2130_READ_CURRENT_SCALE\": {\n    \"en\": \"%1 current scale\"\n  },\n  \"CUSTOM_TMC2130_READ_TSTEP\": {\n    \"en\": \"%1 TSTEP\"\n  }\n};\n\nconst initType = 'custom_tmc2130_init';\nBlockly.BlockRegExpList['custom_tmc2130'] = {\n  regexp: new RegExp(/^custom_tmc2130_/),\n  code: \"from TMC2130 import TMC2130\",\n  initBlockType: initType,\n  categoryId: 'custom_tmc2130',\n}\nBlockly.utils.registerLanguages(CUSTOM_TMC2130_LANGUAGES)\n\nBlockly.Msg.CUSTOM_TMC2130_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_TMC2130 = 'TMC2130'\n\nBlockly.utils.getcustom_tmc2130Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['tmc2130_0', 'tmc2130_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_tmc2130_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_tmc2130Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'tmc2130_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'step_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'dir_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'en_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_sense'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var step_pin = Blockly.Python.valueToCode(block, 'step_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var dir_pin = Blockly.Python.valueToCode(block, 'dir_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var en_pin = Blockly.Python.valueToCode(block, 'en_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_sense = Blockly.Python.valueToCode(block, 'r_sense', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = TMC2130(${bus}, ${cs_pin}, ${step_pin}, ${dir_pin}, ${en_pin}, ${r_sense})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_enable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_ENABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_enable\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.enable()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_disable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_DISABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_disable\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.disable()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_set_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_SET_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'current'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_set_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var current = Blockly.Python.valueToCode(block, 'current', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_current(${current})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_set_hold_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_SET_HOLD_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'current'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_set_hold_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var current = Blockly.Python.valueToCode(block, 'current', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_hold_current(${current})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_move\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_MOVE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'steps'\n        },\n        {\n          'type': 'input_value',\n          'name': 'speed'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_move\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var steps = Blockly.Python.valueToCode(block, 'steps', Blockly.Python.ORDER_FUNCTION_CALL);\n  var speed = Blockly.Python.valueToCode(block, 'speed', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.move(${steps}, ${speed})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_set_microsteps\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_SET_MICROSTEPS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'n'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_set_microsteps\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var n = Blockly.Python.valueToCode(block, 'n', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_microsteps(${n})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_set_interpolation\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_SET_INTERPOLATION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_set_interpolation\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_interpolation(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_set_chopper_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_SET_CHOPPER_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'spreadcycle'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2130_set_chopper_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var spreadcycle = Blockly.Python.valueToCode(block, 'spreadcycle', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_chopper_mode(${spreadcycle})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2130_set_stealthchop_threshold\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2130_SET_STEALTHCHOP_THRESHOLD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2130Options\n        },\n        