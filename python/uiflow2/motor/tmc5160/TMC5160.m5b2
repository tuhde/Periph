is_position_reached()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc5160_is_standstill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_IS_STANDSTILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_is_standstill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_standstill()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc5160_read_fault\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_READ_FAULT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_read_fault\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_fault()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc5160_read_stallguard\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_READ_STALLGUARD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_read_stallguard\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_stallguard()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc5160_is_stalled\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_IS_STALLED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_is_stalled\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_stalled()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc5160_read_current_scale\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_READ_CURRENT_SCALE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_read_current_scale\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_current_scale()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"TMC5160\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_tmc5160\">\n<title text=\"TMC5160\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_tmc5160_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"cs_pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5</field>\n    </shadow>\n  </value>\n  <value name=\"en_pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n  <value name=\"r_sense\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.075</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_enable\"/><block type=\"custom_tmc5160_disable\"/><block type=\"custom_tmc5160_set_current\">\n  <value name=\"current\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_set_speed\">\n  <value name=\"speed\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">200</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_set_acceleration\">\n  <value name=\"accel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">400</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_move_to\">\n  <value name=\"position\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_move\">\n  <value name=\"steps\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">400</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_run\">\n  <value name=\"velocity\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">200</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_stop\"/><block type=\"custom_tmc5160_set_position\">\n  <value name=\"position\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_set_microsteps\">\n  <value name=\"n\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">256</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_set_chopper_mode\">\n  <value name=\"spreadcycle\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_set_stall_threshold\">\n  <value name=\"sgt\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_set_coolstep_threshold\">\n  <value name=\"tcoolthrs\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_enable_stall_stop\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc5160_clear_ramp_events\"/><block type=\"custom_tmc5160_position\"/><block type=\"custom_tmc5160_velocity\"/><block type=\"custom_tmc5160_is_position_reached\"/><block type=\"custom_tmc5160_is_standstill\"/><block type=\"custom_tmc5160_read_fault\"/><block type=\"custom_tmc5160_read_stallguard\"/><block type=\"custom_tmc5160_is_stalled\"/><block type=\"custom_tmc5160_read_current_scale\"/>\n</category>\n",
