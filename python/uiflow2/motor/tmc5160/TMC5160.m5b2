{
  "category": "TMC5160",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_TMC5160_LANGUAGES = {\n  \"CUSTOM_TMC5160_INIT\": {\n    \"en\": \"%1 init SPI bus %2 CS pin %3 ENN pin %4 sense resistor (ohm) %5\"\n  },\n  \"CUSTOM_TMC5160_ENABLE\": {\n    \"en\": \"%1 enable driver\"\n  },\n  \"CUSTOM_TMC5160_DISABLE\": {\n    \"en\": \"%1 disable driver\"\n  },\n  \"CUSTOM_TMC5160_SET_CURRENT\": {\n    \"en\": \"%1 set run current (A RMS) %2\"\n  },\n  \"CUSTOM_TMC5160_SET_SPEED\": {\n    \"en\": \"%1 set speed (full steps/s) %2\"\n  },\n  \"CUSTOM_TMC5160_SET_ACCELERATION\": {\n    \"en\": \"%1 set acceleration (full steps/s2) %2\"\n  },\n  \"CUSTOM_TMC5160_MOVE_TO\": {\n    \"en\": \"%1 move to position (full steps) %2\"\n  },\n  \"CUSTOM_TMC5160_MOVE\": {\n    \"en\": \"%1 move relative and wait (full steps) %2\"\n  },\n  \"CUSTOM_TMC5160_RUN\": {\n    \"en\": \"%1 run at velocity (full steps/s) %2\"\n  },\n  \"CUSTOM_TMC5160_STOP\": {\n    \"en\": \"%1 stop\"\n  },\n  \"CUSTOM_TMC5160_SET_POSITION\": {\n    \"en\": \"%1 define position (full steps) %2\"\n  },\n  \"CUSTOM_TMC5160_SET_MICROSTEPS\": {\n    \"en\": \"%1 set microsteps (1-256) %2\"\n  },\n  \"CUSTOM_TMC5160_SET_CHOPPER_MODE\": {\n    \"en\": \"%1 set SpreadCycle (1) / StealthChop (0) %2\"\n  },\n  \"CUSTOM_TMC5160_SET_STALL_THRESHOLD\": {\n    \"en\": \"%1 set StallGuard threshold (SGT) %2\"\n  },\n  \"CUSTOM_TMC5160_SET_COOLSTEP_THRESHOLD\": {\n    \"en\": \"%1 set CoolStep/stall threshold (TCOOLTHRS) %2\"\n  },\n  \"CUSTOM_TMC5160_ENABLE_STALL_STOP\": {\n    \"en\": \"%1 stop on stall (0/1) %2\"\n  },\n  \"CUSTOM_TMC5160_CLEAR_RAMP_EVENTS\": {\n    \"en\": \"%1 clear ramp events\"\n  },\n  \"CUSTOM_TMC5160_POSITION\": {\n    \"en\": \"%1 position (full steps)\"\n  },\n  \"CUSTOM_TMC5160_VELOCITY\": {\n    \"en\": \"%1 velocity (full steps/s)\"\n  },\n  \"CUSTOM_TMC5160_IS_POSITION_REACHED\": {\n    \"en\": \"%1 position reached\"\n  },\n  \"CUSTOM_TMC5160_IS_STANDSTILL\": {\n    \"en\": \"%1 is standstill\"\n  },\n  \"CUSTOM_TMC5160_READ_FAULT\": {\n    \"en\": \"%1 fault flags\"\n  },\n  \"CUSTOM_TMC5160_READ_STALLGUARD\": {\n    \"en\": \"%1 StallGuard result (SG_RESULT)\"\n  },\n  \"CUSTOM_TMC5160_IS_STALLED\": {\n    \"en\": \"%1 is stalled\"\n  },\n  \"CUSTOM_TMC5160_READ_CURRENT_SCALE\": {\n    \"en\": \"%1 current scale\"\n  }\n};\n\nconst initType = 'custom_tmc5160_init';\nBlockly.BlockRegExpList['custom_tmc5160'] = {\n  regexp: new RegExp(/^custom_tmc5160_/),\n  code: \"from TMC5160 import TMC5160\",\n  initBlockType: initType,\n  categoryId: 'custom_tmc5160',\n}\nBlockly.utils.registerLanguages(CUSTOM_TMC5160_LANGUAGES)\n\nBlockly.Msg.CUSTOM_TMC5160_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_TMC5160 = 'TMC5160'\n\nBlockly.utils.getcustom_tmc5160Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['tmc5160_0', 'tmc5160_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_tmc5160_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_tmc5160Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'tmc5160_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'en_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_sense'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var en_pin = Blockly.Python.valueToCode(block, 'en_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_sense = Blockly.Python.valueToCode(block, 'r_sense', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = TMC5160(${bus}, ${cs_pin}, ${en_pin}, ${r_sense})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_enable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_ENABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_enable\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.enable()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_disable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_DISABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_disable\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.disable()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_set_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_SET_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'current'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_set_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var current = Blockly.Python.valueToCode(block, 'current', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_current(${current})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_set_speed\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_SET_SPEED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'speed'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_set_speed\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var speed = Blockly.Python.valueToCode(block, 'speed', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_speed(${speed})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_set_acceleration\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_SET_ACCELERATION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'accel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_set_acceleration\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var accel = Blockly.Python.valueToCode(block, 'accel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_acceleration(${accel})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_move_to\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_MOVE_TO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'position'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_move_to\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var position = Blockly.Python.valueToCode(block, 'position', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.move_to(${position})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_move\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_MOVE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'steps'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_move\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var steps = Blockly.Python.valueToCode(block, 'steps', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.move(${steps})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_run\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_RUN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'velocity'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_run\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var velocity = Blockly.Python.valueToCode(block, 'velocity', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.run(${velocity})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_stop\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_STOP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_stop\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.stop()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_set_position\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_SET_POSITION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'position'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_set_position\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var position = Blockly.Python.valueToCode(block, 'position', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_position(${position})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_set_microsteps\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_SET_MICROSTEPS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'n'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc5160_set_microsteps\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var n = Blockly.Python.valueToCode(block, 'n', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_microsteps(${n})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc5160_set_chopper_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC5160_SET_CHOPPER_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc5160Options\n        },\n    