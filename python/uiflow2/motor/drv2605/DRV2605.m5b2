{
  "category": "DRV2605",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_DRV2605_LANGUAGES = {\n  \"CUSTOM_DRV2605_INIT\": {\n    \"en\": \"%1 init bus %2 actuator (0 = ERM, 1 = LRA) %3\"\n  },\n  \"CUSTOM_DRV2605_PLAY_EFFECT\": {\n    \"en\": \"%1 play effect (1-123) %2\"\n  },\n  \"CUSTOM_DRV2605_PLAY_SEQUENCE\": {\n    \"en\": \"%1 play sequence (e.g. 1,w100,10; wN = wait N ms) %2\"\n  },\n  \"CUSTOM_DRV2605_STOP\": {\n    \"en\": \"%1 stop\"\n  },\n  \"CUSTOM_DRV2605_IS_PLAYING\": {\n    \"en\": \"%1 is playing\"\n  },\n  \"CUSTOM_DRV2605_WAIT_DONE\": {\n    \"en\": \"%1 wait until done, timeout (ms) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_LIBRARY\": {\n    \"en\": \"%1 set library (0-6) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_MODE\": {\n    \"en\": \"%1 set mode (0-7) %2\"\n  },\n  \"CUSTOM_DRV2605_STANDBY\": {\n    \"en\": \"%1 standby\"\n  },\n  \"CUSTOM_DRV2605_WAKE\": {\n    \"en\": \"%1 wake\"\n  },\n  \"CUSTOM_DRV2605_RESET\": {\n    \"en\": \"%1 reset\"\n  },\n  \"CUSTOM_DRV2605_SET_HI_Z\": {\n    \"en\": \"%1 set high-impedance (0/1) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_ACTUATOR\": {\n    \"en\": \"%1 set actuator (0 = ERM, 1 = LRA) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_OPEN_LOOP\": {\n    \"en\": \"%1 set open loop (0/1) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_BIDIRECTIONAL\": {\n    \"en\": \"%1 set bidirectional input (0/1) %2\"\n  },\n  \"CUSTOM_DRV2605_RTP_LEVEL\": {\n    \"en\": \"%1 RTP level (0.0-1.0) %2\"\n  },\n  \"CUSTOM_DRV2605_RTP_WRITE\": {\n    \"en\": \"%1 RTP raw value (0-255) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_RTP_FORMAT\": {\n    \"en\": \"%1 set RTP unsigned (0/1) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_INPUT\": {\n    \"en\": \"%1 set input (0 = PWM, 1 = analog) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_RATED_VOLTAGE\": {\n    \"en\": \"%1 set rated voltage (V) %2 LRA frequency (Hz, 0 = ERM) %3\"\n  },\n  \"CUSTOM_DRV2605_SET_OVERDRIVE_CLAMP\": {\n    \"en\": \"%1 set overdrive clamp (V) %2 LRA frequency (Hz, 0 = not needed) %3\"\n  },\n  \"CUSTOM_DRV2605_SET_DRIVE_TIME\": {\n    \"en\": \"%1 set drive time (ms) %2\"\n  },\n  \"CUSTOM_DRV2605_SET_FEEDBACK\": {\n    \"en\": \"%1 set feedback brake factor (0-7) %2 loop gain (0-3) %3 BEMF gain (0-3) %4\"\n  },\n  \"CUSTOM_DRV2605_SET_ADVANCED\": {\n    \"en\": \"%1 set advanced startup boost (0/1) %2 brake stabilizer (0/1) %3 sample time (0-3) %4 blanking time (0-3) %5 idiss time (0-3) %6 LRA drive twice (0/1) %7 supply compensation (0/1) %8 noise gate (0-3) %9\"\n  },\n  \"CUSTOM_DRV2605_SET_TIME_OFFSETS\": {\n    \"en\": \"%1 set time offsets overdrive (ms) %2 sustain + (ms) %3 sustain - (ms) %4 brake (ms) %5\"\n  },\n  \"CUSTOM_DRV2605_CALIBRATE\": {\n    \"en\": \"%1 calibrate, LRA (0/1) %2 rated voltage (V) %3 overdrive voltage (V) %4 LRA frequency (Hz, 0 = ERM) %5 (1 = OK)\"\n  },\n  \"CUSTOM_DRV2605_CALIBRATION_COMP\": {\n    \"en\": \"%1 calibration compensation\"\n  },\n  \"CUSTOM_DRV2605_CALIBRATION_BEMF\": {\n    \"en\": \"%1 calibration back-EMF\"\n  },\n  \"CUSTOM_DRV2605_CALIBRATION_BEMF_GAIN\": {\n    \"en\": \"%1 calibration BEMF gain\"\n  },\n  \"CUSTOM_DRV2605_SET_CALIBRATION\": {\n    \"en\": \"%1 set calibration compensation (0-255) %2 back-EMF (0-255) %3 BEMF gain (0-3) %4\"\n  },\n  \"CUSTOM_DRV2605_DIAGNOSE\": {\n    \"en\": \"%1 diagnose actuator (OK = true)\"\n  },\n  \"CUSTOM_DRV2605_SET_AUDIO_TO_VIBE\": {\n    \"en\": \"%1 audio to vibe AC coupled (0/1) %2 peak time (10/20/30/40 ms) %3 filter (100/125/150/200 Hz) %4 min input (V) %5 max input (V) %6 min drive (0.0-1.0) %7 max drive (0.0-1.0) %8\"\n  },\n  \"CUSTOM_DRV2605_DIAG_FAILED\": {\n    \"en\": \"%1 diagnostics failed (clears flags)\"\n  },\n  \"CUSTOM_DRV2605_FB_TIMEOUT\": {\n    \"en\": \"%1 feedback timeout (clears flags)\"\n  },\n  \"CUSTOM_DRV2605_OVER_TEMP\": {\n    \"en\": \"%1 over-temperature (clears flags)\"\n  },\n  \"CUSTOM_DRV2605_OVER_CURRENT\": {\n    \"en\": \"%1 over-current\"\n  },\n  \"CUSTOM_DRV2605_DEVICE_ID\": {\n    \"en\": \"%1 device id\"\n  },\n  \"CUSTOM_DRV2605_SUPPLY_VOLTAGE\": {\n    \"en\": \"%1 supply voltage (V)\"\n  },\n  \"CUSTOM_DRV2605_LRA_FREQUENCY\": {\n    \"en\": \"%1 LRA frequency (Hz, 0 = n/a)\"\n  },\n  \"CUSTOM_DRV2605_PROGRAM_OTP\": {\n    \"en\": \"%1 program OTP, IRREVERSIBLE (1 to burn) %2\"\n  },\n  \"CUSTOM_DRV2605_OTP_PROGRAMMED\": {\n    \"en\": \"%1 OTP programmed\"\n  }\n};\n\nconst initType = 'custom_drv2605_init';\nBlockly.BlockRegExpList['custom_drv2605'] = {\n  regexp: new RegExp(/^custom_drv2605_/),\n  code: \"from DRV2605 import DRV2605\",\n  initBlockType: initType,\n  categoryId: 'custom_drv2605',\n}\nBlockly.utils.registerLanguages(CUSTOM_DRV2605_LANGUAGES)\n\nBlockly.Msg.CUSTOM_DRV2605_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_DRV2605 = 'DRV2605'\n\nBlockly.utils.getcustom_drv2605Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['drv2605_0', 'drv2605_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_drv2605_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV2605_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_drv2605Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'drv2605_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'lra'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv2605_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var lra = Blockly.Python.valueToCode(block, 'lra', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = DRV2605(${bus}, ${lra})\\n`\n}\n\nBlockly.Blocks[\"custom_drv2605_play_effect\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV2605_PLAY_EFFECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv2605Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'effect'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv2605_play_effect\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var effect = Blockly.Python.valueToCode(block, 'effect', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.play_effect(${effect})\\n`\n}\n\nBlockly.Blocks[\"custom_drv2605_play_sequence\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV2605_PLAY_SEQUENCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv2605Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'steps'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv2605_play_sequence\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var steps = Blockly.Python.valueToCode(block, 'steps', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.play_sequence(${steps})\\n`\n}\n\nBlockly.Blocks[\"custom_drv2605_stop\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV2605_STOP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv2605Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv2605_stop\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.stop()\\n`\n}\n\nBlockly.Blocks[\"custom_drv2605_is_playing\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV2605_IS_PLAYING,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv2605Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv2605_is_playing\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_playing()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv2605_wait_done\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV2605_WAIT_DONE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv2605Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'timeout_ms'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv2605_wait_done\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var timeout_ms = Blockly.Pyt