    "toolbox": "\n<category name=\"DRV2605\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_drv2605\">\n<title text=\"DRV2605\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_drv2605_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"lra\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_play_effect\">\n  <value name=\"effect\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_play_sequence\">\n  <value name=\"steps\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\">1,w100,1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_stop\"/><block type=\"custom_drv2605_is_playing\"/><block type=\"custom_drv2605_wait_done\">\n  <value name=\"timeout_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5000</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_library\">\n  <value name=\"library\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_standby\"/><block type=\"custom_drv2605_wake\"/><block type=\"custom_drv2605_reset\"/><block type=\"custom_drv2605_set_hi_z\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_actuator\">\n  <value name=\"lra\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_open_loop\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_bidirectional\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_rtp_level\">\n  <value name=\"level\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_rtp_write\">\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">64</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_rtp_format\">\n  <value name=\"unsigned\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_input\">\n  <value name=\"analog\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_rated_voltage\">\n  <value name=\"volts\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3.0</field>\n    </shadow>\n  </value>\n  <value name=\"lra_freq_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_overdrive_clamp\">\n  <value name=\"volts\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3.0</field>\n    </shadow>\n  </value>\n  <value name=\"lra_freq_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_drive_time\">\n  <value name=\"ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_feedback\">\n  <value name=\"brake_factor\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n  <value name=\"loop_gain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"bemf_gain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_advanced\">\n  <value name=\"startup_boost\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"brake_stabilizer\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"sample_time\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n  <value name=\"blanking_time\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"idiss_time\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"lra_drive_twice\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"supply_comp\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"noise_gate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_set_time_offsets\">\n  <value name=\"overdrive_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"sustain_pos_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"sustain_neg_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"brake_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_calibrate\">\n  <value name=\"lra\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"rated_voltage\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3.0</field>\n    </shadow>\n  </value>\n  <value name=\"overdrive_voltage\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3.0</field>\n    </shadow>\n  </value>\n  <value name=\"lra_freq_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_calibration_comp\"/><block type=\"custom_drv2605_calibration_bemf\"/><block type=\"custom_drv2605_calibration_bemf_gain\"/><block type=\"custom_drv2605_set_calibration\">\n  <value name=\"comp\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">13</field>\n    </shadow>\n  </value>\n  <value name=\"bemf\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">109</field>\n    </shadow>\n  </value>\n  <value name=\"bemf_gain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">2</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_diagnose\"/><block type=\"custom_drv2605_set_audio_to_vibe\">\n  <value name=\"ac_couple\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"peak_time_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">20</field>\n    </shadow>\n  </value>\n  <value name=\"filter_hz\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">125</field>\n    </shadow>\n  </value>\n  <value name=\"min_input_v\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.1</field>\n    </shadow>\n  </value>\n  <value name=\"max_input_v\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.8</field>\n    </shadow>\n  </value>\n  <value name=\"min_drive\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.1</field>\n    </shadow>\n  </value>\n  <value name=\"max_drive\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_diag_failed\"/><block type=\"custom_drv2605_fb_timeout\"/><block type=\"custom_drv2605_over_temp\"/><block type=\"custom_drv2605_over_current\"/><block type=\"custom_drv2605_device_id\"/><block type=\"custom_drv2605_supply_voltage\"/><block type=\"custom_drv2605_lra_frequency\"/><block type=\"custom_drv2605_program_otp\">\n  <value name=\"confirm\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv2605_otp_programmed\"/>\n</category>\n",
