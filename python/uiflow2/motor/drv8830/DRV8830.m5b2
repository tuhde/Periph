    "jscode": "const CUSTOM_DRV8830_LANGUAGES = {\n  \"CUSTOM_DRV8830_INIT\": {\n    \"en\": \"%1 init bus %2 address (96-104) %3\"\n  },\n  \"CUSTOM_DRV8830_DRIVE\": {\n    \"en\": \"%1 drive voltage (V, negative = reverse) %2\"\n  },\n  \"CUSTOM_DRV8830_BRAKE\": {\n    \"en\": \"%1 brake\"\n  },\n  \"CUSTOM_DRV8830_STOP\": {\n    \"en\": \"%1 stop (coast)\"\n  },\n  \"CUSTOM_DRV8830_SET_OUTPUT\": {\n    \"en\": \"%1 set output VSET (6-63) %2 IN1 (0/1) %3 IN2 (0/1) %4\"\n  },\n  \"CUSTOM_DRV8830_OUTPUT_VOLTAGE\": {\n    \"en\": \"%1 commanded voltage (V)\"\n  },\n  \"CUSTOM_DRV8830_OUTPUT_DIRECTION\": {\n    \"en\": \"%1 direction\"\n  },\n  \"CUSTOM_DRV8830_FAULT\": {\n    \"en\": \"%1 fault\"\n  },\n  \"CUSTOM_DRV8830_OCP\": {\n    \"en\": \"%1 overcurrent (OCP)\"\n  },\n  \"CUSTOM_DRV8830_UVLO\": {\n    \"en\": \"%1 undervoltage (UVLO)\"\n  },\n  \"CUSTOM_DRV8830_OTS\": {\n    \"en\": \"%1 overtemperature (OTS)\"\n  },\n  \"CUSTOM_DRV8830_ILIMIT\": {\n    \"en\": \"%1 current limit (ILIMIT)\"\n  },\n  \"CUSTOM_DRV8830_CLEAR_FAULT\": {\n    \"en\": \"%1 clear fault\"\n  },\n  \"CUSTOM_DRV8830_POLL_INTERRUPT\": {\n    \"en\": \"%1 poll fault\"\n  }\n};\n\nconst initType = 'custom_drv8830_init';\nBlockly.BlockRegExpList['custom_drv8830'] = {\n  regexp: new RegExp(/^custom_drv8830_/),\n  code: \"from DRV8830 import DRV8830\",\n  initBlockType: initType,\n  categoryId: 'custom_drv8830',\n}\nBlockly.utils.registerLanguages(CUSTOM_DRV8830_LANGUAGES)\n\nBlockly.Msg.CUSTOM_DRV8830_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_DRV8830 = 'DRV8830'\n\nBlockly.utils.getcustom_drv8830Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['drv8830_0', 'drv8830_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_drv8830_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_drv8830Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'drv8830_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = DRV8830(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_drv8830_drive\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_DRIVE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'voltage'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_drive\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var voltage = Blockly.Python.valueToCode(block, 'voltage', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.drive(${voltage})\\n`\n}\n\nBlockly.Blocks[\"custom_drv8830_brake\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_BRAKE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_brake\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.brake()\\n`\n}\n\nBlockly.Blocks[\"custom_drv8830_stop\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_STOP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_stop\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.stop()\\n`\n}\n\nBlockly.Blocks[\"custom_drv8830_set_output\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_SET_OUTPUT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'vset'\n        },\n        {\n          'type': 'input_value',\n          'name': 'in1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'in2'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_set_output\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var vset = Blockly.Python.valueToCode(block, 'vset', Blockly.Python.ORDER_FUNCTION_CALL);\n  var in1 = Blockly.Python.valueToCode(block, 'in1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var in2 = Blockly.Python.valueToCode(block, 'in2', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_output(${vset}, ${in1}, ${in2})\\n`\n}\n\nBlockly.Blocks[\"custom_drv8830_output_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_OUTPUT_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_output_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.output_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv8830_output_direction\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_OUTPUT_DIRECTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_output_direction\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.output_direction()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv8830_fault\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_FAULT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_fault\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.fault()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv8830_ocp\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_OCP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_ocp\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.ocp()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv8830_uvlo\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_UVLO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_uvlo\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.uvlo()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv8830_ots\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_OTS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_ots\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.ots()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv8830_ilimit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_ILIMIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_ilimit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.ilimit()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_drv8830_clear_fault\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_CLEAR_FAULT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_clear_fault\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear_fault()\\n`\n}\n\nBlockly.Blocks[\"custom_drv8830_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DRV8830_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_drv8830Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_drv8830_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"DRV8830\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_drv8830\">\n<title text=\"DRV8830\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_drv8830_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">96</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv8830_drive\">\n  <value name=\"voltage\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv8830_brake\"/><block type=\"custom_drv8830_stop\"/><block type=\"custom_drv8830_set_output\">\n  <value name=\"vset\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">37</field>\n    </shadow>\n  </value>\n  <value name=\"in1\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"in2\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_drv8830_output_voltage\"/><block type=\"custom_drv8830_output_direction\"/><block type=\"custom_drv8830_fault\"/><block type=\"custom_drv8830_ocp\"/><block type=\"custom_drv8830_uvlo\"/><block type=\"custom_drv8830_ots\"/><block type=\"custom_drv8830_ilimit\"/><block type=\"custom_drv8830_clear_fault\"/><block type=\"custom_drv8830_poll_interrupt\"/>\n</category>\n",
