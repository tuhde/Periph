  "pyCode": "\"\"\"\nfile     TMC2208\ntime     2026-11-09\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.uart_auto import UARTConnection\nfrom periph.chips.motor.tmc2208 import TMC2208Full\n\n\nclass TMC2208:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, port: int = 1, baudrate: int = 115200, tx: int = 17, rx: int = 16, r_sense: float = 0.11):\n        \"\"\"\n        label:\n            en: '%1 init UART port %2 baudrate %3 TX pin %4 RX pin %5 sense resistor (ohm) %6'\n        params:\n            port:\n                name: port\n                type: int\n                default: '1'\n                field: number\n            baudrate:\n                name: baudrate\n                type: int\n                default: '115200'\n                field: number\n            tx:\n                name: tx\n                type: int\n                default: '17'\n                field: number\n            rx:\n                name: rx\n                type: int\n                default: '16'\n                field: number\n            r_sense:\n                name: r_sense\n                type: float\n                default: '0.11'\n                field: number\n        \"\"\"\n        connection = UARTConnection(port=port, baudrate=baudrate, tx=tx, rx=rx)\n        self._driver = TMC2208Full(connection, r_sense_ohm=r_sense)\n\n    def enable(self):\n        \"\"\"\n        label:\n            en: '%1 enable driver'\n        \"\"\"\n        self._driver.enable()\n\n    def disable(self):\n        \"\"\"\n        label:\n            en: '%1 disable driver'\n        \"\"\"\n        self._driver.disable()\n\n    def set_current(self, current: float):\n        \"\"\"\n        label:\n            en: '%1 set run current (A RMS) %2'\n        params:\n            current:\n                name: current\n                type: float\n                default: '0.5'\n                field: number\n        \"\"\"\n        self._driver.set_current(current)\n\n    def set_hold_current(self, current: float):\n        \"\"\"\n        label:\n            en: '%1 set hold current (A RMS) %2'\n        params:\n            current:\n                name: current\n                type: float\n                default: '0.15'\n                field: number\n        \"\"\"\n        self._driver.set_hold_current(current)\n\n    def run(self, speed: float):\n        \"\"\"\n        label:\n            en: '%1 run (full steps/s, negative = reverse) %2'\n        params:\n            speed:\n                name: speed\n                type: float\n                default: '200'\n                field: number\n        \"\"\"\n        self._driver.run(speed)\n\n    def stop(self):\n        \"\"\"\n        label:\n            en: '%1 stop'\n        \"\"\"\n        self._driver.stop()\n\n    def set_microsteps(self, n: int):\n        \"\"\"\n        label:\n            en: '%1 set microsteps (1-256) %2'\n        params:\n            n:\n                name: n\n                type: int\n                default: '16'\n                field: number\n                min: '1'\n                max: '256'\n        \"\"\"\n        self._driver.set_microsteps(n)\n\n    def set_interpolation(self, enabled: int):\n        \"\"\"\n        label:\n            en: '%1 set interpolation (0/1) %2'\n        params:\n            enabled:\n                name: enabled\n                type: int\n                default: '1'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        self._driver.set_interpolation(bool(enabled))\n\n    def set_chopper_mode(self, spreadcycle: int):\n        \"\"\"\n        label:\n            en: '%1 set SpreadCycle (0 = StealthChop, 1 = SpreadCycle) %2'\n        params:\n            spreadcycle:\n                name: spreadcycle\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        self._driver.set_chopper_mode(bool(spreadcycle))\n\n    def set_stealthchop_threshold(self, tpwmthrs: int):\n        \"\"\"\n        label:\n            en: '%1 set StealthChop threshold (TPWMTHRS) %2'\n        params:\n            tpwmthrs:\n                name: tpwmthrs\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1048575'\n        \"\"\"\n        self._driver.set_stealthchop_threshold(tpwmthrs)\n\n    def set_direction_inverted(self, inverted: int):\n        \"\"\"\n        label:\n            en: '%1 invert direction (0/1) %2'\n        params:\n            inverted:\n                name: inverted\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        self._driver.set_direction_inverted(bool(inverted))\n\n    def set_freewheel(self, mode: int):\n        \"\"\"\n        label:\n            en: '%1 set freewheel mode (0-3) %2'\n        params:\n            mode:\n                name: mode\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '3'\n        \"\"\"\n        self._driver.set_freewheel(mode)\n\n    def standstill(self) -> bool:\n        \"\"\"\n        label:\n            en: '%1 standstill'\n        \"\"\"\n        return self._driver.is_standstill()\n\n    def fault(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 fault bitmask'\n        \"\"\"\n        return self._driver.read_fault()\n\n    def microstep_position(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 microstep position (0-1023)'\n        \"\"\"\n        return self._driver.microstep_position()\n\n    def current_scale(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 current scale (0-31)'\n        \"\"\"\n        return self._driver.read_current_scale()\n\n    def tstep(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 TSTEP'\n        \"\"\"\n        return self._driver.read_tstep()\n\n    def temperature_flags(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 temperature flags (0-15)'\n        \"\"\"\n        return self._driver.read_temperature_flags()\n\n    def ifcnt(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 write counter (IFCNT)'\n        \"\"\"\n        return self._driver.read_ifcnt()\n",
  "version": "alpha2"
}
