{
  "category": "TMC2208",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_TMC2208_LANGUAGES = {\n  \"CUSTOM_TMC2208_INIT\": {\n    \"en\": \"%1 init UART port %2 baudrate %3 TX pin %4 RX pin %5 sense resistor (ohm) %6\"\n  },\n  \"CUSTOM_TMC2208_ENABLE\": {\n    \"en\": \"%1 enable driver\"\n  },\n  \"CUSTOM_TMC2208_DISABLE\": {\n    \"en\": \"%1 disable driver\"\n  },\n  \"CUSTOM_TMC2208_SET_CURRENT\": {\n    \"en\": \"%1 set run current (A RMS) %2\"\n  },\n  \"CUSTOM_TMC2208_SET_HOLD_CURRENT\": {\n    \"en\": \"%1 set hold current (A RMS) %2\"\n  },\n  \"CUSTOM_TMC2208_RUN\": {\n    \"en\": \"%1 run (full steps/s, negative = reverse) %2\"\n  },\n  \"CUSTOM_TMC2208_STOP\": {\n    \"en\": \"%1 stop\"\n  },\n  \"CUSTOM_TMC2208_SET_MICROSTEPS\": {\n    \"en\": \"%1 set microsteps (1-256) %2\"\n  },\n  \"CUSTOM_TMC2208_SET_INTERPOLATION\": {\n    \"en\": \"%1 set interpolation (0/1) %2\"\n  },\n  \"CUSTOM_TMC2208_SET_CHOPPER_MODE\": {\n    \"en\": \"%1 set SpreadCycle (0 = StealthChop, 1 = SpreadCycle) %2\"\n  },\n  \"CUSTOM_TMC2208_SET_STEALTHCHOP_THRESHOLD\": {\n    \"en\": \"%1 set StealthChop threshold (TPWMTHRS) %2\"\n  },\n  \"CUSTOM_TMC2208_SET_DIRECTION_INVERTED\": {\n    \"en\": \"%1 invert direction (0/1) %2\"\n  },\n  \"CUSTOM_TMC2208_SET_FREEWHEEL\": {\n    \"en\": \"%1 set freewheel mode (0-3) %2\"\n  },\n  \"CUSTOM_TMC2208_STANDSTILL\": {\n    \"en\": \"%1 standstill\"\n  },\n  \"CUSTOM_TMC2208_FAULT\": {\n    \"en\": \"%1 fault bitmask\"\n  },\n  \"CUSTOM_TMC2208_MICROSTEP_POSITION\": {\n    \"en\": \"%1 microstep position (0-1023)\"\n  },\n  \"CUSTOM_TMC2208_CURRENT_SCALE\": {\n    \"en\": \"%1 current scale (0-31)\"\n  },\n  \"CUSTOM_TMC2208_TSTEP\": {\n    \"en\": \"%1 TSTEP\"\n  },\n  \"CUSTOM_TMC2208_TEMPERATURE_FLAGS\": {\n    \"en\": \"%1 temperature flags (0-15)\"\n  },\n  \"CUSTOM_TMC2208_IFCNT\": {\n    \"en\": \"%1 write counter (IFCNT)\"\n  }\n};\n\nconst initType = 'custom_tmc2208_init';\nBlockly.BlockRegExpList['custom_tmc2208'] = {\n  regexp: new RegExp(/^custom_tmc2208_/),\n  code: \"from TMC2208 import TMC2208\",\n  initBlockType: initType,\n  categoryId: 'custom_tmc2208',\n}\nBlockly.utils.registerLanguages(CUSTOM_TMC2208_LANGUAGES)\n\nBlockly.Msg.CUSTOM_TMC2208_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_TMC2208 = 'TMC2208'\n\nBlockly.utils.getcustom_tmc2208Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['tmc2208_0', 'tmc2208_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_tmc2208_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_tmc2208Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'tmc2208_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'port'\n        },\n        {\n          'type': 'input_value',\n          'name': 'baudrate'\n        },\n        {\n          'type': 'input_value',\n          'name': 'tx'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rx'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_sense'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var port = Blockly.Python.valueToCode(block, 'port', Blockly.Python.ORDER_FUNCTION_CALL);\n  var baudrate = Blockly.Python.valueToCode(block, 'baudrate', Blockly.Python.ORDER_FUNCTION_CALL);\n  var tx = Blockly.Python.valueToCode(block, 'tx', Blockly.Python.ORDER_FUNCTION_CALL);\n  var rx = Blockly.Python.valueToCode(block, 'rx', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_sense = Blockly.Python.valueToCode(block, 'r_sense', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = TMC2208(${port}, ${baudrate}, ${tx}, ${rx}, ${r_sense})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_enable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_ENABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_enable\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.enable()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_disable\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_DISABLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_disable\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.disable()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'current'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var current = Blockly.Python.valueToCode(block, 'current', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_current(${current})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_hold_current\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_HOLD_CURRENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'current'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_hold_current\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var current = Blockly.Python.valueToCode(block, 'current', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_hold_current(${current})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_run\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_RUN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'speed'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_run\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var speed = Blockly.Python.valueToCode(block, 'speed', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.run(${speed})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_stop\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_STOP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_stop\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.stop()\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_microsteps\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_MICROSTEPS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'n'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_microsteps\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var n = Blockly.Python.valueToCode(block, 'n', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_microsteps(${n})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_interpolation\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_INTERPOLATION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_interpolation\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_interpolation(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_chopper_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_CHOPPER_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'spreadcycle'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_chopper_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var spreadcycle = Blockly.Python.valueToCode(block, 'spreadcycle', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_chopper_mode(${spreadcycle})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_stealthchop_threshold\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_STEALTHCHOP_THRESHOLD,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'tpwmthrs'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_stealthchop_threshold\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var tpwmthrs = Blockly.Python.valueToCode(block, 'tpwmthrs', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_stealthchop_threshold(${tpwmthrs})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_direction_inverted\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_DIRECTION_INVERTED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'inverted'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_direction_inverted\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var inverted = Blockly.Python.valueToCode(block, 'inverted', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_direction_inverted(${inverted})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_set_freewheel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_SET_FREEWHEEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_set_freewheel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_freewheel(${mode})\\n`\n}\n\nBlockly.Blocks[\"custom_tmc2208_standstill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_STANDSTILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_standstill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.standstill()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc2208_fault\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_FAULT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_fault\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.fault()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc2208_microstep_position\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_MICROSTEP_POSITION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_microstep_position\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.microstep_position()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc2208_current_scale\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_CURRENT_SCALE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_current_scale\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.current_scale()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc2208_tstep\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_TSTEP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_tstep\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.tstep()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc2208_temperature_flags\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_TEMPERATURE_FLAGS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_temperature_flags\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature_flags()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_tmc2208_ifcnt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_TMC2208_IFCNT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_tmc2208Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_tmc2208_ifcnt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.ifcnt()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"TMC2208\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_tmc2208\">\n<title text=\"TMC2208\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_tmc2208_init\">\n  <value name=\"port\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"baudrate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">115200</field>\n    </shadow>\n  </value>\n  <value name=\"tx\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">17</field>\n    </shadow>\n  </value>\n  <value name=\"rx\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">16</field>\n    </shadow>\n  </value>\n  <value name=\"r_sense\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.11</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_enable\"/><block type=\"custom_tmc2208_disable\"/><block type=\"custom_tmc2208_set_current\">\n  <value name=\"current\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_set_hold_current\">\n  <value name=\"current\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.15</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_run\">\n  <value name=\"speed\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">200</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_stop\"/><block type=\"custom_tmc2208_set_microsteps\">\n  <value name=\"n\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">16</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_set_interpolation\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_set_chopper_mode\">\n  <value name=\"spreadcycle\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_set_stealthchop_threshold\">\n  <value name=\"tpwmthrs\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_set_direction_inverted\">\n  <value name=\"inverted\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_set_freewheel\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_tmc2208_standstill\"/><block type=\"custom_tmc2208_fault\"/><block type=\"custom_tmc2208_microstep_position\"/><block type=\"custom_tmc2208_current_scale\"/><block type=\"custom_tmc2208_tstep\"/><block type=\"custom_tmc2208_temperature_flags\"/><block type=\"custom_tmc2208_ifcnt\"/>\n</category>\n",
