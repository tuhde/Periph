  "uiflow2": {
    "jscode": "const CUSTOM_BME280_LANGUAGES = {\n  \"CUSTOM_BME280_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_BME280_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_BME280_PRESSURE\": {\n    \"en\": \"%1 pressure (hPa)\"\n  },\n  \"CUSTOM_BME280_HUMIDITY\": {\n    \"en\": \"%1 humidity (%)\"\n  }\n};\n\nconst initType = 'custom_bme280_init';\nBlockly.BlockRegExpList['custom_bme280'] = {\n  regexp: new RegExp(/^custom_bme280_/),\n  code: \"from BME280 import BME280\",\n  initBlockType: initType,\n  categoryId: 'custom_bme280',\n}\nBlockly.utils.registerLanguages(CUSTOM_BME280_LANGUAGES)\n\nBlockly.Msg.CUSTOM_BME280_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_BME280 = 'BME280'\n\nBlockly.utils.getcustom_bme280Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['bme280_0', 'bme280_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_bme280_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BME280_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_bme280Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'bme280_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_bme280_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = BME280(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_bme280_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BME280_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bme280Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bme280_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bme280_pressure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BME280_PRESSURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bme280Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bme280_pressure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.pressure()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bme280_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BME280_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bme280Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bme280_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.humidity()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"BME280\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_bme280\"><title text=\"BME280\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_bme280_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">118</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bme280_temperature\"/><block type=\"custom_bme280_pressure\"/><block type=\"custom_bme280_humidity\"/>\n</category>\n",
