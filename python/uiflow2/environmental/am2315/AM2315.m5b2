  "uiflow2": {
    "jscode": "const CUSTOM_AM2315_LANGUAGES = {\n  \"CUSTOM_AM2315_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_AM2315_TEMPERATURE\": {\n    \"en\": \"%1 temperature (\\u00b0C)\"\n  },\n  \"CUSTOM_AM2315_HUMIDITY\": {\n    \"en\": \"%1 relative humidity (%RH)\"\n  },\n  \"CUSTOM_AM2315_FRESH_TEMPERATURE\": {\n    \"en\": \"%1 real-time temperature (\\u00b0C, two reads)\"\n  },\n  \"CUSTOM_AM2315_FRESH_HUMIDITY\": {\n    \"en\": \"%1 real-time humidity (%RH, two reads)\"\n  },\n  \"CUSTOM_AM2315_DEVICE_ID\": {\n    \"en\": \"%1 device ID\"\n  },\n  \"CUSTOM_AM2315_WAKE\": {\n    \"en\": \"%1 wake\"\n  }\n};\n\nconst initType = 'custom_am2315_init';\nBlockly.BlockRegExpList['custom_am2315'] = {\n  regexp: new RegExp(/^custom_am2315_/),\n  code: \"from AM2315 import AM2315\",\n  initBlockType: initType,\n  categoryId: 'custom_am2315',\n}\nBlockly.utils.registerLanguages(CUSTOM_AM2315_LANGUAGES)\n\nBlockly.Msg.CUSTOM_AM2315_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_AM2315 = 'AM2315'\n\nBlockly.utils.getcustom_am2315Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['am2315_0', 'am2315_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_am2315_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AM2315_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_am2315Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'am2315_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_am2315_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = AM2315(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_am2315_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AM2315_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_am2315Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_am2315_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\nBlockly.Blocks[\"custom_am2315_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AM2315_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_am2315Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_am2315_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.humidity()`, Blockly.Python.ORDER_NONE]\n}\nBlockly.Blocks[\"custom_am2315_fresh_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AM2315_FRESH_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_am2315Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_am2315_fresh_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.fresh_temperature()`, Blockly.Python.ORDER_NONE]\n}\nBlockly.Blocks[\"custom_am2315_fresh_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AM2315_FRESH_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_am2315Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_am2315_fresh_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.fresh_humidity()`, Blockly.Python.ORDER_NONE]\n}\nBlockly.Blocks[\"custom_am2315_device_id\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AM2315_DEVICE_ID,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_am2315Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_am2315_device_id\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.device_id()`, Blockly.Python.ORDER_NONE]\n}\nBlockly.Blocks[\"custom_am2315_wake\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AM2315_WAKE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_am2315Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_am2315_wake\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.wake()\\n`\n}\n",
    "toolbox": "\n<category name=\"AM2315\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_am2315\">\n<title text=\"AM2315\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_am2315_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">92</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_am2315_temperature\"/><block type=\"custom_am2315_humidity\"/><block type=\"custom_am2315_fresh_temperature\"/><block type=\"custom_am2315_fresh_humidity\"/><block type=\"custom_am2315_device_id\"/><block type=\"custom_am2315_wake\"/>\n</category>\n",
