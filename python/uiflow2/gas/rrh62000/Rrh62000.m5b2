  "uiflow2": {
    "jscode": "const CUSTOM_RRH62000_LANGUAGES = {\n  \"CUSTOM_RRH62000_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_RRH62000_READ\": {\n    \"en\": \"%1 read new sample\"\n  },\n  \"CUSTOM_RRH62000_PM1\": {\n    \"en\": \"%1 PM1 (ug/m3)\"\n  },\n  \"CUSTOM_RRH62000_PM2_5\": {\n    \"en\": \"%1 PM2.5 (ug/m3)\"\n  },\n  \"CUSTOM_RRH62000_PM10\": {\n    \"en\": \"%1 PM10 (ug/m3)\"\n  },\n  \"CUSTOM_RRH62000_PM1_SMOKE\": {\n    \"en\": \"%1 PM1 smoke ref. (ug/m3)\"\n  },\n  \"CUSTOM_RRH62000_PM2_5_SMOKE\": {\n    \"en\": \"%1 PM2.5 smoke ref. (ug/m3)\"\n  },\n  \"CUSTOM_RRH62000_PM10_SMOKE\": {\n    \"en\": \"%1 PM10 smoke ref. (ug/m3)\"\n  },\n  \"CUSTOM_RRH62000_NC_0_3\": {\n    \"en\": \"%1 particles >0.3 um (1/cm3)\"\n  },\n  \"CUSTOM_RRH62000_NC_0_5\": {\n    \"en\": \"%1 particles >0.5 um (1/cm3)\"\n  },\n  \"CUSTOM_RRH62000_NC_1\": {\n    \"en\": \"%1 particles >1 um (1/cm3)\"\n  },\n  \"CUSTOM_RRH62000_NC_2_5\": {\n    \"en\": \"%1 particles >2.5 um (1/cm3)\"\n  },\n  \"CUSTOM_RRH62000_NC_4\": {\n    \"en\": \"%1 particles >4 um (1/cm3)\"\n  },\n  \"CUSTOM_RRH62000_TEMPERATURE\": {\n    \"en\": \"%1 temperature (C)\"\n  },\n  \"CUSTOM_RRH62000_HUMIDITY\": {\n    \"en\": \"%1 humidity (%RH)\"\n  },\n  \"CUSTOM_RRH62000_TVOC\": {\n    \"en\": \"%1 TVOC (ug/m3)\"\n  },\n  \"CUSTOM_RRH62000_ECO2\": {\n    \"en\": \"%1 eCO2 (ppm)\"\n  },\n  \"CUSTOM_RRH62000_IAQ\": {\n    \"en\": \"%1 IAQ index (1-5)\"\n  },\n  \"CUSTOM_RRH62000_STATUS\": {\n    \"en\": \"%1 status word\"\n  },\n  \"CUSTOM_RRH62000_HIGH_CONCENTRATION\": {\n    \"en\": \"%1 dust concentration too high\"\n  },\n  \"CUSTOM_RRH62000_DUST_ACCUMULATION\": {\n    \"en\": \"%1 dust accumulated\"\n  },\n  \"CUSTOM_RRH62000_FAN_SPEED_ERROR\": {\n    \"en\": \"%1 fan speed out of range\"\n  },\n  \"CUSTOM_RRH62000_FAN_ERROR\": {\n    \"en\": \"%1 fan malfunction\"\n  },\n  \"CUSTOM_RRH62000_DATA_READY\": {\n    \"en\": \"%1 new data ready\"\n  },\n  \"CUSTOM_RRH62000_SLEEP\": {\n    \"en\": \"%1 sleep\"\n  },\n  \"CUSTOM_RRH62000_WAKE\": {\n    \"en\": \"%1 wake up\"\n  },\n  \"CUSTOM_RRH62000_START_CLEANING\": {\n    \"en\": \"%1 start fan cleaning\"\n  },\n  \"CUSTOM_RRH62000_CLEANING_DONE\": {\n    \"en\": \"%1 cleaning done\"\n  },\n  \"CUSTOM_RRH62000_SOFT_RESET\": {\n    \"en\": \"%1 reset\"\n  },\n  \"CUSTOM_RRH62000_SET_MOVING_AVERAGE\": {\n    \"en\": \"%1 moving average (1-60) %2\"\n  },\n  \"CUSTOM_RRH62000_GET_MOVING_AVERAGE\": {\n    \"en\": \"%1 moving average\"\n  },\n  \"CUSTOM_RRH62000_SET_FAN_SPEED\": {\n    \"en\": \"%1 fan speed (60-100 %) %2\"\n  },\n  \"CUSTOM_RRH62000_GET_FAN_SPEED\": {\n    \"en\": \"%1 fan speed (%)\"\n  },\n  \"CUSTOM_RRH62000_SET_CLEANING_INTERVAL\": {\n    \"en\": \"%1 cleaning interval (s, multiple of 30) %2\"\n  },\n  \"CUSTOM_RRH62000_GET_CLEANING_INTERVAL\": {\n    \"en\": \"%1 cleaning interval (s)\"\n  },\n  \"CUSTOM_RRH62000_SET_CLEANING_TIME\": {\n    \"en\": \"%1 cleaning time (0-60 s) %2\"\n  },\n  \"CUSTOM_RRH62000_GET_CLEANING_TIME\": {\n    \"en\": \"%1 cleaning time (s)\"\n  },\n  \"CUSTOM_RRH62000_MOX_RESISTANCE\": {\n    \"en\": \"%1 MOX resistance (ohm)\"\n  },\n  \"CUSTOM_RRH62000_UNIQUE_ID\": {\n    \"en\": \"%1 unique ID (hex)\"\n  },\n  \"CUSTOM_RRH62000_ALGORITHM_VERSION\": {\n    \"en\": \"%1 algorithm version\"\n  },\n  \"CUSTOM_RRH62000_FIRMWARE_VERSION\": {\n    \"en\": \"%1 firmware version\"\n  }\n};\n\nconst initType = 'custom_rrh62000_init';\nBlockly.BlockRegExpList['custom_rrh62000'] = {\n  regexp: new RegExp(/^custom_rrh62000_/),\n  code: \"from Rrh62000 import Rrh62000\",\n  initBlockType: initType,\n  categoryId: 'custom_rrh62000',\n}\nBlockly.utils.registerLanguages(CUSTOM_RRH62000_LANGUAGES)\n\nBlockly.Msg.CUSTOM_RRH62000_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_RRH62000 = 'Rrh62000'\n\nBlockly.utils.getcustom_rrh62000Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['rrh62000_0', 'rrh62000_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_rrh62000_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH62000_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_rrh62000Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'rrh62000_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh62000_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Rrh62000(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_rrh62000_read\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH62000_READ,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rrh62000Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh62000_read\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.read()\\n`\n}\n\nBlockly.Blocks[\"custom_rrh62000_pm1\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH62000_PM1,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rrh62000Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh62000_pm1\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.pm1()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rrh62000_pm2_5\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH62000_PM2_5,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rrh62000Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh62000_pm2_5\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.pm2_5()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rrh62000_pm10\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH62000_PM10,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rrh62000Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh62000_pm10\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.pm10()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rrh62000_pm1_sm