  "pyCode": "\"\"\"\nfile     Ccs811\ntime     2026-11-26\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.i2c_auto import I2CConnection\nfrom periph.chips.gas.ccs811 import CCS811Full\n\n\nclass Ccs811:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 0, address: int = 90):\n        \"\"\"\n        label:\n            en: '%1 init bus %2 address %3'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '0'\n                field: number\n            address:\n                name: address\n                type: int\n                default: '90'\n                field: number\n        \"\"\"\n        connection = I2CConnection(address, bus=bus)\n        self._driver = CCS811Full(connection)\n        self._driver.init()\n\n    def eco2(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 eCO2 (ppm)'\n        \"\"\"\n        return self._driver.read_eco2()\n\n    def tvoc(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 TVOC (ppb)'\n        \"\"\"\n        return self._driver.read_tvoc()\n\n    def data_ready(self) -> bool:\n        \"\"\"\n        label:\n            en: '%1 data ready'\n        \"\"\"\n        return self._driver.data_ready()\n\n    def set_mode(self, mode: int = 1):\n        \"\"\"\n        label:\n            en: '%1 drive mode (0-4) %2'\n        params:\n            mode:\n                name: mode\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.set_mode(mode)\n\n    def set_environment(self, humidity: float = 50.0, temperature: float = 25.0):\n        \"\"\"\n        label:\n            en: '%1 environment humidity (%RH) %2 temperature (°C) %3'\n        params:\n            humidity:\n                name: humidity\n                type: float\n                default: '50.0'\n                field: number\n            temperature:\n                name: temperature\n                type: float\n                default: '25.0'\n                field: number\n        \"\"\"\n        self._driver.set_environment(humidity, temperature)\n\n    def set_thresholds(self, low_medium: int = 1500, medium_high: int = 2500, hysteresis: int = 50):\n        \"\"\"\n        label:\n            en: '%1 thresholds low/medium (ppm) %2 medium/high (ppm) %3 hysteresis (ppm) %4'\n        params:\n            low_medium:\n                name: low_medium\n                type: int\n                default: '1500'\n                field: number\n            medium_high:\n                name: medium_high\n                type: int\n                default: '2500'\n                field: number\n            hysteresis:\n                name: hysteresis\n                type: int\n                default: '50'\n                field: number\n        \"\"\"\n        self._driver.set_thresholds(low_medium, medium_high, hysteresis)\n\n    def baseline(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 baseline'\n        \"\"\"\n        return self._driver.get_baseline()\n\n    def set_baseline(self, baseline: int = 0):\n        \"\"\"\n        label:\n            en: '%1 set baseline %2'\n        params:\n            baseline:\n                name: baseline\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.set_baseline(baseline)\n\n    def status(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 status'\n        \"\"\"\n        return self._driver.status()\n\n    def error(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 error ID'\n        \"\"\"\n        return self._driver.error()\n\n    def soft_reset(self):\n        \"\"\"\n        label:\n            en: '%1 soft reset'\n        \"\"\"\n        self._driver.soft_reset()\n",
  "version": "alpha2"
}
