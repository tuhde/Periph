    "jscode": "const CUSTOM_RRH46410_LANGUAGES = {\n  \"CUSTOM_RRH46410_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_RRH46410_WAIT_FOR_SAMPLE\": {\n    \"en\": \"%1 new sample (wait up to 5 s)\"\n  },\n  \"CUSTOM_RRH46410_IAQ\": {\n    \"en\": \"%1 IAQ index (1-5)\"\n  },\n  \"CUSTOM_RRH46410_TVOC_MG_M3\": {\n    \"en\": \"%1 TVOC (mg/m3)\"\n  },\n  \"CUSTOM_RRH46410_ETOH_PPM\": {\n    \"en\": \"%1 ethanol (ppm)\"\n  },\n  \"CUSTOM_RRH46410_ECO2_PPM\": {\n    \"en\": \"%1 eCO2 (ppm)\"\n  },\n  \"CUSTOM_RRH46410_RELATIVE_IAQ\": {\n    \"en\": \"%1 relative IAQ\"\n  },\n  \"CUSTOM_RRH46410_WARMED_UP\": {\n    \"en\": \"%1 warmed up\"\n  },\n  \"CUSTOM_RRH46410_AIR_QUALITY_LABEL\": {\n    \"en\": \"%1 air quality rating\"\n  },\n  \"CUSTOM_RRH46410_PRODUCT_ID\": {\n    \"en\": \"%1 product ID\"\n  },\n  \"CUSTOM_RRH46410_GET_MODE\": {\n    \"en\": \"%1 operation mode\"\n  },\n  \"CUSTOM_RRH46410_SET_MODE\": {\n    \"en\": \"%1 operation mode (0 suspend, 1 IAQ, 2 ULP, 5 PBAQ) %2\"\n  },\n  \"CUSTOM_RRH46410_SET_HUMIDITY\": {\n    \"en\": \"%1 ambient humidity (%RH) %2\"\n  },\n  \"CUSTOM_RRH46410_SAMPLE_PERIOD\": {\n    \"en\": \"%1 sample period (s)\"\n  },\n  \"CUSTOM_RRH46410_WARMUP_SAMPLES\": {\n    \"en\": \"%1 warm-up samples\"\n  },\n  \"CUSTOM_RRH46410_CONFIG_GPIO\": {\n    \"en\": \"%1 GPIO outputs mask %2\"\n  },\n  \"CUSTOM_RRH46410_GET_GPIO\": {\n    \"en\": \"%1 GPIO levels\"\n  },\n  \"CUSTOM_RRH46410_SET_GPIO\": {\n    \"en\": \"%1 set GPIO mask %2\"\n  },\n  \"CUSTOM_RRH46410_CLEAR_GPIO\": {\n    \"en\": \"%1 clear GPIO mask %2\"\n  },\n  \"CUSTOM_RRH46410_STATUS\": {\n    \"en\": \"%1 status byte\"\n  },\n  \"CUSTOM_RRH46410_SUSPEND\": {\n    \"en\": \"%1 suspend\"\n  },\n  \"CUSTOM_RRH46410_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_rrh46410_init';\nBlockly.BlockRegExpList['custom_rrh46410'] = {\n  regexp: new RegExp(/^custom_rrh46410_/),\n  code: \"from Rrh46410 import Rrh46410\",\n  initBlockType: initType,\n  categoryId: 'custom_rrh46410',\n}\nBlockly.utils.registerLanguages(CUSTOM_RRH46410_LANGUAGES)\n\nBlockly.Msg.CUSTOM_RRH46410_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_RRH46410 = 'Rrh46410'\n\nBlockly.utils.getcustom_rrh46410Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['rrh46410_0', 'rrh46410_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_rrh46410_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH46410_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_rrh46410Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'rrh46410_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh46410_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Rrh46410(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_rrh46410_wait_for_sample\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH46410_WAIT_FOR_SAMPLE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rrh46410Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh46410_wait_for_sample\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.wait_for_sample()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rrh46410_iaq\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH46410_IAQ,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rrh46410Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh46410_iaq\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.iaq()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rrh46410_tvoc_mg_m3\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH46410_TVOC_MG_M3,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_rrh46410Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_rrh46410_tvoc_mg_m3\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.tvoc_mg_m3()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_rrh46410_etoh_ppm\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_RRH46410_ETOH_PPM,\n      'args0': [\n        {\n          'type': 'fi