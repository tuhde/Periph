    "toolbox": "\n<category name=\"Rrh46410\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_rrh46410\">\n<title text=\"Rrh46410\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_rrh46410_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">56</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rrh46410_wait_for_sample\"/><block type=\"custom_rrh46410_iaq\"/><block type=\"custom_rrh46410_tvoc_mg_m3\"/><block type=\"custom_rrh46410_etoh_ppm\"/><block type=\"custom_rrh46410_eco2_ppm\"/><block type=\"custom_rrh46410_relative_iaq\"/><block type=\"custom_rrh46410_warmed_up\"/><block type=\"custom_rrh46410_air_quality_label\"/><block type=\"custom_rrh46410_product_id\"/><block type=\"custom_rrh46410_get_mode\"/><block type=\"custom_rrh46410_set_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rrh46410_set_humidity\">\n  <value name=\"percent\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">50.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rrh46410_sample_period\"/><block type=\"custom_rrh46410_warmup_samples\"/><block type=\"custom_rrh46410_config_gpio\">\n  <value name=\"directions\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rrh46410_get_gpio\"/><block type=\"custom_rrh46410_set_gpio\">\n  <value name=\"mask\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rrh46410_clear_gpio\">\n  <value name=\"mask\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_rrh46410_st