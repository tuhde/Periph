  "uiflow2": {
    "jscode": "const CUSTOM_ENS160_LANGUAGES = {\n  \"CUSTOM_ENS160_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_ENS160_READ_AQI\": {\n    \"en\": \"%1 air quality index\"\n  },\n  \"CUSTOM_ENS160_READ_TVOC\": {\n    \"en\": \"%1 TVOC (ppb)\"\n  },\n  \"CUSTOM_ENS160_READ_ECO2\": {\n    \"en\": \"%1 eCO2 (ppm)\"\n  }\n};\n\nconst initType = 'custom_ens160_init';\nBlockly.BlockRegExpList['custom_ens160'] = {\n  regexp: new RegExp(/^custom_ens160_/),\n  code: \"from ENS160 import ENS160\",\n  initBlockType: initType,\n  categoryId: 'custom_ens160',\n}\nBlockly.utils.registerLanguages(CUSTOM_ENS160_LANGUAGES)\n\nBlockly.Msg.CUSTOM_ENS160_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_ENS160 = 'ENS160'\n\nBlockly.utils.getcustom_ens160Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ens160_0', 'ens160_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ens160_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ENS160_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ens160Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ens160_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ens160_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = ENS160(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_ens160_read_aqi\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ENS160_READ_AQI,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ens160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ens160_read_aqi\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_aqi()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ens160_read_tvoc\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ENS160_READ_TVOC,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ens160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ens160_read_tvoc\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_tvoc()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ens160_read_eco2\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ENS160_READ_ECO2,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ens160Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ens160_read_eco2\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_eco2()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"ENS160\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ens160\"><title text=\"ENS160\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ens160_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ens160_read_aqi\"/><block type=\"custom_ens160_read_tvoc\"/><block type=\"custom_ens160_read_eco2\"/>\n</category>\n",
