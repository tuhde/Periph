    "toolbox": "\n<category name=\"VL53L0X\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_vl53l0x\">\n<title text=\"VL53L0X\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_vl53l0x_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">41</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_vl53l0x_distance\"/><block type=\"custom_vl53l0x_range_valid\"/><block type=\"custom_vl53l0x_start_continuous\">\n  <value name=\"period_ms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_vl53l0x_stop_continuous\"/><block type=\"custom_vl53l0x_read_continuous\"/><block type=\"custom_vl53l0x_data_ready\"/><block type=\"custom_vl53l0x_read_measurement\"/><block type=\"custom_vl53l0x_range_status\"/><block type=\"custom_vl53l0x_set_timing_budget\">\n  <value name=\"budget_us\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">33000</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_vl53l0x_timing_budget\"/><block type=\"custom_vl53l0x_set_signal_rate_limit\">\n  <value name=\"limit_mcps\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.25</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_vl53l0x_signal_rate_limit\"/><block type=\"custom_vl53l0x_set_vcsel_pulse_period\">\n  <value name=\"period_type\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"pclks\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">14</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_vl53l0x_vcsel_pulse_period\">\n  <value name=\"period_type\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block t