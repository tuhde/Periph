  "uiflow2": {
    "jscode": "const CUSTOM_VL6180X_LANGUAGES = {\n  \"CUSTOM_VL6180X_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_VL6180X_RANGE\": {\n    \"en\": \"%1 range (mm)\"\n  },\n  \"CUSTOM_VL6180X_RANGE_ERROR\": {\n    \"en\": \"%1 single-shot range error code (0=valid)\"\n  },\n  \"CUSTOM_VL6180X_LUX\": {\n    \"en\": \"%1 ambient light (lux)\"\n  },\n  \"CUSTOM_VL6180X_ALS_RAW\": {\n    \"en\": \"%1 ALS raw count\"\n  },\n  \"CUSTOM_VL6180X_START_CONTINUOUS_RANGE\": {\n    \"en\": \"%1 start continuous range, period (ms, 10-2550) %2\"\n  },\n  \"CUSTOM_VL6180X_STOP_CONTINUOUS_RANGE\": {\n    \"en\": \"%1 stop continuous range\"\n  },\n  \"CUSTOM_VL6180X_RANGE_CONTINUOUS\": {\n    \"en\": \"%1 next continuous range (mm)\"\n  },\n  \"CUSTOM_VL6180X_START_CONTINUOUS_ALS\": {\n    \"en\": \"%1 start continuous ALS, period (ms, 10-2550) %2\"\n  },\n  \"CUSTOM_VL6180X_STOP_CONTINUOUS_ALS\": {\n    \"en\": \"%1 stop continuous ALS\"\n  },\n  \"CUSTOM_VL6180X_SET_INTERLEAVED\": {\n    \"en\": \"%1 interleaved ALS+range (1=on 0=off) %2\"\n  },\n  \"CUSTOM_VL6180X_SET_ALS_GAIN\": {\n    \"en\": \"%1 ALS gain code (0=20 6=1 7=40) %2\"\n  },\n  \"CUSTOM_VL6180X_SET_ALS_INTEGRATION_TIME\": {\n    \"en\": \"%1 ALS integration time (ms) %2\"\n  },\n  \"CUSTOM_VL6180X_SET_ALS_SCALER\": {\n    \"en\": \"%1 ALS scaler %2\"\n  },\n  \"CUSTOM_VL6180X_SET_RANGE_THRESHOLDS\": {\n    \"en\": \"%1 range thresholds low (mm) %2 high (mm) %3\"\n  },\n  \"CUSTOM_VL6180X_SET_ALS_THRESHOLDS\": {\n    \"en\": \"%1 ALS thresholds low %2 high %3\"\n  },\n  \"CUSTOM_VL6180X_SET_MAX_CONVERGENCE_TIME\": {\n    \"en\": \"%1 max convergence time (ms) %2\"\n  },\n  \"CUSTOM_VL6180X_SET_AVERAGING_PERIOD\": {\n    \"en\": \"%1 averaging period (units of 64.5 us) %2\"\n  },\n  \"CUSTOM_VL6180X_SET_RANGE_OFFSET\": {\n    \"en\": \"%1 range offset (mm) %2\"\n  },\n  \"CUSTOM_VL6180X_RANGE_OFFSET\": {\n    \"en\": \"%1 range offset (mm)\"\n  },\n  \"CUSTOM_VL6180X_SET_CROSSTALK_RATE\": {\