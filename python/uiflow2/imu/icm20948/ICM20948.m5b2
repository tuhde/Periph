 },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ICM20948_SET_WAKE_ON_MOTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_icm20948Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'threshold_mg'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_icm20948_set_wake_on_motion\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var threshold_mg = Blockly.Python.valueToCode(block, 'threshold_mg', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_wake_on_motion(${threshold_mg})\\n`\n}\n\nBlockly.Blocks[\"custom_icm20948_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ICM20948_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_icm20948Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_icm20948_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_icm20948_enable_fifo\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ICM20948_ENABLE_FIFO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_icm20948Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\