{
  "category": "ICM20948",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_ICM20948_LANGUAGES = {\n  \"CUSTOM_ICM20948_INIT\": {\n    \"en\": \"%1 init bus %2 address (104-105) %3\"\n  },\n  \"CUSTOM_ICM20948_ACCEL_X\": {\n    \"en\": \"%1 acceleration X (m/s²)\"\n  },\n  \"CUSTOM_ICM20948_ACCEL_Y\": {\n    \"en\": \"%1 acceleration Y (m/s²)\"\n  },\n  \"CUSTOM_ICM20948_ACCEL_Z\": {\n    \"en\": \"%1 acceleration Z (m/s²)\"\n  },\n  \"CUSTOM_ICM20948_GYRO_X\": {\n    \"en\": \"%1 angular rate X (rad/s)\"\n  },\n  \"CUSTOM_ICM20948_GYRO_Y\": {\n    \"en\": \"%1 angular rate Y (rad/s)\"\n  },\n  \"CUSTOM_ICM20948_GYRO_Z\": {\n    \"en\": \"%1 angular rate Z (rad/s)\"\n  },\n  \"CUSTOM_ICM20948_TEMPERATURE\": {\n    \"en\": \"%1 die temperature (°C)\"\n  },\n  \"CUSTOM_ICM20948_DATA_READY\": {\n    \"en\": \"%1 new data ready?\"\n  },\n  \"CUSTOM_ICM20948_ENABLE_MAG\": {\n    \"en\": \"%1 enable magnetometer\"\n  },\n  \"CUSTOM_ICM20948_MAG_X\": {\n    \"en\": \"%1 magnetic field X (µT)\"\n  },\n  \"CUSTOM_ICM20948_MAG_Y\": {\n    \"en\": \"%1 magnetic field Y (µT)\"\n  },\n  \"CUSTOM_ICM20948_MAG_Z\": {\n    \"en\": \"%1 magnetic field Z (µT)\"\n  },\n  \"CUSTOM_ICM20948_MAG_DATA_READY\": {\n    \"en\": \"%1 magnetometer data ready?\"\n  },\n  \"CUSTOM_ICM20948_CONFIGURE_GYRO\": {\n    \"en\": \"%1 gyro range (0=±250 1=±500 2=±1000 3=±2000 dps) %2\"\n  },\n  \"CUSTOM_ICM20948_CONFIGURE_ACCEL\": {\n    \"en\": \"%1 accel range (0=±2 1=±4 2=±8 3=±16 g) %2\"\n  },\n  \"CUSTOM_ICM20948_CONFIGURE_FILTERS\": {\n    \"en\": \"%1 filters gyro DLPF (0-7) %2 accel DLPF (0-7) %3\"\n  },\n  \"CUSTOM_ICM20948_CONFIGURE_SAMPLE_RATE\": {\n    \"en\": \"%1 sample rate dividers gyro (0-255) %2 accel (0-4095) %3\"\n  },\n  \"CUSTOM_ICM20948_SET_SLEEP\": {\n    \"en\": \"%1 sleep (0=wake 1=sleep) %2\"\n  },\n  \"CUSTOM_ICM20948_SET_WAKE_ON_MOTION\": {\n    \"en\": \"%1 wake-on-motion threshold (mg) %2\"\n  },\n  \"CUSTOM_ICM20948_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status (1=data 2=motion 4=I2C master 8=PLL 16=FIFO overflow)\"\n  },\n  \"CUSTOM_ICM20948_ENABLE_FIFO\": {\n    \"en\": \"%1 enable FIFO (accel + gyro)\"\n  },\n  \"CUSTOM_ICM20948_FIFO_COUNT\": {\n    \"en\": \"%1 FIFO byte count\"\n  },\n  \"CUSTOM_ICM20948_RESET_FIFO\": {\n    \"en\": \"%1 reset FIFO\"\n  }\n};\n\nconst initType = 'custom_icm20948_init';\nBlockly.BlockRegExpList['custom_icm20948'] = {\n  regexp: new RegExp(/^custom_icm20948_/),\n  code: \"from ICM20948 import ICM20948\",\n  initBlockType: initType,\n  categoryId: 'custom_icm20948',\n}\nBlockly.utils.registerLanguages(CUSTOM_ICM20948_LANGUAGES)\n\nBlockly.Msg.CUSTOM_ICM20948_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_ICM20948 = 'ICM20948'\n\nBlockly.utils.getcustom_icm20948Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['icm20948_0', 'icm20948_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_icm20948_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ICM20948_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_icm20948Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'icm20948_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_icm20948_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = ICM20948(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_icm20948_accel_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ICM20948_ACCEL_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_icm20948Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_icm20948_accel_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_icm20948_accel_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ICM20948_ACCEL_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_icm20948Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_icm20948_accel_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_icm20948_accel_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ICM20948_ACCEL_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_icm20948Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"