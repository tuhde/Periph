    "toolbox": "\n<category name=\"ICM20948\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_icm20948\">\n<title text=\"ICM20948\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_icm20948_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">104</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_icm20948_accel_x\"/><block type=\"custom_icm20948_accel_y\"/><block type=\"custom_icm20948_accel_z\"/><block type=\"custom_icm20948_gyro_x\"/><block type=\"custom_icm20948_gyro_y\"/><block type=\"custom_icm20948_gyro_z\"/><block type=\"custom_icm20948_temperature\"/><block type=\"custom_icm20948_data_ready\"/><block type=\"custom_icm20948_enable_mag\"/><block type=\"custom_icm20948_mag_x\"/><block type=\"custom_icm20948_mag_y\"/><block type=\"custom_icm20948_mag_z\"/><block type=\"custom_icm20948_mag_data_ready\"/><block type=\"custom_icm20948_configure_gyro\">\n  <value name=\"full_scale\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_icm20948_configure_accel\">\n  <value name=\"full_scale\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_icm20948_configure_filters\">\n  <value name=\"gyro_dlpf\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n  <value name=\"accel_dlpf\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_icm20948_configure_sample_rate\">\n  <value name=\"gyro_div\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10</field>\n    </shadow>\n  </value>\n  <value name=\"accel_div\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_icm20948_set_sleep\">\n  <value name=\"sleep\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_icm20948_set_wake_on_motion\">\n  <value name=\"threshold_mg\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">200.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_icm20948_poll_interrupt\"/><block type=\"custom_icm20948_enable_fifo\"/><block type=\"custom_icm20948_fifo_count\"/><block type=\"custom_icm20948_reset_fifo\"/>\n</category>\n",
