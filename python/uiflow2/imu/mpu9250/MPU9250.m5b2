  "uiflow2": {
    "jscode": "const CUSTOM_MPU9250_LANGUAGES = {\n  \"CUSTOM_MPU9250_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_MPU9250_ACCEL_X\": {\n    \"en\": \"%1 acceleration X (m/s²)\"\n  },\n  \"CUSTOM_MPU9250_ACCEL_Y\": {\n    \"en\": \"%1 acceleration Y (m/s²)\"\n  },\n  \"CUSTOM_MPU9250_ACCEL_Z\": {\n    \"en\": \"%1 acceleration Z (m/s²)\"\n  },\n  \"CUSTOM_MPU9250_GYRO_X\": {\n    \"en\": \"%1 angular rate X (rad/s)\"\n  },\n  \"CUSTOM_MPU9250_GYRO_Y\": {\n    \"en\": \"%1 angular rate Y (rad/s)\"\n  },\n  \"CUSTOM_MPU9250_GYRO_Z\": {\n    \"en\": \"%1 angular rate Z (rad/s)\"\n  },\n  \"CUSTOM_MPU9250_TEMPERATURE\": {\n    \"en\": \"%1 die temperature (°C)\"\n  },\n  \"CUSTOM_MPU9250_DATA_READY\": {\n    \"en\": \"%1 new data ready?\"\n  }\n};\n\nconst initType = 'custom_mpu9250_init';\nBlockly.BlockRegExpList['custom_mpu9250'] = {\n  regexp: new RegExp(/^custom_mpu9250_/),\n  code: \"from MPU9250 import MPU9250\",\n  initBlockType: initType,\n  categoryId: 'custom_mpu9250',\n}\nBlockly.utils.registerLanguages(CUSTOM_MPU9250_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MPU9250_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MPU9250 = 'MPU9250'\n\nBlockly.utils.getcustom_mpu9250Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['mpu9250_0', 'mpu9250_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_mpu9250_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_mpu9250Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'mpu9250_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MPU9250(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_mpu9250_accel_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_ACCEL_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_accel_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpu9250_accel_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_ACCEL_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_accel_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpu9250_accel_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_ACCEL_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_accel_z\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_z()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpu9250_gyro_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_GYRO_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_gyro_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.gyro_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpu9250_gyro_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_GYRO_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_gyro_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.gyro_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpu9250_gyro_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_GYRO_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_gyro_z\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.gyro_z()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpu9250_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mpu9250_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MPU9250_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mpu9250Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mpu9250_data_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.data_ready()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"MPU9250\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mpu9250\">\n<title text=\"MPU9250\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mpu9250_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">104</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mpu9250_accel_x\"/><block type=\"custom_mpu9250_accel_y\"/><block type=\"custom_mpu9250_accel_z\"/><block type=\"custom_mpu9250_gyro_x\"/><block type=\"custom_mpu9250_gyro_y\"/><block type=\"custom_mpu9250_gyro_z\"/><block type=\"custom_mpu9250_temperature\"/><block type=\"custom_mpu9250_data_ready\"/>\n</category>\n",
