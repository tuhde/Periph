essage0': Blockly.Msg.CUSTOM_BNO055_SET_POWER_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_set_power_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_power_mode(${mode})\\n`\n}\n\nBlockly.Blocks[\"custom_bno055_system_status\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_SYSTEM_STATUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_system_status\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.system_status()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_system_error\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_SYSTEM_ERROR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_system_error\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.system_error()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_self_test_passed\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_SELF_TEST_PASSED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_self_test_passed\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.self_test_passed()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}\n",
    "toolbox": "\n<category name=\"BNO055\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_bno055\">\n<title text=\"BNO055\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_bno055_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">41</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bno055_heading\"/><block type=\"custom_bno055_roll\"/><block type=\"custom_bno055_pitch\"/><block type=\"custom_bno055_quaternion_w\"/><block type=\"custom_bno055_quaternion_x\"/><block type=\"custom_bno055_quaternion_y\"/><block type=\"custom_bno055_quaternion_z\"/><block type=\"custom_bno055_linear_accel_x\"/><block type=\"custom_bno055_linear_accel_y\"/><block type=\"custom_bno055_linear_accel_z\"/><block type=\"custom_bno055_gravity_x\"/><block type=\"custom_bno055_gravity_y\"/><block type=\"custom_bno055_gravity_z\"/><block type=\"custom_bno055_temperature\"/><block type=\"custom_bno055_calib_system\"/><block type=\"custom_bno055_calib_gyroscope\"/><block type=\"custom_bno055_calib_accelerometer\"/><block type=\"custom_bno055_calib_magnetometer\"/><block type=\"custom_bno055_is_calibrated\"/><block type=\"custom_bno055_get_mode\"/><block type=\"custom_bno055_set_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">12</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bno055_set_axis_remap\">\n  <value name=\"config\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">36</field>\n    </shadow>\n  </value>\n  <value name=\"sign\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_bno055_set_power_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </v