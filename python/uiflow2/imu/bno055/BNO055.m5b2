{
  "category": "BNO055",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_BNO055_LANGUAGES = {\n  \"CUSTOM_BNO055_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_BNO055_HEADING\": {\n    \"en\": \"%1 heading (rad)\"\n  },\n  \"CUSTOM_BNO055_ROLL\": {\n    \"en\": \"%1 roll (rad)\"\n  },\n  \"CUSTOM_BNO055_PITCH\": {\n    \"en\": \"%1 pitch (rad)\"\n  },\n  \"CUSTOM_BNO055_QUATERNION_W\": {\n    \"en\": \"%1 quaternion W\"\n  },\n  \"CUSTOM_BNO055_QUATERNION_X\": {\n    \"en\": \"%1 quaternion X\"\n  },\n  \"CUSTOM_BNO055_QUATERNION_Y\": {\n    \"en\": \"%1 quaternion Y\"\n  },\n  \"CUSTOM_BNO055_QUATERNION_Z\": {\n    \"en\": \"%1 quaternion Z\"\n  },\n  \"CUSTOM_BNO055_LINEAR_ACCEL_X\": {\n    \"en\": \"%1 linear acceleration X (m/s²)\"\n  },\n  \"CUSTOM_BNO055_LINEAR_ACCEL_Y\": {\n    \"en\": \"%1 linear acceleration Y (m/s²)\"\n  },\n  \"CUSTOM_BNO055_LINEAR_ACCEL_Z\": {\n    \"en\": \"%1 linear acceleration Z (m/s²)\"\n  },\n  \"CUSTOM_BNO055_GRAVITY_X\": {\n    \"en\": \"%1 gravity X (m/s²)\"\n  },\n  \"CUSTOM_BNO055_GRAVITY_Y\": {\n    \"en\": \"%1 gravity Y (m/s²)\"\n  },\n  \"CUSTOM_BNO055_GRAVITY_Z\": {\n    \"en\": \"%1 gravity Z (m/s²)\"\n  },\n  \"CUSTOM_BNO055_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_BNO055_CALIB_SYSTEM\": {\n    \"en\": \"%1 system calibration (0-3)\"\n  },\n  \"CUSTOM_BNO055_CALIB_GYROSCOPE\": {\n    \"en\": \"%1 gyroscope calibration (0-3)\"\n  },\n  \"CUSTOM_BNO055_CALIB_ACCELEROMETER\": {\n    \"en\": \"%1 accelerometer calibration (0-3)\"\n  },\n  \"CUSTOM_BNO055_CALIB_MAGNETOMETER\": {\n    \"en\": \"%1 magnetometer calibration (0-3)\"\n  },\n  \"CUSTOM_BNO055_IS_CALIBRATED\": {\n    \"en\": \"%1 fully calibrated?\"\n  },\n  \"CUSTOM_BNO055_GET_MODE\": {\n    \"en\": \"%1 operation mode\"\n  },\n  \"CUSTOM_BNO055_SET_MODE\": {\n    \"en\": \"%1 set operation mode (0=config 8=IMU 12=NDOF) %2\"\n  },\n  \"CUSTOM_BNO055_SET_AXIS_REMAP\": {\n    \"en\": \"%1 axis remap config %2 sign %3\"\n  },\n  \"CUSTOM_BNO055_SET_POWER_MODE\": {\n    \"en\": \"%1 power mode (0=normal 1=low power 2=suspend) %2\"\n  },\n  \"CUSTOM_BNO055_SYSTEM_STATUS\": {\n    \"en\": \"%1 system status\"\n  },\n  \"CUSTOM_BNO055_SYSTEM_ERROR\": {\n    \"en\": \"%1 system error\"\n  },\n  \"CUSTOM_BNO055_SELF_TEST_PASSED\": {\n    \"en\": \"%1 self-test passed?\"\n  },\n  \"CUSTOM_BNO055_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status flags\"\n  },\n  \"CUSTOM_BNO055_RESET\": {\n    \"en\": \"%1 reset chip\"\n  }\n};\n\nconst initType = 'custom_bno055_init';\nBlockly.BlockRegExpList['custom_bno055'] = {\n  regexp: new RegExp(/^custom_bno055_/),\n  code: \"from BNO055 import BNO055\",\n  initBlockType: initType,\n  categoryId: 'custom_bno055',\n}\nBlockly.utils.registerLanguages(CUSTOM_BNO055_LANGUAGES)\n\nBlockly.Msg.CUSTOM_BNO055_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_BNO055 = 'BNO055'\n\nBlockly.utils.getcustom_bno055Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['bno055_0', 'bno055_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_bno055_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_bno055Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'bno055_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = BNO055(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_bno055_heading\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_HEADING,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_heading\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.heading()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_roll\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_ROLL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_roll\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.roll()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_pitch\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_PITCH,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_pitch\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.pitch()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_quaternion_w\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_QUATERNION_W,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_quaternion_w\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.quaternion_w()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_quaternion_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_QUATERNION_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_bno055Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_bno055_quaternion_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.quaternion_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_bno055_quaternion_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_BNO055_QUATERNION_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.ut