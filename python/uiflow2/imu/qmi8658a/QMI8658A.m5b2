{
  "category": "QMI8658A",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_QMI8658A_LANGUAGES = {\n  \"CUSTOM_QMI8658A_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_QMI8658A_ACCEL_X\": {\n    \"en\": \"%1 acceleration X (m/s²)\"\n  },\n  \"CUSTOM_QMI8658A_ACCEL_Y\": {\n    \"en\": \"%1 acceleration Y (m/s²)\"\n  },\n  \"CUSTOM_QMI8658A_ACCEL_Z\": {\n    \"en\": \"%1 acceleration Z (m/s²)\"\n  },\n  \"CUSTOM_QMI8658A_GYRO_X\": {\n    \"en\": \"%1 angular rate X (rad/s)\"\n  },\n  \"CUSTOM_QMI8658A_GYRO_Y\": {\n    \"en\": \"%1 angular rate Y (rad/s)\"\n  },\n  \"CUSTOM_QMI8658A_GYRO_Z\": {\n    \"en\": \"%1 angular rate Z (rad/s)\"\n  },\n  \"CUSTOM_QMI8658A_TEMPERATURE\": {\n    \"en\": \"%1 die temperature (°C)\"\n  },\n  \"CUSTOM_QMI8658A_DATA_READY\": {\n    \"en\": \"%1 new data ready?\"\n  },\n  \"CUSTOM_QMI8658A_TIMESTAMP\": {\n    \"en\": \"%1 sample counter\"\n  },\n  \"CUSTOM_QMI8658A_CONFIGURE_ACCEL\": {\n    \"en\": \"%1 set accel range (0=±2 1=±4 2=±8 3=±16 g) %2 ODR code (5=224 Hz) %3\"\n  },\n  \"CUSTOM_QMI8658A_CONFIGURE_GYRO\": {\n    \"en\": \"%1 set gyro range (0=±16 … 7=±2048 dps) %2 ODR code (5=224 Hz) %3\"\n  },\n  \"CUSTOM_QMI8658A_SET_SENSORS\": {\n    \"en\": \"%1 enable accel (0/1) %2 gyro (0/1) %3\"\n  },\n  \"CUSTOM_QMI8658A_SET_POWER_DOWN\": {\n    \"en\": \"%1 power down (1) or wake (0) %2\"\n  },\n  \"CUSTOM_QMI8658A_FIFO_COUNT\": {\n    \"en\": \"%1 FIFO bytes available\"\n  },\n  \"CUSTOM_QMI8658A_RESET_FIFO\": {\n    \"en\": \"%1 reset FIFO\"\n  },\n  \"CUSTOM_QMI8658A_ENABLE_PEDOMETER\": {\n    \"en\": \"%1 pedometer on (1) or off (0) %2\"\n  },\n  \"CUSTOM_QMI8658A_STEP_COUNT\": {\n    \"en\": \"%1 step count\"\n  },\n  \"CUSTOM_QMI8658A_RESET_STEP_COUNT\": {\n    \"en\": \"%1 reset step count\"\n  },\n  \"CUSTOM_QMI8658A_ENABLE_TAP\": {\n    \"en\": \"%1 tap detection on (1) or off (0) %2\"\n  },\n  \"CUSTOM_QMI8658A_TAP_COUNT\": {\n    \"en\": \"%1 last tap count (0 none, 1 single, 2 double)\"\n  },\n  \"CUSTOM_QMI8658A_TAP_AXIS\": {\n    \"en\": \"%1 last tap axis (0 none, 1 X, 2 Y, 3 Z)\"\n  },\n  \"CUSTOM_QMI8658A_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status flags\"\n  },\n  \"CUSTOM_QMI8658A_SET_WAKE_ON_MOTION\": {\n    \"en\": \"%1 wake-on-motion threshold mg (0 = off) %2\"\n  },\n  \"CUSTOM_QMI8658A_RESET\": {\n    \"en\": \"%1 soft reset\"\n  }\n};\n\nconst initType = 'custom_qmi8658a_init';\nBlockly.BlockRegExpList['custom_qmi8658a'] = {\n  regexp: new RegExp(/^custom_qmi8658a_/),\n  code: \"from QMI8658A import QMI8658A\",\n  initBlockType: initType,\n  categoryId: 'custom_qmi8658a',\n}\nBlockly.utils.registerLanguages(CUSTOM_QMI8658A_LANGUAGES)\n\nBlockly.Msg.CUSTOM_QMI8658A_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_QMI8658A = 'QMI8658A'\n\nBlockly.utils.getcustom_qmi8658aOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['qmi8658a_0', 'qmi8658a_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_qmi8658a_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_QMI8658A_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_qmi8658aOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'qmi8658a_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_qmi8658a_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = QMI8658A(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_qmi8658a_accel_x\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_QMI8658A_ACCEL_X,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_qmi8658aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_qmi8658a_accel_x\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_x()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_qmi8658a_accel_y\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_QMI8658A_ACCEL_Y,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_qmi8658aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_qmi8658a_accel_y\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.accel_y()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_qmi8658a_accel_z\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_QMI8658A_ACCEL_Z,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_qmi8658aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n    