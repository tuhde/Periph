  "uiflow2": {
    "jscode": "const CUSTOM_WS2814_LANGUAGES = {\n  \"CUSTOM_WS2814_INIT\": {\n    \"en\": \"%1 init mosi %2 sck %3 miso %4 n %5\"\n  },\n  \"CUSTOM_WS2814_FILL\": {\n    \"en\": \"%1 fill all pixels r %2 g %3 b %4 w %5\"\n  },\n  \"CUSTOM_WS2814_SET_PIXEL\": {\n    \"en\": \"%1 set pixel index %2 r %3 g %4 b %5 w %6\"\n  },\n  \"CUSTOM_WS2814_SHOW\": {\n    \"en\": \"%1 show (transmit buffer)\"\n  },\n  \"CUSTOM_WS2814_OFF\": {\n    \"en\": \"%1 off (all pixels)\"\n  }\n};\n\nconst initType = 'custom_ws2814_init';\nBlockly.BlockRegExpList['custom_ws2814'] = {\n  regexp: new RegExp(/^custom_ws2814_/),\n  code: \"from WS2814 import WS2814\",\n  initBlockType: initType,\n  categoryId: 'custom_ws2814',\n}\nBlockly.utils.registerLanguages(CUSTOM_WS2814_LANGUAGES)\n\nBlockly.Msg.CUSTOM_WS2814_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_WS2814 = 'WS2814'\n\nBlockly.utils.getcustom_ws2814Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ws2814_0', 'ws2814_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ws2814_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_WS2814_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ws2814Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ws2814_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mosi'\n        },\n        {\n          'type': 'input_value',\n          'name': 'sck'\n        },\n        {\n          'type': 'input_value',\n          'name': 'miso'\n        },\n        {\n          'type': 'input_value',\n          'name': 'n'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ws2814_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mosi = Blockly.Python.valueToCode(block, 'mosi', Blockly.Python.ORDER_FUNCTION_CALL);\n  var sck = Blockly.Python.valueToCode(block, 'sck', Blockly.Python.ORDER_FUNCTION_CALL);\n  var miso = Blockly.Python.valueToCode(block, 'miso', Blockly.Python.ORDER_FUNCTION_CALL);\n  var n = Blockly.Python.valueToCode(block, 'n', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = WS2814(${mosi}, ${sck}, ${miso}, ${n})\\n`\n}\n\nBlockly.Blocks[\"custom_ws2814_fill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_WS2814_FILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ws2814Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'r'\n        },\n        {\n          'type': 'input_value',\n          'name': 'g'\n        },\n        {\n          'type': 'input_value',\n          'name': 'b'\n        },\n        {\n          'type': 'input_value',\n          'name': 'w'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ws2814_fill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var r = Blockly.Python.valueToCode(block, 'r', Blockly.Python.ORDER_FUNCTION_CALL);\n  var g = Blockly.Python.valueToCode(block, 'g', Blockly.Python.ORDER_FUNCTION_CALL);\n  var b = Blockly.Python.valueToCode(block, 'b', Blockly.Python.ORDER_FUNCTION_CALL);\n  var w = Blockly.Python.valueToCode(block, 'w', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill(${r}, ${g}, ${b}, ${w})\\n`\n}\n\nBlockly.Blocks[\"custom_ws2814_set_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_WS2814_SET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ws2814Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'index'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r'\n        },\n        {\n          'type': 'input_value',\n          'name': 'g'\n        },\n        {\n          'type': 'input_value',\n          'name': 'b'\n        },\n        {\n          'type': 'input_value',\n          'name': 'w'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ws2814_set_pixel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var index = Blockly.Python.valueToCode(block, 'index', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r = Blockly.Python.valueToCode(block, 'r', Blockly.Python.ORDER_FUNCTION_CALL);\n  var g = Blockly.Python.valueToCode(block, 'g', Blockly.Python.ORDER_FUNCTION_CALL);\n  var b = Blockly.Python.valueToCode(block, 'b', Blockly.Python.ORDER_FUNCTION_CALL);\n  var w = Blockly.Python.valueToCode(block, 'w', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pixel(${index}, ${r}, ${g}, ${b}, ${w})\\n`\n}\n\nBlockly.Blocks[\"custom_ws2814_show\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_WS2814_SHOW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ws2814Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ws2814_show\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.show()\\n`\n}\n\nBlockly.Blocks[\"custom_ws2814_off\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_WS2814_OFF,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ws2814Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ws2814_off\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.off()\\n`\n}\n",
    "toolbox": "\n<category name=\"WS2814\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ws2814\"><title text=\"WS2814\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ws2814_init\">\n  <value name=\"mosi\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"sck\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"miso\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"n\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ws2814_fill\">\n  <value name=\"r\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"b\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"w\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ws2814_set_pixel\">\n  <value name=\"index\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"r\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"b\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"w\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ws2814_show\"/><block type=\"custom_ws2814_off\"/>\n</category>\n