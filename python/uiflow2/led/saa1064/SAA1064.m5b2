  "pyCode": "\"\"\"\nfile     SAA1064\ntime     2026-11-24\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.i2c_auto import I2CConnection\nfrom periph.chips.led.saa1064 import SAA1064Full\n\n\nclass SAA1064:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 0, address: int = 56):\n        \"\"\"\n        label:\n            en: '%1 init bus %2 address %3'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '0'\n                field: number\n            address:\n                name: address\n                type: int\n                default: '56'\n                field: number\n        \"\"\"\n        connection = I2CConnection(address, bus=bus)\n        self._driver = SAA1064Full(connection)\n\n    def clear(self):\n        \"\"\"\n        label:\n            en: '%1 clear'\n        \"\"\"\n        self._driver.clear()\n\n    def show_number(self, value: int):\n        \"\"\"\n        label:\n            en: '%1 show number %2'\n        params:\n            value:\n                name: value\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.show_number(value)\n\n    def show_digit(self, position: int, value: int, dp: int):\n        \"\"\"\n        label:\n            en: '%1 show digit %2 %3 %4'\n        params:\n            position:\n                name: position\n                type: int\n                default: '1'\n                field: number\n            value:\n                name: value\n                type: int\n                default: '0'\n                field: number\n            dp:\n                name: dp\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.show_digit(position, None if value < 0 else value, bool(dp))\n\n    def set_decimal_point(self, position: int, on: int):\n        \"\"\"\n        label:\n            en: '%1 set decimal point %2 %3'\n        params:\n            position:\n                name: position\n                type: int\n                default: '1'\n                field: number\n            'on':\n                name: 'on'\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.set_decimal_point(position, bool(on))\n\n    def set_mode(self, dynamic: int):\n        \"\"\"\n        label:\n            en: '%1 set dynamic mode %2'\n        params:\n            dynamic:\n                name: dynamic\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.set_mode(bool(dynamic))\n\n    def blank(self, digits_13: int, digits_24: int):\n        \"\"\"\n        label:\n            en: '%1 blank %2 %3'\n        params:\n            digits_13:\n                name: digits_13\n                type: int\n                default: '0'\n                field: number\n            digits_24:\n                name: digits_24\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.blank(bool(digits_13), bool(digits_24))\n\n    def set_current(self, ma: int):\n        \"\"\"\n        label:\n            en: '%1 set current %2'\n        params:\n            ma:\n                name: ma\n                type: int\n                default: '12'\n                field: number\n        \"\"\"\n        self._driver.set_current(ma)\n\n    def segment_test(self, on: int):\n        \"\"\"\n        label:\n            en: '%1 segment test %2'\n        params:\n            'on':\n                name: 'on'\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.segment_test(bool(on))\n\n    def write_control(self, value: int):\n        \"\"\"\n        label:\n            en: '%1 write control %2'\n        params:\n            value:\n                name: value\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.write_control(value)\n\n    def read_status(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 read status'\n        \"\"\"\n        return self._driver.read_status()\n\n    def power_reset_flag(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 power reset flag'\n        \"\"\"\n        return int(self._driver.power_reset_flag())\n",
