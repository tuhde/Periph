    "jscode": "const CUSTOM_SAA1064_LANGUAGES = {\n  \"CUSTOM_SAA1064_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_SAA1064_CLEAR\": {\n    \"en\": \"%1 clear\"\n  },\n  \"CUSTOM_SAA1064_SHOW_NUMBER\": {\n    \"en\": \"%1 show number %2\"\n  },\n  \"CUSTOM_SAA1064_SHOW_DIGIT\": {\n    \"en\": \"%1 show digit %2 %3 %4\"\n  },\n  \"CUSTOM_SAA1064_SET_DECIMAL_POINT\": {\n    \"en\": \"%1 set decimal point %2 %3\"\n  },\n  \"CUSTOM_SAA1064_SET_MODE\": {\n    \"en\": \"%1 set dynamic mode %2\"\n  },\n  \"CUSTOM_SAA1064_BLANK\": {\n    \"en\": \"%1 blank %2 %3\"\n  },\n  \"CUSTOM_SAA1064_SET_CURRENT\": {\n    \"en\": \"%1 set current %2\"\n  },\n  \"CUSTOM_SAA1064_SEGMENT_TEST\": {\n    \"en\": \"%1 segment test %2\"\n  },\n  \"CUSTOM_SAA1064_WRITE_CONTROL\": {\n    \"en\": \"%1 write control %2\"\n  },\n  \"CUSTOM_SAA1064_READ_STATUS\": {\n    \"en\": \"%1 read status\"\n  },\n  \"CUSTOM_SAA1064_POWER_RESET_FLAG\": {\n    \"en\": \"%1 power reset flag\"\n  }\n};\n\nconst initType = 'custom_saa1064_init';\nBlockly.BlockRegExpList['custom_saa1064'] = {\n  regexp: new RegExp(/^custom_saa1064_/),\n  code: \"from SAA1064 import SAA1064\",\n  initBlockType: initType,\n  categoryId: 'custom_saa1064',\n}\nBlockly.utils.registerLanguages(CUSTOM_SAA1064_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SAA1064_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SAA1064 = 'SAA1064'\n\nBlockly.utils.getcustom_saa1064Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['saa1064_0', 'saa1064_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_saa1064_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SAA1064_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_saa1064Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'saa1064_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_saa1064_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = SAA1064(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_saa1064_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SAA1064_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_saa1064Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_saa1064_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear()\\n`\n}\n\nBlockly.Blocks[\"custom_saa1064_show_number\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SAA1064_SHOW_NUMBER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_saa1064Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_saa1064_show_number\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.show_number(${value})\\n`\n}\n\nBlockly.Blocks[\"custom_saa1064_show_digit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SAA1064_SHOW_DIGIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_saa1064Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'position'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n        {\n          'type': 'input_value',\n          'name': 'dp'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_saa1064_show_digit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var position = Blockly.Python.valueToCode(block, 'position', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  var dp = Blockly.Python.valueToCode(block, 'dp', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.show_digit(${position}, ${value}, ${dp})\\n`\n}\n\nBlockly.Blocks[\"custom_saa1064_set_decimal_point\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SAA1064_SET_DECIMAL_POINT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME