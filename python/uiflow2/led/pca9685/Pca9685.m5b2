{
  "category": "Pca9685",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_PCA9685_LANGUAGES = {\n  \"CUSTOM_PCA9685_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_PCA9685_SET_DUTY\": {\n    \"en\": \"%1 set duty channel %2 duty %3\"\n  },\n  \"CUSTOM_PCA9685_SET_PWM\": {\n    \"en\": \"%1 set pwm channel %2 on %3 off %4\"\n  },\n  \"CUSTOM_PCA9685_GET_PWM_ON\": {\n    \"en\": \"%1 get pwm on count channel %2\"\n  },\n  \"CUSTOM_PCA9685_GET_PWM_OFF\": {\n    \"en\": \"%1 get pwm off count channel %2\"\n  },\n  \"CUSTOM_PCA9685_SET_FULL_ON\": {\n    \"en\": \"%1 set full on channel %2\"\n  },\n  \"CUSTOM_PCA9685_SET_FULL_OFF\": {\n    \"en\": \"%1 set full off channel %2\"\n  },\n  \"CUSTOM_PCA9685_SET_ALL_DUTY\": {\n    \"en\": \"%1 set all duty %2\"\n  },\n  \"CUSTOM_PCA9685_SET_ALL_PWM\": {\n    \"en\": \"%1 set all pwm on %2 off %3\"\n  },\n  \"CUSTOM_PCA9685_SET_FREQUENCY\": {\n    \"en\": \"%1 set frequency Hz %2\"\n  },\n  \"CUSTOM_PCA9685_GET_FREQUENCY\": {\n    \"en\": \"%1 get frequency\"\n  },\n  \"CUSTOM_PCA9685_SET_PULSE_WIDTH\": {\n    \"en\": \"%1 set pulse width channel %2 seconds %3\"\n  },\n  \"CUSTOM_PCA9685_SLEEP\": {\n    \"en\": \"%1 sleep\"\n  },\n  \"CUSTOM_PCA9685_WAKE\": {\n    \"en\": \"%1 wake\"\n  },\n  \"CUSTOM_PCA9685_RESTART\": {\n    \"en\": \"%1 restart\"\n  },\n  \"CUSTOM_PCA9685_SET_OUTPUT_MODE\": {\n    \"en\": \"%1 set output mode open drain %2 invert %3 off state %4\"\n  },\n  \"CUSTOM_PCA9685_SET_UPDATE_ON_ACK\": {\n    \"en\": \"%1 set update on ACK enabled %2\"\n  },\n  \"CUSTOM_PCA9685_SET_ALLCALL\": {\n    \"en\": \"%1 set all-call enabled %2 address %3\"\n  },\n  \"CUSTOM_PCA9685_SET_SUBADDRESS\": {\n    \"en\": \"%1 set sub address index %2 address %3 enabled %4\"\n  },\n  \"CUSTOM_PCA9685_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_pca9685_init';\nBlockly.BlockRegExpList['custom_pca9685'] = {\n  regexp: new RegExp(/^custom_pca9685_/),\n  code: \"from Pca9685 import Pca9685\",\n  initBlockType: initType,\n  categoryId: 'custom_pca9685',\n}\nBlockly.utils.registerLanguages(CUSTOM_PCA9685_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PCA9685_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_PCA9685 = 'Pca9685'\n\nBlockly.utils.getcustom_pca9685Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pca9685_0', 'pca9685_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_pca9685_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9685_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pca9685Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pca9685_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9685_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Pca9685(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_pca9685_set_duty\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9685_SET_DUTY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9685Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'duty'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9685_set_duty\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var duty = Blockly.Python.valueToCode(block, 'duty', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_duty(${channel}, ${duty})\\n`\n}\n\nBlockly.Blocks[\"custom_pca9685_set_pwm\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9685_SET_PWM,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9685Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'on'\n        },\n        {\n          'type': 'input_value',\n          'name': 'off'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9685_set_pwm\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var on = Blockly.Python.valueToCode(block, 'on', Blockly.Python.ORDER_FUNCTION_CALL);\n  var off = Blockly.Python.valueToCode(block, 'off', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pwm(${channel}, ${on}, ${off})\\n`\n}\n\nBlockly.Blocks[\"custom_pca9685_get