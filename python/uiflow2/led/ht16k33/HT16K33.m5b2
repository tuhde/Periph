  "pyCode": "\"\"\"\nfile     HT16K33\ntime     2026-11-17\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.i2c_auto import I2CConnection\nfrom periph.chips.led.ht16k33 import HT16K33Full\n\n\nclass HT16K33:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 0, address: int = 112):\n        \"\"\"\n        label:\n            en: '%1 init bus %2 address %3'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '0'\n                field: number\n            address:\n                name: address\n                type: int\n                default: '112'\n                field: number\n        \"\"\"\n        connection = I2CConnection(address, bus=bus)\n        self._driver = HT16K33Full(connection)\n\n    def clear(self):\n        \"\"\"\n        label:\n            en: '%1 clear'\n        \"\"\"\n        self._driver.clear()\n\n    def set_pixel(self, com: int, row: int, state: int):\n        \"\"\"\n        label:\n            en: '%1 set pixel com %2 row %3 state %4'\n        params:\n            com:\n                name: com\n                type: int\n                field: number\n            row:\n                name: row\n                type: int\n                field: number\n            state:\n                name: state\n                type: int\n                field: number\n        \"\"\"\n        self._driver.set_pixel(com, row, bool(state))\n\n    def show(self):\n        \"\"\"\n        label:\n            en: '%1 show'\n        \"\"\"\n        self._driver.show()\n\n    def set_brightness(self, level: int):\n        \"\"\"\n        label:\n            en: '%1 set brightness %2'\n        params:\n            level:\n                name: level\n                type: int\n                field: number\n        \"\"\"\n        self._driver.set_brightness(level)\n\n    def display_on(self):\n        \"\"\"\n        label:\n            en: '%1 display on'\n        \"\"\"\n        self._driver.display_on()\n\n    def display_off(self):\n        \"\"\"\n        label:\n            en: '%1 display off'\n        \"\"\"\n        self._driver.display_off()\n\n    def set_blink(self, frequency: float):\n        \"\"\"\n        label:\n            en: '%1 set blink frequency (Hz) %2'\n        params:\n            frequency:\n                name: frequency\n                type: float\n                field: number\n        \"\"\"\n        self._driver.set_blink(frequency)\n\n    def standby(self):\n        \"\"\"\n        label:\n            en: '%1 standby'\n        \"\"\"\n        self._driver.standby()\n\n    def wake(self):\n        \"\"\"\n        label:\n            en: '%1 wake'\n        \"\"\"\n        self._driver.wake()\n\n    def set_int_output(self, enable: int, active_high: int):\n        \"\"\"\n        label:\n            en: '%1 set INT output enable %2 active high %3'\n        params:\n            enable:\n                name: enable\n                type: int\n                field: number\n            active_high:\n                name: active_high\n                type: int\n                field: number\n        \"\"\"\n        self._driver.set_int_output(bool(enable), bool(active_high))\n\n    def read_keys(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 read keys'\n        \"\"\"\n\n        return self._driver.read_keys()\n\n    def key_pressed(self) -> bool:\n        \"\"\"\n        label:\n            en: '%1 key pressed'\n        \"\"\"\n\n        return self._driver.key_pressed()\n\n    def get_pixel(self, com: int, row: int) -> bool:\n        \"\"\"\n        label:\n            en: '%1 get pixel com %2 row %3'\n        params:\n            com:\n                name: com\n                type: int\n                field: number\n            row:\n                name: row\n                type: int\n                field: number\n        \"\"\"\n\n        return self._driver.get_pixel(com, row)\n",
  "version": "alpha2"
