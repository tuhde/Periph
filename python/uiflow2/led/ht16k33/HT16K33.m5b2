    "jscode": "const CUSTOM_HT16K33_LANGUAGES = {\n  \"CUSTOM_HT16K33_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_HT16K33_CLEAR\": {\n    \"en\": \"%1 clear\"\n  },\n  \"CUSTOM_HT16K33_SET_PIXEL\": {\n    \"en\": \"%1 set pixel com %2 row %3 state %4\"\n  },\n  \"CUSTOM_HT16K33_SHOW\": {\n    \"en\": \"%1 show\"\n  },\n  \"CUSTOM_HT16K33_SET_BRIGHTNESS\": {\n    \"en\": \"%1 set brightness %2\"\n  },\n  \"CUSTOM_HT16K33_DISPLAY_ON\": {\n    \"en\": \"%1 display on\"\n  },\n  \"CUSTOM_HT16K33_DISPLAY_OFF\": {\n    \"en\": \"%1 display off\"\n  },\n  \"CUSTOM_HT16K33_SET_BLINK\": {\n    \"en\": \"%1 set blink frequency (Hz) %2\"\n  },\n  \"CUSTOM_HT16K33_STANDBY\": {\n    \"en\": \"%1 standby\"\n  },\n  \"CUSTOM_HT16K33_WAKE\": {\n    \"en\": \"%1 wake\"\n  },\n  \"CUSTOM_HT16K33_SET_INT_OUTPUT\": {\n    \"en\": \"%1 set INT output enable %2 active high %3\"\n  },\n  \"CUSTOM_HT16K33_READ_KEYS\": {\n    \"en\": \"%1 read keys\"\n  },\n  \"CUSTOM_HT16K33_KEY_PRESSED\": {\n    \"en\": \"%1 key pressed\"\n  },\n  \"CUSTOM_HT16K33_GET_PIXEL\": {\n    \"en\": \"%1 get pixel com %2 row %3\"\n  }\n};\n\nconst initType = 'custom_ht16k33_init';\nBlockly.BlockRegExpList['custom_ht16k33'] = {\n  regexp: new RegExp(/^custom_ht16k33_/),\n  code: \"from HT16K33 import HT16K33\",\n  initBlockType: initType,\n  categoryId: 'custom_ht16k33',\n}\nBlockly.utils.registerLanguages(CUSTOM_HT16K33_LANGUAGES)\n\nBlockly.Msg.CUSTOM_HT16K33_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_HT16K33 = 'HT16K33'\n\nBlockly.utils.getcustom_ht16k33Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ht16k33_0', 'ht16k33_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ht16k33_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ht16k33Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ht16k33_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = HT16K33(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.clear()\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_set_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_SET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'com'\n        },\n        {\n          'type': 'input_value',\n          'name': 'row'\n        },\n        {\n          'type': 'input_value',\n          'name': 'state'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_set_pixel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var com = Blockly.Python.valueToCode(block, 'com', Blockly.Python.ORDER_FUNCTION_CALL);\n  var row = Blockly.Python.valueToCode(block, 'row', Blockly.Python.ORDER_FUNCTION_CALL);\n  var state = Blockly.Python.valueToCode(block, 'state', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pixel(${com}, ${row}, ${state})\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_show\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_SHOW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_show\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.show()\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_set_brightness\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_SET_BRIGHTNESS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'level'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_set_brightness\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var level = Blockly.Python.valueToCode(block, 'level', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_brightness(${level})\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_display_on\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_DISPLAY_ON,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_display_on\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.display_on()\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_display_off\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_DISPLAY_OFF,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_display_off\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.display_off()\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_set_blink\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_SET_BLINK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'frequency'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_set_blink\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var frequency = Blockly.Python.valueToCode(block, 'frequency', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_blink(${frequency})\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_standby\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_STANDBY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_standby\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.standby()\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_wake\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_WAKE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_wake\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.wake()\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_set_int_output\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_SET_INT_OUTPUT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enable'\n        },\n        {\n          'type': 'input_value',\n          'name': 'active_high'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_set_int_output\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enable = Blockly.Python.valueToCode(block, 'enable', Blockly.Python.ORDER_FUNCTION_CALL);\n  var active_high = Blockly.Python.valueToCode(block, 'active_high', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_int_output(${enable}, ${active_high})\\n`\n}\n\nBlockly.Blocks[\"custom_ht16k33_read_keys\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_READ_KEYS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_read_keys\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_keys()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ht16k33_key_pressed\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_KEY_PRESSED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_key_pressed\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.key_pressed()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ht16k33_get_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HT16K33_GET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ht16k33Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'com'\n        },\n        {\n          'type': 'input_value',\n          'name': 'row'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ht16k33_get_pixel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var com = Blockly.Python.valueToCode(block, 'com', Blockly.Python.ORDER_FUNCTION_CALL);\n  var row = Blockly.Python.valueToCode(block, 'row', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_pixel(${com}, ${row})`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"HT16K33\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ht16k33\"><title text=\"HT16K33\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ht16k33_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">112</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ht16k33_clear\"/><block type=\"custom_ht16k33_set_pixel\">\n  <value name=\"com\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"row\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"state\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ht16k33_show\"/><block type=\"custom_ht16k33_set_brightness\">\n  <value name=\"level\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ht16k33_display_on\"/><block type=\"custom_ht16k33_display_off\"/><block type=\"custom_ht16k33_set_blink\">\n  <value name=\"frequency\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ht16k33_standby\"/><block type=\"custom_ht16k33_wake\"/><block type=\"custom_ht16k33_set_int_output\">\n  <value name=\"enable\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"active_high\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ht16k33_read_keys\"/><block type=\"custom_ht16k33_key_pressed\"/><block type=\"custom_ht16k33_get_pixel\">\n  <value name=\"com\">\n    <shadow type=\"mat