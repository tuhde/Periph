  "pyCode": "\"\"\"\nfile     Shtc3\ntime     2026-11-24\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.i2c_auto import I2CConnection\nfrom periph.chips.humidity.shtc3 import SHTC3Full\n\n\nclass Shtc3:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 0, address: int = 112):\n        \"\"\"\n        label:\n            en: '%1 init bus %2 address %3'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '0'\n                field: number\n            address:\n                name: address\n                type: int\n                default: '112'\n                field: number\n        \"\"\"\n        connection = I2CConnection(address, bus=bus)\n        self._driver = SHTC3Full(connection)\n        self._driver.init()\n\n    def temperature(self) -> float:\n        \"\"\"\n        label:\n            en: '%1 temperature (°C)'\n        \"\"\"\n        return self._driver.read_temperature()\n\n    def humidity(self) -> float:\n        \"\"\"\n        label:\n            en: '%1 relative humidity (%RH)'\n        \"\"\"\n        return self._driver.read_humidity()\n\n    def dew_point(self) -> float:\n        \"\"\"\n        label:\n            en: '%1 dew point (°C)'\n        \"\"\"\n        return self._driver.dew_point()\n\n    def read_id(self) -> int:\n        \"\"\"\n        label:\n            en: '%1 ID word'\n        \"\"\"\n        return self._driver.read_id()\n\n    def set_low_power(self, enabled: int = 0):\n        \"\"\"\n        label:\n            en: '%1 low-power mode (1=on 0=off) %2'\n        params:\n            enabled:\n                name: enabled\n                type: int\n                default: '0'\n                field: number\n                max: '1'\n                min: '0'\n        \"\"\"\n        self._driver.set_low_power(bool(enabled))\n\n    def set_sleep_between(self, enabled: int = 1):\n        \"\"\"\n        label:\n            en: '%1 sleep between reads (1=on 0=off) %2'\n        params:\n            enabled:\n                name: enabled\n                type: int\n                default: '1'\n                field: number\n                max: '1'\n                min: '0'\n        \"\"\"\n        self._driver.set_sleep_between(bool(enabled))\n\n    def wake(self):\n        \"\"\"\n        label:\n            en: '%1 wake up'\n        \"\"\"\n        self._driver.wake()\n\n    def sleep(self):\n        \"\"\"\n        label:\n            en: '%1 sleep'\n        \"\"\"\n        self._driver.sleep()\n\n    def software_reset(self):\n        \"\"\"\n        label:\n            en: '%1 software reset'\n        \"\"\"\n        self._driver.soft_reset()\n",
  "version": "alpha2"
}
