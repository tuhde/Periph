  "uiflow2": {
    "jscode": "const CUSTOM_HTU31D_LANGUAGES = {\n  \"CUSTOM_HTU31D_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_HTU31D_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_HTU31D_HUMIDITY\": {\n    \"en\": \"%1 relative humidity (%RH)\"\n  },\n  \"CUSTOM_HTU31D_DEW_POINT\": {\n    \"en\": \"%1 dew point (°C)\"\n  },\n  \"CUSTOM_HTU31D_SERIAL_NUMBER\": {\n    \"en\": \"%1 serial number\"\n  },\n  \"CUSTOM_HTU31D_DIAGNOSTIC\": {\n    \"en\": \"%1 diagnostic byte\"\n  },\n  \"CUSTOM_HTU31D_SET_RESOLUTION\": {\n    \"en\": \"%1 oversampling RH OSR (0-3) %2 T OSR (0-3) %3\"\n  },\n  \"CUSTOM_HTU31D_SET_HEATER\": {\n    \"en\": \"%1 heater (1=on 0=off) %2\"\n  },\n  \"CUSTOM_HTU31D_HEATER_ON\": {\n    \"en\": \"%1 heater on (1=yes 0=no)\"\n  },\n  \"CUSTOM_HTU31D_SOFTWARE_RESET\": {\n    \"en\": \"%1 software reset\"\n  }\n};\n\nconst initType = 'custom_htu31d_init';\nBlockly.BlockRegExpList['custom_htu31d'] = {\n  regexp: new RegExp(/^custom_htu31d_/),\n  code: \"from Htu31d import Htu31d\",\n  initBlockType: initType,\n  categoryId: 'custom_htu31d',\n}\nBlockly.utils.registerLanguages(CUSTOM_HTU31D_LANGUAGES)\n\nBlockly.Msg.CUSTOM_HTU31D_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_HTU31D = 'Htu31d'\n\nBlockly.utils.getcustom_htu31dOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['htu31d_0', 'htu31d_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_htu31d_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_htu31dOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'htu31d_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Htu31d(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_htu31d_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_htu31d_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.humidity()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_htu31d_dew_point\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_DEW_POINT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_dew_point\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.dew_point()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_htu31d_serial_number\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_SERIAL_NUMBER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_serial_number\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.serial_number()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_htu31d_diagnostic\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_DIAGNOSTIC,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_diagnostic\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.diagnostic()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_htu31d_set_resolution\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_SET_RESOLUTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'osr_rh'\n        },\n        {\n          'type': 'input_value',\n          'name': 'osr_t'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_set_resolution\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var osr_rh = Blockly.Python.valueToCode(block, 'osr_rh', Blockly.Python.ORDER_FUNCTION_CALL);\n  var osr_t = Blockly.Python.valueToCode(block, 'osr_t', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resolution(${osr_rh}, ${osr_t})\\n`\n}\n\nBlockly.Blocks[\"custom_htu31d_set_heater\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_SET_HEATER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_set_heater\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_heater(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_htu31d_heater_on\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_HEATER_ON,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_heater_on\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.heater_on()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_htu31d_software_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HTU31D_SOFTWARE_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_htu31dOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_htu31d_software_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.software_reset()\\n`\n}\n",
    "toolbox": "\n<category name=\"Htu31d\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_htu31d\">\n<title text=\"Htu31d\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_htu31d_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">64</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_htu31d_temperature\"/><block type=\"custom_htu31d_humidity\"/><block type=\"custom_htu31d_dew_point\"/><block type=\"custom_htu31d_serial_number\"/><block type=\"custom_htu31d_diagnostic\"/><block type=\"custom_htu31d_set_resolution\">\n  <value name=\"osr_rh\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n  <value name=\"osr_t\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_htu31d_set_heater\">\n  <value name=\"enabled\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_htu31d_heater_on\"/><block type=\"custom_htu31d_software_reset\"/>\n</category>\n",
