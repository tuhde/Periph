{
  "category": "DHT11",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_DHT11_LANGUAGES = {\n  \"CUSTOM_DHT11_INIT\": {\n    \"en\": \"%1 init pin %2\"\n  },\n  \"CUSTOM_DHT11_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_DHT11_READ_HUMIDITY\": {\n    \"en\": \"%1 humidity (%)\"\n  }\n};\n\nconst initType = 'custom_dht11_init';\nBlockly.BlockRegExpList['custom_dht11'] = {\n  regexp: new RegExp(/^custom_dht11_/),\n  code: \"from DHT11 import DHT11\",\n  initBlockType: initType,\n  categoryId: 'custom_dht11',\n}\nBlockly.utils.registerLanguages(CUSTOM_DHT11_LANGUAGES)\n\nBlockly.Msg.CUSTOM_DHT11_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_DHT11 = 'DHT11'\n\nBlockly.utils.getcustom_dht11Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['dht11_0', 'dht11_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_dht11_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DHT11_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_dht11Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'dht11_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'pin'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_dht11_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pin = Blockly.Python.valueToCode(block, 'pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = DHT11(${pin})\\n`\n}\n\nBlockly.Blocks[\"custom_dht11_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DHT11_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_dht11Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_dht11_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_dht11_read_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DHT11_READ_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_dht11Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_dht11_read_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_humidity()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"DHT11\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_dht11\"><title text=\"DHT11\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_dht11_init\">\n  <value name=\"pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_dht11_read_temperature\"/><block type=\"custom_dht11_read_humidity\"/>\n</category>\n",
