  "uiflow2": {
    "jscode": "const CUSTOM_HS40XX_LANGUAGES = {\n  \"CUSTOM_HS40XX_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_HS40XX_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C)\"\n  },\n  \"CUSTOM_HS40XX_HUMIDITY\": {\n    \"en\": \"%1 relative humidity (%RH)\"\n  },\n  \"CUSTOM_HS40XX_DEW_POINT\": {\n    \"en\": \"%1 dew point (°C)\"\n  },\n  \"CUSTOM_HS40XX_RAW_HUMIDITY\": {\n    \"en\": \"%1 raw humidity (14 bit)\"\n  },\n  \"CUSTOM_HS40XX_RAW_TEMPERATURE\": {\n    \"en\": \"%1 raw temperature (14 bit)\"\n  },\n  \"CUSTOM_HS40XX_SENSOR_ID\": {\n    \"en\": \"%1 sensor ID\"\n  },\n  \"CUSTOM_HS40XX_SET_RESOLUTION\": {\n    \"en\": \"%1 resolution humidity %2 bits temperature %3 bits\"\n  },\n  \"CUSTOM_HS40XX_START_PERIODIC\": {\n    \"en\": \"%1 start periodic mode, period %2 (0=0.5 s, 1=1 s, 2=2.5 s)\"\n  },\n  \"CUSTOM_HS40XX_STOP_PERIODIC\": {\n    \"en\": \"%1 stop periodic mode\"\n  },\n  \"CUSTOM_HS40XX_PERIODIC_HUMIDITY\": {\n    \"en\": \"%1 periodic relative humidity (%RH)\"\n  },\n  \"CUSTOM_HS40XX_PERIODIC_TEMPERATURE\": {\n    \"en\": \"%1 periodic temperature (°C)\"\n  },\n  \"CUSTOM_HS40XX_SOFT_RESET\": {\n    \"en\": \"%1 soft reset\"\n  }\n};\n\nconst initType = 'custom_hs40xx_init';\nBlockly.BlockRegExpList['custom_hs40xx'] = {\n  regexp: new RegExp(/^custom_hs40xx_/),\n  code: \"from HS40xx import HS40xx\",\n  initBlockType: initType,\n  categoryId: 'custom_hs40xx',\n}\nBlockly.utils.registerLanguages(CUSTOM_HS40XX_LANGUAGES)\n\nBlockly.Msg.CUSTOM_HS40XX_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_HS40XX = 'HS40xx'\n\nBlockly.utils.getcustom_hs40xxOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['hs40xx_0', 'hs40xx_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_hs40xx_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_hs40xxOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'hs40xx_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = HS40xx(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_hs40xx_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.humidity()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_dew_point\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_DEW_POINT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_dew_point\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.dew_point()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_raw_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_RAW_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_raw_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.raw_humidity()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_raw_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_RAW_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_raw_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.raw_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_sensor_id\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_SENSOR_ID,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_sensor_id\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.sensor_id()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_set_resolution\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_SET_RESOLUTION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'humidity_bits'\n        },\n        {\n          'type': 'input_value',\n          'name': 'temperature_bits'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_set_resolution\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var humidity_bits = Blockly.Python.valueToCode(block, 'humidity_bits', Blockly.Python.ORDER_FUNCTION_CALL);\n  var temperature_bits = Blockly.Python.valueToCode(block, 'temperature_bits', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resolution(${humidity_bits}, ${temperature_bits})\\n`\n}\n\nBlockly.Blocks[\"custom_hs40xx_start_periodic\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_START_PERIODIC,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'period'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_start_periodic\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var period = Blockly.Python.valueToCode(block, 'period', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.start_periodic(${period})\\n`\n}\n\nBlockly.Blocks[\"custom_hs40xx_stop_periodic\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_STOP_PERIODIC,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_stop_periodic\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.stop_periodic()\\n`\n}\n\nBlockly.Blocks[\"custom_hs40xx_periodic_humidity\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_PERIODIC_HUMIDITY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_periodic_humidity\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.periodic_humidity()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_periodic_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_PERIODIC_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_periodic_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.periodic_temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hs40xx_soft_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HS40XX_SOFT_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hs40xxOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hs40xx_soft_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.soft_reset()\\n`\n}\n",
    "toolbox": "\n<category name=\"HS40xx\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_hs40xx\">\n<title text=\"HS40xx\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_hs40xx_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">84</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_hs40xx_temperature\"/><block type=\"custom_hs40xx_humidity\"/><block type=\"custom_hs40xx_dew_point\"/><block type=\"custom_hs40xx_raw_humidity\"/><block type=\"custom_hs40xx_raw_temperature\"/><block type=\"custom_hs40xx_sensor_id\"/><block type=\"custom_hs40xx_set_resolution\">\n  <value name=\"humidity_bits\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">14</field>\n    </shadow>\n  </value>\n  <value name=\"temperature_bits\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">14</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_hs40xx_start_periodic\">\n  <value name=\"period\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_hs40xx_stop_periodic\"/><block type=\"custom_hs40xx_periodic_humidity\"/><block type=\"custom_hs40xx_periodic_temperature\"/><block type=\"custom_hs40xx_soft_reset\"/>\n</category>\n",
