{
  "category": "Pn532",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_PN532_LANGUAGES = {\n  \"CUSTOM_PN532_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_PN532_READ_UID\": {\n    \"en\": \"%1 card UID (hex, empty if none)\"\n  },\n  \"CUSTOM_PN532_FIRMWARE_VERSION\": {\n    \"en\": \"%1 firmware version\"\n  },\n  \"CUSTOM_PN532_FIELD_PRESENT\": {\n    \"en\": \"%1 external RF field present?\"\n  },\n  \"CUSTOM_PN532_SELF_TEST\": {\n    \"en\": \"%1 self test passed?\"\n  },\n  \"CUSTOM_PN532_LIST_PASSIVE_TARGETS\": {\n    \"en\": \"%1 list cards (hex UIDs, comma separated) max targets (1-2) %2\"\n  },\n  \"CUSTOM_PN532_RELEASE\": {\n    \"en\": \"%1 release target (0 = all) %2\"\n  },\n  \"CUSTOM_PN532_SELECT\": {\n    \"en\": \"%1 select target %2\"\n  },\n  \"CUSTOM_PN532_DESELECT\": {\n    \"en\": \"%1 deselect target %2\"\n  },\n  \"CUSTOM_PN532_DATA_EXCHANGE\": {\n    \"en\": \"%1 exchange with target %2 data (hex) %3 -> hex\"\n  },\n  \"CUSTOM_PN532_MIFARE_AUTHENTICATE\": {\n    \"en\": \"%1 MIFARE authenticate target %2 block %3 key (hex) %4 UID (hex) %5\"\n  },\n  \"CUSTOM_PN532_MIFARE_READ_BLOCK\": {\n    \"en\": \"%1 MIFARE read target %2 block %3 (hex)\"\n  },\n  \"CUSTOM_PN532_MIFARE_WRITE_BLOCK\": {\n    \"en\": \"%1 MIFARE write target %2 block %3 data (32 hex digits) %4\"\n  },\n  \"CUSTOM_PN532_NTAG_READ_PAGE\": {\n    \"en\": \"%1 NTAG read target %2 page %3 (4 pages, hex)\"\n  },\n  \"CUSTOM_PN532_NTAG_WRITE_PAGE\": {\n    \"en\": \"%1 NTAG write target %2 page %3 data (8 hex digits) %4\"\n  },\n  \"CUSTOM_PN532_SET_RF_FIELD\": {\n    \"en\": \"%1 RF field on (1) / off (0) %2\"\n  },\n  \"CUSTOM_PN532_SET_MAX_RETRIES\": {\n    \"en\": \"%1 card activation retries (255 = forever) %2\"\n  },\n  \"CUSTOM_PN532_READ_REGISTER\": {\n    \"en\": \"%1 register %2\"\n  },\n  \"CUSTOM_PN532_WRITE_REGISTER\": {\n    \"en\": \"%1 set register %2 value %3\"\n  },\n  \"CUSTOM_PN532_POWER_DOWN\": {\n    \"en\": \"%1 power down\"\n  }\n};\n\nconst initType = 'custom_pn532_init';\nBlockly.BlockRegExpList['custom_pn532'] = {\n  regexp: new RegExp(/^custom_pn532_/),\n  code: \"from Pn532 import Pn532\",\n  initBlockType: initType,\n  categoryId: 'custom_pn532',\n}\nBlockly.utils.registerLanguages(CUSTOM_PN532_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PN532_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_PN532 = 'Pn532'\n\nBlockly.utils.getcustom_pn532Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pn532_0', 'pn532_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_pn532_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pn532Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pn532_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Pn532(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_pn532_read_uid\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_READ_UID,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_read_uid\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_uid()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pn532_firmware_version\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_FIRMWARE_VERSION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_firmware_version\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.firmware_version()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pn532_field_present\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_FIELD_PRESENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_field_present\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.field_present()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pn532_self_test\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_SELF_TEST,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_self_test\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.self_test()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pn532_list_passive_targets\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_LIST_PASSIVE_TARGETS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'max_targets'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_list_passive_targets\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var max_targets = Blockly.Python.valueToCode(block, 'max_targets', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.list_passive_targets(${max_targets})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pn532_release\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_RELEASE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'target'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_release\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var target = Blockly.Python.valueToCode(block, 'target', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.release(${target})\\n`\n}\n\nBlockly.Blocks[\"custom_pn532_select\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_SELECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'target'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_select\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var target = Blockly.Python.valueToCode(block, 'target', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.select(${target})\\n`\n}\n\nBlockly.Blocks[\"custom_pn532_deselect\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_DESELECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'target'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_deselect\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var target = Blockly.Python.valueToCode(block, 'target', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.deselect(${target})\\n`\n}\n\nBlockly.Blocks[\"custom_pn532_data_exchange\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_DATA_EXCHANGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'target'\n        },\n        {\n          'type': 'input_value',\n          'name': 'data'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_data_exchange\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var target = Blockly.Python.valueToCode(block, 'target', Blockly.Python.ORDER_FUNCTION_CALL);\n  var data = Blockly.Python.valueToCode(block, 'data', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.data_exchange(${target}, ${data})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pn532_mifare_authenticate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_MIFARE_AUTHENTICATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'target'\n        },\n        {\n          'type': 'input_value',\n          'name': 'block'\n        },\n        {\n          'type': 'input_value',\n          'name': 'key'\n        },\n        {\n          'type': 'input_value',\n          'name': 'uid'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_mifare_authenticate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var target = Blockly.Python.valueToCode(block, 'target', Blockly.Python.ORDER_FUNCTION_CALL);\n  var block = Blockly.Python.valueToCode(block, 'block', Blockly.Python.ORDER_FUNCTION_CALL);\n  var key = Blockly.Python.valueToCode(block, 'key', Blockly.Python.ORDER_FUNCTION_CALL);\n  var uid = Blockly.Python.valueToCode(block, 'uid', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.mifare_authenticate(${target}, ${block}, ${key}, ${uid})\\n`\n}\n\nBlockly.Blocks[\"custom_pn532_mifare_read_block\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_MIFARE_READ_BLOCK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'target'\n        },\n        {\n          'type': 'input_value',\n          'name': 'block'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pn532_mifare_read_block\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var target = Blockly.Python.valueToCode(block, 'target', Blockly.Python.ORDER_FUNCTION_CALL);\n  var block = Blockly.Python.valueToCode(block, 'block', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.mifare_read_block(${target}, ${block})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pn532_mifare_write_block\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PN532_MIFARE_WRITE_BLOCK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pn532Options\n        },\n        {\n          'type':