{
  "category": "St25dv",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_ST25DV_LANGUAGES = {\n  \"CUSTOM_ST25DV_INIT\": {\n    \"en\": \"%1 init bus %2\"\n  },\n  \"CUSTOM_ST25DV_READ\": {\n    \"en\": \"%1 read address %2 length %3 -> hex\"\n  },\n  \"CUSTOM_ST25DV_WRITE\": {\n    \"en\": \"%1 write address %2 data (hex) %3\"\n  },\n  \"CUSTOM_ST25DV_MEMORY_SIZE\": {\n    \"en\": \"%1 memory size (bytes)\"\n  },\n  \"CUSTOM_ST25DV_IC_REFERENCE\": {\n    \"en\": \"%1 IC reference\"\n  },\n  \"CUSTOM_ST25DV_UID\": {\n    \"en\": \"%1 UID (hex)\"\n  },\n  \"CUSTOM_ST25DV_IC_REVISION\": {\n    \"en\": \"%1 IC revision\"\n  },\n  \"CUSTOM_ST25DV_READ_SYSTEM\": {\n    \"en\": \"%1 read system area address %2 length %3 -> hex\"\n  },\n  \"CUSTOM_ST25DV_WRITE_SYSTEM\": {\n    \"en\": \"%1 write system area address %2 data (hex) %3\"\n  },\n  \"CUSTOM_ST25DV_PRESENT_PASSWORD\": {\n    \"en\": \"%1 present I2C password (hex) %2\"\n  },\n  \"CUSTOM_ST25DV_WRITE_PASSWORD\": {\n    \"en\": \"%1 change I2C password (hex) %2\"\n  },\n  \"CUSTOM_ST25DV_SESSION_OPEN\": {\n    \"en\": \"%1 security session open\"\n  },\n  \"CUSTOM_ST25DV_SET_AREA_END\": {\n    \"en\": \"%1 set end of area (1-3) %2 to block (x32 bytes) %3\"\n  },\n  \"CUSTOM_ST25DV_SET_AREA_PROTECTION\": {\n    \"en\": \"%1 protect area (1-4) %2 RF (0-15) %3 I2C (0-3) %4\"\n  },\n  \"CUSTOM_ST25DV_GET_AREA_RF_PROTECTION\": {\n    \"en\": \"%1 RF protection of area (1-4) %2\"\n  },\n  \"CUSTOM_ST25DV_GET_AREA_I2C_PROTECTION\": {\n    \"en\": \"%1 I2C protection of area (1-4) %2\"\n  },\n  \"CUSTOM_ST25DV_SET_GPO\": {\n    \"en\": \"%1 set GPO sources %2 enable (1/0) %3\"\n  },\n  \"CUSTOM_ST25DV_GET_GPO\": {\n    \"en\": \"%1 GPO register\"\n  },\n  \"CUSTOM_ST25DV_SET_GPO_RUNTIME\": {\n    \"en\": \"%1 GPO output enable (1/0) %2\"\n  },\n  \"CUSTOM_ST25DV_SET_INTERRUPT_PULSE\": {\n    \"en\": \"%1 GPO pulse (0-7) %2\"\n  },\n  \"CUSTOM_ST25DV_FIELD_PRESENT\": {\n    \"en\": \"%1 RF field present\"\n  },\n  \"CUSTOM_ST25DV_SET_ENERGY_HARVESTING\": {\n    \"en\": \"%1 energy harvesting (1/0) %2 forced after boot (1/0) %3\"\n  },\n  \"CUSTOM_ST25DV_SET_RF_STATE\": {\n    \"en\": \"%1 RF disable (1/0) %2 sleep (1/0) %3\"\n  },\n  \"CUSTOM_ST25DV_ENABLE_MAILBOX\": {\n    \"en\": \"%1 enable mailbox\"\n  },\n  \"CUSTOM_ST25DV_DISABLE_MAILBOX\": {\n    \"en\": \"%1 disable mailbox\"\n  },\n  \"CUSTOM_ST25DV_MAILBOX_HAS_RF_MESSAGE\": {\n    \"en\": \"%1 mailbox has RF message\"\n  },\n  \"CUSTOM_ST25DV_MAILBOX_HAS_HOST_MESSAGE\": {\n    \"en\": \"%1 mailbox has host message\"\n  },\n  \"CUSTOM_ST25DV_MAILBOX_WRITE\": {\n    \"en\": \"%1 mailbox write (hex) %2\"\n  },\n  \"CUSTOM_ST25DV_MAILBOX_READ\": {\n    \"en\": \"%1 mailbox read -> hex\"\n  },\n  \"CUSTOM_ST25DV_SET_MAILBOX_WATCHDOG\": {\n    \"en\": \"%1 mailbox watchdog (0-7) %2\"\n  },\n  \"CUSTOM_ST25DV_LOCK_CCFILE\": {\n    \"en\": \"%1 lock CC file (1/0) %2\"\n  },\n  \"CUSTOM_ST25DV_WRITE_NDEF\": {\n    \"en\": \"%1 write NDEF message (hex) %2\"\n  },\n  \"CUSTOM_ST25DV_READ_NDEF\": {\n    \"en\": \"%1 read NDEF message -> hex\"\n  },\n  \"CUSTOM_ST25DV_WAIT_WRITE_COMPLETE\": {\n    \"en\": \"%1 wait for write cycle\"\n  },\n  \"CUSTOM_ST25DV_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt sources\"\n  },\n  \"CUSTOM_ST25DV_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt source %2\"\n  },\n  \"CUSTOM_ST25DV_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt source %2\"\n  }\n};\n\nconst initType = 'custom_st25dv_init';\nBlockly.BlockRegExpList['custom_st25dv'] = {\n  regexp: new RegExp(/^custom_st25dv_/),\n  code: \"from St25dv import St25dv\",\n  initBlockType: initType,\n  categoryId: 'custom_st25dv',\n}\nBlockly.utils.registerLanguages(CUSTOM_ST25DV_LANGUAGES)\n\nBlockly.Msg.CUSTOM_ST25DV_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_ST25DV = 'St25dv'\n\nBlockly.utils.getcustom_st25dvOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['st25dv_0', 'st25dv_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_st25dv_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ST25DV_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_st25dvOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'st25dv_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_st25dv_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = St25dv(${bus})\\n`\n}\n\nBlockly.Blocks[\"custom_st25dv_read\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ST25DV_READ,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_st25dvOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'length'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_st25dv_read\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var length = Blockly.Python.valueToCode(block, 'length', Blockly.Python.ORDER_FUNCTION_CALL);\n  return [`${varname}.read(${address}, ${length})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_st25dv_write\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ST25DV_WRITE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_st25dvOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'data'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_st25dv_write\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var data = Blockly.Python.valueToCode(block, 'data', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write(${address}, ${data})\\n`\n}\n\nBlockly.Blocks[\"custom_st25dv_memory_size\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ST25DV_MEMORY_SIZE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_st25dvOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_st25dv_memory_size\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.memory_size()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_st25dv_ic_reference\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      