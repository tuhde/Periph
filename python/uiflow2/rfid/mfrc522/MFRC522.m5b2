  "uiflow2": {
    "jscode": "const CUSTOM_MFRC522_LANGUAGES = {\n  \"CUSTOM_MFRC522_INIT\": {\n    \"en\": \"%1 init bus %2 cs_pin %3\"\n  },\n  \"CUSTOM_MFRC522_IS_CARD_PRESENT\": {\n    \"en\": \"%1 card present?\"\n  },\n  \"CUSTOM_MFRC522_READ_UID\": {\n    \"en\": \"%1 card UID (hex, empty if none)\"\n  }\n};\n\nconst initType = 'custom_mfrc522_init';\nBlockly.BlockRegExpList['custom_mfrc522'] = {\n  regexp: new RegExp(/^custom_mfrc522_/),\n  code: \"from MFRC522 import MFRC522\",\n  initBlockType: initType,\n  categoryId: 'custom_mfrc522',\n}\nBlockly.utils.registerLanguages(CUSTOM_MFRC522_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MFRC522_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MFRC522 = 'MFRC522'\n\nBlockly.utils.getcustom_mfrc522Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['mfrc522_0', 'mfrc522_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_mfrc522_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MFRC522_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_mfrc522Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'mfrc522_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_mfrc522_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MFRC522(${bus}, ${cs_pin})\\n`\n}\n\nBlockly.Blocks[\"custom_mfrc522_is_card_present\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MFRC522_IS_CARD_PRESENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mfrc522Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mfrc522_is_card_present\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_card_present()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mfrc522_read_uid\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MFRC522_READ_UID,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mfrc522Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mfrc522_read_uid\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_uid()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"MFRC522\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mfrc522\"><title text=\"MFRC522\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mfrc522_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"cs_pin\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mfrc522_is_card_present\"/><block type=\"custom_mfrc522_read_uid\"/>\n</category>\n",
