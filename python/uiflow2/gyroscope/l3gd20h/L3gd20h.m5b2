    "toolbox": "\n<category name=\"L3gd20h\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_l3gd20h\">\n<title text=\"L3gd20h\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_l3gd20h_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">106</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_l3gd20h_gyro\"/><block type=\"custom_l3gd20h_configure\">\n  <value name=\"odr\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"bw\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"full_scale\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_l3gd20h_gyro_raw\"/><block type=\"custom_l3gd20h_temperature\"/><block type=\"custom_l3gd20h_data_ready\"/><block type=\"custom_l3gd20h_configure_hp_filter\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"cutoff\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_l3gd20h_enable_hp_filter\">\n  <value name=\"enable\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_l3gd20h_configure_fifo\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"watermark\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_l3gd20h_enable_fifo\">\n  <value name=\"enable\">\n    <shadow type=\"math_number\">\n     