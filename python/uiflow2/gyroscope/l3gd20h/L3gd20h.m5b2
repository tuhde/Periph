    "jscode": "const CUSTOM_L3GD20H_LANGUAGES = {\n  \"CUSTOM_L3GD20H_INIT\": {\n    \"en\": \"%1 init I2C bus %2 address %3\"\n  },\n  \"CUSTOM_L3GD20H_GYRO\": {\n    \"en\": \"%1 read angular rate (rad/s)\"\n  },\n  \"CUSTOM_L3GD20H_CONFIGURE\": {\n    \"en\": \"%1 configure ODR %2 BW %3 full_scale %4\"\n  },\n  \"CUSTOM_L3GD20H_GYRO_RAW\": {\n    \"en\": \"%1 read raw angular rate\"\n  },\n  \"CUSTOM_L3GD20H_TEMPERATURE\": {\n    \"en\": \"%1 read temperature (counts)\"\n  },\n  \"CUSTOM_L3GD20H_DATA_READY\": {\n    \"en\": \"%1 data ready\"\n  },\n  \"CUSTOM_L3GD20H_CONFIGURE_HP_FILTER\": {\n    \"en\": \"%1 configure HPF mode %2 cutoff %3\"\n  },\n  \"CUSTOM_L3GD20H_ENABLE_HP_FILTER\": {\n    \"en\": \"%1 enable HPF %2\"\n  },\n  \"CUSTOM_L3GD20H_CONFIGURE_FIFO\": {\n    \"en\": \"%1 configure FIFO mode %2 watermark %3\"\n  },\n  \"CUSTOM_L3GD20H_ENABLE_FIFO\": {\n    \"en\": \"%1 enable FIFO %2\"\n  },\n  \"CUSTOM_L3GD20H_FIFO_LEVEL\": {\n    \"en\": \"%1 FIFO level\"\n  },\n  \"CUSTOM_L3GD20H_READ_FIFO\": {\n    \"en\": \"%1 read FIFO\"\n  },\n  \"CUSTOM_L3GD20H_SET_POWER_MODE\": {\n    \"en\": \"%1 set power mode %2\"\n  }\n};\n\nconst initType = 'custom_l3gd20h_init';\nBlockly.BlockRegExpList['custom_l3gd20h'] = {\n  regexp: new RegExp(/^custom_l3gd20h_/),\n  code: \"from L3gd20h import L3gd20h\",\n  initBlockType: initType,\n  categoryId: 'custom_l3gd20h',\n}\nBlockly.utils.registerLanguages(CUSTOM_L3GD20H_LANGUAGES)\n\nBlockly.Msg.CUSTOM_L3GD20H_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_L3GD20H = 'L3gd20h'\n\nBlockly.utils.getcustom_l3gd20hOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['l3gd20h_0', 'l3gd20h_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_l3gd20h_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_l3gd20hOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'l3gd20h_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = L3gd20h(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_l3gd20h_gyro\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_GYRO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_gyro\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.gyro()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3gd20h_configure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_CONFIGURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'odr'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bw'\n        },\n        {\n          'type': 'input_value',\n          'name': 'full_scale'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_configure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var odr = Blockly.Python.valueToCode(block, 'odr', Blockly.Python.ORDER_FUNCTION_CALL);\n  var bw = Blockly.Python.valueToCode(block, 'bw', Blockly.Python.ORDER_FUNCTION_CALL);\n  var full_scale = Blockly.Python.valueToCode(block, 'full_scale', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure(${odr}, ${bw}, ${full_scale})\\n`\n}\n\nBlockly.Blocks[\"custom_l3gd20h_gyro_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_GYRO_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_gyro_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.gyro_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3gd20h_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3gd20h_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_data_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.data_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3gd20h_configure_hp_filter\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_CONFIGURE_HP_FILTER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cutoff'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_configure_hp_filter\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cutoff = Blockly.Python.valueToCode(block, 'cutoff', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure_hp_filter(${mode}, ${cutoff})\\n`\n}\n\nBlockly.Blocks[\"custom_l3gd20h_enable_hp_filter\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_ENABLE_HP_FILTER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'enable'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_enable_hp_filter\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enable = Blockly.Python.valueToCode(block, 'enable', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.enable_hp_filter(${enable})\\n`\n}\n\nBlockly.Blocks[\"custom_l3gd20h_configure_fifo\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_CONFIGURE_FIFO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'mode'\n        },\n        {\n          'type': 'input_value',\n          'name': 'watermark'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_configure_fifo\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var mode = Blockly.Python.valueToCode(block, 'mode', Blockly.Python.ORDER_FUNCTION_CALL);\n  var watermark = Blockly.Python.valueToCode(block, 'watermark', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure_fifo(${mode}, ${watermark})\\n`\n}\n\nBlockly.Blocks[\"custom_l3gd20h_enable_fifo\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_ENABLE_FIFO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'enable'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_enable_fifo\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enable = Blockly.Python.valueToCode(block, 'enable', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.enable_fifo(${enable})\\n`\n}\n\nBlockly.Blocks[\"custom_l3gd20h_fifo_level\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_FIFO_LEVEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3gd20h_fifo_level\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.fifo_level()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3gd20h_read_fifo\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3GD20H_READ_FIFO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3gd20hOptions\n        },\n    