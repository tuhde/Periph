  "uiflow2": {
    "jscode": "const CUSTOM_L3G4200D_LANGUAGES = {\n  \"CUSTOM_L3G4200D_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_L3G4200D_ANGULAR_RATE\": {\n    \"en\": \"%1 angular rate (rad/s)\"\n  },\n  \"CUSTOM_L3G4200D_TEMPERATURE\": {\n    \"en\": \"%1 temperature (counts)\"\n  },\n  \"CUSTOM_L3G4200D_WHO_AM_I\": {\n    \"en\": \"%1 WHO_AM_I\"\n  },\n  \"CUSTOM_L3G4200D_DATA_READY\": {\n    \"en\": \"%1 data ready\"\n  },\n  \"CUSTOM_L3G4200D_STATUS\": {\n    \"en\": \"%1 STATUS_REG\"\n  },\n  \"CUSTOM_L3G4200D_FIFO_SAMPLES\": {\n    \"en\": \"%1 FIFO samples\"\n  }\n};\n\nconst initType = 'custom_l3g4200d_init';\nBlockly.BlockRegExpList['custom_l3g4200d'] = {\n  regexp: new RegExp(/^custom_l3g4200d_/),\n  code: \"from L3G4200D import L3G4200D\",\n  initBlockType: initType,\n  categoryId: 'custom_l3g4200d',\n}\nBlockly.utils.registerLanguages(CUSTOM_L3G4200D_LANGUAGES)\n\nBlockly.Msg.CUSTOM_L3G4200D_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_L3G4200D = 'L3G4200D'\n\nBlockly.utils.getcustom_l3g4200dOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['l3g4200d_0', 'l3g4200d_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_l3g4200d_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3G4200D_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_l3g4200dOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'l3g4200d_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3g4200d_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = L3G4200D(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_l3g4200d_angular_rate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3G4200D_ANGULAR_RATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3g4200dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3g4200d_angular_rate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.angular_rate()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3g4200d_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3G4200D_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3g4200dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3g4200d_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.temperature()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3g4200d_who_am_i\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3G4200D_WHO_AM_I,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3g4200dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3g4200d_who_am_i\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.who_am_i()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3g4200d_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3G4200D_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3g4200dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3g4200d_data_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.data_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3g4200d_status\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3G4200D_STATUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3g4200dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3g4200d_status\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.status()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_l3g4200d_fifo_samples\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_L3G4200D_FIFO_SAMPLES,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_l3g4200dOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_l3g4200d_fifo_samples\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.fifo_samples()`, Blockly.Python.ORDER_NONE]\n}\n",
    "toolbox": "\n<category name=\"L3G4200D\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_l3g4200d\">\n<title text=\"L3G4200D\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_l3g4200d_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">104</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_l3g4200d_angular_rate\"/><block type=\"custom_l3g4200d_temperature\"/><block type=\"custom_l3g4200d_who_am_i\"/><block type=\"custom_l3g4200d_data_ready\"/><block type=\"custom_l3g4200d_status\"/><block type=\"custom_l3g4200d_fifo_samples\"/>\n</category>\n",
