  "uiflow2": {
    "jscode": "const CUSTOM_UC1611SSPI_LANGUAGES = {\n  \"CUSTOM_UC1611SSPI_INIT\": {\n    \"en\": \"%1 init (4-wire SPI) SCK %2 MOSI %3 CS %4 CD %5 RST %6\"\n  },\n  \"CUSTOM_UC1611SSPI_CLEAR\": {\n    \"en\": \"%1 clear framebuffer\"\n  },\n  \"CUSTOM_UC1611SSPI_FILL\": {\n    \"en\": \"%1 fill all pixels on (1) / off (0) %2\"\n  },\n  \"CUSTOM_UC1611SSPI_SET_PIXEL\": {\n    \"en\": \"%1 set pixel x %2 y %3 on (1/0) %4\"\n  },\n  \"CUSTOM_UC1611SSPI_DRAW_LINE\": {\n    \"en\": \"%1 draw line x0 %2 y0 %3 x1 %4 y1 %5 on (1/0) %6\"\n  },\n  \"CUSTOM_UC1611SSPI_DRAW_RECT\": {\n    \"en\": \"%1 draw rectangle x %2 y %3 w %4 h %5 on (1/0) %6 filled (1/0) %7\"\n  },\n  \"CUSTOM_UC1611SSPI_SHOW\": {\n    \"en\": \"%1 show framebuffer\"\n  },\n  \"CUSTOM_UC1611SSPI_SHOW_PAGE\": {\n    \"en\": \"%1 show page (0..15) %2\"\n  },\n  \"CUSTOM_UC1611SSPI_SET_CONTRAST\": {\n    \"en\": \"%1 set contrast (0..255) %2\"\n  },\n  \"CUSTOM_UC1611SSPI_SET_DISPLAY\": {\n    \"en\": \"%1 display on (1) / sleep (0) %2\"\n  },\n  \"CUSTOM_UC1611SSPI_SET_INVERT\": {\n    \"en\": \"%1 invert on (1) / off (0) %2\"\n  },\n  \"CUSTOM_UC1611SSPI_SET_FLIP\": {\n    \"en\": \"%1 mirror x (1/0) %2 mirror y (1/0) %3\"\n  },\n  \"CUSTOM_UC1611SSPI_SET_SCROLL_LINE\": {\n    \"en\": \"%1 scroll line (0..159) %2\"\n  },\n  \"CUSTOM_UC1611SSPI_SLEEP\": {\n    \"en\": \"%1 sleep\"\n  },\n  \"CUSTOM_UC1611SSPI_WAKE\": {\n    \"en\": \"%1 wake\"\n  }\n};\n\nconst initType = 'custom_uc1611sspi_init';\nBlockly.BlockRegExpList['custom_uc1611sspi'] = {\n  regexp: new RegExp(/^custom_uc1611sspi_/),\n  code: \"from UC1611sSpi import UC1611sSpi\",\n  initBlockType: initType,\n  categoryId: 'custom_uc1611sspi',\n}\nBlockly.utils.registerLanguages(CUSTOM_UC1611SSPI_LANGUAGES)\n\nBlockly.Msg.CUSTOM_UC1611SSPI_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_UC1611SSPI = 'UC1611sSpi'\n\nBlockly.utils.getcustom_uc1611sspiOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['uc1611sspi_0', 'uc1611sspi_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_uc1611sspi_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC1611SSPI_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_uc1611sspiOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'uc1611sspi_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'sck'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mosi'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cd'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rst'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc1611sspi_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var sck = Blockly.Python.valueToCode(block, 'sck', Blockly.Python.ORDER_FUNCTION_CALL);\n  var mosi = Blockly.Python.valueToCode(block, 'mosi', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs = Blockly.Python.valueToCode(block, 'cs', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cd = Blockly.Python.valueToCode(block, 'cd', Blockly.Python.ORDER_FUNCTION_CALL);\n  var rst = Blockly.Python.valueToCode(block, 'rst', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = UC1611sSpi(${sck}, ${mosi}, ${cs}, ${cd}, ${rst})\\n`\n}\n\nBlockly.Blocks[\"custom_uc1611sspi_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC1611SSPI_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc1611sspiOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc1611sspi_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear()\\n`\n}\n\nBlockly.Blocks[\"custom_uc1611sspi_fill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC1611SSPI_FILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc1611sspiOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'state'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc1611sspi_fill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var state = Blockly.Python.valueToCode(block, 'state', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill(${state})\\n`\n}\n\nBlockly.Blocks[\"custom_uc1611sspi_set_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC1611SSPI_SET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc1611sspiOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        