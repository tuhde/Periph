  "pyCode": "\"\"\"\nfile     UC1611sSpi\ntime     2026-10-20\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom machine import SPI, Pin\nfrom periph.connection.display_micropython import DisplayConnection\nfrom periph.connection.output_pin import MicroPythonOutputPin\nfrom periph.chips.display.uc1611s import UC1611sSpiFull\n\n\nclass UC1611sSpi:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, sck: int = 18, mosi: int = 19, cs: int = 17, cd: int = 20, rst: int = 21):\n        \"\"\"\n        label:\n            en: '%1 init (4-wire SPI) SCK %2 MOSI %3 CS %4 CD %5 RST %6'\n        params:\n            sck:\n                name: sck\n                type: int\n                default: '18'\n                field: number\n            mosi:\n                name: mosi\n                type: int\n                default: '19'\n                field: number\n            cs:\n                name: cs\n                type: int\n                default: '17'\n                field: number\n            cd:\n                name: cd\n                type: int\n                default: '20'\n                field: number\n            rst:\n                name: rst\n                type: int\n                default: '21'\n                field: number\n        \"\"\"\n        # EA DOGXL240-7 (240 x 128, 3.3 V), 4-wire SPI (BM0 = D13 = VSS), SPI mode 0 at 4 MHz.\n        spi = SPI(2, baudrate=4000000, polarity=0, phase=0, sck=Pin(sck), mosi=Pin(mosi))\n        connection = DisplayConnection(spi, MicroPythonOutputPin(cs), MicroPythonOutputPin(cd),\n                                       MicroPythonOutputPin(rst), None)\n        self._driver = UC1611sSpiFull(connection)\n\n    def clear(self):\n        \"\"\"\n        label:\n            en: '%1 clear framebuffer'\n        \"\"\"\n        self._driver.clear()\n\n    def fill(self, state: int = 1):\n        \"\"\"\n        label:\n            en: '%1 fill all pixels on (1) / off (0) %2'\n        params:\n            state:\n                name: state\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.fill(bool(state))\n\n    def set_pixel(self, x: int = 0, y: int = 0, state: int = 1):\n        \"\"\"\n        label:\n            en: '%1 set pixel x %2 y %3 on (1/0) %4'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n            y:\n                name: y\n                type: int\n                default: '0'\n                field: number\n            state:\n                name: state\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.set_pixel(x, y, bool(state))\n\n    def draw_line(self, x0: int = 0, y0: int = 0, x1: int = 239, y1: int = 127, state: int = 1):\n        \"\"\"\n        label:\n            en: '%1 draw line x0 %2 y0 %3 x1 %4 y1 %5 on (1/0) %6'\n        params:\n            x0:\n                name: x0\n                type: int\n                default: '0'\n                field: number\n            y0:\n                name: y0\n                type: int\n                default: '0'\n                field: number\n            x1:\n                name: x1\n                type: int\n                default: '239'\n                field: number\n            y1:\n                name: y1\n                type: int\n                default: '127'\n                field: number\n            state:\n                name: state\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.draw_line(x0, y0, x1, y1, bool(state))\n\n    def draw_rect(self, x: int = 0, y: int = 0, w: int = 240, h: int = 128, state: int = 1, fill: int = 0):\n        \"\"\"\n        label:\n            en: '%1 draw rectangle x %2 y %3 w %4 h %5 on (1/0) %6 filled (1/0) %7'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n            y:\n                name: y\n                type: int\n                default: '0'\n                field: number\n            w:\n                name: w\n                type: int\n                default: '240'\n                field: number\n            h:\n                name: h\n                type: int\n                default: '128'\n                field: number\n            state:\n                name: state\n                type: int\n                default: '1'\n                field: number\n            fill:\n                name: fill\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.draw_rect(x, y, w, h, bool(state), bool(fill))\n\n    def show(self):\n        \"\"\"\n        label:\n            en: '%1 show framebuffer'\n        \"\"\"\n        self._driver.show()\n\n    def show_page(self, page: int = 0):\n        \"\"\"\n        label:\n            en: '%1 show page (0..15) %2'\n        params:\n            page:\n                name: page\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.show_page(page)\n\n    def set_contrast(self, value: int = 143):\n        \"\"\"\n        label:\n            en: '%1 set contrast (0..255) %2'\n        params:\n            value:\n                name: value\n                type: int\n                default: '143'\n                field: number\n        \"\"\"\n        self._driver.set_contrast(value)\n\n    def set_display(self, state: int = 1):\n        \"\"\"\n        label:\n            en: '%1 display on (1) / sleep (0) %2'\n        params:\n            state:\n                name: state\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.set_display(bool(state))\n\n    def set_invert(self, state: int = 0):\n        \"\"\"\n        label:\n            en: '%1 invert on (1) / off (0) %2'\n        params:\n            state:\n                name: state\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.set_invert(bool(state))\n\n    def set_flip(self, mirror_x: int = 1, mirror_y: int = 0):\n        \"\"\"\n        label:\n            en: '%1 mirror x (1/0) %2 mirror y (1/0) %3'\n        params:\n            mirror_x:\n                name: mirror_x\n                type: int\n                default: '1'\n                field: number\n            mirror_y:\n                name: mirror_y\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.set_flip(bool(mirror_x), bool(mirror_y))\n\n    def set_scroll_line(self, line: int = 0):\n        \"\"\"\n        label:\n            en: '%1 scroll line (0..159) %2'\n        params:\n            line:\n                name: line\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.set_scroll_line(line)\n\n    def sleep(self):\n        \"\"\"\n        label:\n            en: '%1 sleep'\n        \"\"\"\n        self._driver.sleep()\n\n    def wake(self):\n        \"\"\"\n        label:\n            en: '%1 wake'\n        \"\"\"\n        self._driver.wake()\n",
  "version": "alpha2"
}
