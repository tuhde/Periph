{
  "category": "SSD1305",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_SSD1305_LANGUAGES = {\n  \"CUSTOM_SSD1305_INIT\": {\n    \"en\": \"%1 init bus %2 address (0x3C=60, 0x3D=61) %3 column offset (4 for 128 px modules) %4\"\n  },\n  \"CUSTOM_SSD1305_CLEAR\": {\n    \"en\": \"%1 clear framebuffer\"\n  },\n  \"CUSTOM_SSD1305_SET_PIXEL\": {\n    \"en\": \"%1 set pixel x %2 y %3 on (1/0) %4\"\n  },\n  \"CUSTOM_SSD1305_SHOW\": {\n    \"en\": \"%1 show (send framebuffer)\"\n  },\n  \"CUSTOM_SSD1305_SHOW_PAGE\": {\n    \"en\": \"%1 show page (0..7) %2\"\n  },\n  \"CUSTOM_SSD1305_FILL\": {\n    \"en\": \"%1 fill framebuffer on (1/0) %2\"\n  },\n  \"CUSTOM_SSD1305_DRAW_LINE\": {\n    \"en\": \"%1 line x0 %2 y0 %3 x1 %4 y1 %5 on (1/0) %6\"\n  },\n  \"CUSTOM_SSD1305_DRAW_RECT\": {\n    \"en\": \"%1 rectangle x %2 y %3 w %4 h %5 on (1/0) %6 filled (1/0) %7\"\n  },\n  \"CUSTOM_SSD1305_SET_CONTRAST\": {\n    \"en\": \"%1 set contrast (0..255) %2\"\n  },\n  \"CUSTOM_SSD1305_SET_DISPLAY\": {\n    \"en\": \"%1 display on (1/0) %2\"\n  },\n  \"CUSTOM_SSD1305_SLEEP\": {\n    \"en\": \"%1 sleep\"\n  },\n  \"CUSTOM_SSD1305_WAKE\": {\n    \"en\": \"%1 wake\"\n  },\n  \"CUSTOM_SSD1305_SET_INVERT\": {\n    \"en\": \"%1 invert (1/0) %2\"\n  },\n  \"CUSTOM_SSD1305_SET_FLIP\": {\n    \"en\": \"%1 flip horizontal (1/0) %2 vertical (1/0) %3\"\n  },\n  \"CUSTOM_SSD1305_SET_START_LINE\": {\n    \"en\": \"%1 scroll: start line (0..63) %2\"\n  },\n  \"CUSTOM_SSD1305_READ_STATUS\": {\n    \"en\": \"%1 status byte (bit 7 BUSY, bit 6 display off)\"\n  }\n};\n\nconst initType = 'custom_ssd1305_init';\nBlockly.BlockRegExpList['custom_ssd1305'] = {\n  regexp: new RegExp(/^custom_ssd1305_/),\n  code: \"from SSD1305 import SSD1305\",\n  initBlockType: initType,\n  categoryId: 'custom_ssd1305',\n}\nBlockly.utils.registerLanguages(CUSTOM_SSD1305_LANGUAGES)\n\nBlockly.Msg.CUSTOM_SSD1305_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_SSD1305 = 'SSD1305'\n\nBlockly.utils.getcustom_ssd1305Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ssd1305_0', 'ssd1305_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ssd1305_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ssd1305Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ssd1305_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'column_offset'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var column_offset = Blockly.Python.valueToCode(block, 'column_offset', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = SSD1305(${bus}, ${address}, ${column_offset})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear()\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_set_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_set_pixel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pixel(${x}, ${y}, ${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_show\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SHOW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_show\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.show()\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_show_page\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SHOW_PAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'page'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_show_page\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var page = Blockly.Python.valueToCode(block, 'page', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.show_page(${page})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_fill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_FILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_fill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_draw_line\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_DRAW_LINE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'x1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_draw_line\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x0 = Blockly.Python.valueToCode(block, 'x0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y0 = Blockly.Python.valueToCode(block, 'y0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var x1 = Blockly.Python.valueToCode(block, 'x1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y1 = Blockly.Python.valueToCode(block, 'y1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.draw_line(${x0}, ${y0}, ${x1}, ${y1}, ${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_draw_rect\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_DRAW_RECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        {\n          'type': 'input_value',\n          'name': 'w'\n        },\n        {\n          'type': 'input_value',\n          'name': 'h'\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n        {\n          'type': 'input_value',\n          'name': 'filled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_draw_rect\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n  var w = Blockly.Python.valueToCode(block, 'w', Blockly.Python.ORDER_FUNCTION_CALL);\n  var h = Blockly.Python.valueToCode(block, 'h', Blockly.Python.ORDER_FUNCTION_CALL);\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  var filled = Blockly.Python.valueToCode(block, 'filled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.draw_rect(${x}, ${y}, ${w}, ${h}, ${enabled}, ${filled})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_set_contrast\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SET_CONTRAST,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_set_contrast\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_contrast(${value})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_set_display\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SET_DISPLAY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_set_display\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_display(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_sleep\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SLEEP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_sleep\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.sleep()\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_wake\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_WAKE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_wake\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.wake()\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_set_invert\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SET_INVERT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'enabled'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_set_invert\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var enabled = Blockly.Python.valueToCode(block, 'enabled', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_invert(${enabled})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_set_flip\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SET_FLIP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'horizontal'\n        },\n        {\n          'type': 'input_value',\n          'name': 'vertical'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_set_flip\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var horizontal = Blockly.Python.valueToCode(block, 'horizontal', Blockly.Python.ORDER_FUNCTION_CALL);\n  var vertical = Blockly.Python.valueToCode(block, 'vertical', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_flip(${horizontal}, ${vertical})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_set_start_line\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_SET_START_LINE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'line'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_set_start_line\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var line = Blockly.Python.valueToCode(block, 'line', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_start_line(${line})\\n`\n}\n\nBlockly.Blocks[\"custom_ssd1305_read_status\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_SSD1305_READ_STATUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ssd1305Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ssd1305_read_status\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_status()`, Blockly.Python.ORDER_NONE]\n}\n",
