{
  "category": "PCF8578",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_PCF8578_LANGUAGES = {\n  \"CUSTOM_PCF8578_INIT\": {\n    \"en\": \"%1 init bus %2 address %3 rows (8/16/24/32) %4\"\n  },\n  \"CUSTOM_PCF8578_CLEAR\": {\n    \"en\": \"%1 clear display\"\n  },\n  \"CUSTOM_PCF8578_SET_PIXEL\": {\n    \"en\": \"%1 set pixel x %2 y %3 on (0/1) %4\"\n  },\n  \"CUSTOM_PCF8578_GET_PIXEL\": {\n    \"en\": \"%1 pixel x %2 y %3 set?\"\n  },\n  \"CUSTOM_PCF8578_WRITE_COLUMN\": {\n    \"en\": \"%1 write column byte x %2 bank %3 value %4\"\n  },\n  \"CUSTOM_PCF8578_FILL\": {\n    \"en\": \"%1 fill display (0/1) %2\"\n  },\n  \"CUSTOM_PCF8578_DRAW_LINE\": {\n    \"en\": \"%1 draw line x0 %2 y0 %3 x1 %4 y1 %5 on (0/1) %6\"\n  },\n  \"CUSTOM_PCF8578_DRAW_RECT\": {\n    \"en\": \"%1 draw rectangle x %2 y %3 width %4 height %5 on (0/1) %6 fill (0/1) %7\"\n  },\n  \"CUSTOM_PCF8578_SET_DISPLAY\": {\n    \"en\": \"%1 set display status (0=blank 1=normal 2=all on 3=inverse) %2\"\n  },\n  \"CUSTOM_PCF8578_SET_MODE\": {\n    \"en\": \"%1 set rows (8/16/24/32) %2 mixed mode (0/1) %3\"\n  },\n  \"CUSTOM_PCF8578_SET_START_BANK\": {\n    \"en\": \"%1 set start bank %2\"\n  },\n  \"CUSTOM_PCF8578_SCROLL\": {\n    \"en\": \"%1 scroll by banks %2\"\n  },\n  \"CUSTOM_PCF8578_DEVICE_SELECT\": {\n    \"en\": \"%1 select device subaddress %2\"\n  },\n  \"CUSTOM_PCF8578_RESET\": {\n    \"en\": \"%1 reset display\"\n  }\n};\n\nconst initType = 'custom_pcf8578_init';\nBlockly.BlockRegExpList['custom_pcf8578'] = {\n  regexp: new RegExp(/^custom_pcf8578_/),\n  code: \"from PCF8578 import PCF8578\",\n  initBlockType: initType,\n  categoryId: 'custom_pcf8578',\n}\nBlockly.utils.registerLanguages(CUSTOM_PCF8578_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PCF8578_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_PCF8578 = 'PCF8578'\n\nBlockly.utils.getcustom_pcf8578Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pcf8578_0', 'pcf8578_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_pcf8578_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pcf8578Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pcf8578_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rows'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var rows = Blockly.Python.valueToCode(block, 'rows', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = PCF8578(${bus}, ${address}, ${rows})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.clear()\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_set_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_SET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        {\n          'type': 'input_value',\n          'name': 'True'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_set_pixel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n  var True = Blockly.Python.valueToCode(block, 'True', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pixel(${x}, ${y}, ${True})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_get_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_GET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_get_pixel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_pixel(${x}, ${y})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pcf8578_write_column\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_WRITE_COLUMN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bank'\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_write_column\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var bank = Blockly.Python.valueToCode(block, 'bank', Blockly.Python.ORDER_FUNCTION_CALL);\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.write_column(${x}, ${bank}, ${value})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_fill\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_FILL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'True'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_fill\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var True = Blockly.Python.valueToCode(block, 'True', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.fill(${True})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_draw_line\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_DRAW_LINE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'x1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'True'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_draw_line\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x0 = Blockly.Python.valueToCode(block, 'x0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y0 = Blockly.Python.valueToCode(block, 'y0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var x1 = Blockly.Python.valueToCode(block, 'x1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y1 = Blockly.Python.valueToCode(block, 'y1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var True = Blockly.Python.valueToCode(block, 'True', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.draw_line(${x0}, ${y0}, ${x1}, ${y1}, ${True})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_draw_rect\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_DRAW_RECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        {\n          'type': 'input_value',\n          'name': 'w'\n        },\n        {\n          'type': 'input_value',\n          'name': 'h'\n        },\n        {\n          'type': 'input_value',\n          'name': 'True'\n        },\n        {\n          'type': 'input_value',\n          'name': 'fill'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_draw_rect\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n  var w = Blockly.Python.valueToCode(block, 'w', Blockly.Python.ORDER_FUNCTION_CALL);\n  var h = Blockly.Python.valueToCode(block, 'h', Blockly.Python.ORDER_FUNCTION_CALL);\n  var True = Blockly.Python.valueToCode(block, 'True', Blockly.Python.ORDER_FUNCTION_CALL);\n  var fill = Blockly.Python.valueToCode(block, 'fill', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.draw_rect(${x}, ${y}, ${w}, ${h}, ${True}, ${fill})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_set_display\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_SET_DISPLAY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'status'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_set_display\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var status = Blockly.Python.valueToCode(block, 'status', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_display(${status})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_set_mode\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_SET_MODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'rows'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mixed'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_set_mode\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var rows = Blockly.Python.valueToCode(block, 'rows', Blockly.Python.ORDER_FUNCTION_CALL);\n  var mixed = Blockly.Python.valueToCode(block, 'mixed', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_mode(${rows}, ${mixed})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_set_start_bank\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_SET_START_BANK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'bank'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_set_start_bank\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bank = Blockly.Python.valueToCode(block, 'bank', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_start_bank(${bank})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_scroll\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_SCROLL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'banks'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_scroll\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var banks = Blockly.Python.valueToCode(block, 'banks', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.scroll(${banks})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_device_select\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_DEVICE_SELECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'subaddress'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_device_select\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var subaddress = Blockly.Python.valueToCode(block, 'subaddress', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.device_select(${subaddress})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8578_reset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8578_RESET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8578Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8578_reset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.reset()\\n`\n}\n",
    "toolbox": "\n<category name=\"PCF8578\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_pcf8578\">\n<title text=\"PCF8578\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_pcf8578_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">60</field>\n    </shadow>\n  </value>\n  <value name=\"rows\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">16</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pcf8578_clear\"/><block type=\"custom_pcf8578_set_pixel\">\n  <value name=\"x\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"y\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"True\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pcf8578_get_pixel\">\n  <value name=\"x\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"y\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pcf8578_write_column\">\n  <value name=\"x\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"bank\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"value\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">255</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pcf8578_fill\">\n  <value name=\"True\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pcf8578_draw_line\"