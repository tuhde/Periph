  "pyCode": "\"\"\"\nfile     PCF8578\ntime     2026-11-05\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.i2c_auto import I2CConnection\nfrom periph.chips.display.pcf8578 import PCF8578Full\n\n\nclass PCF8578:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 0, address: int = 60, rows: int = 16):\n        \"\"\"\n        label:\n            en: '%1 init bus %2 address %3 rows (8/16/24/32) %4'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '0'\n                field: number\n            address:\n                name: address\n                type: int\n                default: '60'\n                field: number\n            rows:\n                name: rows\n                type: int\n                default: '16'\n                field: number\n                max: '32'\n                min: '8'\n        \"\"\"\n        connection = I2CConnection(address, bus=bus)\n        self._driver = PCF8578Full(connection, rows)\n\n    def clear(self):\n        \"\"\"\n        label:\n            en: '%1 clear display'\n        \"\"\"\n        self._driver.clear()\n\n    def set_pixel(self, x: int, y: int, on: int):\n        \"\"\"\n        label:\n            en: '%1 set pixel x %2 y %3 on (0/1) %4'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n                max: '39'\n                min: '0'\n            y:\n                name: y\n                type: int\n                default: '0'\n                field: number\n                max: '31'\n                min: '0'\n            on:\n                name: on\n                type: int\n                default: '1'\n                field: number\n                max: '1'\n                min: '0'\n        \"\"\"\n        self._driver.set_pixel(x, y, bool(on))\n\n    def get_pixel(self, x: int, y: int) -> bool:\n        \"\"\"\n        label:\n            en: '%1 pixel x %2 y %3 set?'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n                max: '39'\n                min: '0'\n            y:\n                name: y\n                type: int\n                default: '0'\n                field: number\n                max: '31'\n                min: '0'\n        \"\"\"\n        return self._driver.get_pixel(x, y)\n\n    def write_column(self, x: int, bank: int, value: int):\n        \"\"\"\n        label:\n            en: '%1 write column byte x %2 bank %3 value %4'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n                max: '39'\n                min: '0'\n            bank:\n                name: bank\n                type: int\n                default: '0'\n                field: number\n                max: '3'\n                min: '0'\n            value:\n                name: value\n                type: int\n                default: '255'\n                field: number\n                max: '255'\n                min: '0'\n        \"\"\"\n        self._driver.write_columns(x, bank, bytes([value & 0xFF]))\n\n    def fill(self, on: int):\n        \"\"\"\n        label:\n            en: '%1 fill display (0/1) %2'\n        params:\n            on:\n                name: on\n                type: int\n                default: '1'\n                field: number\n                max: '1'\n                min: '0'\n        \"\"\"\n        self._driver.fill(bool(on))\n\n    def draw_line(self, x0: int, y0: int, x1: int, y1: int, on: int):\n        \"\"\"\n        label:\n            en: '%1 draw line x0 %2 y0 %3 x1 %4 y1 %5 on (0/1) %6'\n        params:\n            x0:\n                name: x0\n                type: int\n                default: '0'\n                field: number\n                max: '39'\n                min: '0'\n            y0:\n                name: y0\n                type: int\n                default: '0'\n                field: number\n                max: '31'\n                min: '0'\n            x1:\n                name: x1\n                type: int\n                default: '0'\n                field: number\n                max: '39'\n                min: '0'\n            y1:\n                name: y1\n                type: int\n                default: '0'\n                field: number\n                max: '31'\n                min: '0'\n            on:\n                name: on\n                type: int\n                default: '1'\n                field: number\n                max: '1'\n                min: '0'\n        \"\"\"\n        self._driver.draw_line(x0, y0, x1, y1, bool(on))\n\n    def draw_rect(self, x: int, y: int, w: int, h: int, on: int, fill: int):\n        \"\"\"\n        label:\n            en: '%1 draw rectangle x %2 y %3 width %4 height %5 on (0/1) %6 fill (0/1) %7'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n                max: '39'\n                min: '0'\n            y:\n                name: y\n                type: int\n                default: '0'\n                field: number\n                max: '31'\n                min: '0'\n            w:\n                name: w\n                type: int\n                default: '1'\n                field: number\n                max: '40'\n                min: '1'\n            h:\n                name: h\n                type: int\n                default: '1'\n                field: number\n                max: '32'\n                min: '1'\n            on:\n                name: on\n                type: int\n                default: '1'\n                field: number\n                max: '1'\n                min: '0'\n            fill:\n                name: fill\n                type: int\n                default: '0'\n                field: number\n                max: '1'\n                min: '0'\n        \"\"\"\n        self._driver.draw_rect(x, y, w, h, bool(on), bool(fill))\n\n    def set_display(self, status: int):\n        \"\"\"\n        label:\n            en: '%1 set display status (0=blank 1=normal 2=all on 3=inverse) %2'\n        params:\n            status:\n                name: status\n                type: int\n                default: '1'\n                field: number\n                max: '3'\n                min: '0'\n        \"\"\"\n        self._driver.set_display(status)\n\n    def set_mode(self, rows: int, mixed: int):\n        \"\"\"\n        label:\n            en: '%1 set rows (8/16/24/32) %2 mixed mode (0/1) %3'\n        params:\n            rows:\n                name: rows\n                type: int\n                default: '16'\n                field: number\n                max: '32'\n                min: '8'\n            mixed:\n                name: mixed\n                type: int\n                default: '1'\n                field: number\n                max: '1'\n                min: '0'\n        \"\"\"\n        self._driver.set_mode(rows, bool(mixed))\n\n    def set_start_bank(self, bank: int):\n        \"\"\"\n        label:\n            en: '%1 set start bank %2'\n        params:\n            bank:\n                name: bank\n                type: int\n                default: '0'\n                field: number\n                max: '3'\n                min: '0'\n        \"\"\"\n        self._driver.set_start_bank(bank)\n\n    def scroll(self, banks: int):\n        \"\"\"\n        label:\n            en: '%1 scroll by banks %2'\n        params:\n            banks:\n                name: banks\n                type: int\n                default: '1'\n                field: number\n                max: '3'\n                min: '-3'\n        \"\"\"\n        self._driver.scroll(banks)\n\n    def device_select(self, subaddress: int):\n        \"\"\"\n        label:\n            en: '%1 select device subaddress %2'\n        params:\n            subaddress:\n                name: subaddress\n                type: int\n                default: '0'\n                field: number\n                max: '15'\n                min: '0'\n        \"\"\"\n        self._driver.device_select(subaddress)\n\n    def reset(self):\n        \"\"\"\n        label:\n            en: '%1 reset display'\n        \"\"\"\n        self._driver.reset()\n",
  "version": "alpha2"
}
