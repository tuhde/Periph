  "pyCode": "\"\"\"\nfile     UC8276C\ntime     2026-10-15\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom machine import SPI, Pin\nfrom periph.connection.display_micropython import DisplayConnection\nfrom periph.connection.output_pin import MicroPythonOutputPin\nfrom periph.connection.input_pin import MicroPythonPin\nfrom periph.chips.display.uc8276c import UC8276CFull\n\n\nclass UC8276C:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, sck: int = 18, mosi: int = 19, cs: int = 17, dc: int = 20, res: int = 21, busy: int = 22):\n        \"\"\"\n        label:\n            en: '%1 init SCK %2 MOSI %3 CS %4 DC %5 RES %6 BUSY %7'\n        params:\n            sck:\n                name: sck\n                type: int\n                default: '18'\n                field: number\n            mosi:\n                name: mosi\n                type: int\n                default: '19'\n                field: number\n            cs:\n                name: cs\n                type: int\n                default: '17'\n                field: number\n            dc:\n                name: dc\n                type: int\n                default: '20'\n                field: number\n            res:\n                name: res\n                type: int\n                default: '21'\n                field: number\n            busy:\n                name: busy\n                type: int\n                default: '22'\n                field: number\n        \"\"\"\n        spi = SPI(2, baudrate=4000000, polarity=0, phase=0, sck=Pin(sck), mosi=Pin(mosi))\n        connection = DisplayConnection(spi, MicroPythonOutputPin(cs), MicroPythonOutputPin(dc),\n                                       MicroPythonOutputPin(res), MicroPythonPin(Pin(busy, Pin.IN)))\n        self._driver = UC8276CFull(connection)\n\n    def clear(self, color: int):\n        \"\"\"\n        label:\n            en: '%1 clear framebuffer color (0 black, 1 white, 2 red) %2'\n        params:\n            color:\n                name: color\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.clear(color)\n\n    def set_pixel(self, x: int, y: int, color: int):\n        \"\"\"\n        label:\n            en: '%1 set pixel x %2 y %3 color (0 black, 1 white, 2 red) %4'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n            y:\n                name: y\n                type: int\n                default: '0'\n                field: number\n            color:\n                name: color\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.set_pixel(x, y, color)\n\n    def draw_line(self, x0: int, y0: int, x1: int, y1: int, color: int):\n        \"\"\"\n        label:\n            en: '%1 draw line x0 %2 y0 %3 x1 %4 y1 %5 color (0 black, 1 white, 2 red) %6'\n        params:\n            x0:\n                name: x0\n                type: int\n                default: '0'\n                field: number\n            y0:\n                name: y0\n                type: int\n                default: '0'\n                field: number\n            x1:\n                name: x1\n                type: int\n                default: '10'\n                field: number\n            y1:\n                name: y1\n                type: int\n                default: '10'\n                field: number\n            color:\n                name: color\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        self._driver.draw_line(x0, y0, x1, y1, color)\n\n    def draw_rect(self, x: int, y: int, w: int, h: int, color: int, fill: int):\n        \"\"\"\n        label:\n            en: '%1 draw rectangle x %2 y %3 width %4 height %5 color (0 black, 1 white, 2 red) %6 fill (0/1) %7'\n        params:\n            x:\n                name: x\n                type: int\n                default: '0'\n                field: number\n            y:\n                name: y\n                type: int\n                default: '0'\n                field: number\n            w:\n                name: w\n                type: int\n                default: '10'\n                field: number\n            h:\n                name: h\n                type: int\n                default: '10'\n                field: number\n            color:\n                name: color\n                type: int\n                default: '0'\n                field: number\n            fill:\n                name: fill\n                type: int\n                default: '1'\n                field: number\n        \"\"\"\n        self._driver.draw_rect(x, y, w, h, color, bool(fill))\n\n    def show(self):\n        \"\"\"\n        label:\n            en: '%1 refresh panel (blocks about 17 s)'\n        \"\"\"\n        self._driver.show()\n\n    def sleep(self):\n        \"\"\"\n        label:\n            en: '%1 deep sleep'\n        \"\"\"\n        self._driver.sleep()\n",
  "version": "alpha2"
}
