  "uiflow2": {
    "jscode": "const CUSTOM_UC8276C_LANGUAGES = {\n  \"CUSTOM_UC8276C_INIT\": {\n    \"en\": \"%1 init SCK %2 MOSI %3 CS %4 DC %5 RES %6 BUSY %7\"\n  },\n  \"CUSTOM_UC8276C_CLEAR\": {\n    \"en\": \"%1 clear framebuffer color (0 black, 1 white, 2 red) %2\"\n  },\n  \"CUSTOM_UC8276C_SET_PIXEL\": {\n    \"en\": \"%1 set pixel x %2 y %3 color (0 black, 1 white, 2 red) %4\"\n  },\n  \"CUSTOM_UC8276C_DRAW_LINE\": {\n    \"en\": \"%1 draw line x0 %2 y0 %3 x1 %4 y1 %5 color (0 black, 1 white, 2 red) %6\"\n  },\n  \"CUSTOM_UC8276C_DRAW_RECT\": {\n    \"en\": \"%1 draw rectangle x %2 y %3 width %4 height %5 color (0 black, 1 white, 2 red) %6 fill (0/1) %7\"\n  },\n  \"CUSTOM_UC8276C_SHOW\": {\n    \"en\": \"%1 refresh panel (blocks about 17 s)\"\n  },\n  \"CUSTOM_UC8276C_SLEEP\": {\n    \"en\": \"%1 deep sleep\"\n  }\n};\n\nconst initType = 'custom_uc8276c_init';\nBlockly.BlockRegExpList['custom_uc8276c'] = {\n  regexp: new RegExp(/^custom_uc8276c_/),\n  code: \"from UC8276C import UC8276C\",\n  initBlockType: initType,\n  categoryId: 'custom_uc8276c',\n}\nBlockly.utils.registerLanguages(CUSTOM_UC8276C_LANGUAGES)\n\nBlockly.Msg.CUSTOM_UC8276C_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_UC8276C = 'UC8276C'\n\nBlockly.utils.getcustom_uc8276cOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['uc8276c_0', 'uc8276c_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_uc8276c_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC8276C_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_uc8276cOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'uc8276c_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'sck'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mosi'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs'\n        },\n        {\n          'type': 'input_value',\n          'name': 'dc'\n        },\n        {\n          'type': 'input_value',\n          'name': 'res'\n        },\n        {\n          'type': 'input_value',\n          'name': 'busy'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc8276c_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var sck = Blockly.Python.valueToCode(block, 'sck', Blockly.Python.ORDER_FUNCTION_CALL);\n  var mosi = Blockly.Python.valueToCode(block, 'mosi', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs = Blockly.Python.valueToCode(block, 'cs', Blockly.Python.ORDER_FUNCTION_CALL);\n  var dc = Blockly.Python.valueToCode(block, 'dc', Blockly.Python.ORDER_FUNCTION_CALL);\n  var res = Blockly.Python.valueToCode(block, 'res', Blockly.Python.ORDER_FUNCTION_CALL);\n  var busy = Blockly.Python.valueToCode(block, 'busy', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = UC8276C(${sck}, ${mosi}, ${cs}, ${dc}, ${res}, ${busy})\\n`\n}\n\nBlockly.Blocks[\"custom_uc8276c_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC8276C_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc8276cOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'color'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc8276c_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.clear(${color})\\n`\n}\n\nBlockly.Blocks[\"custom_uc8276c_set_pixel\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC8276C_SET_PIXEL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc8276cOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        {\n          'type': 'input_value',\n          'name': 'color'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc8276c_set_pixel\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_pixel(${x}, ${y}, ${color})\\n`\n}\n\nBlockly.Blocks[\"custom_uc8276c_draw_line\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC8276C_DRAW_LINE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc8276cOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'x0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'x1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y1'\n        },\n        {\n          'type': 'input_value',\n          'name': 'color'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc8276c_draw_line\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x0 = Blockly.Python.valueToCode(block, 'x0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y0 = Blockly.Python.valueToCode(block, 'y0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var x1 = Blockly.Python.valueToCode(block, 'x1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y1 = Blockly.Python.valueToCode(block, 'y1', Blockly.Python.ORDER_FUNCTION_CALL);\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.draw_line(${x0}, ${y0}, ${x1}, ${y1}, ${color})\\n`\n}\n\nBlockly.Blocks[\"custom_uc8276c_draw_rect\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC8276C_DRAW_RECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc8276cOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'x'\n        },\n        {\n          'type': 'input_value',\n          'name': 'y'\n        },\n        {\n          'type': 'input_value',\n          'name': 'w'\n        },\n        {\n          'type': 'input_value',\n          'name': 'h'\n        },\n        {\n          'type': 'input_value',\n          'name': 'color'\n        },\n        {\n          'type': 'input_value',\n          'name': 'fill'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc8276c_draw_rect\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var x = Blockly.Python.valueToCode(block, 'x', Blockly.Python.ORDER_FUNCTION_CALL);\n  var y = Blockly.Python.valueToCode(block, 'y', Blockly.Python.ORDER_FUNCTION_CALL);\n  var w = Blockly.Python.valueToCode(block, 'w', Blockly.Python.ORDER_FUNCTION_CALL);\n  var h = Blockly.Python.valueToCode(block, 'h', Blockly.Python.ORDER_FUNCTION_CALL);\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL);\n  var fill = Blockly.Python.valueToCode(block, 'fill', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.draw_rect(${x}, ${y}, ${w}, ${h}, ${color}, ${fill})\\n`\n}\n\nBlockly.Blocks[\"custom_uc8276c_show\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC8276C_SHOW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc8276cOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc8276c_show\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.show()\\n`\n}\n\nBlockly.Blocks[\"custom_uc8276c_sleep\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_UC8276C_SLEEP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_uc8276cOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_uc8276c_sleep\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.sleep()\\n`\n}\n",
    "toolbox": "\n<category name=\"UC8276C\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_uc8276c\">\n<title text=\"UC8276C\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_uc8276c_init\">\n  <value name=\"sck\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">18</field>\n    </shadow>\n  </value>\n  <value name=\"mosi\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">19</field>\n    </shadow>\n  </value>\n  <value name=\"cs\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">17</field>\n    </shadow>\n  </value>\n  <value name=\"dc\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">20</field>\n    </shadow>\n  </value>\n  <value name=\"res\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">21</field>\n    </shadow>\n  </value>\n  <value name=\"busy\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">22</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_uc8276c_clear\">\n  <value name=\"color\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_uc8276c_set_pixel\">\n  <value name=\"x\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"y\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"color\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_uc8276c_draw_line\">\n  <value name=\"x0\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"y0\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"x1\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10</field>\n    </shadow>\n  </value>\n  <value name=\"