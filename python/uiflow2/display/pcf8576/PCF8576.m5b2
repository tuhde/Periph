  "uiflow2": {
    "jscode": "const CUSTOM_PCF8576_LANGUAGES = {\n  \"CUSTOM_PCF8576_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_PCF8576_CLEAR\": {\n    \"en\": \"%1 clear display\"\n  },\n  \"CUSTOM_PCF8576_SET_DIGIT\": {\n    \"en\": \"%1 set digit position %2 segments %3\"\n  }\n};\n\nconst initType = 'custom_pcf8576_init';\nBlockly.BlockRegExpList['custom_pcf8576'] = {\n  regexp: new RegExp(/^custom_pcf8576_/),\n  code: \"from PCF8576 import PCF8576\",\n  initBlockType: initType,\n  categoryId: 'custom_pcf8576',\n}\nBlockly.utils.registerLanguages(CUSTOM_PCF8576_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PCF8576_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_PCF8576 = 'PCF8576'\n\nBlockly.utils.getcustom_pcf8576Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pcf8576_0', 'pcf8576_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_pcf8576_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8576_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pcf8576Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pcf8576_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8576_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = PCF8576(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8576_clear\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8576_CLEAR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8576Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8576_clear\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.clear()\\n`\n}\n\nBlockly.Blocks[\"custom_pcf8576_set_digit\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCF8576_SET_DIGIT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pcf8576Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'position'\n        },\n        {\n          'type': 'input_value',\n          'name': 'segments'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pcf8576_set_digit\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var position = Blockly.Python.valueToCode(block, 'position', Blockly.Python.ORDER_FUNCTION_CALL);\n  var segments = Blockly.Python.valueToCode(block, 'segments', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_digit(${position}, ${segments})\\n`\n}\n",
    "toolbox": "\n<category name=\"PCF8576\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_pcf8576\"><title text=\"PCF8576\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_pcf8576_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_pcf8576_clear\"/><block type=\"custom_pcf8576_set_digit\">\n  <value name=\"position\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"segments\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
