    "jscode": "const CUSTOM_ISL29125_LANGUAGES = {\n  \"CUSTOM_ISL29125_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_ISL29125_READ_RED\": {\n    \"en\": \"%1 red count\"\n  },\n  \"CUSTOM_ISL29125_READ_GREEN\": {\n    \"en\": \"%1 green count\"\n  },\n  \"CUSTOM_ISL29125_READ_BLUE\": {\n    \"en\": \"%1 blue count\"\n  },\n  \"CUSTOM_ISL29125_DATA_READY\": {\n    \"en\": \"%1 conversion done\"\n  },\n  \"CUSTOM_ISL29125_SET_MODE\": {\n    \"en\": \"%1 set mode %2 (0 power down, 1 green, 2 red, 3 blue, 4 standby, 5 RGB, 6 green+red, 7 green+blue)\"\n  },\n  \"CUSTOM_ISL29125_SET_RANGE\": {\n    \"en\": \"%1 set range lux %2\"\n  },\n  \"CUSTOM_ISL29125_SET_RESOLUTION\": {\n    \"en\": \"%1 set resolution bits %2\"\n  },\n  \"CUSTOM_ISL29125_SET_SYNC\": {\n    \"en\": \"%1 set external sync %2 (1 = INT starts conversion)\"\n  },\n  \"CUSTOM_ISL29125_SET_IR_COMPENSATION\": {\n    \"en\": \"%1 set IR compensation offset %2 adjust %3\"\n  },\n  \"CUSTOM_ISL29125_SET_THRESHOLDS\": {\n    \"en\": \"%1 set thresholds low %2 high %3\"\n  },\n  \"CUSTOM_ISL29125_SET_INTERRUPT_CHANNEL\": {\n    \"en\": \"%1 set interrupt channel %2 (0 none, 1 green, 2 red, 3 blue)\"\n  },\n  \"CUSTOM_ISL29125_SET_PERSISTENCE\": {\n    \"en\": \"%1 set persistence %2\"\n  },\n  \"CUSTOM_ISL29125_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt %2 (1 conversion, 0 threshold)\"\n  },\n  \"CUSTOM_ISL29125_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt %2 (1 conversion, 0 threshold)\"\n  },\n  \"CUSTOM_ISL29125_STATUS\": {\n    \"en\": \"%1 status byte\"\n  },\n  \"CUSTOM_ISL29125_DEVICE_ID\": {\n    \"en\": \"%1 device ID\"\n  },\n  \"CUSTOM_ISL29125_SOFT_RESET\": {\n    \"en\": \"%1 software reset\"\n  }\n};\n\nconst initType = 'custom_isl29125_init';\nBlockly.BlockRegExpList['custom_isl29125'] = {\n  regexp: new RegExp(/^custom_isl29125_/),\n  code: \"from Isl29125 import Isl29125\",\n  initBlockType: initType,\n  categoryId: 'custom_isl29125',\n}\nBlockly.utils.registerLanguages(CUSTOM_ISL29125_LANGUAGES)\n\nBlockly.Msg.CUSTOM_ISL29125_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_ISL29125 = 'Isl29125'\n\nBlockly.utils.getcustom_isl29125Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['isl29125_0', 'isl29125_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_isl29125_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ISL29125_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_isl29125Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'isl29125_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_isl29125_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = Isl29125(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_isl29125_read_red\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ISL29125_READ_RED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_isl29125Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_isl29125_read_red\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_red()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_isl29125_read_green\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ISL29125_READ_GREEN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_isl29125Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_isl29125_read_green\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_green()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_isl29125_read_blue\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ISL29125_READ_BLUE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_isl29125Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_isl29125_read_blue\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_blue()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_isl29125_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ISL29125_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          