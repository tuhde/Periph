    "toolbox": "\n<category name=\"Isl29125\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_isl29125\">\n<title text=\"Isl29125\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_isl29125_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">68</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_read_red\"/><block type=\"custom_isl29125_read_green\"/><block type=\"custom_isl29125_read_blue\"/><block type=\"custom_isl29125_data_ready\"/><block type=\"custom_isl29125_set_mode\">\n  <value name=\"mode\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_set_range\">\n  <value name=\"lux\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10000</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_set_resolution\">\n  <value name=\"bits\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">16</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_set_sync\">\n  <value name=\"external\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_set_ir_compensation\">\n  <value name=\"offset\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"adjust\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">63</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_set_thresholds\">\n  <value name=\"low\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"high\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">65535</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_set_interrupt_channel\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_set_persistence\">\n  <value name=\"count\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_enable_interrupt\">\n  <value name=\"source\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_disable_interrupt\">\n  <value name=\"source\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_isl29125_status\"/><block type=\"custom_isl29125_device_id\"/><block type=\"custom_isl29125_soft_reset\"/>\n</category>\n",
