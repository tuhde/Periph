{
  "category": "HY3131",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_HY3131_LANGUAGES = {\n  \"CUSTOM_HY3131_INIT\": {\n    \"en\": \"%1 init SPI bus %2 CS pin %3 REFO (V) %4\"\n  },\n  \"CUSTOM_HY3131_READ_RAW\": {\n    \"en\": \"%1 read AD1 raw code\"\n  },\n  \"CUSTOM_HY3131_READ_VOLTAGE\": {\n    \"en\": \"%1 read AD1 voltage (V)\"\n  },\n  \"CUSTOM_HY3131_DATA_READY\": {\n    \"en\": \"%1 AD1 data ready?\"\n  },\n  \"CUSTOM_HY3131_CONFIGURE_AD1\": {\n    \"en\": \"%1 configure AD1 osr (0-7) %2 chop (0-3) %3 input gain (0-3) %4 ref gain (0-1) %5 offset (0-7) %6 buffers (0-15) %7\"\n  },\n  \"CUSTOM_HY3131_SET_AD1_INPUT\": {\n    \"en\": \"%1 set AD1 input pos (0-15) %2 neg (0-7) %3 filter R (0-3) %4\"\n  },\n  \"CUSTOM_HY3131_SET_AD1_REFERENCE\": {\n    \"en\": \"%1 set AD1 reference high (0-6) %2 low (0-6) %3\"\n  },\n  \"CUSTOM_HY3131_READ_TEMPERATURE_CODE\": {\n    \"en\": \"%1 read temperature code\"\n  },\n  \"CUSTOM_HY3131_READ_TEMPERATURE\": {\n    \"en\": \"%1 temperature (°C) from code at 25 °C %2\"\n  },\n  \"CUSTOM_HY3131_ENABLE_AD2\": {\n    \"en\": \"%1 enable AD2 osr (0-7) %2 input gain (0-3) %3 source (0-3) %4\"\n  },\n  \"CUSTOM_HY3131_READ_AD2_RAW\": {\n    \"en\": \"%1 read AD2 raw code\"\n  },\n  \"CUSTOM_HY3131_ENABLE_LPF\": {\n    \"en\": \"%1 enable low-pass filter bw (0-7) %2\"\n  },\n  \"CUSTOM_HY3131_READ_LPF_RAW\": {\n    \"en\": \"%1 read LPF raw code\"\n  },\n  \"CUSTOM_HY3131_ENABLE_RMS\": {\n    \"en\": \"%1 enable RMS converter\"\n  },\n  \"CUSTOM_HY3131_READ_RMS\": {\n    \"en\": \"%1 read RMS (LSB)\"\n  },\n  \"CUSTOM_HY3131_ENABLE_PEAK_HOLD\": {\n    \"en\": \"%1 enable peak hold source (0-3) %2\"\n  },\n  \"CUSTOM_HY3131_READ_PEAK_MIN\": {\n    \"en\": \"%1 peak minimum code\"\n  },\n  \"CUSTOM_HY3131_READ_PEAK_MAX\": {\n    \"en\": \"%1 peak maximum code\"\n  },\n  \"CUSTOM_HY3131_START_COUNTER\": {\n    \"en\": \"%1 start frequency counter gate preload (0-65535) %2\"\n  },\n  \"CUSTOM_HY3131_READ_FLAGS\": {\n    \"en\": \"%1 read INTF flags\"\n  },\n  \"CUSTOM_HY3131_ENABLE_INTERRUPTS\": {\n    \"en\": \"%1 enable interrupts mask (0-31) %2\"\n  },\n  \"CUSTOM_HY3131_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_hy3131_init';\nBlockly.BlockRegExpList['custom_hy3131'] = {\n  regexp: new RegExp(/^custom_hy3131_/),\n  code: \"from HY3131 import HY3131\",\n  initBlockType: initType,\n  categoryId: 'custom_hy3131',\n}\nBlockly.utils.registerLanguages(CUSTOM_HY3131_LANGUAGES)\n\nBlockly.Msg.CUSTOM_HY3131_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_HY3131 = 'HY3131'\n\nBlockly.utils.getcustom_hy3131Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['hy3131_0', 'hy3131_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_hy3131_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_hy3131Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'hy3131_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'vref'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var vref = Blockly.Python.valueToCode(block, 'vref', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = HY3131(${bus}, ${cs_pin}, ${vref})\\n`\n}\n\nBlockly.Blocks[\"custom_hy3131_read_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_READ_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_read_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hy3131_read_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_READ_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_read_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hy3131_data_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_DATA_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_data_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.data_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hy3131_configure_ad1\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_CONFIGURE_AD1,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'osr'\n        },\n        {\n          'type': 'input_value',\n          'name': 'chop'\n        },\n        {\n          'type': 'input_value',\n          'name': 'input_gain'\n        },\n        {\n          'type': 'input_value',\n          'name': 'ref_gain'\n        },\n        {\n          'type': 'input_value',\n          'name': 'offset'\n        },\n        {\n          'type': 'input_value',\n          'name': 'buffers'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_configure_ad1\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var osr = Blockly.Python.valueToCode(block, 'osr', Blockly.Python.ORDER_FUNCTION_CALL);\n  var chop = Blockly.Python.valueToCode(block, 'chop', Blockly.Python.ORDER_FUNCTION_CALL);\n  var input_gain = Blockly.Python.valueToCode(block, 'input_gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  var ref_gain = Blockly.Python.valueToCode(block, 'ref_gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  var offset = Blockly.Python.valueToCode(block, 'offset', Blockly.Python.ORDER_FUNCTION_CALL);\n  var buffers = Blockly.Python.valueToCode(block, 'buffers', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure_ad1(${osr}, ${chop}, ${input_gain}, ${ref_gain}, ${offset}, ${buffers})\\n`\n}\n\nBlockly.Blocks[\"custom_hy3131_set_ad1_input\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_SET_AD1_INPUT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'pos'\n        },\n        {\n          'type': 'input_value',\n          'name': 'neg'\n        },\n        {\n          'type': 'input_value',\n          'name': 'filter_r'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_set_ad1_input\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var pos = Blockly.Python.valueToCode(block, 'pos', Blockly.Python.ORDER_FUNCTION_CALL);\n  var neg = Blockly.Python.valueToCode(block, 'neg', Blockly.Python.ORDER_FUNCTION_CALL);\n  var filter_r = Blockly.Python.valueToCode(block, 'filter_r', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_ad1_input(${pos}, ${neg}, ${filter_r})\\n`\n}\n\nBlockly.Blocks[\"custom_hy3131_set_ad1_reference\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_SET_AD1_REFERENCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'high'\n        },\n        {\n          'type': 'input_value',\n          'name': 'low'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_set_ad1_reference\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var high = Blockly.Python.valueToCode(block, 'high', Blockly.Python.ORDER_FUNCTION_CALL);\n  var low = Blockly.Python.valueToCode(block, 'low', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_ad1_reference(${high}, ${low})\\n`\n}\n\nBlockly.Blocks[\"custom_hy3131_read_temperature_code\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_READ_TEMPERATURE_CODE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_read_temperature_code\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature_code()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hy3131_read_temperature\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HY3131_READ_TEMPERATURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hy3131Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'tcode_25'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hy3131_read_temperature\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var tcode_25 = Blockly.Python.valueToCode(block, 'tcode_25', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_temperature(${tcode_25})`, Blockly.Pyth