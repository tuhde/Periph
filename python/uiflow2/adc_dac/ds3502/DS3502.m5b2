s0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3502Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'v_high'\n        },\n        {\n          'type': 'input_value',\n          'name': 'v_low'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3502_set_endpoints\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var v_high = Blockly.Python.valueToCode(block, 'v_high', Blockly.Python.ORDER_FUNCTION_CALL);\n  var v_low = Blockly.Python.valueToCode(block, 'v_low', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_endpoints(${v_high}, ${v_low})\\n`\n}\n",
    "toolbox": "\n<category name=\"DS3502\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ds3502\">\n<title text=\"DS3502\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ds3502_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">40</field>\n    </shadow>\n  </value>\n  <value name=\"v_high\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.0</field>\n    </shadow>\n  </value>\n  <value name=\"v_low\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ds3502_set_wiper\">\n  <value name=\"code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">64</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ds3502_get_wiper\"/><block type=\"custom_ds3502_set_voltage\">\n  <value name=\"volts\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ds3502_get_voltage\"/><block type=\"custom_ds3502_set_ratio\">\n  <value name=\"ratio\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ds3502_get_ratio\"/><block type=\"custom_ds3502_get_resistance_low\"/><block type=\"custom_ds3502_get_resistance_high\"/><block type=\"custom_ds3502_increment\">\n  <value name=\"steps\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ds3502_store_wiper\">\n  <value name=\"code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">64</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ds3502_set_mode\">\n  <value name=\"eeprom\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </sha