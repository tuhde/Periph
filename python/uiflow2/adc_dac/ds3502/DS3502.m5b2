    "jscode": "const CUSTOM_DS3502_LANGUAGES = {\n  \"CUSTOM_DS3502_INIT\": {\n    \"en\": \"%1 init bus %2 address %3 RH (V) %4 RL (V) %5\"\n  },\n  \"CUSTOM_DS3502_SET_WIPER\": {\n    \"en\": \"%1 set wiper code (0-127) %2\"\n  },\n  \"CUSTOM_DS3502_GET_WIPER\": {\n    \"en\": \"%1 wiper code\"\n  },\n  \"CUSTOM_DS3502_SET_VOLTAGE\": {\n    \"en\": \"%1 set output voltage (V) %2\"\n  },\n  \"CUSTOM_DS3502_GET_VOLTAGE\": {\n    \"en\": \"%1 output voltage (V)\"\n  },\n  \"CUSTOM_DS3502_SET_RATIO\": {\n    \"en\": \"%1 set ratio (0-1) %2\"\n  },\n  \"CUSTOM_DS3502_GET_RATIO\": {\n    \"en\": \"%1 ratio\"\n  },\n  \"CUSTOM_DS3502_GET_RESISTANCE_LOW\": {\n    \"en\": \"%1 wiper-to-RL resistance (ohm)\"\n  },\n  \"CUSTOM_DS3502_GET_RESISTANCE_HIGH\": {\n    \"en\": \"%1 wiper-to-RH resistance (ohm)\"\n  },\n  \"CUSTOM_DS3502_INCREMENT\": {\n    \"en\": \"%1 step wiper steps %2\"\n  },\n  \"CUSTOM_DS3502_STORE_WIPER\": {\n    \"en\": \"%1 store wiper code in EEPROM %2\"\n  },\n  \"CUSTOM_DS3502_SET_MODE\": {\n    \"en\": \"%1 EEPROM-backed writes (1 = yes) %2\"\n  },\n  \"CUSTOM_DS3502_GET_MODE\": {\n    \"en\": \"%1 EEPROM-backed writes\"\n  },\n  \"CUSTOM_DS3502_WAIT_READY\": {\n    \"en\": \"%1 wait until ready timeout (ms) %2\"\n  },\n  \"CUSTOM_DS3502_SET_ENDPOINTS\": {\n    \"en\": \"%1 set RH (V) %2 RL (V) %3\"\n  }\n};\n\nconst initType = 'custom_ds3502_init';\nBlockly.BlockRegExpList['custom_ds3502'] = {\n  regexp: new RegExp(/^custom_ds3502_/),\n  code: \"from DS3502 import DS3502\",\n  initBlockType: initType,\n  categoryId: 'custom_ds3502',\n}\nBlockly.utils.registerLanguages(CUSTOM_DS3502_LANGUAGES)\n\nBlockly.Msg.CUSTOM_DS3502_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_DS3502 = 'DS3502'\n\nBlockly.utils.getcustom_ds3502Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ds3502_0', 'ds3502_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ds3502_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3502_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ds3502Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ds3502_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'v_high'\n        },\n        {\n          'type': 'input_value',\n          'name': 'v_low'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3502_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var v_high = Blockly.Python.valueToCode(block, 'v_high', Blockly.Python.ORDER_FUNCTION_CALL);\n  var v_low = Blockly.Python.valueToCode(block, 'v_low', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = DS3502(${bus}, ${address}, ${v_high}, ${v_low})\\n`\n}\n\nBlockly.Blocks[\"custom_ds3502_set_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3502_SET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3502Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'code'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3502_set_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var code = Blockly.Python.valueToCode(block, 'code', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_wiper(${code})\\n`\n}\n\nBlockly.Blocks[\"custom_ds3502_get_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3502_GET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3502Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3502_get_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_wiper()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ds3502_set_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_DS3502_SET_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ds3502Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'volts'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ds3502_set_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var volts = Blockly.Python.valueToCode(block, 'volts', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_voltage(${volts})\\n`\n}\