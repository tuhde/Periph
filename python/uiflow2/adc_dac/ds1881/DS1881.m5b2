  "pyCode": "\"\"\"\nfile     DS1881\ntime     2026-11-12\nauthor\nemail\nlicense  Apache License 2.0\n\"\"\"\n\nfrom periph.connection.i2c_auto import I2CConnection\nfrom periph.chips.adc_dac.ds1881 import DS1881Full\n\n\nclass DS1881:\n    \"\"\"\n    note:\n        en: ''\n    details:\n        color: '#C084FC'\n        link: https://github.com/tuhde/Periph\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, bus: int = 0):\n        \"\"\"\n        label:\n            en: '%1 init bus %2'\n        params:\n            bus:\n                name: bus\n                type: int\n                default: '0'\n                field: number\n        \"\"\"\n        connection = I2CConnection(0x28, bus=bus)\n        self._driver = DS1881Full(connection)\n        self._driver.init()\n\n    def set_attenuation(self, channel: int, db: float):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            channel:\n                name: channel\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n            db:\n                name: db\n                type: float\n                default: '10.0'\n                field: number\n        \"\"\"\n        self._driver.set_attenuation(channel, db)\n\n    def get_attenuation(self, channel: int) -> float:\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            channel:\n                name: channel\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        return self._driver.get_attenuation(channel)\n\n    def mute(self, channel: int):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            channel:\n                name: channel\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        self._driver.mute(channel)\n\n    def set_position(self, channel: int, position: int):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            channel:\n                name: channel\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n            position:\n                name: position\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '63'\n        \"\"\"\n        self._driver.set_position(channel, position)\n\n    def get_position(self, channel: int) -> int:\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            channel:\n                name: channel\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        return self._driver.get_position(channel)\n\n    def set_both(self, position0: int, position1: int):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            position0:\n                name: position0\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '63'\n            position1:\n                name: position1\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '63'\n        \"\"\"\n        self._driver.set_both(position0, position1)\n\n    def set_attenuation_both(self, db0: float, db1: float):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            db0:\n                name: db0\n                type: float\n                default: '10.0'\n                field: number\n            db1:\n                name: db1\n                type: float\n                default: '10.0'\n                field: number\n        \"\"\"\n        self._driver.set_attenuation_both(db0, db1)\n\n    def set_option(self, option: int):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            option:\n                name: option\n                type: int\n                default: '1'\n                field: number\n                min: '1'\n                max: '2'\n        \"\"\"\n        self._driver.set_option(option)\n\n    def set_zero_crossing(self, enabled: int):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            enabled:\n                name: enabled\n                type: int\n                default: '1'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        self._driver.set_zero_crossing(bool(enabled))\n\n    def set_nonvolatile(self, enabled: int):\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            enabled:\n                name: enabled\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '1'\n        \"\"\"\n        self._driver.set_nonvolatile(bool(enabled))\n\n    def store(self):\n        \"\"\"\n        label:\n            en: '{lab}'\n        \"\"\"\n        self._driver.store()\n\n    def position_to_db(self, position: int) -> float:\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            position:\n                name: position\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '63'\n        \"\"\"\n        return self._driver.position_to_db(position)\n\n    def db_to_position(self, db: float) -> int:\n        \"\"\"\n        label:\n            en: '{lab}'\n        params:\n            db:\n                name: db\n                type: float\n                default: '10.0'\n                field: number\n        \"\"\"\n        return self._driver.db_to_position(db)\n\n    def max_position(self) -> int:\n        \"\"\"\n        label:\n            en: '{lab}'\n        \"\"\"\n        return self._driver.max_position()\n\n    def reset(self):\n        \"\"\"\n        label:\n            en: '{lab}'\n        \"\"\"\n        self._driver.reset()\n",
  "version": "alpha2"
}
