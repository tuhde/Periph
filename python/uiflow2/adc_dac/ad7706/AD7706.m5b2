    "jscode": "const CUSTOM_AD7706_LANGUAGES = {\n  \"CUSTOM_AD7706_INIT\": {\n    \"en\": \"%1 init SPI bus %2 CS pin %3 Vref (V) %4 MCLK (Hz) %5\"\n  },\n  \"CUSTOM_AD7706_CONFIGURE\": {\n    \"en\": \"%1 configure channel %2 gain %3 bipolar %4 buffered %5 output_rate_hz %6\"\n  },\n  \"CUSTOM_AD7706_READ_RAW\": {\n    \"en\": \"%1 read raw (channel %2)\"\n  },\n  \"CUSTOM_AD7706_READ_VOLTAGE\": {\n    \"en\": \"%1 read voltage V (channel %2)\"\n  },\n  \"CUSTOM_AD7706_SELF_CALIBRATE\": {\n    \"en\": \"%1 self_calibrate channel %2\"\n  },\n  \"CUSTOM_AD7706_SYSTEM_CALIBRATE_ZERO\": {\n    \"en\": \"%1 system calibrate zero channel %2\"\n  },\n  \"CUSTOM_AD7706_SYSTEM_CALIBRATE_FULL\": {\n    \"en\": \"%1 system calibrate full channel %2\"\n  },\n  \"CUSTOM_AD7706_GET_OFFSET_CALIBRATION\": {\n    \"en\": \"%1 get offset cal (channel %2)\"\n  },\n  \"CUSTOM_AD7706_SET_OFFSET_CALIBRATION\": {\n    \"en\": \"%1 set offset cal channel %2 value %3\"\n  },\n  \"CUSTOM_AD7706_GET_GAIN_CALIBRATION\": {\n    \"en\": \"%1 get gain cal (channel %2)\"\n  },\n  \"CUSTOM_AD7706_SET_GAIN_CALIBRATION\": {\n    \"en\": \"%1 set gain cal channel %2 value %3\"\n  },\n  \"CUSTOM_AD7706_STANDBY\": {\n    \"en\": \"%1 standby\"\n  },\n  \"CUSTOM_AD7706_WAKEUP\": {\n    \"en\": \"%1 wakeup\"\n  },\n  \"CUSTOM_AD7706_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_ad7706_init';\nBlockly.BlockRegExpList['custom_ad7706'] = {\n  regexp: new RegExp(/^custom_ad7706_/),\n  code: \"from AD7706 import AD7706\",\n  initBlockType: initType,\n  categoryId: 'custom_ad7706',\n}\nBlockly.utils.registerLanguages(CUSTOM_AD7706_LANGUAGES)\n\nBlockly.Msg.CUSTOM_AD7706_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_AD7706 = 'AD7706'\n\nBlockly.utils.getcustom_ad7706Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ad7706_0', 'ad7706_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ad7706_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ad7706Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ad7706_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'cs_pin'\n        },\n        {\n          'type': 'input_value',\n          'name': 'vref'\n        },\n        {\n          'type': 'input_value',\n          'name': 'mclk_hz'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var cs_pin = Blockly.Python.valueToCode(block, 'cs_pin', Blockly.Python.ORDER_FUNCTION_CALL);\n  var vref = Blockly.Python.valueToCode(block, 'vref', Blockly.Python.ORDER_FUNCTION_CALL);\n  var mclk_hz = Blockly.Python.valueToCode(block, 'mclk_hz', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = AD7706(${bus}, ${cs_pin}, ${vref}, ${mclk_hz})\\n`\n}\n\nBlockly.Blocks[\"custom_ad7706_configure\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_CONFIGURE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'gain'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bipolar'\n        },\n        {\n          'type': 'input_value',\n          'name': 'buffered'\n        },\n        {\n          'type': 'input_value',\n          'name': 'output_rate_hz'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_configure\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var gain = Blockly.Python.valueToCode(block, 'gain', Blockly.Python.ORDER_FUNCTION_CALL);\n  var bipolar = Blockly.Python.valueToCode(block, 'bipolar', Blockly.Python.ORDER_FUNCTION_CALL);\n  var buffered = Blockly.Python.valueToCode(block, 'buffered', Blockly.Python.ORDER_FUNCTION_CALL);\n  var output_rate_hz = Blockly.Python.valueToCode(block, 'output_rate_hz', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.configure(${channel}, ${gain}, ${bipolar}, ${buffered}, ${output_rate_hz})\\n`\n}\n\nBlockly.Blocks[\"custom_ad7706_read_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_READ_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_read_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_raw(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ad7706_read_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_READ_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_read_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_voltage(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ad7706_self_calibrate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_SELF_CALIBRATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_self_calibrate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.self_calibrate(${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_ad7706_system_calibrate_zero\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_SYSTEM_CALIBRATE_ZERO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_system_calibrate_zero\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.system_calibrate_zero(${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_ad7706_system_calibrate_full\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_SYSTEM_CALIBRATE_FULL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_system_calibrate_full\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.system_calibrate_full(${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_ad7706_get_offset_calibration\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_GET_OFFSET_CALIBRATION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_get_offset_calibration\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_offset_calibration(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ad7706_set_offset_calibration\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD7706_SET_OFFSET_CALIBRATION,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad7706Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'value'\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad7706_set_offset_calibration\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var value = Blockly.Python.valueToCode(block, 'value', Blockly.Python.ORDER_FUNCTION_CALL);\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_offset_calibration(${value}, ${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_ad7706_get_gain_calibration\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_A