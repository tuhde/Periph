    "toolbox": "\n<category name=\"MCP4XXX\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mcp4xxx\">\n<title text=\"MCP4XXX\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mcp4xxx_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">88</field>\n    </shadow>\n  </value>\n  <value name=\"part\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4532</field>\n    </shadow>\n  </value>\n  <value name=\"r_ab\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10000.0</field>\n    </shadow>\n  </value>\n  <value name=\"hvc\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">-1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp4xxx_set_wiper\">\n  <value name=\"code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">64</field>\n    </shadow>\n  </value>\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp4xxx_get_wiper\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp4xxx_set_resistance\">\n  <value name=\"ohms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5000.0</field>\n    </shadow>\n  </value>\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp4xxx_get_resistance\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp4xxx_set_ratio\">\n  <value name=\"ratio\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </sha