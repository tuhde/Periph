{
  "category": "MCP4XXX",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_MCP4XXX_LANGUAGES = {\n  \"CUSTOM_MCP4XXX_INIT\": {\n    \"en\": \"%1 init bus %2 address (40-47 or 88-91) %3 part number (4531-4662) %4 RAB ohms %5 HVC pin GPIO (-1 none) %6\"\n  },\n  \"CUSTOM_MCP4XXX_SET_WIPER\": {\n    \"en\": \"%1 set wiper code %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_GET_WIPER\": {\n    \"en\": \"%1 wiper code (network 0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_SET_RESISTANCE\": {\n    \"en\": \"%1 set W-B resistance ohms %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_GET_RESISTANCE\": {\n    \"en\": \"%1 W-B resistance in ohms (network 0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_SET_RATIO\": {\n    \"en\": \"%1 set wiper ratio (0-1) %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_GET_RATIO\": {\n    \"en\": \"%1 wiper ratio (network 0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_GET_RESISTANCE_WA\": {\n    \"en\": \"%1 W-A resistance in ohms, potentiometer parts (network 0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_SET_RESISTANCE_WA\": {\n    \"en\": \"%1 set W-A resistance ohms, potentiometer parts %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_GET_RESISTANCE_STEP\": {\n    \"en\": \"%1 resistance of one step in ohms\"\n  },\n  \"CUSTOM_MCP4XXX_SET_BOTH\": {\n    \"en\": \"%1 set both wipers, dual parts, network 0 code %2 network 1 code %3\"\n  },\n  \"CUSTOM_MCP4XXX_INCREMENT\": {\n    \"en\": \"%1 increment wiper, returns new code, steps %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_DECREMENT\": {\n    \"en\": \"%1 decrement wiper, returns new code, steps %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_SHUTDOWN\": {\n    \"en\": \"%1 shutdown network (0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_RESUME\": {\n    \"en\": \"%1 resume network (0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_IS_SHUTDOWN\": {\n    \"en\": \"%1 network in shutdown? (0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_SET_TERMINALS\": {\n    \"en\": \"%1 connect terminals A (1/0) %2 W (1/0) %3 B (1/0) %4 network (0-1) %5\"\n  },\n  \"CUSTOM_MCP4XXX_GET_TCON\": {\n    \"en\": \"%1 raw TCON register\"\n  },\n  \"CUSTOM_MCP4XXX_SET_GENERAL_CALL\": {\n    \"en\": \"%1 General Call enabled (1/0) %2\"\n  },\n  \"CUSTOM_MCP4XXX_RESET\": {\n    \"en\": \"%1 reset to power-up state\"\n  },\n  \"CUSTOM_MCP4XXX_SET_RAB\": {\n    \"en\": \"%1 set resistance model RAB ohms %2 RW ohms %3\"\n  },\n  \"CUSTOM_MCP4XXX_WAIT_READY\": {\n    \"en\": \"%1 wait for EEPROM write, non-volatile parts, timeout ms %2\"\n  },\n  \"CUSTOM_MCP4XXX_GET_NV_WIPER\": {\n    \"en\": \"%1 EEPROM wiper, non-volatile parts (network 0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_SET_NV_WIPER\": {\n    \"en\": \"%1 set EEPROM wiper, non-volatile parts, code %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_STORE_WIPER\": {\n    \"en\": \"%1 store wiper in EEPROM, non-volatile parts, returns code (network 0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_READ_DATA\": {\n    \"en\": \"%1 EEPROM data register, non-volatile parts (index 0-9) %2\"\n  },\n  \"CUSTOM_MCP4XXX_WRITE_DATA\": {\n    \"en\": \"%1 write EEPROM data register, non-volatile parts, index (0-9) %2 value (0-511) %3\"\n  },\n  \"CUSTOM_MCP4XXX_IS_WIPER_LOCKED\": {\n    \"en\": \"%1 WiperLock active? non-volatile parts (network 0-1) %2\"\n  },\n  \"CUSTOM_MCP4XXX_IS_WRITE_PROTECTED\": {\n    \"en\": \"%1 EEPROM write protected? non-volatile parts\"\n  },\n  \"CUSTOM_MCP4XXX_SET_WIPER_LOCK\": {\n    \"en\": \"%1 set WiperLock, needs HVC pin, locked (1/0) %2 network (0-1) %3\"\n  },\n  \"CUSTOM_MCP4XXX_SET_WRITE_PROTECT\": {\n    \"en\": \"%1 set write protect, needs HVC pin, enabled (1/0) %2\"\n  }\n};\n\nconst initType = 'custom_mcp4xxx_init';\nBlockly.BlockRegExpList['custom_mcp4xxx'] = {\n  regexp: new RegExp(/^custom_mcp4xxx_/),\n  code: \"from MCP4XXX import MCP4XXX\",\n  initBlockType: initType,\n  categoryId: 'custom_mcp4xxx',\n}\nBlockly.utils.registerLanguages(CUSTOM_MCP4XXX_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MCP4XXX_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MCP4XXX = 'MCP4XXX'\n\nBlockly.utils.getcustom_mcp4xxxOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['mcp4xxx_0', 'mcp4xxx_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_mcp4xxxOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'mcp4xxx_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n        {\n          'type': 'input_value',\n          'name': 'part'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_ab'\n        },\n        {\n          'type': 'input_value',\n          'name': 'hvc'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  var part = Blockly.Python.valueToCode(block, 'part', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_ab = Blockly.Python.valueToCode(block, 'r_ab', Blockly.Python.ORDER_FUNCTION_CALL);\n  var hvc = Blockly.Python.valueToCode(block, 'hvc', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MCP4XXX(${bus}, ${address}, ${part}, ${r_ab}, ${hvc})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_set_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_SET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'code'\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_set_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var code = Blockly.Python.valueToCode(block, 'code', Blockly.Python.ORDER_FUNCTION_CALL);\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_wiper(${code}, ${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_get_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_GET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_get_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_wiper(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_set_resistance\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_SET_RESISTANCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'ohms'\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_set_resistance\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var ohms = Blockly.Python.valueToCode(block, 'ohms', Blockly.Python.ORDER_FUNCTION_CALL);\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resistance(${ohms}, ${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_get_resistance\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_GET_RESISTANCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_get_resistance\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_resistance(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_set_ratio\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_SET_RATIO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'ratio'\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_set_ratio\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var ratio = Blockly.Python.valueToCode(block, 'ratio', Blockly.Python.ORDER_FUNCTION_CALL);\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_ratio(${ratio}, ${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_get_ratio\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_GET_RATIO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_get_ratio\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_ratio(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_get_resistance_wa\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_GET_RESISTANCE_WA,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_get_resistance_wa\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_resistance_wa(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_set_resistance_wa\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_SET_RESISTANCE_WA,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'ohms'\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_set_resistance_wa\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var ohms = Blockly.Python.valueToCode(block, 'ohms', Blockly.Python.ORDER_FUNCTION_CALL);\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resistance_wa(${ohms}, ${channel})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_get_resistance_step\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_GET_RESISTANCE_STEP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_get_resistance_step\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_resistance_step()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_set_both\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_SET_BOTH,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'code0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'code1'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_set_both\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var code0 = Blockly.Python.valueToCode(block, 'code0', Blockly.Python.ORDER_FUNCTION_CALL);\n  var code1 = Blockly.Python.valueToCode(block, 'code1', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_both(${code0}, ${code1})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_increment\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_INCREMENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'steps'\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_increment\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var steps = Blockly.Python.valueToCode(block, 'steps', Blockly.Python.ORDER_FUNCTION_CALL);\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.increment(${steps}, ${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_decrement\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_DECREMENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4xxxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'steps'\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4xxx_decrement\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var steps = Blockly.Python.valueToCode(block, 'steps', Blockly.Python.ORDER_FUNCTION_CALL);\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.decrement(${steps}, ${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_mcp4xxx_shutdown\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4XXX_SHUTDOWN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'op