    "source_external": "from periph.connection.i2c_auto import I2CConnection\nfrom periph.connection.output_pin import MicroPythonOutputPin\nfrom periph.chips.adc_dac.mcp4xxx import Mcp4xxxFull",
    "members": [
      {
        "name": "__init__",
        "note": {},
        "label": {
          "en": "%1 init bus %2 address (40-47 or 88-91) %3 part number (4531-4662) %4 RAB ohms %5 HVC pin GPIO (-1 none) %6"
        },
        "params": [
          {
            "name": "bus",
            "type": "int",
            "default": "0",
            "note": {},
            "field": "number"
          },
          {
            "name": "address",
            "type": "int",
            "default": "88",
            "note": {},
            "field": "number",
            "max": "95",
            "min": "40"
          },
          {
            "name": "part",
            "type": "int",
            "default": "4532",
            "note": {},
            "field": "number",
            "max": "4662",
            "min": "4531"
          },
          {
            "name": "r_ab",
            "type": "float",
            "default": "10000.0",
            "note": {},
            "field": "number"
          },
          {
            "name": "hvc",
            "type": "int",
            "default": "-1",
            "note": {},
            "field": "number"
          }
        ],
        "return": "",
        "source": "        connection = I2CConnection(address, bus=bus)\n        hvc_pin = MicroPythonOutputPin(hvc) if hvc >= 0 else None\n        self._driver = Mcp4xxxFull(connection, part='MCP%d' % part, r_ab=r_ab, hvc=hvc_pin)",
        "ast_return": {
          "code": null,
          "id": null
        },
        "doc_return": null
      },
