  "uiflow2": {
    "jscode": "const CUSTOM_ADS1014_LANGUAGES = {\n  \"CUSTOM_ADS1014_INIT\": {\n    \"en\": \"%1 init bus %2 address (72-75) %3\"\n  },\n  \"CUSTOM_ADS1014_READ_RAW\": {\n    \"en\": \"%1 raw code\"\n  },\n  \"CUSTOM_ADS1014_READ_VOLTAGE\": {\n    \"en\": \"%1 voltage (V)\"\n  },\n  \"CUSTOM_ADS1014_SET_GAIN\": {\n    \"en\": \"%1 set gain (0=6.144 V 1=4.096 V 2=2.048 V 3=1.024 V 4=0.512 V 5=0.256 V) %2\"\n  },\n  \"CUSTOM_ADS1014_GET_GAIN\": {\n    \"en\": \"%1 gain code\"\n  },\n  \"CUSTOM_ADS1014_FULL_SCALE\": {\n    \"en\": \"%1 full scale (V)\"\n  },\n  \"CUSTOM_ADS1014_LSB\": {\n    \"en\": \"%1 LSB (V)\"\n  },\n  \"CUSTOM_ADS1014_SET_DATA_RATE\": {\n    \"en\": \"%1 set data rate (0=128 1=250 2=490 3=920 4=1600 5=2400 6=3300 SPS) %2\"\n  },\n  \"CUSTOM_ADS1014_GET_DATA_RATE\": {\n    \"en\": \"%1 data rate code\"\n  },\n  \"CUSTOM_ADS1014_DATA_RATE_SPS\": {\n    \"en\": \"%1 data rate (SPS)\"\n  },\n  \"CUSTOM_ADS1014_START_CONTINUOUS\": {\n    \"en\": \"%1 start continuous\"\n  },\n  \"CUSTOM_ADS1014_READ_CONTINUOUS_RAW\": {\n    \"en\": \"%1 continuous raw code\"\n  },\n  \"CUSTOM_ADS1014_READ_CONTINUOUS\": {\n    \"en\": \"%1 continuous voltage (V)\"\n  },\n  \"CUSTOM_ADS1014_STOP_CONTINUOUS\": {\n    \"en\": \"%1 stop continuous\"\n  },\n  \"CUSTOM_ADS1014_IS_CONVERTING\": {\n    \"en\": \"%1 is converting\"\n  },\n  \"CUSTOM_ADS1014_READ_CONFIG\": {\n    \"en\": \"%1 CONFIG register\"\n  },\n  \"CUSTOM_ADS1014_RESET\": {\n    \"en\": \"%1 reset\"\n  },\n  \"CUSTOM_ADS1014_CONFIGURE_COMPARATOR\": {\n    \"en\": \"%1 configure comparator mode (0=traditional 1=window) %2 polarity (0=low 1=high) %3 latch (0/1) %4 queue (0/1/2 = 1/2/4 conversions) %5\"\n  },\n  \"CUSTOM_ADS1014_DISABLE_COMPARATOR\": {\n    \"en\": \"%1 disable comparator\"\n  },\n  \"CUSTOM_ADS1014_SET_LOW_THRESHOLD_RAW\": {\n    \"en\": \"%1 set low threshold code %2\"\n  },\n  \"CUSTOM_ADS1014_SET_HIGH_THRESHOLD_RAW\": {\n    \"en\": \"%1 set high threshold code %2\"\n  },\n  \"CUSTOM_ADS1014_SET_THRESHOLDS\": {\n    \"en\": \"%1 set thresholds low (V) %2 high (V) %3\"\n  },\n  \"CUSTOM_ADS1014_CLEAR_ALERT\": {\n    \"en\": \"%1 clear alert\"\n  },\n  \"CUSTOM_ADS1014_ENABLE_INTERRUPT\": {\n    \"en\": \"%1 enable interrupt (1=conversion ready 2=comparator) %2\"\n  },\n  \"CUSTOM_ADS1014_DISABLE_INTERRUPT\": {\n    \"en\": \"%1 disable interrupt (1=conversion ready 2=comparator) %2\"\n  },\n  \"CUSTOM_ADS1014_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status (1=ready 2=comparator)\"\n  }\n};\n\nconst initType = 'custom_ads1014_init';\nBlockly.BlockRegExpList['custom_ads1014'] = {\n  regexp: new RegExp(/^custom_ads1014_/),\n  code: \"from ADS1014 import ADS1014\",\n  initBlockType: initType,\n  categoryId: 'custom_ads1014',\n}\nBlockly.utils.registerLanguages(CUSTOM_ADS1014_LANGUAGES)\n\nBlockly.Msg.CUSTOM_ADS1014_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_ADS1014 = 'ADS1014'\n\nBlockly.utils.getcustom_ads1014Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ads1014_0', 'ads1014_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ads1014_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1014_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ads1014Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ads1014_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1014_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = ADS1014(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_ads1014_read_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1014_READ_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1014Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1014_read_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1014_read_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1014_READ_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1014Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1014_read_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1014_set_gain\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1014_SET_GAIN,\n      'args0': [\n        {\n          