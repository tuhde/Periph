    "jscode": "const CUSTOM_ADS1013_LANGUAGES = {\n  \"CUSTOM_ADS1013_INIT\": {\n    \"en\": \"%1 init bus %2 address (72-75) %3\"\n  },\n  \"CUSTOM_ADS1013_READ_RAW\": {\n    \"en\": \"%1 raw code\"\n  },\n  \"CUSTOM_ADS1013_READ_VOLTAGE\": {\n    \"en\": \"%1 voltage (V)\"\n  },\n  \"CUSTOM_ADS1013_FULL_SCALE\": {\n    \"en\": \"%1 full scale (V)\"\n  },\n  \"CUSTOM_ADS1013_LSB\": {\n    \"en\": \"%1 LSB (V)\"\n  },\n  \"CUSTOM_ADS1013_SET_DATA_RATE\": {\n    \"en\": \"%1 set data rate (0=128 1=250 2=490 3=920 4=1600 5=2400 6=3300 SPS) %2\"\n  },\n  \"CUSTOM_ADS1013_GET_DATA_RATE\": {\n    \"en\": \"%1 data rate code\"\n  },\n  \"CUSTOM_ADS1013_DATA_RATE_SPS\": {\n    \"en\": \"%1 data rate (SPS)\"\n  },\n  \"CUSTOM_ADS1013_START_CONTINUOUS\": {\n    \"en\": \"%1 start continuous\"\n  },\n  \"CUSTOM_ADS1013_READ_CONTINUOUS_RAW\": {\n    \"en\": \"%1 continuous raw code\"\n  },\n  \"CUSTOM_ADS1013_READ_CONTINUOUS\": {\n    \"en\": \"%1 continuous voltage (V)\"\n  },\n  \"CUSTOM_ADS1013_STOP_CONTINUOUS\": {\n    \"en\": \"%1 stop continuous\"\n  },\n  \"CUSTOM_ADS1013_IS_CONVERTING\": {\n    \"en\": \"%1 is converting\"\n  },\n  \"CUSTOM_ADS1013_READ_CONFIG\": {\n    \"en\": \"%1 CONFIG register\"\n  },\n  \"CUSTOM_ADS1013_RESET\": {\n    \"en\": \"%1 reset\"\n  }\n};\n\nconst initType = 'custom_ads1013_init';\nBlockly.BlockRegExpList['custom_ads1013'] = {\n  regexp: new RegExp(/^custom_ads1013_/),\n  code: \"from ADS1013 import ADS1013\",\n  initBlockType: initType,\n  categoryId: 'custom_ads1013',\n}\nBlockly.utils.registerLanguages(CUSTOM_ADS1013_LANGUAGES)\n\nBlockly.Msg.CUSTOM_ADS1013_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_ADS1013 = 'ADS1013'\n\nBlockly.utils.getcustom_ads1013Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ads1013_0', 'ads1013_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ads1013_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ads1013Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ads1013_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = ADS1013(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_ads1013_read_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_READ_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_read_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_read_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_READ_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_read_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_voltage()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_full_scale\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_FULL_SCALE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_full_scale\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.full_scale()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_lsb\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_LSB,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_lsb\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.lsb()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_set_data_rate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_SET_DATA_RATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'dr'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_set_data_rate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var dr = Blockly.Python.valueToCode(block, 'dr', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_data_rate(${dr})\\n`\n}\n\nBlockly.Blocks[\"custom_ads1013_get_data_rate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_GET_DATA_RATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_get_data_rate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_data_rate()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_data_rate_sps\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_DATA_RATE_SPS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_data_rate_sps\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.data_rate_sps()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_start_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_START_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_start_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.start_continuous()\\n`\n}\n\nBlockly.Blocks[\"custom_ads1013_read_continuous_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_READ_CONTINUOUS_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_read_continuous_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_continuous_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_read_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_READ_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_read_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_continuous()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_stop_continuous\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_STOP_CONTINUOUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_stop_continuous\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.stop_continuous()\\n`\n}\n\nBlockly.Blocks[\"custom_ads1013_is_converting\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_IS_CONVERTING,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ads1013_is_converting\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_converting()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ads1013_read_config\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_ADS1013_READ_CONFIG,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ads1013Options\n        },