    "toolbox": "\n<category name=\"ADS1013\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ads1013\">\n<title text=\"ADS1013\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ads1013_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">72</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ads1013_read_raw\"/><block type=\"custom_ads1013_read_voltage\"/><block type=\"custom_ads1013_full_scale\"/><block type=\"custom_ads1013_lsb\"/><block type=\"custom_ads1013_set_data_rate\">\n  <value name=\"dr\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">4</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ads1013_get_data_rate\"/><block type=\"custom_ads1013_data_rate_sps\"/><block type=\"custom_ads1013_start_continuous\"/><block type=\"custom_ads1013_read_continuous_raw\"/><block type=\"custom_ads1013_read_continuous\"/><block type=\"custom_ads1013_stop_continuous\"/><block type=\"custom_ads1013_is_converting\"/><block type=\"custom_ads1013_read_config\"/><block type=\"custom_ads1013_reset\"/>\n</category>\n",
