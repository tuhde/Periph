    "toolbox": "\n<category name=\"AD5243\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_ad5243\">\n<title text=\"AD5243\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_ad5243_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"r_ab\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10000.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ad5243_set_wiper\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">128</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ad5243_get_wiper\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ad5243_set_resistance\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"ohms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">5000.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ad5243_get_resistance\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ad5243_set_both\">\n  <value name=\"code1\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">128</field>\n    </shadow>\n  </value>\n  <value name=\"code2\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">128</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_ad5243_set_ratio\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"ratio\">\n    <shadow type=\"math_number\">\n     