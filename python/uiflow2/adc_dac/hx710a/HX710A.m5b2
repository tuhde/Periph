  "uiflow2": {
    "jscode": "const CUSTOM_HX710A_LANGUAGES = {\n  \"CUSTOM_HX710A_INIT\": {\n    \"en\": \"%1 init dout %2 pd_sck %3\"\n  },\n  \"CUSTOM_HX710A_IS_READY\": {\n    \"en\": \"%1 ready?\"\n  },\n  \"CUSTOM_HX710A_READ_RAW\": {\n    \"en\": \"%1 raw ADC value\"\n  },\n  \"CUSTOM_HX710A_SET_RATE\": {\n    \"en\": \"%1 set rate rate %2\"\n  },\n  \"CUSTOM_HX710A_READ_AVERAGE\": {\n    \"en\": \"%1 average of %2 readings\"\n  },\n  \"CUSTOM_HX710A_TARE\": {\n    \"en\": \"%1 tare (zero the scale)\"\n  },\n  \"CUSTOM_HX710A_GET_OFFSET\": {\n    \"en\": \"%1 tare offset\"\n  },\n  \"CUSTOM_HX710A_SET_SCALE\": {\n    \"en\": \"%1 set scale factor factor %2\"\n  },\n  \"CUSTOM_HX710A_GET_SCALE\": {\n    \"en\": \"%1 scale factor\"\n  },\n  \"CUSTOM_HX710A_READ_WEIGHT\": {\n    \"en\": \"%1 weight\"\n  },\n  \"CUSTOM_HX710A_READ_TEMPERATURE_RAW\": {\n    \"en\": \"%1 raw temperature code\"\n  },\n  \"CUSTOM_HX710A_POWER_DOWN\": {\n    \"en\": \"%1 power down\"\n  },\n  \"CUSTOM_HX710A_POWER_UP\": {\n    \"en\": \"%1 power up\"\n  }\n};\n\nconst initType = 'custom_hx710a_init';\nBlockly.BlockRegExpList['custom_hx710a'] = {\n  regexp: new RegExp(/^custom_hx710a_/),\n  code: \"from HX710A import HX710A\",\n  initBlockType: initType,\n  categoryId: 'custom_hx710a',\n}\nBlockly.utils.registerLanguages(CUSTOM_HX710A_LANGUAGES)\n\nBlockly.Msg.CUSTOM_HX710A_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_HX710A = 'HX710A'\n\nBlockly.utils.getcustom_hx710aOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['hx710a_0', 'hx710a_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_hx710a_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_hx710aOptions },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'hx710a_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'dout'\n        },\n        {\n          'type': 'input_value',\n          'name': 'pd_sck'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var dout = Blockly.Python.valueToCode(block, 'dout', Blockly.Python.ORDER_FUNCTION_CALL);\n  var pd_sck = Blockly.Python.valueToCode(block, 'pd_sck', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = HX710A(${dout}, ${pd_sck})\\n`\n}\n\nBlockly.Blocks[\"custom_hx710a_is_ready\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_IS_READY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_is_ready\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_ready()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hx710a_read_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_READ_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_read_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hx710a_set_rate\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_SET_RATE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'rate'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_set_rate\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var rate = Blockly.Python.valueToCode(block, 'rate', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_rate(${rate})\\n`\n}\n\nBlockly.Blocks[\"custom_hx710a_read_average\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_READ_AVERAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'times'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_read_average\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var times = Blockly.Python.valueToCode(block, 'times', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.read_average(${times})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hx710a_tare\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_TARE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_tare\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.tare()\\n`\n}\n\nBlockly.Blocks[\"custom_hx710a_get_offset\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_GET_OFFSET,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_get_offset\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_offset()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hx710a_set_scale\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_SET_SCALE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'factor'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_set_scale\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var factor = Blockly.Python.valueToCode(block, 'factor', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_scale(${factor})\\n`\n}\n\nBlockly.Blocks[\"custom_hx710a_get_scale\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_GET_SCALE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_get_scale\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_scale()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hx710a_read_weight\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_READ_WEIGHT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_read_weight\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_weight()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hx710a_read_temperature_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_READ_TEMPERATURE_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_read_temperature_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.read_temperature_raw()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_hx710a_power_down\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_POWER_DOWN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_power_down\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.power_down()\\n`\n}\n\nBlockly.Blocks[\"custom_hx710a_power_up\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_HX710A_POWER_UP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_hx710aOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_hx710a_power_up\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return `${varname}.power_up()\\n`\n}\n",
    "toolbox": "\n<category name=\"HX710A\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_hx710a\"><title text=\"HX710A\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_hx710a_init\">\n  <value name=\"dout\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"pd_sck\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_hx710a_is_ready\"/><block type=\"custom_hx710a_read_raw\"/><block type=\"custom_hx710a_set_rate\">\n  <value name=\"rate\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_hx710a_read_average\">\n  <value name=\"times\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">10</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_hx710a_tare\"/><block type=\"custom_hx710a_get_offset\"/><block type=\"custom_hx710a_set_scale\">\n  <value name=\"factor\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_hx710a_get_scale\"/><block type=\"custom_hx710a_read_weight\"/><block type=\"custom_hx710a_read_temperature_raw\"/><block type=\"custom_hx710a_power_down\"/><block type=\"custom_hx710a_power_up\"/>\n</category>\n",
