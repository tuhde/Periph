    "jscode": "const CUSTOM_CAT5171_LANGUAGES = {\n  \"CUSTOM_CAT5171_INIT\": {\n    \"en\": \"%1 init bus %2 RAB (ohm) %3\"\n  },\n  \"CUSTOM_CAT5171_SET_WIPER\": {\n    \"en\": \"%1 set wiper code (0-255) %2\"\n  },\n  \"CUSTOM_CAT5171_GET_WIPER\": {\n    \"en\": \"%1 wiper code\"\n  },\n  \"CUSTOM_CAT5171_SET_RESISTANCE\": {\n    \"en\": \"%1 set W-B resistance ohms %2\"\n  },\n  \"CUSTOM_CAT5171_GET_RESISTANCE\": {\n    \"en\": \"%1 W-B resistance (ohm)\"\n  },\n  \"CUSTOM_CAT5171_SET_RATIO\": {\n    \"en\": \"%1 set ratio (0-1) %2\"\n  },\n  \"CUSTOM_CAT5171_GET_RATIO\": {\n    \"en\": \"%1 ratio\"\n  },\n  \"CUSTOM_CAT5171_SET_RESISTANCE_WA\": {\n    \"en\": \"%1 set W-A resistance ohms %2\"\n  },\n  \"CUSTOM_CAT5171_GET_RESISTANCE_WA\": {\n    \"en\": \"%1 W-A resistance (ohm)\"\n  },\n  \"CUSTOM_CAT5171_INCREMENT\": {\n    \"en\": \"%1 step wiper steps %2\"\n  },\n  \"CUSTOM_CAT5171_MIDSCALE\": {\n    \"en\": \"%1 move to midscale\"\n  },\n  \"CUSTOM_CAT5171_SHUTDOWN\": {\n    \"en\": \"%1 shutdown\"\n  },\n  \"CUSTOM_CAT5171_RESUME\": {\n    \"en\": \"%1 resume\"\n  },\n  \"CUSTOM_CAT5171_IS_SHUTDOWN\": {\n    \"en\": \"%1 is shut down\"\n  },\n  \"CUSTOM_CAT5171_RESET\": {\n    \"en\": \"%1 reset to midscale\"\n  },\n  \"CUSTOM_CAT5171_SET_RAB\": {\n    \"en\": \"%1 set RAB (ohm) %2 RW (ohm) %3\"\n  }\n};\n\nconst initType = 'custom_cat5171_init';\nBlockly.BlockRegExpList['custom_cat5171'] = {\n  regexp: new RegExp(/^custom_cat5171_/),\n  code: \"from CAT5171 import CAT5171\",\n  initBlockType: initType,\n  categoryId: 'custom_cat5171',\n}\nBlockly.utils.registerLanguages(CUSTOM_CAT5171_LANGUAGES)\n\nBlockly.Msg.CUSTOM_CAT5171_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_CAT5171 = 'CAT5171'\n\nBlockly.utils.getcustom_cat5171Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['cat5171_0', 'cat5171_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_cat5171_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_cat5171Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'cat5171_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_ab'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_ab = Blockly.Python.valueToCode(block, 'r_ab', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = CAT5171(${bus}, ${r_ab})\\n`\n}\n\nBlockly.Blocks[\"custom_cat5171_set_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_SET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'code'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_set_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var code = Blockly.Python.valueToCode(block, 'code', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_wiper(${code})\\n`\n}\n\nBlockly.Blocks[\"custom_cat5171_get_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_GET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_get_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_wiper()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_cat5171_set_resistance\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_SET_RESISTANCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'ohms'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_set_resistance\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var ohms = Blockly.Python.valueToCode(block, 'ohms', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resistance(${ohms})\\n`\n}\n\nBlockly.Blocks[\"custom_cat5171_get_resistance\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_GET_RESISTANCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_get_resistance\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_resistance()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_cat5171_set_ratio\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_SET_RATIO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'ratio'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_set_ratio\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var ratio = Blockly.Python.valueToCode(block, 'ratio', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_ratio(${ratio})\\n`\n}\n\nBlockly.Blocks[\"custom_cat5171_get_ratio\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_GET_RATIO,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_get_ratio\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_ratio()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_cat5171_set_resistance_wa\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_SET_RESISTANCE_WA,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'ohms'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_set_resistance_wa\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var ohms = Blockly.Python.valueToCode(block, 'ohms', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resistance_wa(${ohms})\\n`\n}\n\nBlockly.Blocks[\"custom_cat5171_get_resistance_wa\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_GET_RESISTANCE_WA,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_get_resistance_wa\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_resistance_wa()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_cat5171_increment\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_INCREMENT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'steps'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_increment\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var steps = Blockly.Python.valueToCode(block, 'steps', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.increment(${steps})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_cat5171_midscale\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_MIDSCALE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_midscale\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.midscale()\\n`\n}\n\nBlockly.Blocks[\"custom_cat5171_shutdown\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_SHUTDOWN,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_shutdown\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.shutdown()\\n`\n}\n\nBlockly.Blocks[\"custom_cat5171_resume\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_CAT5171_RESUME,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n  