         'name': 'NAME',\n          'options': Blockly.utils.getcustom_cat5171Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_ab'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_wiper'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_cat5171_set_rab\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var r_ab = Blockly.Python.valueToCode(block, 'r_ab', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_wiper = Blockly.Python.valueToCode(block, 'r_wiper', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_rab(${r_ab}, ${r_wiper})\\n`\n}\n",
    "toolbox": "\n<category name=\"CAT5171\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_cat5171\">\n<title text=\"CAT5171\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_cat5171_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"r_ab\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">100000.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_cat5171_set_wiper\">\n  <value name=\"code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">128</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_cat5171_get_wiper\"/><block type=\"custom_cat5171_set_resistance\">\n  <value name=\"ohms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">50000.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_cat5171_get_resistance\"/><block type=\"custom_cat5171_set_ratio\">\n  <value name=\"ratio\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0.5</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_cat5171_get_ratio\"/><block type=\"custom_cat5171_set_resistance_wa\">\n  <value name=\"ohms\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">50000.0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_cat5171_get_resistance_wa\"/><block type=\"custom_cat5171_increment\">\n  <value name=\"steps\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_cat5171_midscale\"/><block type=\"custom_cat5171_shutdown\"/><block type=\"custom_cat5171_resume\"/><block type=\"custom_cat5171_is_shutdown\"/><block type=\"custom_cat5171_reset\"/><block type=\"custom_cat5171_set_rab\">\n  <value name=\"r_ab\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">100000.0</field>\n    </shadow>\n  </value>\n  <value name=\"r_wiper\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">50.0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
