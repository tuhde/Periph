{
  "category": "AD5251",
  "color": "#C084FC",
  "uiflow2": {
    "jscode": "const CUSTOM_AD5251_LANGUAGES = {\n  \"CUSTOM_AD5251_INIT\": {\n    \"en\": \"%1 init bus %2 RAB (ohm) %3\"\n  },\n  \"CUSTOM_AD5251_SET_WIPER\": {\n    \"en\": \"%1 set wiper channel (0-1) %2 code (0-63) %3\"\n  },\n  \"CUSTOM_AD5251_GET_WIPER\": {\n    \"en\": \"%1 wiper code channel (0-1) %2\"\n  },\n  \"CUSTOM_AD5251_SET_RESISTANCE\": {\n    \"en\": \"%1 set W-B resistance channel (0-1) %2 ohms %3\"\n  },\n  \"CUSTOM_AD5251_GET_RESISTANCE\": {\n    \"en\": \"%1 W-B resistance (ohm) channel (0-1) %2\"\n  },\n  \"CUSTOM_AD5251_SET_BOTH\": {\n    \"en\": \"%1 set both wipers channel 0 code %2 channel 1 code %3\"\n  },\n  \"CUSTOM_AD5251_SET_RATIO\": {\n    \"en\": \"%1 set ratio channel (0-1) %2 ratio (0-1) %3\"\n  },\n  \"CUSTOM_AD5251_GET_RATIO\": {\n    \"en\": \"%1 ratio channel (0-1) %2\"\n  },\n  \"CUSTOM_AD5251_SET_RESISTANCE_WA\": {\n    \"en\": \"%1 set W-A resistance channel (0-1) %2 ohms %3\"\n  },\n  \"CUSTOM_AD5251_GET_RESISTANCE_WA\": {\n    \"en\": \"%1 W-A resistance (ohm) channel (0-1) %2\"\n  },\n  \"CUSTOM_AD5251_INCREMENT\": {\n    \"en\": \"%1 step up channel (0-1, -1 = both) %2\"\n  },\n  \"CUSTOM_AD5251_DECREMENT\": {\n    \"en\": \"%1 step down channel (0-1, -1 = both) %2\"\n  },\n  \"CUSTOM_AD5251_DOUBLE\": {\n    \"en\": \"%1 double (+6 dB) channel (0-1, -1 = both) %2\"\n  },\n  \"CUSTOM_AD5251_HALVE\": {\n    \"en\": \"%1 halve (-6 dB) channel (0-1, -1 = both) %2\"\n  },\n  \"CUSTOM_AD5251_STORE\": {\n    \"en\": \"%1 store to EEMEM channel (0-1, -1 = both) %2\"\n  },\n  \"CUSTOM_AD5251_RESTORE\": {\n    \"en\": \"%1 restore from EEMEM channel (0-1, -1 = both) %2\"\n  },\n  \"CUSTOM_AD5251_RESET\": {\n    \"en\": \"%1 reset from EEMEM\"\n  },\n  \"CUSTOM_AD5251_READ_EEMEM\": {\n    \"en\": \"%1 read user EEMEM index (4-15) %2\"\n  },\n  \"CUSTOM_AD5251_WRITE_EEMEM\": {\n    \"en\": \"%1 write user EEMEM index (4-15) %2 value (0-63) %3\"\n  },\n  \"CUSTOM_AD5251_READ_TOLERANCE\": {\n    \"en\": \"%1 RAB tolerance (percent) channel (0-1) %2\"\n  },\n  \"CUSTOM_AD5251_RAB_ACTUAL\": {\n    \"en\": \"%1 actual RAB (ohm) channel (0-1) %2\"\n  },\n  \"CUSTOM_AD5251_NOP\": {\n    \"en\": \"%1 NOP\"\n  },\n  \"CUSTOM_AD5251_SET_RAB\": {\n    \"en\": \"%1 set RAB (ohm) %2 RW (ohm) %3\"\n  }\n};\n\nconst initType = 'custom_ad5251_init';\nBlockly.BlockRegExpList['custom_ad5251'] = {\n  regexp: new RegExp(/^custom_ad5251_/),\n  code: \"from AD5251 import AD5251\",\n  initBlockType: initType,\n  categoryId: 'custom_ad5251',\n}\nBlockly.utils.registerLanguages(CUSTOM_AD5251_LANGUAGES)\n\nBlockly.Msg.CUSTOM_AD5251_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_AD5251 = 'AD5251'\n\nBlockly.utils.getcustom_ad5251Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['ad5251_0', 'ad5251_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_ad5251_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD5251_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_ad5251Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'ad5251_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'r_ab'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad5251_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var r_ab = Blockly.Python.valueToCode(block, 'r_ab', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = AD5251(${bus}, ${r_ab})\\n`\n}\n\nBlockly.Blocks[\"custom_ad5251_set_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD5251_SET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad5251Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'code'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad5251_set_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var code = Blockly.Python.valueToCode(block, 'code', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_wiper(${channel}, ${code})\\n`\n}\n\nBlockly.Blocks[\"custom_ad5251_get_wiper\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD5251_GET_WIPER,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad5251Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad5251_get_wiper\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_wiper(${channel})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_ad5251_set_resistance\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD5251_SET_RESISTANCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad5251Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n        {\n          'type': 'input_value',\n          'name': 'ohms'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad5251_set_resistance\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n  var ohms = Blockly.Python.valueToCode(block, 'ohms', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_resistance(${channel}, ${ohms})\\n`\n}\n\nBlockly.Blocks[\"custom_ad5251_get_resistance\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_AD5251_GET_RESISTANCE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_ad5251Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'channel'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_ad5251_get_resistance\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var channel = Blockly.Python.valueToCode(block, 'channel', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.get_resistance(${channel})`, Blockly.Python.ORDER_N