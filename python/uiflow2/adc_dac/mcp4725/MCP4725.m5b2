  "uiflow2": {
    "jscode": "const CUSTOM_MCP4725_LANGUAGES = {\n  \"CUSTOM_MCP4725_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_MCP4725_SET_VOLTAGE\": {\n    \"en\": \"%1 set output (fraction of V_DD) fraction %2\"\n  },\n  \"CUSTOM_MCP4725_SET_RAW\": {\n    \"en\": \"%1 set raw 12-bit code code %2\"\n  }\n};\n\nconst initType = 'custom_mcp4725_init';\nBlockly.BlockRegExpList['custom_mcp4725'] = {\n  regexp: new RegExp(/^custom_mcp4725_/),\n  code: \"from MCP4725 import MCP4725\",\n  initBlockType: initType,\n  categoryId: 'custom_mcp4725',\n}\nBlockly.utils.registerLanguages(CUSTOM_MCP4725_LANGUAGES)\n\nBlockly.Msg.CUSTOM_MCP4725_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_MCP4725 = 'MCP4725'\n\nBlockly.utils.getcustom_mcp4725Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['mcp4725_0', 'mcp4725_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_mcp4725_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4725_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_mcp4725Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'mcp4725_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4725_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = MCP4725(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4725_set_voltage\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4725_SET_VOLTAGE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4725Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'fraction'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4725_set_voltage\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var fraction = Blockly.Python.valueToCode(block, 'fraction', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_voltage(${fraction})\\n`\n}\n\nBlockly.Blocks[\"custom_mcp4725_set_raw\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_MCP4725_SET_RAW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_mcp4725Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'code'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_mcp4725_set_raw\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var code = Blockly.Python.valueToCode(block, 'code', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_raw(${code})\\n`\n}\n",
    "toolbox": "\n<category name=\"MCP4725\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mcp4725\"><title text=\"MCP4725\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mcp4725_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">96</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp4725_set_voltage\">\n  <value name=\"fraction\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp4725_set_raw\">\n  <value name=\"code\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block>\n</category>\n",
