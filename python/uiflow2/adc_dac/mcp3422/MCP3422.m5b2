    "toolbox": "\n<category name=\"MCP3422\" colour=\"#C084FC\" hidden=\"true\" toolboxitemid=\"custom_mcp3422\">\n<title text=\"MCP3422\" docsLink=\"https://github.com/tuhde/Periph\"></title>\n<block type=\"custom_mcp3422_init\">\n  <value name=\"bus\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"address\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">104</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp3422_read_raw\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp3422_read_voltage\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp3422_set_resolution\">\n  <value name=\"bits\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">16</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp3422_get_resolution\"/><block type=\"custom_mcp3422_set_gain\">\n  <value name=\"gain\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp3422_get_gain\"/><block type=\"custom_mcp3422_set_channel\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp3422_start_continuous\">\n  <value name=\"channel\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_mcp3422_stop_continuous\"/><block type=\"custom_mcp3422_is_continuous\"/><block type=\"custom_mcp3422_read_continuous_raw\"/><block type=\"custom_mcp3422_read_continuous\"/><block type=\"custom_mcp3422_is_ready\"/><block type=\"custom_mcp3422_general_call_reset\"/><block type=\"custom_mcp3422_lsb\"/><block type=\"custom