    "jscode": "const CUSTOM_PCA9541_LANGUAGES = {\n  \"CUSTOM_PCA9541_INIT\": {\n    \"en\": \"%1 init bus %2 address %3\"\n  },\n  \"CUSTOM_PCA9541_HAS_CONTROL\": {\n    \"en\": \"%1 this master has the bus\"\n  },\n  \"CUSTOM_PCA9541_ACQUIRE\": {\n    \"en\": \"%1 take the bus (1 = with bus init) %2 timeout (ms) %3\"\n  },\n  \"CUSTOM_PCA9541_RELEASE\": {\n    \"en\": \"%1 give the bus to the other master\"\n  },\n  \"CUSTOM_PCA9541_RECOVER_BUS\": {\n    \"en\": \"%1 recover and take the bus timeout (ms) %2\"\n  },\n  \"CUSTOM_PCA9541_IS_CONNECTED\": {\n    \"en\": \"%1 downstream bus connected\"\n  },\n  \"CUSTOM_PCA9541_CONNECT\": {\n    \"en\": \"%1 connect downstream bus\"\n  },\n  \"CUSTOM_PCA9541_DISCONNECT\": {\n    \"en\": \"%1 disconnect downstream bus\"\n  },\n  \"CUSTOM_PCA9541_GET_CONTROL\": {\n    \"en\": \"%1 CONTROL register\"\n  },\n  \"CUSTOM_PCA9541_SET_INTERRUPT_MASK\": {\n    \"en\": \"%1 mask interrupts (1 = masked) bus lost %2 bus not idle %3 bus init %4 INT_IN %5\"\n  },\n  \"CUSTOM_PCA9541_GET_INTERRUPT_MASK\": {\n    \"en\": \"%1 interrupt mask\"\n  },\n  \"CUSTOM_PCA9541_TEST_INTERRUPT\": {\n    \"en\": \"%1 INT test (1 = drive low) own %2 other %3\"\n  },\n  \"CUSTOM_PCA9541_POLL_INTERRUPT\": {\n    \"en\": \"%1 interrupt status\"\n  }\n};\n\nconst initType = 'custom_pca9541_init';\nBlockly.BlockRegExpList['custom_pca9541'] = {\n  regexp: new RegExp(/^custom_pca9541_/),\n  code: \"from PCA9541 import PCA9541\",\n  initBlockType: initType,\n  categoryId: 'custom_pca9541',\n}\nBlockly.utils.registerLanguages(CUSTOM_PCA9541_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PCA9541_HUE = '#C084FC'\nBlockly.Msg.CUSTOM_PCA9541 = 'PCA9541'\n\nBlockly.utils.getcustom_pca9541Options = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['pca9541_0', 'pca9541_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_pca9541_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_INIT,\n      'args0': [\n        // { 'type': 'field_dropdown', 'name': 'NAME', 'options': Blockly.utils.getcustom_pca9541Options },\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'pca9541_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus'\n        },\n        {\n          'type': 'input_value',\n          'name': 'address'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus = Blockly.Python.valueToCode(block, 'bus', Blockly.Python.ORDER_FUNCTION_CALL);\n  var address = Blockly.Python.valueToCode(block, 'address', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname} = PCA9541(${bus}, ${address})\\n`\n}\n\nBlockly.Blocks[\"custom_pca9541_has_control\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_HAS_CONTROL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_has_control\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.has_control()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca9541_acquire\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_ACQUIRE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus_init'\n        },\n        {\n          'type': 'input_value',\n          'name': 'timeout_ms'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_acquire\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus_init = Blockly.Python.valueToCode(block, 'bus_init', Blockly.Python.ORDER_FUNCTION_CALL);\n  var timeout_ms = Blockly.Python.valueToCode(block, 'timeout_ms', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.acquire(${bus_init}, ${timeout_ms})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca9541_release\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_RELEASE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_release\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.release()\\n`\n}\n\nBlockly.Blocks[\"custom_pca9541_recover_bus\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_RECOVER_BUS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'timeout_ms'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_recover_bus\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var timeout_ms = Blockly.Python.valueToCode(block, 'timeout_ms', Blockly.Python.ORDER_FUNCTION_CALL);\n\n  return [`${varname}.recover_bus(${timeout_ms})`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca9541_is_connected\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_IS_CONNECTED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_is_connected\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.is_connected()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca9541_connect\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_CONNECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_connect\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.connect()\\n`\n}\n\nBlockly.Blocks[\"custom_pca9541_disconnect\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_DISCONNECT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_disconnect\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return `${varname}.disconnect()\\n`\n}\n\nBlockly.Blocks[\"custom_pca9541_get_control\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_GET_CONTROL,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_get_control\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_control()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca9541_set_interrupt_mask\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_SET_INTERRUPT_MASK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus_lost'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus_not_idle'\n        },\n        {\n          'type': 'input_value',\n          'name': 'bus_init'\n        },\n        {\n          'type': 'input_value',\n          'name': 'int_in'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_set_interrupt_mask\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var bus_lost = Blockly.Python.valueToCode(block, 'bus_lost', Blockly.Python.ORDER_FUNCTION_CALL);\n  var bus_not_idle = Blockly.Python.valueToCode(block, 'bus_not_idle', Blockly.Python.ORDER_FUNCTION_CALL);\n  var bus_init = Blockly.Python.valueToCode(block, 'bus_init', Blockly.Python.ORDER_FUNCTION_CALL);\n  var int_in = Blockly.Python.valueToCode(block, 'int_in', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.set_interrupt_mask(${bus_lost}, ${bus_not_idle}, ${bus_init}, ${int_in})\\n`\n}\n\nBlockly.Blocks[\"custom_pca9541_get_interrupt_mask\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_GET_INTERRUPT_MASK,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_get_interrupt_mask\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.get_interrupt_mask()`, Blockly.Python.ORDER_NONE]\n}\n\nBlockly.Blocks[\"custom_pca9541_test_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_TEST_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n        {\n          'type': 'input_value',\n          'name': 'own'\n        },\n        {\n          'type': 'input_value',\n          'name': 'other'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_test_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var own = Blockly.Python.valueToCode(block, 'own', Blockly.Python.ORDER_FUNCTION_CALL);\n  var other = Blockly.Python.valueToCode(block, 'other', Blockly.Python.ORDER_FUNCTION_CALL);\n  return `${varname}.test_interrupt(${own}, ${other})\\n`\n}\n\nBlockly.Blocks[\"custom_pca9541_poll_interrupt\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PCA9541_POLL_INTERRUPT,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_pca9541Options\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#C084FC\",\n    };\n  }\n}\n\nBlockly.Python[\"custom_pca9541_poll_interrupt\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n\n  return [`${varname}.poll_interrupt()`, Blockly.Python.ORDER_NONE]\n}\n",
