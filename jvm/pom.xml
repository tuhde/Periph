<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>it.uhde</groupId>
    <artifactId>periph</artifactId>
    <version>1.2.1</version>
    <packaging>pom</packaging>

    <name>Periph</name>
    <description>A multi-language library for peripheral chips (sensors, actuators, etc.) connected via SPI, I2C, or other transports.</description>
    <url>https://github.com/tuhde/Periph</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Till Uhde</name>
            <email>till@uhde.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/tuhde/Periph.git</connection>
        <developerConnection>scm:git:https://github.com/tuhde/Periph.git</developerConnection>
        <url>https://github.com/tuhde/Periph</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>periph-connection</module>
        <module>periph-java</module>
        <module>periph-kotlin</module>
        <module>periph-groovy</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.version>2.1.21</kotlin.version>
        <groovy.version>4.0.30</groovy.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>it.uhde</groupId>
                <artifactId>periph-connection</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>it.uhde</groupId>
                <artifactId>periph-java</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <!-- periph-java's public API isn't fully doc-commented yet; strict
                             doclint would fail the release build on every gap. -->
                        <doclint>none</doclint>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                    <configuration>
                        <!-- Unset (local): falls back to useAgent's interactive gpg-agent
                             prompt. Set (CI): signs non-interactively off this env var. -->
                        <passphraseEnvName>GPG_PASSPHRASE</passphraseEnvName>
                        <!-- Pin to the dedicated release key rather than gpg's default. -->
                        <keyname>32C2B70F682C45B790BC4B68F3FE2DEF1A9EBFC9</keyname>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Activated with -Prelease for a Maven Central deploy: attaches sources and
             javadoc jars and GPG-signs every artifact. Left out of ordinary builds so
             day-to-day `mvn install`/`mvn test` don't need a GPG key available. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Central Portal deploy: no distributionManagement needed, this
                             plugin overrides the deploy phase itself. Auto-publish is left
                             off on purpose: each release is reviewed and published by hand
                             in the Central Portal UI before it goes live. -->
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
