# Periph JVM test configuration
# Copy this file to testconfig and fill in your values.
# testconfig is gitignored — never commit it.

# ── I²C chips ────────────────────────────────────────────────────────────────

# I²C bus number (e.g. 1 for /dev/i2c-1)
I2C_BUS=1

# Device I²C address in hex (optional — falls back to chip_defaults)
# I2C_ADDR=0x60

# ── SPI / NeoPixel chips ─────────────────────────────────────────────────────

# SPI bus number (e.g. 0 for /dev/spidev0.x)
SPI_BUS=0

# SPI device / chip-select number (e.g. 0 for /dev/spidevx.0)
SPI_DEVICE=0

# Number of pixels in the LED strip (NeoPixel chips only)
PIXEL_COUNT=30

# ------------------------------------------------------------------
# Rig-wide sigrok analyzer (one logic analyzer on the bench)
# ------------------------------------------------------------------
# SIGROK_DRIVER=fx2lafw
# SIGROK_CONN=
# SIGROK_SAMPLERATE=24m

# ------------------------------------------------------------------
# Per-chip wiring overrides
# ------------------------------------------------------------------
# Only list chips whose wiring differs from the flat defaults above — e.g. a
# permanent bench with several chips on different buses/pins, each needing
# its own logic-analyzer channel mapping. jvm is host-only, split by
# language rather than platform, so this block lives directly here rather
# than in a separate testconfig_wiring (see specs/testing_framework.md,
# "Chip Wiring & Sigrok Configuration").
# case "${CATEGORY:-}/${CHIP:-}" in
#     gas/ens160)
#         I2C_ADDR=0x53
#         SIGROK_CHANNELS="D0=SCL,D1=SDA"
#         ;;
#     environmental/aht21)
#         I2C_ADDR=0x38
#         SIGROK_CHANNELS="D2=SCL,D3=SDA"
#         ;;
# esac
