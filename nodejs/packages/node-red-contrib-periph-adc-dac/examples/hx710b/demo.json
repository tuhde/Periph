[
    {
        "id": "tab-hx710b-demo",
        "type": "tab",
        "label": "HX710B Scale Demo",
        "disabled": false,
        "info": "Battery-monitored load cell demo using the HX710B 24-bit ADC. On deploy, an inject node sends 'tare' to zero the scale. Every 2 seconds a second inject node triggers a weight reading. Every 60 seconds a third inject node sends 'supply_diff' to sample the DVDD-AVDD supply-difference channel. The HX710B node outputs { raw, weight } for weight readings and { raw_supply_diff } for supply-diff readings. The weight output connects to a debug node and a gauge UI node (node-red-dashboard) showing grams; the supply-diff output connects to a switch node comparing against a configurable low-battery threshold and a notification node (node-red-dashboard) when crossed. Requires node-red-dashboard for the gauge. Set DOUT and PD_SCK to your GPIO pin numbers and calibrate the scale factor before use."
    },
    {
        "id": "inj-tare-hx710b",
        "type": "inject",
        "name": "Tare on deploy",
        "topic": "",
        "payload": "tare",
        "payloadType": "str",
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.5,
        "z": "tab-hx710b-demo",
        "x": 140,
        "y": 100,
        "wires": [["hx710b"]]
    },
    {
        "id": "inj-read-hx710b",
        "type": "inject",
        "name": "Read every 2 s",
        "topic": "",
        "payload": "",
        "payloadType": "str",
        "repeat": "2",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "z": "tab-hx710b-demo",
        "x": 140,
        "y": 200,
        "wires": [["hx710b"]]
    },
    {
        "id": "inj-supply-diff-hx710b",
        "type": "inject",
        "name": "Supply-diff every 60 s",
        "topic": "",
        "payload": "supply_diff",
        "payloadType": "str",
        "repeat": "60",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "z": "tab-hx710b-demo",
        "x": 140,
        "y": 300,
        "wires": [["hx710b"]]
    },
    {
        "id": "hx710b",
        "type": "periph-hx710b",
        "z": "tab-hx710b-demo",
        "name": "",
        "gpioChip": "0",
        "doutPin": "5",
        "pdSckPin": "6",
        "rate": "10",
        "scaleFactor": "1.0",
        "tareOffset": "0",
        "x": 360,
        "y": 200,
        "wires": [["dbg-weight-hx710b", "gauge-weight-hx710b", "switch-supply-diff-hx710b"]]
    },
    {
        "id": "dbg-weight-hx710b",
        "type": "debug",
        "z": "tab-hx710b-demo",
        "name": "Weight",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 580,
        "y": 100,
        "wires": []
    },
    {
        "id": "gauge-weight-hx710b",
        "type": "ui_gauge",
        "z": "tab-hx710b-demo",
        "name": "Weight (g)",
        "group": "ui-group-hx710b",
        "order": 1,
        "width": "6",
        "height": "4",
        "gtype": "gage",
        "title": "Weight",
        "label": "g",
        "format": "{{value}}",
        "min": 0,
        "max": 1000,
        "colors": ["#00b500", "#e6e600", "#ca3838"],
        "seg1": "",
        "seg2": "",
        "x": 580,
        "y": 200,
        "wires": []
    },
    {
        "id": "ui-group-hx710b",
        "type": "ui_group",
        "z": "",
        "name": "HX710B",
        "tab": "ui-tab-hx710b",
        "order": 1,
        "disp": true,
        "width": "6"
    },
    {
        "id": "ui-tab-hx710b",
        "type": "ui_tab",
        "z": "",
        "name": "HX710B Demo",
        "icon": "dashboard",
        "order": 1
    },
    {
        "id": "switch-supply-diff-hx710b",
        "type": "switch",
        "z": "tab-hx710b-demo",
        "name": "Low battery?",
        "property": "payload.raw_supply_diff",
        "propertyType": "msg",
        "rules": [
            { "t": "lt", "v": "-50000", "vt": "num" },
            { "t": "gt", "v": "50000",  "vt": "num" }
        ],
        "checkall": "false",
        "repair": false,
        "outputs": 2,
        "x": 580,
        "y": 300,
        "wires": [["notify-low-batt-hx710b"], []]
    },
    {
        "id": "notify-low-batt-hx710b",
        "type": "ui_toast",
        "z": "tab-hx710b-demo",
        "position": "top right",
        "displayTime": "5",
        "highlight": "red",
        "outputs": 0,
        "ok": "OK",
        "cancel": "",
        "raw": false,
        "topic": "Battery",
        "name": "LOW BATTERY",
        "x": 800,
        "y": 300,
        "wires": []
    }
]
