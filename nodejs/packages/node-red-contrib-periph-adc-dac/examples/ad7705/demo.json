[
    {
        "id": "tab-ad7705-demo",
        "type": "tab",
        "label": "AD7705 ADC Demo",
        "disabled": false,
        "info": "Dual-channel AD7705 ADC demo for the bridge-pressure-measurement application. An inject node fires every 2 seconds, triggering a dual-channel read of channel1 (bridge pressure signal, gain 128) and channel2 (auxiliary temperature sensor, gain 2). The output splits via a function node into the two channel voltages, each feeding its own debug node. A second inject node fires once on deploy with the literal string 'calibrate' to trigger a self-calibration of both configured channels before the periodic reads begin."
    },
    {
        "id": "cfg-ad7705",
        "type": "ad7705-device",
        "name": "AD7705",
        "bus": "0",
        "device": "0",
        "vref": "2.5",
        "mclkHz": "2457600"
    },
    {
        "id": "inj-calibrate",
        "type": "inject",
        "name": "calibrate (once)",
        "topic": "",
        "payload": "calibrate",
        "payloadType": "str",
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.5,
        "z": "tab-ad7705-demo",
        "x": 150,
        "y": 120,
        "wires": [["ad7705"]]
    },
    {
        "id": "inj-read",
        "type": "inject",
        "name": "read every 2s",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "repeat": "2",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "z": "tab-ad7705-demo",
        "x": 150,
        "y": 220,
        "wires": [["ad7705"]]
    },
    {
        "id": "ad7705",
        "type": "periph-ad7705",
        "name": "AD7705",
        "device": "cfg-ad7705",
        "z": "tab-ad7705-demo",
        "x": 370,
        "y": 180,
        "wires": [["fn-split"]]
    },
    {
        "id": "fn-split",
        "type": "function",
        "name": "split channels",
        "func": "const ch1 = { payload: msg.payload.channel1 };\nconst ch2 = { payload: msg.payload.channel2 };\nreturn [ch1, ch2];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 180,
        "wires": [["dbg-ch1"], ["dbg-ch2"]]
    },
    {
        "id": "dbg-ch1",
        "type": "debug",
        "name": "channel1 (bridge, V)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "z": "tab-ad7705-demo",
        "x": 830,
        "y": 140,
        "wires": []
    },
    {
        "id": "dbg-ch2",
        "type": "debug",
        "name": "channel2 (temp, V)",
