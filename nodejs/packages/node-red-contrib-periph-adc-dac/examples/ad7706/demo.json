[
    {
        "id": "tab-ad7706-demo",
        "type": "tab",
        "label": "AD7706 ADC Demo",
        "disabled": false,
        "info": "3-channel AD7706 ADC demo for the HVAC manifold-pressure monitoring application. An inject node fires every 2 seconds, triggering a 3-channel read of channel1 (filter-inlet static), channel2 (filter-outlet static) and channel3 (duct static). The output splits via a function node into the three channel voltages, each feeding its own debug node. A second inject node fires once on deploy with the literal string 'calibrate' to trigger a self-calibration of all three configured channels before the periodic reads begin."
    },
    {
        "id": "cfg-ad7706",
        "type": "ad7706-device",
        "name": "AD7706",
        "bus": "0",
        "device": "0",
        "vref": "2.5",
        "mclkHz": "2457600"
    },
    {
        "id": "inj-calibrate",
        "type": "inject",
        "name": "calibrate (once)",
        "topic": "",
        "payload": "calibrate",
        "payloadType": "str",
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.5,
        "z": "tab-ad7706-demo",
        "x": 150,
        "y": 120,
        "wires": [["ad7706"]]
    },
    {
        "id": "inj-read",
        "type": "inject",
        "name": "read every 2s",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "repeat": "2",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "z": "tab-ad7706-demo",
        "x": 150,
        "y": 220,
        "wires": [["ad7706"]]
    },
    {
        "id": "ad7706",
        "type": "periph-ad7706",
        "name": "AD7706",
        "device": "cfg-ad7706",
        "z": "tab-ad7706-demo",
        "x": 370,
        "y": 180,
        "wires": [["fn-split"]]
    },
    {
        "id": "fn-split",
        "type": "function",
        "name": "split channels",
        "func": "const ch1 = { payload: msg.payload.channel1 };\nconst ch2 = { payload: msg.payload.channel2 };\nconst ch3 = { payload: msg.payload.channel3 };\nreturn [ch1, ch2, ch3];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 180,
        "wires": [["dbg-ch1"], ["dbg-ch2"], ["dbg-ch3"]]
    },
    {
        "id": "dbg-ch1",
        "type": "debug",
        "name": "channel1 (filter-inlet, V)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "z": "tab-ad7706-demo",
        "x": 830,
        "y": 120,
        "wires": []
    },
