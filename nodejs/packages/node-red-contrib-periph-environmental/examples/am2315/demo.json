[
  {
    "id": "am2315-tab",
    "type": "tab",
    "label": "AM2315 humidity logger",
    "disabled": false,
    "info": "Reads temperature and relative humidity from an AM2315 every 5 s and formats them. The sensor returns the previous measurement on every read and needs at least 2 s between transactions; each response is CRC-16 checked."
  },
  {
    "id": "am2315-inject",
    "type": "inject",
    "z": "am2315-tab",
    "name": "5 s timer",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payloadType": "date",
    "x": 160,
    "y": 160,
    "wires": [
      [
        "am2315-node"
      ]
    ]
  },
  {
    "id": "am2315-node",
    "type": "periph-am2315",
    "z": "am2315-tab",
    "name": "AM2315",
    "bus": "1",
    "address": "0x5C",
    "x": 380,
    "y": 160,
    "wires": [
      [
        "am2315-format"
      ]
    ]
  },
  {
    "id": "am2315-format",
    "type": "function",
    "z": "am2315-tab",
    "name": "Format",
    "func": "msg.payload = msg.payload.temperature_c.toFixed(1) + ' °C / ' + msg.payload.humidity_pct.toFixed(1) + ' %RH';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 160,
    "wires": [
      [
        "am2315-debug"
      ]
    ]
  },
  {
    "id": "am2315-debug",
    "type": "debug",
    "z": "am2315-tab",
    "name": "Reading",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 800,
    "y": 160,
    "wires": []
  }
]
