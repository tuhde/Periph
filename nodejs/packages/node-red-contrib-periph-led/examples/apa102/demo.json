[
  {
    "id": "apa102-demo-tab",
    "type": "tab",
    "label": "APA102 Demo",
    "info": "Cycles through six colors on an APA102 LED strip using inject nodes. Each inject fires every 2 seconds with a different { r, g, b } payload. A second inject demonstrates hardware brightness by sending { r:255, g:255, b:255, pixel_brightness:4 } (soft white at 4/31 current) vs { r:255, g:255, b:255, pixel_brightness:31 } (full white). A third inject sends { command: 'off' } on demand. Demonstrates both the RGB fill path and the per-pixel hardware brightness field."
  },
  {
    "id": "apa102-device-1",
    "type": "apa102-device",
    "name": "APA102 strip",
    "spiBus": "0",
    "spiDevice": "0",
    "pixelCount": "30",
    "brightness": "255"
  },
  {
    "id": "inject-red",
    "type": "inject",
    "z": "apa102-demo-tab",
    "name": "Red",
    "props": [{ "p": "payload" }],
    "repeat": "2",
    "payload": "{\"r\":255,\"g\":0,\"b\":0}",
    "payloadType": "json",
    "wires": [["apa102-node"]]
  },
  {
