[
  {
    "id": "uc1611s_tab",
    "type": "tab",
    "label": "info",
    "disabled": false,
    "info": "Bounces an 8 x 8 ball inside a frame on an EA DOGXL240-7 (240 x 128) on I2C bus 1 (command 0x38, data 0x39). A second inject toggles the inverse display and a third sets the contrast from 0x70 to 0x8F. Auto-show sends the framebuffer after every drawing message."
  },
  {
    "id": "uc1611s_frame_inject",
    "type": "inject",
    "z": "uc1611s_tab",
    "name": "draw frame",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "once": true,
    "onceDelay": "2",
    "payload": "{\"clear\":true,\"rect\":{\"x\":0,\"y\":0,\"w\":240,\"h\":128}}",
    "payloadType": "json",
    "x": 130,
    "y": 80,
    "wires": [["uc1611s_node"]]
  },
  {
    "id": "uc1611s_tick",
    "type": "inject",
    "z": "uc1611s_tab",
    "name": "every 100 ms",
    "props": [{ "p": "payload" }],
    "repeat": "0.1",
    "once": true,
    "onceDelay": "4",
    "payload": "",
    "payloadType": "date",
    "x": 130,
    "y": 160,
    "wires": [["uc1611s_ball"]]
  },
  {
    "id": "uc1611s_ball",
    "type": "function",
    "z": "uc1611s_tab",
    "name": "ball",
    "func": "let s = context.get('s') || { x: 20, y: 12, dx: 3, dy: 2 };\nconst erase = { rect: { x: s.x, y: s.y, w: 8, h: 8, on: false, fill: true } };\ns.x += s.dx; s.y += s.dy;\nif (s.x < 2 || s.x > 229) { s.dx = -s.dx; s.x += 2 * s.dx; }\nif (s.y < 2 || s.y > 118) { s.dy = -s.dy; s.y += 2 * s.dy; }\ncontext.set('s', s);\nreturn [[{ payload: erase }, { payload: { rect: { x: s.x, y: s.y, w: 8, h: 8, on: true, fill: true } } }]];",
    "outputs": 1,
    "x": 320,
    "y": 160,
    "wires": [["uc1611s_node"]]
  },
  {
    "id": "uc1611s_invert",
    "type": "inject",
    "z": "uc1611s_tab",
    "name": "toggle invert",
    "props": [{ "p": "payload" }],
    "repeat": "5",
    "once": false,
    "payload": "",
    "payloadType": "date",
    "x": 130,
    "y": 240,
    "wires": [["uc1611s_invert_fn"]]
  },
  {
    "id": "uc1611s_invert_fn",
    "type": "function",
    "z": "uc1611s_tab",
    "name": "flip invert state",
    "func": "const on = !(context.get('inv') || false);\ncontext.set('inv', on);\nreturn { payload: { invert: on } };",
    "outputs": 1,
    "x": 330,
    "y": 240,
    "wires": [["uc1611s_node"]]
  },
  {
    "id": "uc1611s_contrast",
    "type": "inject",
    "z": "uc1611s_tab",
    "name": "contrast 0x70",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "once": false,
    "payload": "{\"contrast\":112}",
    "payloadType": "json",
    "x": 130,
    "y": 320,
    "wires": [["uc1611s_node"]]
  },
  {
    "id": "uc1611s_contrast_reset",
    "type": "inject",
    "z": "uc1611s_tab",
    "name": "contrast 0x8F",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "once": false,
    "payload": "{\"contrast\":143}",
    "payloadType": "json",
    "x": 130,
    "y": 380,
    "wires": [["uc1611s_node"]]
  },
  {
    "id": "uc1611s_node",
    "type": "periph-uc1611s",
    "z": "uc1611s_tab",
    "name": "DOGXL240-7",
    "i2cBus": "1",
    "address": "0x38",
    "width": "240",
    "height": "128",
    "topView": false,
    "contrast": "143",
    "autoShow": true,
    "x": 640,
    "y": 200,
    "wires": [[]]
  }
]
