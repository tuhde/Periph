[
    {
        "id": "inject-100ms",
        "type": "inject",
        "z": "mpu9255-demo",
        "name": "100ms timer",
        "props": [{"p": "payload"}],
        "repeat": "100",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payloadType": "date",
        "x": 180,
        "y": 160,
        "wires": [["mpu9255-node"]]
    },
    {
        "id": "mpu9255-node",
        "type": "periph-mpu9255",
        "z": "mpu9255-demo",
        "name": "MPU9255",
        "connection": "i2c-conn-1",
        "addr": "0x68",
        "gyroFs": "1",
        "accelFs": "1",
        "enableMag": true,
        "enableWom": false,
        "womThreshold": "64",
        "x": 400,
        "y": 160,
        "wires": [["function-tilt"]]
    },
    {
        "id": "inject-1s",
        "type": "inject",
        "z": "mpu9255-demo",
        "name": "1s timer (WoM)",
        "props": [{"p": "payload"}],
        "repeat": "1",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payloadType": "date",
        "x": 180,
        "y": 240,
        "wires": [["mpu9255-node-wom"]]
    },
    {
        "id": "mpu9255-node-wom",
        "type": "periph-mpu9255",
        "z": "mpu9255-demo",
        "name": "MPU9255 (WoM)",
        "connection": "i2c-conn-1",
        "addr": "0x68",
        "gyroFs": "0",
        "accelFs": "0",
        "enableMag": false,
        "enableWom": true,
        "womThreshold": "64",
        "x": 400,
        "y": 240,
        "wires": [["debug-wom"]]
    },
    {
        "id": "function-tilt",
        "type": "function",
        "z": "mpu9255-demo",
        "name": "Compute tilt & heading",
        "func": "const { ax, ay, az, gx, gy, gz, mx, my, mz } = msg.payload;\nconst roll  = Math.atan2(ay, az) * 180 / Math.PI;\nconst pitch = Math.atan2(-ax, Math.sqrt(ay*ay + az*az)) * 180 / Math.PI;\nconst heading = Math.atan2(my, mx) * 180 / Math.PI;\nmsg.payload = { roll, pitch, heading, gyroMag: Math.sqrt(gx*gx + gy*gy + gz*gz) };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 160,
        "wires": [["debug-out"]]
    },
    {
        "id": "debug-out",
        "type": "debug",
        "z": "mpu9255-demo",
        "name": "Tilt & heading",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 900,
        "y": 160,
        "wires": []
    },
    {
        "id": "debug-wom",
        "type": "debug",
        "z": "mpu9255-demo",
        "name": "Motion events",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 650,
        "y": 240,
        "wires": []
    },
    {
        "id": "i2c-conn-1",
        "type": "periph-i2c-connection",
        "z": "",
        "name": "I2C bus 1",
        "bus": "1"
    }
]