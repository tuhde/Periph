[
  {
    "id": "spl06-tab",
    "type": "tab",
    "label": "SPL06 altimeter",
    "disabled": false,
    "info": "Barometric altimeter with an SPL06-007. An inject node fires every 2 s and triggers one temperature and pressure measurement. A function node converts the pressure into altitude with the international barometric formula (reference 101325 Pa, editable in the function) and feeds a dashboard gauge; the debug node shows the full reading in pascals, degrees Celsius and metres."
  },
  {
    "id": "spl06-inject",
    "type": "inject",
    "z": "spl06-tab",
    "name": "every 2 s",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "2",
    "crontab": "",
    "once": true,
    "onceDelay": 0.5,
    "topic": "",
    "payloadType": "date",
    "x": 150,
    "y": 160,
    "wires": [
      [
        "spl06-node"
      ]
    ]
  },
  {
    "id": "spl06-device-1",
    "type": "spl06-device",
    "name": "SPL06",
    "bus": "1",
    "address": "0x77",
    "oversampling": "16"
  },
  {
    "id": "spl06-node",
    "type": "spl06",
    "z": "spl06-tab",
    "name": "SPL06",
    "device": "spl06-device-1",
    "x": 340,
    "y": 160,
    "wires": [
      [
        "spl06-altitude"
      ]
    ]
  },
  {
    "id": "spl06-altitude",
    "type": "function",
    "z": "spl06-tab",
    "name": "Altitude",
    "func": "const seaLevelPa = 101325;\nconst p = msg.payload.pressure_pa;\nmsg.payload.altitude_m = 44330 * (1 - Math.pow(p / seaLevelPa, 1 / 5.255));\nreturn [msg, { payload: Math.round(msg.payload.altitude_m * 10) / 10 }];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 530,
    "y": 160,
    "wires": [
      [
        "spl06-debug"
      ],
      [
        "spl06-gauge"
      ]
    ]
  },
  {
    "id": "spl06-debug",
    "type": "debug",
    "z": "spl06-tab",
    "name": "Reading",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 740,
    "y": 120,
    "wires": []
  },
  {
    "id": "spl06-gauge",
    "type": "ui_gauge",
    "z": "spl06-tab",
    "name": "Altitude gauge",
    "group": "spl06-group-1",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Altitude",
    "label": "m",
    "format": "{{value}}",
    "min": -100,
    "max": 1000,
    "colors": [
      "#00b500",
      "#e6e600",
      "#ca3838"
    ],
    "seg1": "",
    "seg2": "",
    "x": 750,
    "y": 200,
    "wires": []
  },
  {
    "id": "spl06-group-1",
    "type": "ui_group",
    "name": "SPL06 Altimeter",
    "tab": "spl06-ui-tab-1",
    "order": 1,
    "disp": true,
    "width": 6
  },
  {
    "id": "spl06-ui-tab-1",
    "type": "ui_tab",
    "name": "SPL06 Demo",
    "icon": "dashboard",
    "order": 1
  }
]
