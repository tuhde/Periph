[
  {
    "id": "mpl3115a2-tab",
    "type": "tab",
    "label": "MPL3115A2 weather station",
    "disabled": false,
    "info": "Reads pressure and temperature from an MPL3115A2 every 5 s and formats them as \"1013.3 hPa / 25.0 °C\". Each message triggers one conversion; a second inject with msg.altitude = true returns the altitude in metres relative to the sea-level pressure set in the device node."
  },
  {
    "id": "mpl3115a2-inject",
    "type": "inject",
    "z": "mpl3115a2-tab",
    "name": "5 s timer",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payloadType": "date",
    "x": 160,
    "y": 160,
    "wires": [
      [
        "mpl3115a2-node"
      ]
    ]
  },
  {
    "id": "mpl3115a2-device-1",
    "type": "mpl3115a2-device",
    "name": "MPL3115A2",
    "bus": "1",
    "address": "0x60",
    "oversample": "128",
    "seaLevel": "101325"
  },
  {
    "id": "mpl3115a2-node",
    "type": "mpl3115a2",
    "z": "mpl3115a2-tab",
    "name": "MPL3115A2",
    "x": 380,
    "y": 160,
    "wires": [
      [
        "mpl3115a2-format"
      ]
    ],
    "device": "mpl3115a2-device-1"
  },
  {
    "id": "mpl3115a2-format",
    "type": "function",
    "z": "mpl3115a2-tab",
    "name": "Format",
    "func": "if (msg.payload.altitude_m !== undefined) {\n    msg.payload = msg.payload.altitude_m.toFixed(1) + ' m / ' + msg.payload.temperature_c.toFixed(1) + ' °C';\n} else {\n    msg.payload = (msg.payload.pressure_pa / 100).toFixed(1) + ' hPa / ' + msg.payload.temperature_c.toFixed(1) + ' °C';\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 160,
    "wires": [
      [
        "mpl3115a2-debug"
      ]
    ]
  },
  {
    "id": "mpl3115a2-debug",
    "type": "debug",
    "z": "mpl3115a2-tab",
    "name": "Reading",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 800,
    "y": 160,
    "wires": []
  },
  {
    "id": "mpl3115a2-inject-alt",
    "type": "inject",
    "z": "mpl3115a2-tab",
    "name": "altitude",
    "props": [
      {
        "p": "payload"
      },
      {
        "p": "altitude",
        "v": "true",
        "vt": "bool"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 240,
    "wires": [
      [
        "mpl3115a2-node"
      ]
    ]
  }
]
