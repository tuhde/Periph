[
  {
    "id": "rrh62000-tab",
    "type": "tab",
    "label": "RRH62000 air quality",
    "disabled": false,
    "info": "Room air-quality station with a Renesas RRH62000. An inject node fires every 5 s and asks for the next sample (the module produces one every 3 s and allows one I2C access per second, so a read takes about 2 s). A function node maps the IAQ index to the UBA rating (very good below 2.0, good, medium, poor, bad from 5.0) and feeds dashboard gauges for PM2.5, IAQ and eCO2; the debug node shows the whole sample with the rating. Change the moving average or the fan speed in the device configuration; allow up to 48 h of conditioning on first use before trusting TVOC and eCO2."
  },
  {
    "id": "rrh62000-inject",
    "type": "inject",
    "z": "rrh62000-tab",
    "name": "every 5 s",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": 2,
    "topic": "",
    "payloadType": "date",
    "x": 150,
    "y": 160,
    "wires": [
      [
        "rrh62000-node"
      ]
    ]
  },
  {
    "id": "rrh62000-device-1",
    "type": "rrh62000-device",
    "name": "RRH62000",
    "bus": "1",
    "movingAverage": "10",
    "fanSpeed": "86"
  },
  {
    "id": "rrh62000-node",
    "type": "rrh62000",
    "z": "rrh62000-tab",
    "name": "RRH62000",
    "device": "rrh62000-device-1",
    "x": 340,
    "y": 160,
    "wires": [
      [
        "rrh62000-label"
      ]
    ]
  },
  {
    "id": "rrh62000-label",
    "type": "function",
    "z": "rrh62000-tab",
    "name": "IAQ rating",
    "func": "const p = msg.payload;\np.rating = p.iaq < 2 ? 'very good' : p.iaq < 3 ? 'good' : p.iaq < 4 ? 'medium' : p.iaq < 5 ? 'poor' : 'bad';\nreturn [msg, { payload: p.pm2_5_ug_m3 }, { payload: p.iaq }, { payload: p.eco2_ppm }];",
    "outputs": 4,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 160,
    "wires": [
      [
        "rrh62000-debug"
      ],
      [
        "rrh62000-gauge-pm"
      ],
      [
        "rrh62000-gauge-iaq"
      ],
      [
        "rrh62000-gauge-co2"
      ]
    ]
  },
  {
    "id": "rrh62000-debug",
    "type": "debug",
    "z": "rrh62000-tab",
    "name": "Sample",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 760,
    "y": 80,
    "wires": []
  },
  {
    "id": "rrh62000-gauge-pm",
    "type": "ui_gauge",
    "z": "rrh62000-tab",
    "name": "PM2.5 gauge",
    "group": "rrh62000-group-1",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "PM2.5",
    "label": "ug/m3",
    "format": "{{value}}",
    "min": 0,
    "max": 100,
    "colors": [
      "#00b500",
      "#e6e600",
      "#ca3838"
    ],
    "seg1": "15",
    "seg2": "35",
    "x": 760,
    "y": 140,
    "wires": []
  },
  {
