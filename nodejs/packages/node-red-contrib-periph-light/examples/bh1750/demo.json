    "type": "inject",
    "z": "bh1750-tab",
    "name": "2 s timer",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "2",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payloadType": "date",
    "x": 160,
    "y": 160,
    "wires": [
      [
        "bh1750-node"
      ]
    ]
  },
  {
