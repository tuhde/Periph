[
    {
        "id": "tab-l3gd20h-1",
        "type": "ui_tab",
        "name": "L3GD20H Demo",
        "icon": "compass",
        "order": 1,
        "info": "This flow demonstrates the L3GD20H three-axis MEMS gyroscope.\n\n**Continuous monitoring**: an inject node fires every 100 ms, reading the X, Y, and Z angular rate in rad/s from the chip. Three UI charts visualise rotation on each axis in real time over a 60-second rolling window.\n\nThe chip is configured for 190 Hz ODR and ±500 dps full scale in the device config node. Use this flow to confirm the chip is responding to physical rotation and that the axes are oriented correctly for your mount."
    },
    {
        "id": "l3gd20h-group-1",
        "type": "ui_group",
        "name": "L3GD20H Angular Rate",
        "tab": "tab-l3gd20h-1",
        "order": 1,
        "disp": true,
        "width": 12
    },
    {
        "id": "l3gd20h-device-1",
        "type": "l3gd20h-device",
        "name": "L3GD20H @ i2c-1",
        "bus": "1",
        "addr": "0x6A",
        "odr": "1",
        "bandwidth": "0",
        "fullScale": "1"
    },
    {
        "id": "l3gd20h-read-1",
        "type": "periph-l3gd20h",
        "name": "L3GD20H Angular Rate",
        "device": "l3gd20h-device-1",
        "wires": [["debug-l3gd20h-1", "chart-x-1", "chart-y-1", "chart-z-1"]]
    },
    {
        "id": "inject-l3gd20h-1",
        "type": "inject",
        "name": "Every 100 ms",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "repeat": "0.1",
        "crontab": "",
        "onceDelay": "0.1",
        "wires": [["l3gd20h-read-1"]]
    },
    {
        "id": "debug-l3gd20h-1",
        "type": "debug",
        "name": "Raw payload",
        "active": true,
        "tosideuit": false,
        "console": "false",
        "tostatus": "false",
        "complete": "payload",
        "targetType": "msg",
        "x": 480,
        "y": 200,
        "wires": []
    },
    {
        "id": "chart-x-1",
        "type": "ui_chart",
        "name": "X axis",
        "group": "l3gd20h-group-1",
        "order": 1,
        "width": 6,
        "height": 4,
        "label": "X (rad/s)",
        "chartType": "line",
        "x": 480,
        "y": 260,
        "wires": []
    },
    {
        "id": "chart-y-1",
        "type": "ui_chart",
        "name": "Y axis",
        "group": "l3gd20h-group-1",
        "order": 2,
        "width": 6,
        "height": 4,
        "label": "Y (rad/s)",
        "chartType": "line",
        "x": 480,
        "y": 320,
        "wires": []
    },
    {
        "id": "chart-z-1",
        "type": "ui_chart",
        "name": "Z axis",
        "group": "l3gd20h-group-1",
        "order": 3,
        "width": 12,
        "height": 4,
        "label": "Z (rad/s)",
        "chartType": "line",
        "x": 480,
        "y": 380,
        "wires": []
    }
]