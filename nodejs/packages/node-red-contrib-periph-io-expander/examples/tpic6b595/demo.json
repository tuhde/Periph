{
  "id": "tpic6b595-demo",
  "type": "tab",
  "label": "TPIC6B595 Demo",
  "info": "TPIC6B595 power SIPO demo: two cascaded devices driving 16 LEDs as an automotive-cluster-style indicator bank. Every 150 ms an inject node drives a 'knight rider' chase pattern that walks a single lit LED across all 16 outputs and back. Every 5 seconds a second inject toggles { outputEnable: false } for 500 ms to demonstrate glitch-free global blanking via G — the chase pattern's shadow state is preserved, so the LEDs resume exactly where they left off when G is re-enabled.",
  "nodes": [
    {
      "id": "tpic6b595-1",
      "type": "periph-tpic6b595",
      "z": "tpic6b595-demo",
      "name": "TPIC6B595 × 2",
      "rckPin": "17",
      "srclrPin": "16",
      "gPin": "15",
      "numDevices": "2",
      "wires": [[]]
    },
    {
