[
  {
    "id": "shtc3-tab",
    "type": "tab",
    "label": "SHTC3 hygrometer",
    "disabled": false,
    "info": "Reads temperature and relative humidity from an SHTC3 every 5 s and formats them as \"25.0 °C / 45.0 %RH\". Each message triggers one CRC-checked measurement; the sensor sleeps between messages. Set msg.low_power = true on an inject node, or tick low-power mode in the SHTC3 device node, for 0.7 ms measurements."
  },
  {
    "id": "shtc3-inject",
    "type": "inject",
    "z": "shtc3-tab",
    "name": "5 s timer",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payloadType": "date",
    "x": 160,
    "y": 160,
    "wires": [
      [
        "shtc3-node"
      ]
    ]
  },
  {
    "id": "shtc3-device-1",
    "type": "shtc3-device",
    "name": "SHTC3",
    "bus": "1",
    "address": "0x70",
    "lowPower": false
  },
  {
    "id": "shtc3-node",
    "type": "shtc3",
    "z": "shtc3-tab",
    "name": "SHTC3",
    "x": 380,
    "y": 160,
    "wires": [
      [
        "shtc3-format"
      ]
    ],
    "device": "shtc3-device-1"
  },
  {
    "id": "shtc3-format",
    "type": "function",
    "z": "shtc3-tab",
    "name": "Format",
    "func": "msg.payload = msg.payload.temperature_c.toFixed(1) + ' °C / ' + msg.payload.humidity_pct.toFixed(1) + ' %RH';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 160,
    "wires": [
      [
        "shtc3-debug"
      ]
    ]
  },
  {
    "id": "shtc3-debug",
    "type": "debug",
    "z": "shtc3-tab",
    "name": "Reading",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 800,
    "y": 160,
    "wires": []
  }
]
