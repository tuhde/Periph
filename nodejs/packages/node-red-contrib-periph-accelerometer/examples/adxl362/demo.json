[
    {
        "id": "tab-adxl362-demo",
        "type": "tab",
        "label": "ADXL362 Activity Logger",
        "disabled": false,
        "info": "Two flows. The first reads 3-axis acceleration + on-chip temperature from the ADXL362 every 100 ms and computes the magnitude √(x²+y²+z²). The second uses a separate adxl362 node configured for low-rate awake polling only — illustrates how a host can monitor activity cheaply without pulling full 12-bit samples every cycle. Together they exercise the chip's primary use as an ultralow-power motion sensor (continuous 100 Hz measurement mode when awake; ~270 nA wake-up mode when asleep). Adjust the measurement range, data rate, and noise mode in each device config node to match the application's bandwidth and power budget."
    },
    {
        "id": "cfg-adxl362-fast",
        "type": "adxl362-device",
        "name": "ADXL362 (100 Hz)",
        "bus": "0",
        "device": "0",
        "range": "2",
        "dataRate": "100",
        "noiseMode": "0",
        "halfBw": "true"
    },
    {
        "id": "cfg-adxl362-awake",
        "type": "adxl362-device",
        "name": "ADXL362 (awake-only)",
        "bus": "0",
        "device": "1",
        "range": "2",
        "dataRate": "100",
        "noiseMode": "0",
        "halfBw": "true"
    },
    {
        "id": "inj-tick",
        "type": "inject",
        "name": "every 100 ms",
        "repeat": "0.1",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "z": "tab-adxl362-demo",
        "x": 120,
        "y": 100,
        "wires": [["read-adxl362-fast"]]
    },
    {
        "id": "read-adxl362-fast",
        "type": "adxl362",
        "name": "ADXL362 read",
        "device": "cfg-adxl362-fast",
        "z": "tab-adxl362-demo",
        "x": 320,
        "y": 100,
        "wires": [["fn-magnitude", "dbg-axes"]]
    },
    {
        "id": "fn-magnitude",
        "type": "function",
        "name": "magnitude √(x²+y²+z²)",
        "func": "const {x, y, z, temperature, awake} = msg.payload;\nmsg.payload = { x, y, z, magnitude: Math.sqrt(x*x + y*y + z*z), temperature, awake };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "z": "tab-adxl362-demo",
        "x": 540,
        "y": 100,
        "wires": [["dbg-magnitude"]]
    },
    {
        "id": "dbg-axes",
        "type": "debug",
        "name": "x, y, z",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "z": "tab-adxl362-demo",
        "x": 520,
        "y": 60,
        "wires": []
    },
    {
        "id": "dbg-magnitude",
        "type": "debug",
        "name": "magnitude + temperature",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "z": "tab-adxl362-demo",
        "x": 770,
        "y": 100,
        "wires": []
    },
    {
        "id": "inj-slow",
        "type": "inject",
        "name": "every 2 s",
        "repeat": "2",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "z": "tab-adxl362-demo",
        "x": 120,
        "y": 240,
        "wires": [["read-adxl362-awake"]]
    },
    {
        "id": "read-adxl362-awake",
        "type": "adxl362",
        "name": "ADXL362 awake",
        "device": "cfg-adxl362-awake",
        "z": "tab-adxl362-demo",
        "x": 320,
        "y": 240,
        "wires": [["dbg-awake"]]
    },
    {
