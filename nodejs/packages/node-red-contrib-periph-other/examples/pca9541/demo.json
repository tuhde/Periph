[
    {
        "id": "tab-pca9541-demo",
        "type": "tab",
        "label": "PCA9541 Failover Demo",
        "disabled": false,
        "info": "Bus ownership on one of two redundant masters. An inject node sends {command: 'acquire'} to take the downstream bus, a second inject reads the status every 5 s into a debug node, and a third sends {command: 'release'}. With this master's INT line wired, a message with bus_lost = true is emitted when the other master takes the bus."
    },
    {
        "id": "inj-acquire",
        "type": "inject",
        "name": "Acquire",
        "topic": "",
        "payload": "{\"command\":\"acquire\"}",
        "payloadType": "json",
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 1,
        "z": "tab-pca9541-demo",
        "x": 130,
        "y": 80,
        "wires": [
            [
                "pca9541-node"
            ]
        ]
    },
    {
