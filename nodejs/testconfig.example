# Periph Node.js test configuration
# Copy this file to testconfig and fill in your values.
# testconfig is gitignored — never commit it.

# I²C bus number (the N in /dev/i2c-N)
I2C_BUS=1

# I²C address of the device under test (hex, optional — falls back to chip_defaults)
# I2C_ADDR=0x40

# ------------------------------------------------------------------
# Rig-wide sigrok analyzer (one logic analyzer on the bench)
# ------------------------------------------------------------------
# SIGROK_DRIVER=fx2lafw
# SIGROK_CONN=
# SIGROK_SAMPLERATE=24m

# ------------------------------------------------------------------
# Per-chip wiring overrides
# ------------------------------------------------------------------
# Only list chips whose wiring differs from the flat defaults above — e.g. a
# permanent bench with several chips on different buses/pins, each needing
# its own logic-analyzer channel mapping. nodejs is host-only with a single
# testconfig file, so this block lives directly here rather than in a
# separate testconfig_wiring (see specs/testing_framework.md, "Chip Wiring &
# Sigrok Configuration").
# case "${CATEGORY:-}/${CHIP:-}" in
#     gas/ens160)
#         I2C_ADDR=0x53
#         SIGROK_CHANNELS="D0=SCL,D1=SDA"
#         ;;
#     environmental/aht21)
#         I2C_ADDR=0x38
#         SIGROK_CHANNELS="D2=SCL,D3=SDA"
#         ;;
# esac
