{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Periph I2C discovery registry",
  "type": "object",
  "required": ["schema_version", "chips"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "chips": { "type": "array", "items": { "$ref": "#/$defs/chip" } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
    "address": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{2}(\\.\\.0x[0-9A-Fa-f]{2})?$" },
    "idProbe": {
      "type": "object",
      "required": ["register", "reg_bytes", "length", "byte_order", "mask", "expected"],
      "additionalProperties": false,
      "properties": {
        "register": { "$ref": "#/$defs/hex" },
        "reg_bytes": { "type": "integer", "minimum": 1, "maximum": 4 },
        "length": { "type": "integer", "minimum": 1, "maximum": 4 },
        "byte_order": { "enum": ["big", "little"] },
        "mask": { "$ref": "#/$defs/hex" },
        "expected": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hex" } }
      }
    },
    "chip": {
      "type": "object",
      "required": ["id", "name", "category", "addresses", "id_probe", "probe_safety", "datasheet"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "pattern": "^[a-z_]+$" },
        "addresses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/address" } },
        "id_probe": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/idProbe" }] },
        "probe_safety": { "enum": ["register_pointer", "write_sensitive"] },
        "aliased": { "type": "boolean" },
        "driver": { "type": ["string", "null"] },
        "datasheet": { "type": "string", "minLength": 1 }
      }
    }
  }
}
